++/* A short spin on a shared event/semaphore word before a wait blocks in the
++ * server. Only a successful pw_sync_word_try_wait changes the word; every
++ * other step only loads it. The spin ends at once when the server holds the
++ * word (SLOW) or its value is invalid, so it never races a waiter the server
++ * has queued, and the caller then takes the ordinary blocking wait.
++ */
++#ifndef WINE_PS5_SYNC_SPIN_H
++#define WINE_PS5_SYNC_SPIN_H
++#include <stdint.h>
++#include "ps5_sync_word.h"
++
++#define PW_SYNC_SPIN_DEFAULT_US 100u
++#define PW_SYNC_SPIN_MAX_US 1000u
++/* loads (each followed by a pause) between two reads of the clock */
++#define PW_SYNC_SPIN_POLLS 64u
++
++static inline void pw_sync_spin_pause(void)
++{
++#if defined(__i386__) || defined(__x86_64__)
++    __builtin_ia32_pause();
++#elif defined(__aarch64__)
++    __asm__ __volatile__("yield" ::: "memory");
++#else
++    __asm__ __volatile__("" ::: "memory");
++#endif
++}
++
++/* WINE_PS5_SYNC_SPIN_US: decimal microseconds. Unset, empty or anything but
++ * digits gives the default; 0 turns the spin off; more than the maximum is
++ * the maximum. */
++static inline unsigned int pw_sync_spin_parse(const char *text)
++{
++    unsigned int value = 0;
++    if (!text || !*text) return PW_SYNC_SPIN_DEFAULT_US;
++    for (; *text; ++text)
++    {
++        if (*text < '0' || *text > '9') return PW_SYNC_SPIN_DEFAULT_US;
++        value = value * 10 + (unsigned int)(*text - '0');
++        if (value > PW_SYNC_SPIN_MAX_US) value = PW_SYNC_SPIN_MAX_US + 1;
++    }
++    return value > PW_SYNC_SPIN_MAX_US ? PW_SYNC_SPIN_MAX_US : value;
++}
++
++/* Microseconds a wait may spin, given its NT timeout: none (infinite), or
++ * 100 ns units, negative relative, 0 a poll, positive an absolute time.
++ * A poll and an absolute time don't spin; a relative timeout shorter than
++ * the spin bounds it. INT64_MAX is Wine's infinite. */
++static inline unsigned int pw_sync_spin_budget(unsigned int spin_us, int has_timeout, int64_t timeout)
++{
++    if (!has_timeout || timeout == INT64_MAX) return spin_us;
++    if (timeout >= 0) return 0;
++    if (timeout < -(int64_t)spin_us * 10) return spin_us;
++    return (unsigned int)(-timeout / 10);
++}
++
++/* The relative timeout left after spinning spent_us of a relative timeout
++ * (negative); 0 (a poll) when it has all gone. */
++static inline int64_t pw_sync_spin_rest(int64_t timeout, uint64_t spent_us)
++{
++    if (timeout >= 0) return timeout;
++    /* spent_us * 10 >= -timeout, without negating INT64_MIN */
++    if (spent_us >= (uint64_t)INT64_MAX / 10 || (int64_t)spent_us * 10 - 1 >= -(timeout + 1)) return 0;
++    return timeout + (int64_t)spent_us * 10;
++}
++
++/* Retries the wait on cell for up to budget_us of now_us's clock. 1 when the
++ * wait took the object; 0 when the caller should block, with *spent_us the
++ * time spun. */
++static inline int pw_sync_word_spin_wait(struct pw_sync_word *cell, unsigned int budget_us,
++                                         uint64_t (*now_us)(void), uint64_t *spent_us)
++{
++    uint64_t start;
++    uint64_t word;
++    unsigned int i;
++    *spent_us = 0;
++    if (!budget_us) return 0;
++    start = now_us();
++    do
++    {
++        for (i = 0; i < PW_SYNC_SPIN_POLLS; ++i)
++        {
++            word = pw_sync_word_load(cell);
++            if ((word & PW_SYNC_WORD_SLOW) || !pw_sync_word_value_valid(cell, (uint32_t)word))
++                goto done;
++            if (word && pw_sync_word_try_wait(cell)) return 1;
++            pw_sync_spin_pause();
++        }
++    } while (now_us() - start < budget_us);
++done:
++    *spent_us = now_us() - start;
++    return 0;
++}
++#endif
