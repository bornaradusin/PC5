++    if (!(properties = heap_calloc(count, sizeof(*properties))))
++    {
++        WARN("Failed to allocate memory.\n");
++        ret = AGS_OUT_OF_MEMORY;
++        goto done;
++    }
++
++    if (!(memory_properties = heap_calloc(count, sizeof(*memory_properties))))
++    {
