diff --git a/wine/patches/0999-win32u-ps5-hide-the-pointer-when-unused.patch b/wine/patches/0999-win32u-ps5-hide-the-pointer-when-unused.patch
new file mode 100644
index 0000000..4881552
--- /dev/null
+++ b/wine/patches/0999-win32u-ps5-hide-the-pointer-when-unused.patch
@@ -0,0 +1,132 @@
+From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
+From: prospero-win <prospero-win@invalid>
+Date: Sat, 31 Oct 2026 22:00:00 +0000
+Subject: [PATCH] win32u: PS5: hide the pointer when the player hasn't used it
+ for a while.
+
+A game played with the controller that leaves the Windows cursor on (Valor
+Mortis, with its controller option chosen) showed the pointer, still, in
+the top left corner the whole time: on Windows the player would move the
+mouse out of the way, and here there may be no mouse at all.
+
+The PS5 user driver now hides the pointer once the player hasn't moved it
+or clicked for 5 seconds, as a console's pointer fades, both where it
+draws the cursor over the screen itself and where Vulkan frames get it
+from VideoOut's hardware cursor (patch 0740). The next move (the mouse,
+the touchpad or a stick working as a mouse, even against an edge) or
+click shows it again at once. Only the player's own input counts: a game
+that sets the cursor's position or image doesn't keep it on screen.
+The cursor the application set, and where it is, are unchanged, so
+GetCursorInfo and everything else still see it as shown.
+
+WINE_PS5_CURSOR_IDLE_MS sets the time in milliseconds (0 never hides it).
+---
+diff --git a/dlls/win32u/ps5drv.c b/dlls/win32u/ps5drv.c
+index 602b922..cc5a6c9 100644
+--- a/dlls/win32u/ps5drv.c
++++ b/dlls/win32u/ps5drv.c
+@@ -106,6 +106,40 @@ static UINT cursor_width, cursor_height;
+ static POINT cursor_hotspot;
+ /* The cursor image's visible (non-transparent) pixels, in image coordinates */
+ static RECT cursor_box;
++/* The pointer is hidden once the player hasn't moved it or clicked for
++ * WINE_PS5_CURSOR_IDLE_MS (5 seconds; 0 never hides it), as a console's
++ * pointer fades: a game played with the controller that leaves the Windows
++ * cursor on shows it otherwise, still, in a corner. It shows again at the
++ * next move or click. cursor_used is NtGetTickCount's at the last one, 0
++ * until the first frame that shows the cursor. */
++static DWORD cursor_used;
++
++/* screen_lock held: whether the cursor is drawn now */
++static BOOL cursor_shown(void)
++{
++    static int idle_ms = -1;
++    DWORD now;
++
++    if (!cursor_image) return FALSE;
++    if (idle_ms < 0)
++    {
++        const char *env = getenv( "WINE_PS5_CURSOR_IDLE_MS" );
++        idle_ms = env && *env ? max( 0, min( atoi( env ), 3600000 )) : 5000;
++        TRACE( "the pointer hides after %d ms without use\n", idle_ms );
++    }
++    if (!idle_ms) return TRUE;
++    now = NtGetTickCount();
++    if (!cursor_used) cursor_used = now ? now : 1;
++    return now - cursor_used < (DWORD)idle_ms;
++}
++
++/* screen_lock held: the player moved the pointer or clicked */
++static void cursor_use(void)
++{
++    DWORD now = NtGetTickCount();
++    cursor_used = now ? now : 1;
++}
++
+ /* WINE_PS5_VIEW=window shows only the visible top-level windows' bounding
+  * box, which the title scales to the whole TV, instead of the desktop;
+  * view is what the last frame showed, in screen coordinates. */
+@@ -183,7 +217,7 @@ static void present_screen(void)
+     view = view_rect();
+     width = view.right - view.left;
+     height = view.bottom - view.top;
+-    if ((!cursor_image || !frame) && width == (INT)screen_width && height == (INT)screen_height &&
++    if ((!cursor_shown() || !frame) && width == (INT)screen_width && height == (INT)screen_height &&
+         !view.left && !view.top)
+     {
+         present_frame( screen, screen_width, screen_height, screen_width * 4 );
+@@ -192,7 +226,7 @@ static void present_screen(void)
+     if (!frame) return;
+     for (y = 0; y < height; y++)
+         memcpy( frame + y * width, screen + (view.top + y) * screen_width + view.left, width * 4 );
+-    if (cursor_image) draw_cursor( frame, (POINT){view.left, view.top}, width, height );
++    if (cursor_shown()) draw_cursor( frame, (POINT){view.left, view.top}, width, height );
+     present_frame( frame, width, height, width * 4 );
+ }
+ 
+@@ -553,6 +587,13 @@ static void move_cursor( HWND hwnd, INT dx, INT dy )
+     if (raw_dx || raw_dy) send_motion( hwnd, dx, dy, raw_dx, raw_dy );
+     if (!server_cursor_pos( &pos )) return;
+     pthread_mutex_lock( &screen_lock );
++    if (dx || dy || raw_dx || raw_dy)
++    {
++        BOOL was_shown = cursor_shown();
++        cursor_use();
++        if (!was_shown && cursor_image && cursor.x == pos.x && cursor.y == pos.y)
++            present_screen();                   /* held at an edge: it shows again */
++    }
+     if (cursor.x != pos.x || cursor.y != pos.y)
+     {
+         cursor = pos;
+@@ -692,7 +733,18 @@ static BOOL ps5_ProcessEvents( DWORD mask )
+             move_cursor( hwnd, event.x, event.y );
+             break;
+         case 3:
+-            if (event.code < 3) send_mouse( hwnd, button_flags[event.code][event.down != 0], 0, 0 );
++            if (event.code < 3)
++            {
++                pthread_mutex_lock( &screen_lock );
++                if (!cursor_shown() && cursor_image)
++                {
++                    cursor_use();
++                    present_screen();           /* a click shows the pointer again */
++                }
++                else cursor_use();
++                pthread_mutex_unlock( &screen_lock );
++                send_mouse( hwnd, button_flags[event.code][event.down != 0], 0, 0 );
++            }
+             break;
+         case 6:
+             /* The wheel: x notches, away from the player positive, as a mouse's
+@@ -873,7 +925,7 @@ void ps5drv_vulkan_cursor( void *vulkan_handle )
+     }
+     if (!show) return;
+     pthread_mutex_lock( &screen_lock );
+-    show( cursor_width && cursor_height ? cursor_image : NULL, cursor_width, cursor_height,
++    show( cursor_width && cursor_height && cursor_shown() ? cursor_image : NULL, cursor_width, cursor_height,
+           cursor.x - cursor_hotspot.x, cursor.y - cursor_hotspot.y, screen_width, screen_height );
+     pthread_mutex_unlock( &screen_lock );
+ }
