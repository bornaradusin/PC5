+From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
+From: bornaradusin <bornaradusin@users.noreply.github.com>
+Date: Mon, 2 Nov 2026 17:30:00 +0000
+Subject: [PATCH] win32u: PS5: the hardware cursor follows the pointer between
+ presents.
+
+Over a swapchain's frames the cursor is VideoOut's hardware cursor, which
+ps5drv_vulkan_cursor set only after a present. A game that draws only when
+something changes (Age of Empires II HD's menus) left it where it was, or
+hidden once a desktop frame had shown (pw_videoout_show_tiled hides it, as
+a desktop frame has the cursor drawn in), and the desktop's frames with the
+cursor in them are left out as empty while a swapchain's picture shows
+(prospero-win's wine64_main): the pointer was gone. Each move, new image or
+hiding of the cursor now also goes to libvulkan.prx's
+pw_videoout_cursor_follow, which shows it unless a desktop frame is what
+shows. A libvulkan.prx without it changes nothing.
+
+diff --git a/dlls/win32u/ps5drv.c b/dlls/win32u/ps5drv.c
+index 1bca00f..a4af3d2 100644
+--- a/dlls/win32u/ps5drv.c
++++ b/dlls/win32u/ps5drv.c
+@@ -194,6 +194,27 @@ static void present_screen(void)
+     present_frame( frame, width, height, width * 4 );
+ }
+ 
++#ifdef SONAME_LIBVULKAN
++/* libvulkan.prx's pw_videoout_cursor_follow, once a swapchain has presented (ps5drv_vulkan_cursor) */
++static int (*cursor_follow)( const UINT32 *, UINT, UINT, INT, INT, UINT, UINT );
++#endif
++
++/* screen_lock held: the cursor changed (moved, another image, hidden). It is drawn into the
++ * desktop's frames, but over a swapchain's frames VideoOut's hardware cursor shows it, which
++ * followed it only at a present: a game that draws only when something changes (Age of Empires
++ * II HD's menus) left it where it was, or hidden after a desktop frame had shown, while the
++ * desktop's frames with the cursor in them were left out as empty (wine64_main). It follows now,
++ * while a swapchain's picture shows (pw_videoout_cursor_follow). */
++static void cursor_changed(void)
++{
++    present_screen();
++#ifdef SONAME_LIBVULKAN
++    if (cursor_follow)
++        cursor_follow( cursor_width && cursor_height ? cursor_image : NULL, cursor_width, cursor_height,
++                       cursor.x - cursor_hotspot.x, cursor.y - cursor_hotspot.y, screen_width, screen_height );
++#endif
++}
++
+ /***********************************************************************
+  *           display
+  */
+@@ -567,7 +588,7 @@ static void move_cursor( HWND hwnd, INT dx, INT dy )
+     if (cursor.x != pos.x || cursor.y != pos.y)
+     {
+         cursor = pos;
+-        if (cursor_image) present_screen();     /* the pointer moved on screen */
++        if (cursor_image) cursor_changed();     /* the pointer moved on screen */
+     }
+     pthread_mutex_unlock( &screen_lock );
+ }
+@@ -858,7 +879,7 @@ static void ps5_SetCursor( HWND hwnd, HCURSOR handle )
+     cursor_height = height;
+     cursor_box = box;
+     if (image) cursor_hotspot = (POINT){info.xHotspot, info.yHotspot};
+-    if (old || image) present_screen();
++    if (old || image) cursor_changed();
+     pthread_mutex_unlock( &screen_lock );
+     free( old );
+     TRACE( "cursor %p: %ux%u\n", handle, width, height );
+@@ -879,6 +900,9 @@ void ps5drv_vulkan_cursor( void *vulkan_handle )
+     {
+         looked = TRUE;
+         show = dlsym( vulkan_handle, "pw_videoout_cursor" );
++        pthread_mutex_lock( &screen_lock );
++        cursor_follow = dlsym( vulkan_handle, "pw_videoout_cursor_follow" );
++        pthread_mutex_unlock( &screen_lock );
+     }
+     if (!show) return;
+     pthread_mutex_lock( &screen_lock );
+@@ -899,7 +923,7 @@ static BOOL ps5_SetCursorPos( INT x, INT y )
+     pthread_mutex_lock( &screen_lock );
+     cursor.x = x;
+     cursor.y = y;
+-    if (cursor_image) present_screen();
++    if (cursor_image) cursor_changed();
+     pthread_mutex_unlock( &screen_lock );
+     return TRUE;
+ }
