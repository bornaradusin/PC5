diff --git a/wine/ps5/pw_vulkan_radv.c b/wine/ps5/pw_vulkan_radv.c
index fea1b00..a4058f4 100644
--- a/wine/ps5/pw_vulkan_radv.c
+++ b/wine/ps5/pw_vulkan_radv.c
@@ -92,6 +92,7 @@ static struct {
      * the one on screen never changes under the display. */
     uint32_t *images;
     int failed, enabled, current;
+    int desktop;   /* a desktop frame (the cursor drawn in) is what shows, not a swapchain's */
     uint32_t shown[CURSOR_PIXELS];
 } cursor;
 
@@ -144,13 +145,41 @@ static void cursor_hide_locked(int handle)
  * with its top-left corner at (x, y) of a space_width x space_height desktop,
  * which the swapchain's frames show whole. NULL hides it. 0 shown or hidden, 1 no
  * output yet, <0 failed. */
+static int cursor_show(const uint32_t *argb, uint32_t width, uint32_t height, int32_t x, int32_t y,
+                       uint32_t space_width, uint32_t space_height, int follow);
+
 int pw_videoout_cursor(const uint32_t *argb, uint32_t width, uint32_t height, int32_t x, int32_t y,
                        uint32_t space_width, uint32_t space_height)
+{
+    return cursor_show(argb, width, height, x, y, space_width, space_height, 0);
+}
+
+/* The same between presents, as the pointer moves or changes (win32u, Wine patch 0980): a game
+ * that draws only when something changes leaves a swapchain's picture on screen with nothing
+ * presenting, and the cursor followed only at a present. Nothing while a desktop frame shows:
+ * it has the cursor drawn in. */
+int pw_videoout_cursor_follow(const uint32_t *argb, uint32_t width, uint32_t height, int32_t x, int32_t y,
+                              uint32_t space_width, uint32_t space_height);
+int pw_videoout_cursor_follow(const uint32_t *argb, uint32_t width, uint32_t height, int32_t x, int32_t y,
+                              uint32_t space_width, uint32_t space_height)
+{
+    return cursor_show(argb, width, height, x, y, space_width, space_height, 1);
+}
+
+static int cursor_show(const uint32_t *argb, uint32_t width, uint32_t height, int32_t x, int32_t y,
+                       uint32_t space_width, uint32_t space_height, int follow)
 {
     int handle = __atomic_load_n(&videoout_handle, __ATOMIC_ACQUIRE), rc = 0;
     uint32_t image[CURSOR_PIXELS];
 
     if (handle < 0) return 1;
+    cursor_lock();
+    if (!follow) cursor.desktop = 0;   /* a swapchain presented: its picture shows */
+    else if (cursor.desktop) {
+        cursor_unlock();
+        return 0;
+    }
+    cursor_unlock();
     if (!argb || !width || !height || !space_width || !space_height) {
         cursor_lock();
         cursor_hide_locked(handle);
@@ -218,6 +247,7 @@ int pw_videoout_show_tiled(const void *tiled, uint64_t bytes, uint32_t width, ui
     if (result == 0 && handle >= 0) {
         cursor_lock();
         cursor_hide_locked(handle);
+        cursor.desktop = 1;
         cursor_unlock();
     }
     return result;
