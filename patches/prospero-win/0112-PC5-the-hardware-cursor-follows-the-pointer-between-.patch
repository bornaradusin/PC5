          cursor = pos;
-@@ -874,7 +917,18 @@ static BOOL ps5_ProcessEvents( DWORD mask )
+@@ -924,7 +967,18 @@ static BOOL ps5_ProcessEvents( DWORD mask )
              move_cursor( hwnd, event.x, event.y );
              break;
          case 3:
