diff --git a/wine/patches/0949-mmdevapi-ps5-the-speakers-follow-the-driver.patch b/wine/patches/0949-mmdevapi-ps5-the-speakers-follow-the-driver.patch
new file mode 100644
index 0000000..3c567f5
--- /dev/null
+++ b/wine/patches/0949-mmdevapi-ps5-the-speakers-follow-the-driver.patch
@@ -0,0 +1,42 @@
+From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
+From: bornaradusin <bornaradusin@users.noreply.github.com>
+Date: Mon, 2 Nov 2026 21:00:00 +0000
+Subject: [PATCH] mmdevapi: PS5: the speakers follow the driver.
+
+mmdevapi kept the first PhysicalSpeakers it stored in the registry, so a
+prefix that once ran in stereo told DirectSound games stereo for good. On
+PS5 the audio driver's speakers change between runs with each game's
+Sound output in PC5 (stereo, 5.1 or 7.1), so the driver's answer now
+replaces the kept one each time the devices are listed. A driver without an answer
+leaves what is kept.
+
+diff --git a/dlls/mmdevapi/devenum.c b/dlls/mmdevapi/devenum.c
+index 8440b5d..c7aea97 100644
+--- a/dlls/mmdevapi/devenum.c
++++ b/dlls/mmdevapi/devenum.c
+@@ -542,18 +542,11 @@ static MMDevice *MMDevice_Create(const WCHAR *name, GUID *id, EDataFlow flow, DW
+                 MMDevice_SetPropValue(id, flow, &PKEY_AudioEndpoint_FormFactor, &pv);
+             }
+ 
++            /* PS5: the driver's speakers replace the ones kept from an earlier run, as
++             * each game's Sound output in PC5 changes them between runs; a driver
++             * without an answer leaves what is kept */
+             if (flow != eCapture)
+-            {
+-                PROPVARIANT pv2;
+-
+-                PropVariantInit(&pv2);
+-
+-                /* make read-write by not overwriting if already set */
+-                if (FAILED(MMDevice_GetPropValue(id, flow, &PKEY_AudioEndpoint_PhysicalSpeakers, &pv2)) || pv2.vt != VT_UI4)
+-                    set_driver_prop_value(id, flow, &PKEY_AudioEndpoint_PhysicalSpeakers);
+-
+-                PropVariantClear(&pv2);
+-            }
++                set_driver_prop_value(id, flow, &PKEY_AudioEndpoint_PhysicalSpeakers);
+ 
+             pv.vt = VT_LPWSTR;
+             pv.pwszVal = drvs.module_name;
+-- 
+2.43.0
+
