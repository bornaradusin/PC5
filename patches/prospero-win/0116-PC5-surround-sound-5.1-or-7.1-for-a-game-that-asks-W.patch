     assert(out[0]==16384 && out[1]==-16384 && out[2]==0 && out[3]==-1);
 }
 
+/* Surround: each channel on its own speaker of 7.1, in Windows' order. */
+static void test_surround(void)
+{
+    static float out8[8*4];
+    PwAudioMixStream s;
+    int16_t ring[8*2]={0};
+    int16_t grain[8*2];
+    PwAudioMixFormat f=pcm(48000,8,16);
+    for(int i=0;i<8;i++)ring[i]=(int16_t)(1000*(i+1));
+    assert(pw_audio_mix_stream_init(&s,&f,(const uint8_t *)ring,2)==PW_OK && s.outputs==2);
+    assert(pw_audio_mix_set_outputs(NULL,8)==PW_ERR_PRECONDITION);
+    assert(pw_audio_mix_set_outputs(&s,6)==PW_ERR_UNSUPPORTED && s.outputs==2);
+    assert(pw_audio_mix_set_outputs(&s,PW_AUDIO_MIX_SURROUND)==PW_OK);
+    s.held=2;
+    memset(out8,0,sizeof(out8));
+    assert(pw_audio_mix_add(&s,out8,2)==2);
+    /* the first frame comes out second: the resampler's history is first */
+    for(int i=0;i<8;i++)assert(out8[i]==0 && near(out8[8+i],ring[i]/32768.0f));
+    pw_audio_mix_store_channels(out8,grain,2,8);
+    assert(grain[0]==0 && grain[8]==1000 && grain[15]==8000);
+
+    /* 5.1 without a mask (back pair): the back pair plays on the sides, as 5.1's surround */
+    int16_t ring6[6*2]={0};
+    f=pcm(48000,6,16);
+    for(int i=0;i<6;i++)ring6[i]=(int16_t)(1000*(i+1));
+    assert(pw_audio_mix_stream_init(&s,&f,(const uint8_t *)ring6,2)==PW_OK);
+    assert(pw_audio_mix_set_outputs(&s,8)==PW_OK);
+    s.held=2;memset(out8,0,sizeof(out8));
+    assert(pw_audio_mix_add(&s,out8,2)==2);
+    const float *frame=out8+8;
+    assert(near(frame[0],1000/32768.0f) && near(frame[1],2000/32768.0f) && near(frame[2],3000/32768.0f));
+    assert(near(frame[3],4000/32768.0f) && frame[4]==0 && frame[5]==0);
+    assert(near(frame[6],5000/32768.0f) && near(frame[7],6000/32768.0f));
+
+    /* stereo stays on the front pair; mono on both of it */
+    int16_t ring2[2*2]={3000,-3000,0,0};
+    f=pcm(48000,2,16);
+    assert(pw_audio_mix_stream_init(&s,&f,(const uint8_t *)ring2,2)==PW_OK && pw_audio_mix_set_outputs(&s,8)==PW_OK);
+    s.held=2;memset(out8,0,sizeof(out8));
+    assert(pw_audio_mix_add(&s,out8,2)==2);
+    assert(near(out8[8],3000/32768.0f) && near(out8[9],-3000/32768.0f));
+    for(int i=2;i<8;i++)assert(out8[8+i]==0);
+    int16_t ring1[2]={2000,0};
+    f=pcm(48000,1,16);
+    assert(pw_audio_mix_stream_init(&s,&f,(const uint8_t *)ring1,2)==PW_OK && pw_audio_mix_set_outputs(&s,8)==PW_OK);
+    s.held=2;memset(out8,0,sizeof(out8));
+    assert(pw_audio_mix_add(&s,out8,2)==2);
+    assert(near(out8[8],2000/32768.0f) && near(out8[9],2000/32768.0f) && out8[10]==0);
+
+    /* the gain still applies, and stereo again folds */
+    f=pcm(48000,8,16);
+    assert(pw_audio_mix_stream_init(&s,&f,(const uint8_t *)ring,2)==PW_OK && pw_audio_mix_set_outputs(&s,8)==PW_OK);
+    const float gain[8]={1,1,1,1,1,1,0.5f,0};
+    assert(pw_audio_mix_set_gain(&s,gain,8)==PW_OK);
+    s.held=2;memset(out8,0,sizeof(out8));
+    assert(pw_audio_mix_add(&s,out8,2)==2);
+    assert(near(out8[14],3500/32768.0f) && out8[15]==0);
+    assert(pw_audio_mix_set_outputs(&s,2)==PW_OK);
+    s.offset=0;s.held=2;s.phase=(uint64_t)1<<32;memset(out8,0,sizeof(out8));
+    assert(pw_audio_mix_add(&s,out8,2)==2);
+    /* left, second out: 1000 + centre 3000*0.707 + back 5000*0.707 + side 7000*0.5*0.707 */
+    assert(near(out8[2],(1000+(3000+5000+3500)*0.70710678f)/32768.0f));
+}
