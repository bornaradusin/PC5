diff --git a/wine/ps5/pw_wine_dmem_ps5.c b/wine/ps5/pw_wine_dmem_ps5.c
index 3ea07b6..a47fadf 100644
--- a/wine/ps5/pw_wine_dmem_ps5.c
+++ b/wine/ps5/pw_wine_dmem_ps5.c
@@ -74,26 +74,61 @@ static int map_protection = CPU_READ_WRITE;
 
 static int largest_free_block(size_t pool, size_t *bytes);
 
+/* All the free direct memory of the pool, block by block (as the title's
+ * minute line reads it): with the largest free block, it tells a full pool
+ * (little free) from a fragmented one (much free, no large block). At most
+ * 512 questions to the kernel; no allocation. */
+static size_t total_free_bytes(size_t pool)
+{
+    struct range { int64_t low, high; } waiting[64], now = { 0, (int64_t)pool };
+    const size_t alignment = 0x4000;
+    unsigned count = 0, questions = 0;
+    size_t free_bytes = 0;
+
+    for (;;) {
+        int64_t start = 0;
+        size_t size = 0;
+
+        if (now.high - now.low >= (int64_t)alignment && questions++ < 512 &&
+            !sceKernelAvailableDirectMemorySize(now.low, now.high, alignment, &start, &size) && size &&
+            start >= now.low && size <= (uint64_t)(now.high - start)) {
+            struct range after = { start + (int64_t)size, now.high };
+
+            free_bytes += size;
+            if (after.high - after.low >= (int64_t)alignment && count < sizeof(waiting) / sizeof(waiting[0]))
+                waiting[count++] = after;
+            now.high = start;
+            continue;
+        }
+        if (!count) break;
+        now = waiting[--count];
+    }
+    return free_bytes;
+}
+
 /* A refused direct-memory call, for the title's log: the step, the kernel's
- * status and the largest free block of the pool then, which tells a full
- * pool from a refused protection. The first 32, then every 1000th: a game
- * whose heap spills keeps failing allocations on purpose. Written with
- * write(): the heap calls allocate() with its lock held, and stdio may
- * allocate. */
+ * status, the largest free block of the pool then and all its free memory,
+ * which tell a full pool, a fragmented one and a refused protection apart.
+ * The first 32, then every 1000th: a game whose heap spills keeps failing
+ * allocations on purpose. Written with write(): the heap calls allocate()
+ * with its lock held, and stdio may allocate. */
 static void log_refusal(const char *step, uintptr_t address, size_t bytes, unsigned protection, int status)
 {
     static uint32_t refusals;
     const uint32_t count = __atomic_add_fetch(&refusals, 1, __ATOMIC_RELAXED);
     const int saved_errno = errno;
-    size_t free_bytes = 0;
-    char line[192];
+    const size_t pool = sceKernelGetDirectMemorySize();
+    size_t free_bytes = 0, all_free;
+    char line[224];
     int length;
 
     if (count > 32 && count % 1000) return;
-    if (largest_free_block(sceKernelGetDirectMemorySize(), &free_bytes)) free_bytes = 0;
+    if (largest_free_block(pool, &free_bytes)) free_bytes = 0;
+    all_free = total_free_bytes(pool);
     length = snprintf(line, sizeof(line), "wine-ps5: direct memory %s refused: address %#llx, %zu bytes, "
-                      "protection %#x, status %#x, largest free block %zu MiB (refusal %u)\n", step,
-                      (unsigned long long)address, bytes, protection, (unsigned)status, free_bytes >> 20, count);
+                      "protection %#x, status %#x, largest free block %zu MiB, free in all %zu MiB (refusal %u)\n",
+                      step, (unsigned long long)address, bytes, protection, (unsigned)status, free_bytes >> 20,
+                      all_free >> 20, count);
     if (length > 0) (void)!write(2, line, (size_t)length < sizeof(line) ? (size_t)length : sizeof(line) - 1);
     errno = saved_errno;
 }
@@ -166,7 +201,32 @@ static int release(void *context, int64_t offset, size_t bytes)
     return rc;
 }
 
-static const PwWineDmemOps ops = { NULL, PAGE, reserve, allocate, map, protect, unmap, release };
+/* The largest block allocate could take now: a range one block couldn't
+ * back is backed with several, each sized by it. */
+static int largest(void *context, size_t *bytes)
+{
+    (void)context;
+    return largest_free_block(sceKernelGetDirectMemorySize(), bytes);
+}
+/* After the refusal line, that the range was backed after all, with several
+ * blocks. As often as refusals are logged. */
+static void split(void *context, size_t bytes, unsigned blocks)
+{
+    static uint32_t splits;
+    const uint32_t count = __atomic_add_fetch(&splits, 1, __ATOMIC_RELAXED);
+    const int saved_errno = errno;
+    char line[128];
+    int length;
+
+    (void)context;
+    if (count > 32 && count % 1000) return;
+    length = snprintf(line, sizeof(line), "wine-ps5: direct memory for %zu bytes taken in %u blocks instead (%u)\n",
+                      bytes, blocks, count);
+    if (length > 0) (void)!write(2, line, (size_t)length < sizeof(line) ? (size_t)length : sizeof(line) - 1);
+    errno = saved_errno;
+}
