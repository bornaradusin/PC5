+    /* Without the largest block told: halved until each block fits. */
+    largest_block = 3;
+    assert(pw_wine_dmem_protect(&dmem, at(40), 10 * PAGE, 3) == 0);
+    for (unsigned p = 40; p < 50; p++) assert(state[p] == MAPPED && ((uint8_t *)at(p))[0] == 0);
+    memset((void *)at(40), 0x33, 10 * PAGE);
+    check_consistent();
+    assert(pw_wine_dmem_replace(&dmem, at(40), 10 * PAGE, 0) == 0);
+    /* With it told: each block as large as the largest, a read-only protection on all of them. */
+    dmem.ops = told_ops;
+    split_calls = 0;
+    assert(pw_wine_dmem_replace(&dmem, at(60), 7 * PAGE, 1) == 0);
+    assert(split_calls == 1 && split_blocks == 3);
+    for (unsigned p = 60; p < 67; p++) assert(state[p] == MAPPED && prot_of[p] == 1 && ((uint8_t *)at(p))[0] == 0);
+    check_consistent();
+    /* Blocks of one page each are the least. */
+    {
+        const unsigned pages = allocated_pages();
+        largest_block = 1;
+        assert(pw_wine_dmem_protect(&dmem, at(80), 2 * PAGE, 3) == 0 && split_blocks == 2);
+        assert(pw_wine_dmem_replace(&dmem, at(80), 2 * PAGE, 0) == 0 && allocated_pages() == pages);
+    }
+    /* A map refused partway gives every block back. */
+    largest_block = 2;
+    {
+        const unsigned pages = allocated_pages();
+        fail_map = 3;
+        assert(pw_wine_dmem_protect(&dmem, at(90), 6 * PAGE, 3) == -1);
+        for (unsigned p = 90; p < 96; p++) assert(state[p] == RESERVED);
+        assert(allocated_pages() == pages);
+        check_consistent();
+    }
+    /* More blocks than one range may have: refused, nothing kept. */
+    largest_block = 1;
+    {
