+/* At most this many blocks back one range. */
+enum { MAX_BLOCKS = 32 };
+
+/* Mapped blocks given back: their pages reserved again, their direct memory
+ * released. */
+static void drop_blocks(PwWineDmem *d, const PwWineDmemRun *blocks, unsigned count)
+{
+    const PwWineDmemOps *ops = &d->ops;
+
+    while (count--) {
+        (void)ops->unmap(ops->context, blocks[count].address, blocks[count].bytes);
+        (void)ops->reserve(ops->context, blocks[count].address, blocks[count].bytes);
+        (void)ops->release(ops->context, blocks[count].offset, blocks[count].bytes);
+    }
+}
+
+/* A reserved range one block of direct memory refused to back, backed with
+ * several, each mapped where the one before ends: the kernel hands out each
+ * block in one piece, and a pool split into pieces can hold the whole range
+ * in no one block. The largest free block, when ops tell it, sizes each; a
+ * block refused anyway is halved, down to a page. blocks gets them, mapped:
+ * their count, or 0 with nothing kept. */
+static unsigned back_blocks(PwWineDmem *d, uintptr_t address, size_t bytes, PwWineDmemRun *blocks)
+{
+    const PwWineDmemOps *ops = &d->ops;
+    const size_t page = ops->page;
+    size_t done = 0, size = (bytes / 2) & ~(page - 1);
+    unsigned count = 0;
+
+    while (done < bytes) {
+        size_t largest = 0;
+        int64_t offset;
+
+        if (size > bytes - done) size = bytes - done;
+        if (ops->largest && !ops->largest(ops->context, &largest) && (largest & ~(page - 1)) < size)
+            size = largest & ~(page - 1);
+        if (size < page || count == MAX_BLOCKS) break;
+        if (ops->allocate(ops->context, size, &offset)) {
+            size = (size / 2) & ~(page - 1);
+            continue;
+        }
+        d->stats.allocations++;
+        if (ops->map(ops->context, address + done, size, offset)) {
+            (void)ops->release(ops->context, offset, size);
+            break;
+        }
+        d->stats.maps++;
+        blocks[count++] = (PwWineDmemRun){ address + done, size, offset };
+        done += size;
+    }
+    if (done == bytes) return count;
+    drop_blocks(d, blocks, count);
+    return 0;
+}
+
 /* Back a reserved range that no run touches, with one table entry free. */
 static int back(PwWineDmem *d, uintptr_t address, size_t bytes, unsigned protection)
 {
     const PwWineDmemOps *ops = &d->ops;
+    PwWineDmemRun blocks[MAX_BLOCKS];
+    unsigned count = 0;
     int64_t offset;
 
-    if (ops->allocate(ops->context, bytes, &offset)) goto failed;
-    d->stats.allocations++;
-    if (ops->map(ops->context, address, bytes, offset)) goto release;
-    d->stats.maps++;
+    if (!ops->allocate(ops->context, bytes, &offset)) {
+        d->stats.allocations++;
+        if (ops->map(ops->context, address, bytes, offset)) {
+            (void)ops->release(ops->context, offset, bytes);
+            goto failed;
+        }
+        d->stats.maps++;
+        blocks[count++] = (PwWineDmemRun){ address, bytes, offset };
+    } else {
+        count = back_blocks(d, address, bytes, blocks);
+        /* Each block is a run of its own: past the one free entry, the
+         * table must hold the others. */
+        if (count && d->run_count + count > d->run_capacity) {
+            d->stats.table_full++;
+            drop_blocks(d, blocks, count);
+            count = 0;
+        }
+        if (!count) goto failed;
+        if (ops->split) ops->split(ops->context, bytes, count);
+    }
     if (d->zero_fill) memset((void *)address, 0, bytes);
     if (protection != READ_WRITE) {
-        if (ops->protect(ops->context, address, bytes, protection)) {
-            (void)ops->unmap(ops->context, address, bytes);
-            (void)ops->reserve(ops->context, address, bytes);
-            goto release;
-        }
+        for (unsigned i = 0; i < count; i++)
+            if (ops->protect(ops->context, blocks[i].address, blocks[i].bytes, protection)) {
+                drop_blocks(d, blocks, count);
+                goto failed;
+            }
         d->stats.protects++;
     }
     note_backed(d, address, bytes, 1);
     /* Direct memory handed out in order often continues the run before. */
-    add_run(d, (PwWineDmemRun){ address, bytes, offset });
+    for (unsigned i = 0; i < count; i++) add_run(d, blocks[i]);
     return 0;
-release:
-    (void)ops->release(ops->context, offset, bytes);
 failed:
     d->stats.failures++;
     return -1;
