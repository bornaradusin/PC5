diff --git a/wine/patches/0946-win32u-ps5-report-the-refresh-rate-asked-of-the-display.patch b/wine/patches/0946-win32u-ps5-report-the-refresh-rate-asked-of-the-display.patch
new file mode 100644
index 0000000..020eef6
--- /dev/null
+++ b/wine/patches/0946-win32u-ps5-report-the-refresh-rate-asked-of-the-display.patch
@@ -0,0 +1,37 @@
+From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
+From: Mihawk <163614687+mihawk-99@users.noreply.github.com>
+Date: Sun, 4 Oct 2026 23:30:00 -0400
+Subject: [PATCH] win32u: on PS5, report the refresh rate the title asked of the display
+
+The PS5 driver's one display mode said 60 Hz whatever the output did. A game that opts in to 119.88 Hz
+output (PS5_Proton's PROTON_120HZ, which points RADV at the title's high-frame-rate declaration) ran
+at 119.88 Hz on the console (2026-10-04, record removed from the tree; in git history: the shell reports 2560x1440 at 119.8801 Hz, frames paced
+at 8.5 ms) while a Java game's debug screen still said "@60Hz", read from this mode. The title now
+passes the rate it asked for in WINE_PS5_REFRESH; without it the mode stays at 60 Hz.
+---
+  dlls/win32u/ps5drv.c | 5 ++++-
+  1 file changed, 4 insertions(+), 1 deletion(-)
+
+diff --git a/dlls/win32u/ps5drv.c b/dlls/win32u/ps5drv.c
+index 6c8da1b..9c4870d 100644
+--- a/dlls/win32u/ps5drv.c
++++ b/dlls/win32u/ps5drv.c
+@@ -203,6 +203,9 @@ static UINT ps5_UpdateDisplayDevices( const struct gdi_device_manager *manager,
+     struct pci_id pci_id = {0};
+     struct gdi_monitor monitor = {0};
+     DEVMODEW mode = {.dmSize = sizeof(mode)};
++    /* WINE_PS5_REFRESH: the rate the title asked of the display (120 for a game that opts in
++     * to 119.88 Hz output); a game reads it to pace itself and to show it */
++    const char *refresh = getenv( "WINE_PS5_REFRESH" );
+ 
+     mode.dmFields = DM_DISPLAYORIENTATION | DM_BITSPERPEL | DM_PELSWIDTH | DM_PELSHEIGHT |
+                     DM_DISPLAYFLAGS | DM_DISPLAYFREQUENCY | DM_POSITION;
+@@ -210,7 +213,7 @@ static UINT ps5_UpdateDisplayDevices( const struct gdi_device_manager *manager,
+     mode.dmBitsPerPel = 32;
+     mode.dmPelsWidth = screen_width;
+     mode.dmPelsHeight = screen_height;
+-    mode.dmDisplayFrequency = 60;
++    mode.dmDisplayFrequency = refresh && atoi( refresh ) > 0 ? atoi( refresh ) : 60;
+ 
+     SetRect( &monitor.rc_monitor, 0, 0, screen_width, screen_height );
+     monitor.rc_work = monitor.rc_monitor;
diff --git a/wine/patches/0947-win32u-a-virtual-desktop-offers-the-display-s-rate.patch b/wine/patches/0947-win32u-a-virtual-desktop-offers-the-display-s-rate.patch
new file mode 100644
index 0000000..7a8efad
--- /dev/null
+++ b/wine/patches/0947-win32u-a-virtual-desktop-offers-the-display-s-rate.patch
@@ -0,0 +1,59 @@
+From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
+From: Mihawk <163614687+mihawk-99@users.noreply.github.com>
+Date: Fri, 17 Oct 2026 20:30:00 -0400
+Subject: [PATCH] win32u: a virtual desktop offers the display's rate
+
+With PROTON_120HZ=1 every process in the Mihawk OS session published the PS5 driver's 1920x1080@120, yet programs
+there were offered only 60 Hz (PS5_Proton's modes-p2-2026-10-17-03: all six publishes at 120, the probe reading 36
+modes at 60; the same probe outside a virtual desktop read 60 and 120). In a virtual desktop win32u reports the driver's
+source as detached and adds its own: add_virtual_source made that source's starting mode the display's with the rate
+forced to 60, and Proton's emulate_modeset then collapsed the virtual modes it had generated (at 60 and the display's
+rate) to that one mode and rebuilt them from its 60. The virtual source now starts at the display's own rate, and keeps
+the modes add_virtual_source generated, so a game's later 60 Hz mode change no longer drops the 120 Hz modes for the
+rest of the session. Outside a virtual desktop nothing changes.
+---
+ dlls/win32u/sysparams.c | 12 +++++++++---
+ 1 file changed, 9 insertions(+), 3 deletions(-)
+
+--- a/dlls/win32u/sysparams.c
++++ b/dlls/win32u/sysparams.c
+@@ -1098,6 +1098,7 @@
+     /* for the virtual desktop settings */
+     BOOL is_primary;
+     DEVMODEW primary;
++    BOOL adding_virtual;   /* add_virtual_source's modes, already the virtual desktop's own */
+ };
+ 
+ static void link_device( const char *instance, const char *class )
+@@ -2326,7 +2327,10 @@
+     assert( !list_empty( &sources ) );
+     source = LIST_ENTRY( list_tail( &sources ), struct source, entry );
+ 
+-    if (emulate_modeset)
++    /* A virtual desktop's source keeps the modes add_virtual_source generated: rebuilding them from its current mode
++     * would take that mode's rate (the display's 119.88 Hz lost to the 60 a game set). */
++    if (ctx->adding_virtual) {}
++    else if (emulate_modeset)
+     {
+         modes = current;
+         modes_count = 1;
+@@ -2988,7 +2992,8 @@
+     if (!read_source_mode( source->key, ENUM_CURRENT_SETTINGS, &current ))
+     {
+         current = ctx->primary;
+-        current.dmDisplayFrequency = 60;
++        /* the display's own rate (the PS5's 119.88 Hz under PROTON_120HZ), as get_virtual_modes offers it */
++        if (current.dmDisplayFrequency <= 1) current.dmDisplayFrequency = 60;
+         current.dmPelsWidth = initial.dmPelsWidth;
+         current.dmPelsHeight = initial.dmPelsHeight;
+     }
+@@ -3001,7 +3006,9 @@
+ 
+     /* Expose the virtual source display modes as physical modes, to avoid DPI scaling */
+     if (!(modes = get_virtual_modes( &initial, &maximum, NULL, 0, &modes_count ))) return STATUS_NO_MEMORY;
++    ctx->adding_virtual = TRUE;
+     add_modes( &current, modes_count, modes, ctx );
++    ctx->adding_virtual = FALSE;
+     free( modes );
+ 
+     return STATUS_SUCCESS;
diff --git a/wine/ps5/pw_framegen.cpp b/wine/ps5/pw_framegen.cpp
index 6767e2f..646d788 100644
--- a/wine/ps5/pw_framegen.cpp
+++ b/wine/ps5/pw_framegen.cpp
@@ -29,14 +29,18 @@
 
 extern "C" PFN_vkVoidFunction VKAPI_CALL vk_icdGetInstanceProcAddr(VkInstance instance, const char *name);
 extern "C" PFN_vkVoidFunction VKAPI_CALL vk_common_GetDeviceProcAddr(VkDevice device, const char *name);
+/* The display's rate in millihertz (PC5's patches/radv 0004). */
+extern "C" uint32_t wsi_videoout_refresh_millihertz(void);
 
 struct pw_framegen_vk pw_framegen_vk;
 
 namespace
 {
-constexpr double k_display_hz = 59.94;
+/* The display's rate, from RADV once a swapchain presents (PC5's
+ * patches/radv 0004): 119.88 Hz with 120 Hz output on and kept, else 59.94. */
+double display_hz = 0;
 /* Half the display's rate, less 0.05 fps: the queue stays empty. */
-constexpr double k_period = 1.0 / (k_display_hz / 2.0 - 0.05);
+double k_period = 1.0 / (59.94 / 2.0 - 0.05);
 constexpr unsigned k_slots = 3;
 constexpr unsigned k_settle = 8;
 constexpr double k_log_every = 10.0;
@@ -108,6 +112,19 @@ void sleep_until(double when)
     nanosleep(&ts, nullptr);
 }
 
+/* At a swapchain's first present (VideoOut is open by then): the hold for the
+ * display's rate, 30 -> 60 at 59.94 Hz, 60 -> 120 at 119.88 Hz. */
+void settle_rate()
+{
+    if (display_hz > 0)
+        return;
+    const uint32_t millihertz = wsi_videoout_refresh_millihertz();
+    display_hz = millihertz ? millihertz / 1000.0 : 59.94;
+    k_period = 1.0 / (display_hz / 2.0 - 0.05);
+    fprintf(stderr, "pw_framegen: display at %.2f Hz: %.2f fps shown at %.2f\n", display_hz, 1.0 / k_period,
+            2.0 / k_period);
+}
+
 bool is_wanted()
 {
     if (wanted < 0)
@@ -115,7 +132,7 @@ bool is_wanted()
         const char *value = getenv("PW_PC5_FRAMEGEN");
         wanted = value && !strcmp(value, "1");
         if (wanted)
-            fprintf(stderr, "pw_framegen: on, %.2f fps shown at %.2f\n", 1.0 / k_period, 2.0 / k_period);
+            fprintf(stderr, "pw_framegen: on, half the display's rate shown at the whole\n");
     }
     return wanted > 0;
 }
@@ -559,6 +576,7 @@ VKAPI_ATTR VkResult VKAPI_CALL wrap_QueuePresentKHR(VkQueue queue, const VkPrese
         return next.QueuePresentKHR(queue, info);
     }
 
+    settle_rate();
     /* The hold: a frame at most every k_period. */
     sleep_until(sc->next_due);
     now = now_seconds();
