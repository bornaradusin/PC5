--- /dev/null
+++ b/wine/patches/0919-dnsapi-report-unavailable-unix-backend.patch
@@ -0,0 +1,30 @@
+From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
+From: prospero-win <prospero-win@invalid>
+Date: Sun, 25 Oct 2026 08:54:10 +0000
+Subject: [PATCH] dnsapi: report unavailable Unix backend without dispatching through null
+
+DllMain logs an unavailable resolver backend but still permits PE imports.
+DnsQueryConfig must report that unavailable capability, rather than dispatch
+through a null Unix function table. A console GetAdaptersAddresses trace
+reproduces STATUS_ACCESS_VIOLATION at table index 1 with handle zero.
+Keep the ordinary error visible; this does not provide DNS configuration.
+
+From MihawkOS's patch 0965 (LGPL-2.1-or-later), unchanged but for its
+context.
+---
+ dlls/dnsapi/dnsapi.h | 3 ++-
+ 1 file changed, 2 insertions(+), 1 deletion(-)
+
+diff --git a/dlls/dnsapi/dnsapi.h b/dlls/dnsapi/dnsapi.h
+--- a/dlls/dnsapi/dnsapi.h
++++ b/dlls/dnsapi/dnsapi.h
+@@ -130,4 +130,5 @@ enum unix_funcs
+     unix_funcs_count
+ };
+ 
+-#define RESOLV_CALL( func, params ) WINE_UNIX_CALL( unix_ ## func, params )
++#define RESOLV_CALL( func, params ) \
++    (__wine_unixlib_handle ? WINE_UNIX_CALL( unix_ ## func, params ) : ERROR_NOT_SUPPORTED)
+-- 
+2.43.0
+
diff --git a/wine/patches/0920-dxcore-a-gpu-adapter-has-the-graphics-and-compute-attributes.patch b/wine/patches/0920-dxcore-a-gpu-adapter-has-the-graphics-and-compute-attributes.patch
new file mode 100644
index 0000000..43d45f8
--- /dev/null
+++ b/wine/patches/0920-dxcore-a-gpu-adapter-has-the-graphics-and-compute-attributes.patch
@@ -0,0 +1,43 @@
+From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
+From: prospero-win <prospero-win@invalid>
+Date: Sun, 25 Oct 2026 08:54:10 +0000
+Subject: [PATCH] dxcore: a GPU adapter has the graphics and compute attributes
+
+IDXCoreAdapter::IsAttributeSupported answered FALSE for everything, so a program that sorts adapters by attribute
+took the console's GPU for something else. Chromium (CEF 150, MihawkBrowser) collects NPUs as the hardware adapters
+that support neither DXCORE_ADAPTER_ATTRIBUTE_D3D12_GRAPHICS nor ..._D3D11_GRAPHICS
+(gpu/config/gpu_info_collector_win.cc, CollectNPUInformation), took the GPU for one, and read its driver description
+with GetProperty(DriverDescription, &char_pointer): eight bytes, which the four of "PS5" fit, so the pointer became
+0x00355350 and its std::string read faulted in the browser's GPU thread at startup (console run
+2026-10-16; record removed from the tree; in git history). Every adapter dxcore lists is a wined3d GPU, so it reports Direct3D 11 and 12 graphics
+and core compute; other attributes stay unimplemented.
+
+From MihawkOS's patch 1170 (LGPL-2.1-or-later), unchanged but for its
+context.
+---
+ dlls/dxcore/dxcore.c | 10 +++++++++-
+ 1 file changed, 9 insertions(+), 1 deletion(-)
+
+diff --git a/dlls/dxcore/dxcore.c b/dlls/dxcore/dxcore.c
+--- a/dlls/dxcore/dxcore.c
++++ b/dlls/dxcore/dxcore.c
+@@ -91,7 +91,15 @@ static BOOL STDMETHODCALLTYPE dxcore_adapter_IsValid(IDXCoreAdapter *iface)
+ 
+ static BOOL STDMETHODCALLTYPE dxcore_adapter_IsAttributeSupported(IDXCoreAdapter *iface, REFGUID attribute)
+ {
+-    FIXME("iface %p, attribute %s stub!\n", iface, debugstr_guid(attribute));
++    TRACE("iface %p, attribute %s.\n", iface, debugstr_guid(attribute));
++
++    /* Every adapter here is a wined3d GPU: it draws through Direct3D 11 and 12 and computes. */
++    if (IsEqualGUID(attribute, &DXCORE_ADAPTER_ATTRIBUTE_D3D11_GRAPHICS)
++            || IsEqualGUID(attribute, &DXCORE_ADAPTER_ATTRIBUTE_D3D12_GRAPHICS)
++            || IsEqualGUID(attribute, &DXCORE_ADAPTER_ATTRIBUTE_D3D12_CORE_COMPUTE))
++        return TRUE;
++
++    FIXME("iface %p, attribute %s not implemented.\n", iface, debugstr_guid(attribute));
+     return FALSE;
+ }
+ 
+-- 
+2.43.0
+
