diff --git a/wine/patches/0957-server-ps5-every-file-is-the-player-s.patch b/wine/patches/0957-server-ps5-every-file-is-the-player-s.patch
new file mode 100644
index 0000000..f412418
--- /dev/null
+++ b/wine/patches/0957-server-ps5-every-file-is-the-player-s.patch
@@ -0,0 +1,33 @@
+From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
+From: bornaradusin <bornaradusin@users.noreply.github.com>
+Date: Wed, 4 Nov 2026 10:00:00 +0000
+Subject: [PATCH] server: PS5: Every file is the player's.
+
+The console has one user. A file owned by another id than getuid()'s,
+as a file the game had just made could be, was Anonymous's, so the
+security descriptor gave its user no access: Java's Files.isWritable,
+which checks with AccessCheck, said a new save was read-only, and
+Necesse's zip file system refused to write the world.
+
+diff --git a/server/token.c b/server/token.c
+index 3f0662a..73cfe9a 100644
+--- a/server/token.c
++++ b/server/token.c
+@@ -184,6 +184,14 @@ void security_set_thread_token( struct thread *thread, obj_handle_t handle )
+ 
+ const struct sid *security_unix_uid_to_sid( uid_t uid )
+ {
++#ifdef __PROSPERO__
++    /* The console has one user, the player, and a game's files are theirs whichever id
++     * the kernel gave them: a file the game had just made, owned by another id than
++     * getuid()'s, was Anonymous's, so its user could not write it (Necesse's saves:
++     * Java's Files.isWritable, an AccessCheck, said no). */
++    (void)uid;
++    return &local_user_sid;
++#endif
+     /* very simple mapping: either the current user or not the current user */
+     if (uid == getuid())
+         return &local_user_sid;
+-- 
+2.43.0
+
diff --git a/wine/patches/0966-win32u-keep-the-video-memory-size-within-32-bits.patch b/wine/patches/0966-win32u-keep-the-video-memory-size-within-32-bits.patch
new file mode 100644
index 0000000..b74ec84
--- /dev/null
+++ b/wine/patches/0966-win32u-keep-the-video-memory-size-within-32-bits.patch
@@ -0,0 +1,28 @@
+From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
+From: bornaradusin <bornaradusin@users.noreply.github.com>
+Date: Wed, 4 Nov 2026 10:00:00 +0000
+Subject: [PATCH] win32u: Keep the video memory size within 32 bits.
+
+On the Unix side of a 64-bit build ULONG_MAX is 64 bits wide, so the
+limit never applied and the cast kept only the low 32 bits: a GPU with an
+exact multiple of 4 GiB wrote 0 to HardwareInformation.MemorySize, and WMI
+reported an AdapterRAM of 0, which launchers read as a machine below their
+minimum (Batman: Arkham City's). ULONG is 32 bits, so the limit is that.
+From Leo Lobato's prospero-win (its 0998).
+
+diff --git a/dlls/win32u/sysparams.c b/dlls/win32u/sysparams.c
+index b01cefd..499a1e7 100644
+--- a/dlls/win32u/sysparams.c
++++ b/dlls/win32u/sysparams.c
+@@ -1649,7 +1649,7 @@ static BOOL write_gpu_to_registry( const struct gpu *gpu, const struct pci_id *p
+     set_reg_value( hkey, dac_typeW, REG_SZ, ramdacW, sizeof(ramdacW) );
+ 
+     set_reg_value( hkey, qw_memory_sizeW, REG_QWORD, &memory_size, sizeof(memory_size) );
+-    value = (ULONG)min( memory_size, (ULONGLONG)ULONG_MAX );
++    value = (ULONG)min( memory_size, (ULONGLONG)0xffffffff );
+     set_reg_value( hkey, memory_sizeW, REG_DWORD, &value, sizeof(value) );
+ 
+     set_reg_ascii_value( hkey, "DriverVersion", driver_vendor_to_version( pci->vendor ) );
+-- 
+2.43.0
+
diff --git a/wine/patches/0967-ntdll-answer-processcommandlineinformation.patch b/wine/patches/0967-ntdll-answer-processcommandlineinformation.patch
new file mode 100644
index 0000000..a68bc6e
--- /dev/null
+++ b/wine/patches/0967-ntdll-answer-processcommandlineinformation.patch
@@ -0,0 +1,69 @@
+From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
+From: bornaradusin <bornaradusin@users.noreply.github.com>
+Date: Wed, 4 Nov 2026 10:00:00 +0000
+Subject: [PATCH] ntdll: Answer ProcessCommandLineInformation.
+
+NtQueryInformationProcess(ProcessCommandLineInformation, class 60), which
+Windows answers from 8.1 on, was an unknown class: every caller got
+STATUS_INVALID_INFO_CLASS. A launcher that checks the command line of the
+game it started read nothing. The answer is a UNICODE_STRING whose Buffer
+points just past it, then the text, from the process's parameters: the
+caller's own, or another process's read through its PEB. wow64 converts it
+as it does the image name. After Mihawk OS (its 2427).
+
+diff --git a/dlls/ntdll/unix/process.c b/dlls/ntdll/unix/process.c
+index 5050317..552dc57 100644
+--- a/dlls/ntdll/unix/process.c
++++ b/dlls/ntdll/unix/process.c
+@@ -1583,6 +1583,36 @@ NTSTATUS WINAPI NtQueryInformationProcess( HANDLE handle, PROCESSINFOCLASS class
+         else ret = STATUS_INFO_LENGTH_MISMATCH;
+         break;
+ 
++    case ProcessCommandLineInformation:
++    {
++        /* As Windows answers it from 8.1 on: a UNICODE_STRING whose Buffer points just past it, then the
++         * text, read from the process's parameters (PEB, ProcessParameters, CommandLine). */
++        UNICODE_STRING command, *str = info;
++        SIZE_T done;
++
++        if (handle == GetCurrentProcess())
++            command = peb->ProcessParameters->CommandLine;
++        else
++        {
++            PROCESS_BASIC_INFORMATION pbi;
++            RTL_USER_PROCESS_PARAMETERS *params = NULL;
++
++            if ((ret = NtQueryInformationProcess( handle, ProcessBasicInformation, &pbi, sizeof(pbi), NULL ))) break;
++            if ((ret = NtReadVirtualMemory( handle, &((PEB *)pbi.PebBaseAddress)->ProcessParameters,
++                                            &params, sizeof(params), &done ))) break;
++            if (!params) { ret = STATUS_UNSUCCESSFUL; break; }
++            if ((ret = NtReadVirtualMemory( handle, &params->CommandLine, &command, sizeof(command), &done ))) break;
++        }
++        len = sizeof(UNICODE_STRING) + command.Length;
++        if (size < len) { ret = STATUS_INFO_LENGTH_MISMATCH; break; }
++        str->Length = str->MaximumLength = command.Length;
++        str->Buffer = (WCHAR *)(str + 1);
++        if (!command.Length) break;
++        if (handle == GetCurrentProcess()) memcpy( str->Buffer, command.Buffer, command.Length );
++        else ret = NtReadVirtualMemory( handle, command.Buffer, str->Buffer, command.Length, &done );
++        break;
++    }
++
+     case ProcessWow64Information:
+         len = sizeof(ULONG_PTR);
+         if (size != len) return STATUS_INFO_LENGTH_MISMATCH;
+diff --git a/dlls/wow64/process.c b/dlls/wow64/process.c
+index 1aefd87..21e231f 100644
+--- a/dlls/wow64/process.c
++++ b/dlls/wow64/process.c
+@@ -685,6 +685,7 @@ NTSTATUS WINAPI wow64_NtQueryInformationProcess( UINT *args )
+         }
+         return STATUS_INFO_LENGTH_MISMATCH;
+ 
++    case ProcessCommandLineInformation:
+     case ProcessImageFileName:
+     case ProcessImageFileNameWin32:  /* UNICODE_STRING + string */
+         {
+-- 
+2.43.0
+
diff --git a/wine/patches/0968-ntdll-getmodulehandle-of-an-api-set-finds-its-host-loaded-from-elsewhere.patch b/wine/patches/0968-ntdll-getmodulehandle-of-an-api-set-finds-its-host-loaded-from-elsewhere.patch
new file mode 100644
index 0000000..4b3ffe4
--- /dev/null
+++ b/wine/patches/0968-ntdll-getmodulehandle-of-an-api-set-finds-its-host-loaded-from-elsewhere.patch
@@ -0,0 +1,42 @@
+From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
+From: bornaradusin <bornaradusin@users.noreply.github.com>
+Date: Wed, 4 Nov 2026 10:00:00 +0000
+Subject: [PATCH] ntdll: GetModuleHandle of an API set finds its host loaded from elsewhere.
+
+An API set resolves to its host in system32, and only a module loaded
+from there was found. A game that loads its own ucrtbase.dll from its
+folder and then asks for GetModuleHandle("api-ms-win-crt-heap-l1-1-0.dll")
+got NULL, as Windows never answers: it has the one module of that name.
+Company of Heroes 3 then wrote to address 0 on purpose. When the full
+name isn't loaded, a loaded module with the host's base name answers.
+
+diff --git a/dlls/ntdll/loader.c b/dlls/ntdll/loader.c
+index 1cb22bf..fd03074 100644
+--- a/dlls/ntdll/loader.c
++++ b/dlls/ntdll/loader.c
+@@ -3574,8 +3574,22 @@ NTSTATUS WINAPI LdrGetDllHandleEx( ULONG flags, LPCWSTR load_path, ULONG *dll_ch
+     if (wm) *base = wm->ldr.DllBase;
+     else
+     {
++        const WCHAR *libname = dllname ? dllname : name->Buffer;
++        WCHAR *host;
++
+         if (status == STATUS_SUCCESS) NtClose( mapping );
+         status = STATUS_DLL_NOT_FOUND;
++        /* An API set whose host the program loaded from its own folder (a game's own ucrtbase.dll):
++         * Windows has the one module of that name, and answers with it. */
++        if (!contains_path( libname ) && !find_apiset_dll( libname, &host ))
++        {
++            if ((wm = find_basename_module( wcsrchr( host, '\\' ) + 1 )))
++            {
++                *base = wm->ldr.DllBase;
++                status = STATUS_SUCCESS;
++            }
++            RtlFreeHeap( GetProcessHeap(), 0, host );
++        }
+     }
+     RtlFreeUnicodeString( &nt_name );
+ 
+-- 
+2.43.0
+
diff --git a/wine/patches/0969-ntdll-ps5-a-thread-s-own-cpu-time-and-processor.patch b/wine/patches/0969-ntdll-ps5-a-thread-s-own-cpu-time-and-processor.patch
new file mode 100644
index 0000000..b209acf
--- /dev/null
+++ b/wine/patches/0969-ntdll-ps5-a-thread-s-own-cpu-time-and-processor.patch
@@ -0,0 +1,72 @@
+From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
+From: bornaradusin <bornaradusin@users.noreply.github.com>
+Date: Wed, 4 Nov 2026 10:00:00 +0000
+Subject: [PATCH] ntdll: PS5: A thread's own CPU time and the processor it runs on.
+
+The console has no per-thread times to read, so GetThreadTimes on the
+current thread gave the whole process's: it now reads the thread's CPU
+clock where the platform has one, and falls back as before.
+
+The console's libc has no sched_getcpu, and GetCurrentProcessorNumber's
+fallback gave every thread processor 0, so a program keeping data per
+processor put every thread on one slot. On PS5 it now reads RDTSCP's
+processor id, as Windows does, kept below the count Wine reports. After
+Mihawk OS (its 2457).
+
+diff --git a/dlls/ntdll/unix/thread.c b/dlls/ntdll/unix/thread.c
+index 0477c55..68ad921 100644
+--- a/dlls/ntdll/unix/thread.c
++++ b/dlls/ntdll/unix/thread.c
+@@ -32,6 +32,7 @@
+ #include <stdio.h>
+ #include <stdlib.h>
+ #include <string.h>
++#include <time.h>
+ #include <pthread.h>
+ #include <signal.h>
+ #include <sys/types.h>
+@@ -2292,6 +2293,20 @@ NTSTATUS WINAPI NtQueryInformationThread( HANDLE handle, THREADINFOCLASS class,
+             kusrt.KernelTime.QuadPart = kusrt.UserTime.QuadPart = 0;
+             if (unix_pid != -1 && unix_tid != -1)
+                 ret = get_thread_times( unix_pid, unix_tid, &kusrt.KernelTime, &kusrt.UserTime );
++#ifdef CLOCK_THREAD_CPUTIME_ID
++            if (!ret && handle == GetCurrentThread())
++            {
++                /* the thread's own CPU time, where the platform has no per-thread times to read
++                 * (the PS5): the process's, below, counts every thread's */
++                struct timespec now;
++
++                if (!clock_gettime( CLOCK_THREAD_CPUTIME_ID, &now ))
++                {
++                    kusrt.UserTime.QuadPart = (ULONGLONG)now.tv_sec * 10000000 + now.tv_nsec / 100;
++                    ret = TRUE;
++                }
++            }
++#endif
+             if (!ret && handle == GetCurrentThread())
+             {
+                 /* fall back to process times */
+@@ -2782,6 +2797,20 @@ ULONG WINAPI NtGetCurrentProcessorNumber(void)
+         return cpu_id;
+     }
+ #endif
++#if defined(__PROSPERO__) && defined(__x86_64__)
++    /* (Mihawk OS 2457) The console has no sched_getcpu, and the affinity fallback below gave
++     * every thread processor 0, so a program keeping data per processor (allocators, job systems)
++     * put every thread on one slot. RDTSCP's processor id is the CPU the thread runs on, as
++     * Windows' own GetCurrentProcessorNumber reads it; Wine numbers the console's CPUs as it does
++     * (init_cpu_info), and a number past the count reported would read past a game's table. */
++    if (peb->NumberOfProcessors > 1)
++    {
++        unsigned int aux;
++
++        __asm__ __volatile__( "rdtscp" : "=c"(aux) : : "eax", "edx" );
++        return (aux & 0xfff) % peb->NumberOfProcessors;
++    }
++#endif
+ #if defined(__APPLE__) && (defined(__x86_64__) || defined(__i386__))
+     {
+         struct {
+-- 
+2.43.0
+
