             touch_held = touch_now;
@@ -2164,8 +2167,9 @@ int main(int argc, char **argv)
              * answer its pop-ups too (a dialog box only). */
             if (game_input.mode != PW_GAME_INPUT_KEYBOARD) {
                 PwWineInput dialog[10];
-                size_t keys = pw_wine_dialog_inputs(pad.core.pressed_edges, pad.core.released_edges, dialog,
-                                                    sizeof(dialog) / sizeof(dialog[0]));
+                size_t keys = pw_wine_dialog_inputs_held(pad.core.pressed_edges, pad.core.released_edges,
