diff --git a/tests/test_pw_wine_display.c b/tests/test_pw_wine_display.c
index a460afd..4ea7e5b 100644
--- a/tests/test_pw_wine_display.c
+++ b/tests/test_pw_wine_display.c
@@ -113,6 +113,18 @@ static void test_inputs(void)
     assert(pw_wine_game_inputs(&input, R1 | L1, 0, events, 1) == 1 && events[0].code == 'Z');
     assert(pw_wine_game_inputs(&input, 0, 0, events, 8) == 0);
     assert(pw_wine_game_inputs(NULL, L1, 0, events, 8) == 0 && pw_wine_game_inputs(&input, L1, 0, NULL, 8) == 0);
+
+    /* A tap within one read (pressed and let go, up at the end): down, then up. */
+    assert(pw_wine_game_inputs_held(&input, L1, L1, 0, events, 8) == 2);
+    assert(events[0].code == 'Z' && events[0].down && events[1].code == 'Z' && !events[1].down);
+    /* Let go and pressed again (down at the end): up, then down, as before. */
+    assert(pw_wine_game_inputs_held(&input, L1, L1, L1, events, 8) == 2);
+    assert(events[0].code == 'Z' && !events[0].down && events[1].code == 'Z' && events[1].down);
+    /* A release beside a tap: the plain release first, the tap's last. */
+    assert(pw_wine_game_inputs_held(&input, L1, L1 | CROSS, 0, events, 8) == 3);
+    assert(events[0].code == 0x20 && !events[0].down && events[1].code == 'Z' && events[1].down);
+    assert(events[2].code == 'Z' && !events[2].down);
+    assert(pw_wine_game_inputs_held(NULL, L1, L1, 0, events, 8) == 0);
 }
 
 /* A button bound to the wheel turns it a notch as it is pressed (up away from the player),
@@ -158,6 +170,10 @@ static void test_dialog_inputs(void)
     assert(pw_wine_dialog_inputs(L1 | CIRCLE | SQUARE | R2, 0, events, 10) == 0);
     assert(pw_wine_dialog_inputs(CROSS | UP, 0, events, 1) == 1 && events[0].code == 0x0d);
     assert(pw_wine_dialog_inputs(CROSS, 0, NULL, 10) == 0);
+    /* A tap within one read: Enter down, then up. */
+    assert(pw_wine_dialog_inputs_held(CROSS, CROSS, 0, events, 10) == 2);
+    assert(events[0].code == 0x0d && events[0].down && events[1].code == 0x0d && !events[1].down);
+    assert(pw_wine_dialog_inputs_held(CROSS, CROSS, CROSS, events, 10) == 2 && !events[0].down && events[1].down);
 }
 
