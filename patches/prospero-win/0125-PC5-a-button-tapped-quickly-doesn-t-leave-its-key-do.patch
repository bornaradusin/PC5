From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: bornaradusin <bornaradusin@users.noreply.github.com>
Date: Wed, 4 Nov 2026 12:30:00 +0000
Subject: [PATCH 125/125] PC5: a button tapped quickly doesn't leave its key down

With Keyboard & mouse, a button pressed and let go between two reads of the
controller (a quick tap, or a read that came late while the game kept the
console busy) had both edges in one batch: its key was released first and
then pressed, so the key stayed down until the button was pressed again (keys
that stuck at random in Mega Man W-64). The release now goes after the press
when the button is up at the end of the batch; a button let go and pressed
again within one read still goes up and then down. Cross and the D-pad as a
dialog's keys, with the other controller modes, do the same.
---
 native/pw_wine_display.c     | 24 +++++++++++++++++++-----
 native/pw_wine_display.h     |  7 +++++++
 native/wine64_main.c         | 14 +++++++++-----
 tests/test_pw_wine_display.c | 16 ++++++++++++++++
 4 files changed, 51 insertions(+), 10 deletions(-)

diff --git a/native/pw_wine_display.c b/native/pw_wine_display.c
index 1d2d475..9c96245 100644
--- a/native/pw_wine_display.c
+++ b/native/pw_wine_display.c
@@ -93,11 +93,19 @@ static size_t add_edges(const PwGameInput *input, uint32_t edges, uint32_t down,
 size_t pw_wine_game_inputs(const PwGameInput *input, uint32_t pressed, uint32_t released,
                            PwWineInput *out, size_t max)
 {
+    return pw_wine_game_inputs_held(input, pressed, released, pressed, out, max);
+}
+
+size_t pw_wine_game_inputs_held(const PwGameInput *input, uint32_t pressed, uint32_t released, uint32_t held,
+                                PwWineInput *out, size_t max)
+{
+    uint32_t taps = pressed & released & ~held;
     size_t used;
 
     if (!input || !out) return 0;
-    used = add_edges(input, released, 0, out, 0, max);
-    return add_edges(input, pressed, 1, out, used, max);
+    used = add_edges(input, released & ~taps, 0, out, 0, max);
+    used = add_edges(input, pressed, 1, out, used, max);
+    return add_edges(input, taps, 0, out, used, max);
 }
 
 /* Cross: Enter; the D-pad: the arrows (Windows virtual keys). */
@@ -107,13 +115,19 @@ static const struct { uint32_t button, vk; } dialog_buttons[] = {
 
 size_t pw_wine_dialog_inputs(uint32_t pressed, uint32_t released, PwWineInput *out, size_t max)
 {
+    return pw_wine_dialog_inputs_held(pressed, released, pressed, out, max);
+}
+
+size_t pw_wine_dialog_inputs_held(uint32_t pressed, uint32_t released, uint32_t held, PwWineInput *out, size_t max)
+{
+    uint32_t taps = pressed & released & ~held, edges[3] = { released & ~taps, pressed, taps };
     size_t used = 0;
 
     if (!out) return 0;
-    for (uint32_t down = 0; down <= 1; down++)
+    for (int pass = 0; pass < 3; pass++)
         for (size_t i = 0; i < sizeof(dialog_buttons) / sizeof(dialog_buttons[0]) && used < max; i++)
-            if ((down ? pressed : released) & dialog_buttons[i].button)
-                out[used++] = (PwWineInput){ PW_WINE_INPUT_DIALOG_KEY, dialog_buttons[i].vk, 0, 0, down };
+            if (edges[pass] & dialog_buttons[i].button)
+                out[used++] = (PwWineInput){ PW_WINE_INPUT_DIALOG_KEY, dialog_buttons[i].vk, 0, 0, pass == 1 };
     return used;
 }
 
diff --git a/native/pw_wine_display.h b/native/pw_wine_display.h
index 5edbfe6..90e8611 100644
--- a/native/pw_wine_display.h
+++ b/native/pw_wine_display.h
@@ -52,6 +52,11 @@ int pw_wine_frame_box_take(PwWineFrameBox *box, uint64_t *seen, uint8_t *out,
  * Returns how many were written (at most max). */
 size_t pw_wine_game_inputs(const PwGameInput *input, uint32_t pressed, uint32_t released,
                            PwWineInput *out, size_t max);
+/* The same, with the buttons held at the end of the batch: a button pressed and let go within
+ * one batch (a quick tap, or a read that came late) has both edges, and its release goes after
+ * its press, so its key isn't left down. pw_wine_game_inputs is this with held = pressed. */
+size_t pw_wine_game_inputs_held(const PwGameInput *input, uint32_t pressed, uint32_t released, uint32_t held,
+                                PwWineInput *out, size_t max);
 
 /* xinput and dualsense modes, where the controller is no keyboard: Cross
  * and the D-pad also answer a game's pop-up, as Enter and the arrow keys.
@@ -59,6 +64,8 @@ size_t pw_wine_game_inputs(const PwGameInput *input, uint32_t pressed, uint32_t
  * is in front, so the game never sees them as keys. Releases first, then
  * presses; returns how many were written (at most max). */
 size_t pw_wine_dialog_inputs(uint32_t pressed, uint32_t released, PwWineInput *out, size_t max);
+/* The same, a tap's release after its press (pw_wine_game_inputs_held). */
+size_t pw_wine_dialog_inputs_held(uint32_t pressed, uint32_t released, uint32_t held, PwWineInput *out, size_t max);
 
 /* The DualSense as an XInput gamepad: its held buttons (Cross A, Circle B,
