+From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
+From: bornaradusin <bornaradusin@users.noreply.github.com>
+Date: Sun, 1 Nov 2026 23:45:00 +0000
+Subject: [PATCH] win32u: A PS5 launch window that reads only the keyboard
+ takes dialog keys too.
+
+Marvel's Spider-Man Remastered (and Nixxes' other ports) first shows a
+launch window with Play, Settings and Quit: a 792x447 pop-up of the class
+GameNxApp, which reads the keyboard and not the controller. With the
+controller as the game's XInput controller or DualSense there is no
+keyboard, so the game could not be started without one plugged in.
+Cross and the D-pad go to Wine as dialog keys (patch 0911): such a window
+now takes them as a dialog box does, while it is smaller than the display
+both ways. The game's own window, which may share the class, covers the
+display, so the game never gets those keys beside its controller.
+---
+ dlls/win32u/ps5drv.c | 22 +++++++++++++++++++---
+ 1 file changed, 19 insertions(+), 3 deletions(-)
+
+diff --git a/dlls/win32u/ps5drv.c b/dlls/win32u/ps5drv.c
+index 189f253..1bd1d1a 100644
+--- a/dlls/win32u/ps5drv.c
++++ b/dlls/win32u/ps5drv.c
+@@ -583,11 +583,27 @@ static BOOL is_extended_key( WORD vk )
+ static BOOL is_dialog( HWND hwnd )
+ {
+     static const WCHAR dialogW[] = {'#','3','2','7','7','0'};
++    /* Also a launch window that reads only the keyboard, drawn as a window of
++     * its own: Nixxes' (Marvel's Spider-Man Remastered, Miles Morales,
++     * Ratchet & Clank: Rift Apart), class GameNxApp, a 792x447 pop-up with
++     * Play, Settings and Quit. The game's own window may share the class, so
++     * only one smaller than the display both ways is a launch window: the
++     * game's covers it, and never gets the keys beside the controller. */
++    static const WCHAR nxappW[] = {'G','a','m','e','N','x','A','p','p'};
++    static const struct ratio raw;
+     WCHAR buffer[16];
+     UNICODE_STRING name = {0, sizeof(buffer), buffer};
+-
+-    return hwnd && NtUserGetClassName( hwnd, FALSE, &name ) == ARRAY_SIZE(dialogW) &&
+-           !memcmp( buffer, dialogW, sizeof(dialogW) );
++    RECT rect, display;
++    INT len;
++
++    if (!hwnd) return FALSE;
++    len = NtUserGetClassName( hwnd, FALSE, &name );
++    if (len == ARRAY_SIZE(dialogW) && !memcmp( buffer, dialogW, sizeof(dialogW) )) return TRUE;
++    if (len != ARRAY_SIZE(nxappW) || memcmp( buffer, nxappW, sizeof(nxappW) )) return FALSE;
++    display = get_virtual_screen_rect( raw, MDT_DEFAULT );
++    return get_window_rect( hwnd, &rect, raw ) &&
++           rect.right - rect.left < display.right - display.left &&
++           rect.bottom - rect.top < display.bottom - display.top;
+ }
+ 
+ /* The dialog keys sent down, so that each one's release is sent too, even
