diff --git a/wine/patches/0976-ntdll-ps5-boolean-socket-options-read-back-as-one.patch b/wine/patches/0976-ntdll-ps5-boolean-socket-options-read-back-as-one.patch
new file mode 100644
index 0000000..7f8cccd
--- /dev/null
+++ b/wine/patches/0976-ntdll-ps5-boolean-socket-options-read-back-as-one.patch
@@ -0,0 +1,32 @@
+From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
+From: Mihawk <163614687+mihawk-99@users.noreply.github.com>
+Date: Sun, 25 Oct 2026 11:30:00 -0400
+Subject: [PATCH] ntdll: PS5: boolean socket options read back as 1.
+
+getsockopt of a boolean option gave a Windows program what the console's FreeBSD kernel answered: the option's flag
+bit, SO_BROADCAST as 0x20 and TCP_NODELAY as TF_NODELAY's bit, where Windows and Linux answer 1 (ws2_32's sock test:
+sock.c:1413, 1424, 1435, 1668 and 1712 on the console in both builds, 2026-10-25). A program that compares the value
+with TRUE (a socket library that checks its own setting) took a set option for unset. The boolean SOL_SOCKET options
+and TCP_NODELAY are now 0 or 1, in an int or a one-byte buffer.
+---
+--- a/dlls/ntdll/unix/socket.c
++++ b/dlls/ntdll/unix/socket.c
+@@ -1587,6 +1587,18 @@
+     ret = getsockopt( fd, level, option, out_buffer, &len );
+     if (needs_close) close( fd );
+     if (ret) return sock_errno_to_status( errno );
++#ifdef __PROSPERO__
++    /* The console's FreeBSD kernel reads a boolean option back as its flag bit (SO_BROADCAST as 0x20, TCP_NODELAY as
++     * TF_NODELAY's), where Windows and Linux give 1 (ws2_32 sock.c:1413-1435, 1668, 1712, 2026-10-25). */
++    if (len && ((level == SOL_SOCKET && (option == SO_DEBUG || option == SO_ACCEPTCONN || option == SO_REUSEADDR ||
++                                         option == SO_KEEPALIVE || option == SO_DONTROUTE || option == SO_BROADCAST ||
++                                         option == SO_OOBINLINE)) ||
++                (level == IPPROTO_TCP && option == TCP_NODELAY)))
++    {
++        if (len >= sizeof(int)) *(int *)out_buffer = !!*(int *)out_buffer;
++        else *(char *)out_buffer = !!*(char *)out_buffer;
++    }
++#endif
+     if (io)
+     {
+         io->Status = STATUS_SUCCESS;
diff --git a/wine/patches/0977-win32u-the-cursor-clip-stays-inside-the-virtual-screen.patch b/wine/patches/0977-win32u-the-cursor-clip-stays-inside-the-virtual-screen.patch
new file mode 100644
index 0000000..ed266c8
--- /dev/null
+++ b/wine/patches/0977-win32u-the-cursor-clip-stays-inside-the-virtual-screen.patch
@@ -0,0 +1,31 @@
+From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
+From: Mihawk <163614687+mihawk-99@users.noreply.github.com>
+Date: Wed, 28 Oct 2026 04:00:00 -0400
+Subject: [PATCH] win32u: the cursor clip stays inside the virtual screen.
+
+The PS5 display modes are emulated: a 640x480 mode is drawn letterboxed on the 1920x1080 display, so the raw
+coordinates the server keeps the clip in are the physical screen's. With no clip the server's rect is that whole
+screen, and mapped back into the 640x480 mode it is (-107,0)-(747,480), where Windows reports the screen,
+(0,0)-(640,480). Wine's d3d9 test checks it after a fullscreen mode change (device.c:14950); it showed on the Pro
+once the desktop could be made the foreground (patch 2151), which leaves the cursor unclipped there, and passes on the
+PC, whose mode changes are real. GetClipCursor now keeps the mapped rect inside the virtual screen, as Windows keeps
+every clip.
+---
+--- a/dlls/win32u/input.c
++++ b/dlls/win32u/input.c
+@@ -2791,7 +2791,14 @@
+     while ((status = get_shared_desktop( &lock, &desktop_shm )) == STATUS_PENDING)
+         *rect = wine_server_get_rect( desktop_shm->cursor.clip );
+ 
+-    if (!status && type == MDT_EFFECTIVE_DPI) *rect = map_rect_raw_to_virt( *rect, dpi );
++    if (!status && type == MDT_EFFECTIVE_DPI)
++    {
++        RECT virtual_rect = get_virtual_screen_rect( dpi, MDT_DEFAULT );
++
++        /* in an emulated display mode the unclipped raw rect is the whole physical screen, wider than the mode */
++        *rect = map_rect_raw_to_virt( *rect, dpi );
++        intersect_rect( rect, rect, &virtual_rect );
++    }
+     return !status;
+ }
+ 
