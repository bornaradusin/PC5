+/* The steering wheel: released and centred until set, a packet for each change. */
+static void test_wheel(void)
+{
+    PwWheelState state, read;
+    uint32_t packet;
+
+    assert(!pw_wine_wheel(NULL));
+    assert(!pw_wine_wheel(&read) && read.hat==PW_WHEEL_HAT_NONE && !read.steering && !read.buttons);
+    memset(&state,0,sizeof(state));
+    state.steering=-1200;state.accelerator=40000;state.buttons=1u<<4;state.hat=2;state.gear=3;
+    pw_wine_set_wheel(&state);
+    assert(pw_wine_wheel(&read)==1 && read.connected && read.steering==-1200 && read.accelerator==40000);
+    assert(read.buttons==(1u<<4) && read.hat==2 && read.gear==3 && read.packet);
+    packet=read.packet;
+    pw_wine_set_wheel(&state);
+    assert(pw_wine_wheel(&read)==1 && read.packet==packet);        /* unchanged */
+    state.brake=9;pw_wine_set_wheel(&state);
+    assert(pw_wine_wheel(&read)==1 && read.packet!=packet && read.brake==9);
+    pw_wine_set_wheel(NULL);
+    assert(!pw_wine_wheel(&read) && !read.connected && read.hat==PW_WHEEL_HAT_NONE && !read.accelerator);
+}
+
 int main(void)
 {
     uint32_t frame[4*3];
@@ -422,5 +444,6 @@ int main(void)
     test_display_release();
     test_players();
     test_pad_changes();
+    test_wheel();
     return 0;
 }
