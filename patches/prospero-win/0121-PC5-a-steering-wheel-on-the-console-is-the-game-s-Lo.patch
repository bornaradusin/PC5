+/* The steering wheel's log lines (pw_wheel_ps5.c writes them whole). */
+static void wheel_log(const char *line)
+{
+    PS5LOG_LOG("%s", line);
+}
+
+/* XInput controller 0 with the wheel on it too, for games that only read
+ * a controller: steering the left stick (when turned further than the
+ * stick), the accelerator the right trigger, the brake the left, and the
+ * wheel's buttons as the controller's. */
+static void wheel_on_pad(const PwWheelState *wheel, PwWinePad *pad)
+{
+    static const struct { uint32_t wheel; uint16_t pad; } buttons[] = {
+        { 1u << 0, 0x1000 }, { 1u << 1, 0x4000 }, { 1u << 2, 0x2000 }, { 1u << 3, 0x8000 },   /* A X B Y */
+        { 1u << 4, 0x0200 }, { 1u << 5, 0x0100 },                                         /* RB LB */
+        { 1u << 8, 0x0020 }, { 1u << 9, 0x0010 }, { 1u << 10, 0x0080 }, { 1u << 11, 0x0040 },/* back start RS LS */
+    };
+    static const uint16_t hat[8] = { 0x1, 0x1 | 0x8, 0x8, 0x2 | 0x8, 0x2, 0x2 | 0x4, 0x4, 0x1 | 0x4 };
+    const uint8_t accelerator = (uint8_t)(wheel->accelerator >> 8), brake = (uint8_t)(wheel->brake >> 8);
+    const int steering = wheel->steering < 0 ? -(int)wheel->steering : wheel->steering;
+    const int stick = pad->thumb_lx < 0 ? -(int)pad->thumb_lx : pad->thumb_lx;
+
+    if (!wheel->connected) return;
+    pad->connected = 1;
+    if (steering > stick) pad->thumb_lx = wheel->steering;
+    if (accelerator > pad->right_trigger) pad->right_trigger = accelerator;
+    if (brake > pad->left_trigger) pad->left_trigger = brake;
+    for (unsigned i = 0; i < sizeof(buttons) / sizeof(buttons[0]); i++)
+        if (wheel->buttons & buttons[i].wheel) pad->buttons |= buttons[i].pad;
+    if (wheel->hat < 8) pad->buttons |= hat[wheel->hat];
+}
+
