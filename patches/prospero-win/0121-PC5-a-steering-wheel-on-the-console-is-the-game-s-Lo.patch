+## Steering wheel
+
+A steering wheel on the console (a Logitech G29, as PS4 and PS5 racing
+games take it) is the G29 a PC finds plugged in by USB (`046d:c24f`), in
+any input mode. The title looks for it once the controller is open
+(`native/pw_wheel_ps5.c`): the user's controller when libScePad says its
+device class is a wheel's, else the special port's first controller
+(`scePadOpen` type 2). It logs what the console answers (`PW_WHEEL` lines:
+the controller and device class information, the first parsed reads, and
+every ten seconds the ranges seen), reads it each frame
+(`scePadReadState`, `scePadDeviceClassParseData`), sets `PW_WHEEL=1` and
+publishes it to its sink (`pw_wine_set_wheel`). In xinput mode the wheel
+is also on XInput controller 0: steering the left stick, the accelerator
+the right trigger, the brake the left.
+
+Patch 0957 makes the device in xinput1_3 (`wheel.c`) as 0475 makes the
+DualSense (`\Device\PwWheel`, `Enum\HID\VID_046D&PID_C24F`), and ntdll loads
+xinput1_3 at the start for it. Its input report is
+`wine/ps5/input/pw_wheel.h`'s, staged beside `unixlib.c` by both Wine
+builds: steering on the simulation page, accelerator and brake, the clutch
+a slider, a hat and 24 buttons, numbered as Logitech numbers a G29's on a
+PC (cross 1, square 2, circle 3, triangle 4, the paddles 5 and 6, R2 7,
+L2 8, share 9, options 10, R3 11, L3 12, the shifter's gears 13 to 19);
+the pedals are released at the top of their range, as a G29's are without
+Logitech's software. DirectInput reads it as a driving device. It takes no
+output or feature reports yet: no force feedback.
+
 ## WoW64 CPU backend
 
 The PRX stage also links `wowprospero.prx`, the Unix side of the WoW64 CPU
diff --git a/native/pw_wheel_ps5.c b/native/pw_wheel_ps5.c
new file mode 100644
index 0000000..f72cd07
--- /dev/null
+++ b/native/pw_wheel_ps5.c
@@ -0,0 +1,245 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#include "pw_wheel_ps5.h"
+#include <stdarg.h>
+#include <stdio.h>
+#include <string.h>
+
+#ifndef PW_WHEEL_PS5_HOST_TEST
+extern int scePadOpen(int32_t, int32_t, int32_t, const void *);
+extern int scePadReadState(int32_t, PwPadPs5Data *);
+extern int scePadClose(int32_t);
+extern int scePadGetControllerInformation(int32_t, void *);
+extern int scePadDeviceClassGetExtendedInformation(int32_t, void *);
+extern int scePadDeviceClassParseData(int32_t, const PwPadPs5Data *, void *);
+static int platform_open(int32_t u, int32_t t, int32_t i, const void *p) { return scePadOpen(u, t, i, p); }
+static int platform_read_state(int32_t h, PwPadPs5Data *d) { return scePadReadState(h, d); }
+static int platform_close(int32_t h) { return scePadClose(h); }
+static int platform_info(int32_t h, void *o) { return scePadGetControllerInformation(h, o); }
+static int platform_ext_info(int32_t h, void *o) { return scePadDeviceClassGetExtendedInformation(h, o); }
+static int platform_parse(int32_t h, const PwPadPs5Data *d, void *o) { return scePadDeviceClassParseData(h, d, o); }
+#endif
+
+int pw_wheel_ps5_platform_ops(PwWheelPs5Ops *ops)
+{
+    if (!ops) return PW_ERR_PRECONDITION;
+#ifdef PW_WHEEL_PS5_HOST_TEST
+    memset(ops, 0, sizeof(*ops));
+    return PW_ERR_UNSUPPORTED;
+#else
+    *ops = (PwWheelPs5Ops){ platform_open, platform_read_state, platform_close, platform_info,
+                            platform_ext_info, platform_parse };
+    return PW_OK;
+#endif
+}
+
+static void say(PwWheelPs5 *wheel, const char *format, ...) __attribute__((format(printf, 2, 3)));
+static void say(PwWheelPs5 *wheel, const char *format, ...)
+{
+    char line[512];
+    va_list args;
+
+    if (!wheel->log) return;
+    va_start(args, format);
+    vsnprintf(line, sizeof(line), format, args);
+    va_end(args);
+    wheel->log(line);
+}
+
+/* The first bytes of an answer in hex, for the logs. */
+static const char *hex(const uint8_t *data, size_t size, char *out, size_t out_size)
+{
+    size_t at = 0;
+
+    out[0] = 0;
+    for (size_t i = 0; i < size && at + 3 < out_size; i++) at += (size_t)snprintf(out + at, out_size - at, "%02x", data[i]);
+    return out;
+}
+
+static int32_t read_i32(const uint8_t *at) { int32_t v; memcpy(&v, at, sizeof(v)); return v; }
+static uint16_t read_u16(const uint8_t *at) { uint16_t v; memcpy(&v, at, sizeof(v)); return v; }
+static float read_f32(const uint8_t *at) { float v; memcpy(&v, at, sizeof(v)); return v; }
+
+uint32_t pw_wheel_ps5_buttons(uint32_t pad, uint8_t gear)
+{
+    static const uint32_t order[] = {
+        0x4000u, 0x8000u, 0x2000u, 0x1000u,   /* 1 cross, 2 square, 3 circle, 4 triangle */
+        0x800u, 0x400u, 0x200u, 0x100u,       /* 5 right paddle (R1), 6 left (L1), 7 R2, 8 L2 */
+        0x1u | 0x100000u, 0x8u, 0x4u, 0x2u,   /* 9 share (or the touchpad), 10 options, 11 R3, 12 L3 */
+    };
+    uint32_t buttons = 0;
+
+    for (unsigned i = 0; i < sizeof(order) / sizeof(order[0]); i++)
+        if (pad & order[i]) buttons |= 1u << i;
+    if (gear >= 1 && gear <= 7) buttons |= 1u << (11 + gear);   /* 13 first gear to 19 reverse */
+    return buttons;
+}
+
+uint8_t pw_wheel_ps5_hat(uint32_t pad)
+{
+    const int up = (pad & 0x10u) != 0, right = (pad & 0x20u) != 0, down = (pad & 0x40u) != 0, left = (pad & 0x80u) != 0;
+
+    if (up && right) return 1;
+    if (down && right) return 3;
+    if (down && left) return 5;
+    if (up && left) return 7;
+    if (up) return 0;
+    if (right) return 2;
+    if (down) return 4;
+    if (left) return 6;
+    return PW_WHEEL_HAT_NONE;
+}
+
+static void released(PwWheelPs5 *wheel)
+{
+    memset(&wheel->state, 0, sizeof(wheel->state));
+    wheel->state.hat = PW_WHEEL_HAT_NONE;
+}
+
+/* Whether the controller on handle is a steering wheel, by its information. */
+static int is_wheel(PwWheelPs5 *wheel, int32_t handle, const char *where)
+{
+    char text[2 * 32 + 1];
+
+    memset(wheel->info_raw, 0, sizeof(wheel->info_raw));
+    wheel->info_rc = wheel->ops.info ? wheel->ops.info(handle, wheel->info_raw) : -1;
+    wheel->device_class = wheel->info_rc < 0 ? -1 : read_i32(wheel->info_raw + PW_WHEEL_PS5_INFO_CLASS);
+    say(wheel, "PW_WHEEL %s handle=%d info_rc=%#x class=%d connected=%u info=%s", where, (int)handle,
+        (unsigned)wheel->info_rc, (int)wheel->device_class, wheel->info_raw[PW_WHEEL_PS5_INFO_CONNECTED],
+        hex(wheel->info_raw, 32, text, sizeof(text)));
+    return wheel->info_rc >= 0 && wheel->device_class == PW_WHEEL_PS5_CLASS_STEERING_WHEEL;
+}
+
+int pw_wheel_ps5_find(PwWheelPs5 *wheel, const PwWheelPs5Ops *ops, int32_t user, int32_t standard,
+                      PwWheelPs5Log log)
+{
+    char text[2 * 32 + 1];
+
+    if (!wheel || !ops || !ops->open || !ops->read_state || !ops->close || !ops->info || !ops->parse)
+        return PW_ERR_PRECONDITION;
+    memset(wheel, 0, sizeof(*wheel));
+    wheel->ops = *ops;
+    wheel->log = log;
+    wheel->handle = -1;
+    wheel->port = -1;
+    released(wheel);
+    for (unsigned i = 0; i < 4; i++) wheel->low[i] = 0xffff;
+
+    if (standard >= 0 && is_wheel(wheel, standard, "standard")) {
+        wheel->handle = standard;
+        wheel->port = PW_WHEEL_PS5_PORT_STANDARD;
+    } else if (user >= 0) {
+        wheel->open_rc = ops->open(user, PW_WHEEL_PS5_PORT_SPECIAL, 0, NULL);
+        say(wheel, "PW_WHEEL special user=%d open_rc=%#x", (int)user, (unsigned)wheel->open_rc);
+        if (wheel->open_rc >= 0) {
+            if (is_wheel(wheel, wheel->open_rc, "special")) {
+                wheel->handle = wheel->open_rc;
+                wheel->owned = 1;
+                wheel->port = PW_WHEEL_PS5_PORT_SPECIAL;
+            } else {
+                ops->close(wheel->open_rc);
+            }
+        }
+    }
+    if (wheel->handle < 0) {
+        say(wheel, "PW_WHEEL none");
+        return PW_ERR_NOT_FOUND;
+    }
+    wheel->found = 1;
+    if (ops->ext_info) {
+        wheel->ext_rc = ops->ext_info(wheel->handle, wheel->ext_raw);
+        if (wheel->ext_rc >= 0) wheel->max_angle = read_u16(wheel->ext_raw + PW_WHEEL_PS5_EXT_MAX_ANGLE);
+    }
+    say(wheel, "PW_WHEEL found port=%d handle=%d ext_rc=%#x max_angle=%u ext=%s", (int)wheel->port, (int)wheel->handle,
+        (unsigned)wheel->ext_rc, wheel->max_angle, hex(wheel->ext_raw, 24, text, sizeof(text)));
+    return PW_OK;
+}
+
+static void seen(PwWheelPs5 *wheel, unsigned axis, uint16_t value)
+{
+    if (value < wheel->low[axis]) wheel->low[axis] = value;
+    if (value > wheel->high[axis]) wheel->high[axis] = value;
+}
+
+int pw_wheel_ps5_read(PwWheelPs5 *wheel)
+{
+    PwPadPs5Data data;
+    char text[2 * 32 + 1], unique[2 * 12 + 1];
+
+    if (!wheel || !wheel->found) return PW_ERR_PRECONDITION;
+    memset(&data, 0, sizeof(data));
+    wheel->reads++;
+    wheel->read_rc = wheel->ops.read_state(wheel->handle, &data);
+    if (wheel->read_rc < 0 || !data.connected) {
+        wheel->failures++;
+        released(wheel);
+        return PW_ERR_STATE;
+    }
+    memset(wheel->class_raw, 0, sizeof(wheel->class_raw));
+    wheel->parse_rc = wheel->ops.parse(wheel->handle, &data, wheel->class_raw);
+    if (wheel->logged < 5) {
+        wheel->logged++;
+        say(wheel, "PW_WHEEL data %u parse_rc=%#x buttons=%#x unique=%u:%s class=%s", (unsigned)wheel->logged,
+            (unsigned)wheel->parse_rc, (unsigned)data.buttons, data.device_unique_data_length,
+            hex(data.device_unique_data, sizeof(data.device_unique_data), unique, sizeof(unique)),
+            hex(wheel->class_raw, 32, text, sizeof(text)));
+    }
+    if (wheel->parse_rc < 0 ||
+        read_i32(wheel->class_raw + PW_WHEEL_PS5_DATA_CLASS) != PW_WHEEL_PS5_CLASS_STEERING_WHEEL ||
+        !wheel->class_raw[PW_WHEEL_PS5_DATA_VALID]) {
+        wheel->failures++;
+        released(wheel);
+        return PW_ERR_STATE;
+    }
+    wheel->parsed++;
+    {
+        const uint16_t steering = read_u16(wheel->class_raw + PW_WHEEL_PS5_DATA_STEERING);
+        const uint16_t accelerator = read_u16(wheel->class_raw + PW_WHEEL_PS5_DATA_ACCELERATOR);
+        const uint16_t brake = read_u16(wheel->class_raw + PW_WHEEL_PS5_DATA_BRAKE);
+        const uint16_t clutch = read_u16(wheel->class_raw + PW_WHEEL_PS5_DATA_CLUTCH);
+        const uint8_t gear = wheel->class_raw[PW_WHEEL_PS5_DATA_GEAR];
+
+        seen(wheel, 0, steering);
+        seen(wheel, 1, accelerator);
+        seen(wheel, 2, brake);
+        seen(wheel, 3, clutch);
+        wheel->buttons_seen |= data.buttons;
+        /* centred at 0x8000, as libScePad's 16-bit axes are */
+        wheel->state.connected = 1;
+        wheel->state.steering = (int16_t)((int32_t)steering - 0x8000);
+        wheel->state.accelerator = accelerator;
+        wheel->state.brake = brake;
+        wheel->state.clutch = clutch;
+        wheel->state.gear = gear <= 7 ? gear : 0;
+        wheel->state.buttons = pw_wheel_ps5_buttons(data.buttons & ~0x80000000u, wheel->state.gear);
+        wheel->state.hat = pw_wheel_ps5_hat(data.buttons);
+    }
+    return PW_OK;
+}
+
+void pw_wheel_ps5_report(PwWheelPs5 *wheel)
+{
+    float angle;
+
+    if (!wheel || !wheel->found) return;
+    angle = read_f32(wheel->class_raw + PW_WHEEL_PS5_DATA_ANGLE);
+    say(wheel, "PW_WHEEL reads=%llu parsed=%llu failures=%llu read_rc=%#x parse_rc=%#x angle=%.1f "
+        "steering=%u-%u accelerator=%u-%u brake=%u-%u clutch=%u-%u buttons_seen=%#x gear=%u",
+        (unsigned long long)wheel->reads, (unsigned long long)wheel->parsed, (unsigned long long)wheel->failures,
+        (unsigned)wheel->read_rc, (unsigned)wheel->parse_rc, (double)angle, wheel->low[0], wheel->high[0],
+        wheel->low[1], wheel->high[1], wheel->low[2], wheel->high[2], wheel->low[3], wheel->high[3],
+        (unsigned)wheel->buttons_seen, wheel->state.gear);
+    for (unsigned i = 0; i < 4; i++) {
+        wheel->low[i] = 0xffff;
+        wheel->high[i] = 0;
+    }
+    wheel->buttons_seen = 0;
+}
+
+void pw_wheel_ps5_close(PwWheelPs5 *wheel)
+{
+    if (!wheel) return;
+    if (wheel->owned && wheel->handle >= 0) wheel->ops.close(wheel->handle);
+    wheel->handle = -1;
+    wheel->owned = wheel->found = 0;
+    released(wheel);
+}
diff --git a/native/pw_wheel_ps5.h b/native/pw_wheel_ps5.h
new file mode 100644
index 0000000..ed540e8
--- /dev/null
+++ b/native/pw_wheel_ps5.h
@@ -0,0 +1,96 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#ifndef PW_WHEEL_PS5_H
+#define PW_WHEEL_PS5_H
+/*
+ * A steering wheel on the console (a Logitech G29, as PS4 and PS5 games
+ * read it): libScePad's special controllers. The wheel is found either as the
+ * user's own controller (its device class says so) or on the special port,
+ * and each read's data is parsed as a steering wheel's
+ * (scePadDeviceClassParseData) into a PwWheelState for the game's G29
+ * (wine/ps5/input/pw_wheel.h).
+ *
+ * The layouts below are libScePad's as PS4 software used them; the first
+ * test builds log what the console actually answers (the raw bytes of the
+ * controller and device class information and of the parsed data), so they
+ * can be checked against a wheel.
+ */
+#include "../include/prospero_win.h"
+#include "pw_pad_ps5.h"
+#include "../wine/ps5/input/pw_wheel.h"
+#include <stdint.h>
+
+enum {
+    PW_WHEEL_PS5_PORT_STANDARD = 0, PW_WHEEL_PS5_PORT_SPECIAL = 2,
+    PW_WHEEL_PS5_CLASS_STEERING_WHEEL = 6,
+    PW_WHEEL_PS5_RAW = 64,           /* room for each answer, larger than libScePad's */
+};
+
+typedef struct PwWheelPs5Ops {
+    int (*open)(int32_t user, int32_t type, int32_t index, const void *param);   /* scePadOpen */
+    int (*read_state)(int32_t handle, PwPadPs5Data *data);                       /* scePadReadState */
+    int (*close)(int32_t handle);
+    int (*info)(int32_t handle, void *out);       /* scePadGetControllerInformation */
+    int (*ext_info)(int32_t handle, void *out);   /* scePadDeviceClassGetExtendedInformation, or NULL */
+    int (*parse)(int32_t handle, const PwPadPs5Data *data, void *out);           /* scePadDeviceClassParseData */
+} PwWheelPs5Ops;
+
+typedef void (*PwWheelPs5Log)(const char *line);
+
+typedef struct PwWheelPs5 {
+    PwWheelPs5Ops ops;
+    int32_t handle;                  /* -1: none */
+    int owned;                       /* opened here (the special port): closed here */
+    int found;                       /* a steering wheel */
+    int32_t device_class;            /* the controller's, as the console reported it */
+    int32_t port;                    /* where it was found */
+    int open_rc, info_rc, ext_rc, parse_rc, read_rc;
+    uint16_t max_angle;              /* degrees lock to lock, 0 when not reported */
+    uint8_t info_raw[PW_WHEEL_PS5_RAW], ext_raw[PW_WHEEL_PS5_RAW], class_raw[PW_WHEEL_PS5_RAW];
+    PwWheelState state;
+    uint64_t reads, parsed, failures, logged;
+    /* the ranges seen, for the logs: steering, accelerator, brake, clutch */
+    uint16_t low[4], high[4];
+    uint32_t buttons_seen;
+    PwWheelPs5Log log;
+} PwWheelPs5;
+
+int pw_wheel_ps5_platform_ops(PwWheelPs5Ops *ops);
+/* Looks for a steering wheel: the user's controller (standard, its handle,
+ * or -1) when its device class is a wheel's, else the special port's first
+ * controller. PW_OK when found, PW_ERR_NOT_FOUND when there is none,
+ * PW_ERR_PRECONDITION for missing arguments. What the console answered is
+ * logged either way. */
+int pw_wheel_ps5_find(PwWheelPs5 *wheel, const PwWheelPs5Ops *ops, int32_t user, int32_t standard,
+                      PwWheelPs5Log log);
+/* Reads the wheel once into wheel->state. PW_OK, or PW_ERR_STATE when the
+ * read or the parse failed (the state is then a released wheel). */
+int pw_wheel_ps5_read(PwWheelPs5 *wheel);
+/* Every ten seconds or so: what was seen since, for the logs. */
+void pw_wheel_ps5_report(PwWheelPs5 *wheel);
+void pw_wheel_ps5_close(PwWheelPs5 *wheel);
+
+/* The parts of libScePad's answers this module reads, at their offsets
+ * (for the host tests, which make such answers). */
+enum {
+    PW_WHEEL_PS5_INFO_CLASS = 0x10,       /* ScePadControllerInformation.deviceClass */
+    PW_WHEEL_PS5_INFO_CONNECTED = 0x0c,
+    PW_WHEEL_PS5_EXT_MAX_ANGLE = 0x0a,    /* ScePadDeviceClassExtendedInformation: maxPhysicalWheelAngle */
+    PW_WHEEL_PS5_DATA_CLASS = 0x00,       /* ScePadDeviceClassData.deviceClass */
+    PW_WHEEL_PS5_DATA_VALID = 0x04,
+    PW_WHEEL_PS5_DATA_ANGLE = 0x08,       /* float: degrees */
+    PW_WHEEL_PS5_DATA_STEERING = 0x0c,    /* uint16 */
+    PW_WHEEL_PS5_DATA_ACCELERATOR = 0x0e,
+    PW_WHEEL_PS5_DATA_BRAKE = 0x10,
+    PW_WHEEL_PS5_DATA_CLUTCH = 0x12,
+    PW_WHEEL_PS5_DATA_HANDBRAKE = 0x14,
+    PW_WHEEL_PS5_DATA_GEAR = 0x16,
+};
+
+/* The game's buttons from libScePad's (cross, square, circle, triangle, the
+ * paddles, R2, L2, share, options, R3, L3) and the shifter's gear (13 to
+ * 19), as Logitech numbers a G29's on a PC. */
+uint32_t pw_wheel_ps5_buttons(uint32_t pad_buttons, uint8_t gear);
+/* The D-pad as a hat (PW_WHEEL_HAT_NONE when centred). */
+uint8_t pw_wheel_ps5_hat(uint32_t pad_buttons);
+
+#endif
