++/* A steering wheel on the console (PW_WHEEL=1, which a PS5 title sets
++ * when it finds one): the game finds a Logitech G29 Driving Force as a PC
++ * finds one plugged in by USB, through SetupAPI and HID, DirectInput or raw
++ * input. It is made as dualsense.c makes the DualSense: a device in the
++ * server answered on a thread of the game's process as hidclass.sys answers
++ * a HID collection, input reports 250 times a second, from the title's
++ * wheel. The report and its descriptor are the Unix library's
++ * (pw_wheel.h): steering, accelerator, brake and clutch, a hat and 24
++ * buttons, which DirectInput reads as a driving device. No force feedback
++ * yet: the device takes no output or feature reports. */
++
++#include <stdarg.h>
++#include <stdlib.h>
++#include <string.h>
++
++#include "ntstatus.h"
++#define WIN32_NO_STATUS
++#include "windef.h"
++#include "winbase.h"
++#include "winternl.h"
++#include "winioctl.h"
++#include "winreg.h"
++#include "ddk/wdm.h"
++#include "hidusage.h"
++#include "ddk/hidclass.h"
++#include "ddk/hidpi.h"
++#include "ddk/hidpddi.h"
++#include "ntuser.h"
