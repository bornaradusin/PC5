++#include "wine/hid.h"
++#include "wine/list.h"
++#include "wine/server.h"
++#include "wine/debug.h"
++
++#include "unixlib.h"
++#include "wheel.h"
++
++WINE_DEFAULT_DEBUG_CHANNEL(xinput);
++
++#define WHL_HID_GUID     L"{4d1e55b2-f16f-11cf-88cb-001111000030}"
++#define WHL_HIDCLASS     L"{745a17a0-74d3-11d0-b6fe-00a0c90f57da}"
++#define WHL_HARDWARE     L"VID_046D&PID_C24F"
++#define WHL_SERIAL       L"1&2d595ca7&0&0000"
++#define WHL_INSTANCE     L"HID\\" WHL_HARDWARE L"\\" WHL_SERIAL
++#define WHL_LINK         L"HID#" WHL_HARDWARE L"#" WHL_SERIAL L"#" WHL_HID_GUID
++#define WHL_DEVICE       L"\\Device\\PwWheel"
++#define WHL_ENUM_KEY     L"System\\CurrentControlSet\\Enum\\" WHL_INSTANCE
++#define WHL_CLASS_KEY    L"System\\CurrentControlSet\\Control\\DeviceClasses\\" WHL_HID_GUID L"\\##?#" WHL_LINK
++
++enum
++{
++    WHL_INPUT_SIZE = 13,         /* pw_wheel.h's report 1, with its id */
++    WHL_INPUT_ID = 1,
++    WHL_QUEUE_DEFAULT = 32,      /* hidclass's, and Windows' */
++    WHL_QUEUE_MIN = 2,
++    WHL_QUEUE_MAX = 512,
++    WHL_TICK_US = 4000,          /* 250 reports a second */
++    WHL_RAWINPUT_HANDLE = 0x5c0f1, /* any but 1 and 2 (the mouse's and the keyboard's) and the DualSense's */
++    WHL_VERSION = 0x0100,
++};
++
++struct wh_read
++{
++    struct list entry;
++    HANDLE irp;                 /* until it is answered */
++    UINT64 id;                  /* the server's name for it, which a cancel gives: never reused */
++};
++
++struct wh_file
++{
++    struct list entry;
++    struct list reads;          /* wh_read: waiting for a report */
++    BOOL closed;
++    ULONG length;               /* the input reports kept, as IOCTL_SET_NUM_DEVICE_INPUT_BUFFERS sets */
++    ULONG first, count;
++    BYTE (*reports)[WHL_INPUT_SIZE];
++};
++
++/* What the next get_next_device_request answers the current call with. */
++struct wh_result
++{
++    HANDLE handle;              /* the call's, which the server then closes; 0 when it is pending */
++    client_ptr_t user_ptr;
++    NTSTATUS status;
++    int pending;
++    ULONG_PTR info;
++    BYTE *data;
++    ULONG size;
++};
++
++static struct
++{
++    unixlib_handle_t unix;
++    HANDLE manager, link;
++    HIDP_DEVICE_DESC desc;
++    const HIDP_COLLECTION_DESC *collection;
++    HID_COLLECTION_INFORMATION information;
++    struct list files;
++    BYTE report[WHL_INPUT_SIZE]; /* the newest input report */
++    BYTE *in;
++    ULONG in_capacity;
++    UINT64 next_read;
++    BOOL keys;
++} wh = { .files = LIST_INIT( wh.files ) };
++
++static NTSTATUS wh_call( unsigned int code, void *params )
++{
++    return __wine_unix_call( wh.unix, code, params );
++}
++
++/* The registry, as plug and play leaves it for a HID collection: the
++ * device's instance, and its interface, enabled. */
++static BOOL set_value( HKEY key, const WCHAR *name, DWORD type, const void *data, DWORD size )
++{
++    return !RegSetValueExW( key, name, 0, type, data, size );
++}
++
++static BOOL set_string( HKEY key, const WCHAR *name, const WCHAR *value )
++{
++    return set_value( key, name, REG_SZ, value, (wcslen( value ) + 1) * sizeof(WCHAR) );
++}
++
++static HKEY create_key( HKEY root, const WCHAR *path )
++{
++    HKEY key;
++
++    if (RegCreateKeyExW( root, path, 0, NULL, REG_OPTION_VOLATILE, KEY_ALL_ACCESS, NULL, &key, NULL )) return NULL;
++    return key;
++}
++
++static BOOL create_keys(void)
++{
++    static const WCHAR hardware_ids[] =
++        L"HID\\VID_046D&PID_C24F&REV_0100\0HID\\" WHL_HARDWARE L"\0"
++        L"HID\\VID_046D&UP:0001_U:0004\0HID_DEVICE_SYSTEM_GAME\0HID_DEVICE_UP:0001_U:0004\0HID_DEVICE\0";
++    static const WCHAR compatible_ids[] = L"HID_DEVICE_SYSTEM_GAME\0HID_DEVICE_UP:0001_U:0004\0HID_DEVICE\0";
++    static const WCHAR link[] = L"\\\\?\\" WHL_LINK;
++    const DWORD one = 1;
++    HKEY key, refstr, control;
++    BOOL ok;
++
++    if (!(key = create_key( HKEY_LOCAL_MACHINE, WHL_ENUM_KEY ))) return FALSE;
++    ok = set_string( key, L"ClassGUID", WHL_HIDCLASS ) && set_string( key, L"Class", L"HIDClass" ) &&
++         set_string( key, L"DeviceDesc", L"HID-compliant game controller" ) &&
++         set_string( key, L"Mfg", L"(Standard system devices)" ) &&
++         set_value( key, L"HardwareID", REG_MULTI_SZ, hardware_ids, sizeof(hardware_ids) ) &&
++         set_value( key, L"CompatibleIDs", REG_MULTI_SZ, compatible_ids, sizeof(compatible_ids) );
++    RegCloseKey( key );
++    if (!ok) return FALSE;
++
++    if (!(key = create_key( HKEY_LOCAL_MACHINE, WHL_CLASS_KEY ))) return FALSE;
++    ok = set_string( key, L"DeviceInstance", WHL_INSTANCE );
++    if (ok && (ok = (refstr = create_key( key, L"#" )) != NULL))
++    {
++        ok = set_string( refstr, L"SymbolicLink", link );
++        if (ok && (ok = (control = create_key( refstr, L"Control" )) != NULL))
++        {
++            ok = set_value( control, L"Linked", REG_DWORD, &one, sizeof(one) );
++            RegCloseKey( control );
++        }
++        RegCloseKey( refstr );
++    }
++    RegCloseKey( key );
++    return ok;
++}
++
++static void delete_keys(void)
++{
++    RegDeleteTreeW( HKEY_LOCAL_MACHINE, WHL_CLASS_KEY );
++    RegDeleteTreeW( HKEY_LOCAL_MACHINE, WHL_ENUM_KEY );
++}
++
++/* The device in the server, and the link the interface's path opens. */
++static NTSTATUS create_device(void)
++{
++    static const WCHAR device[] = WHL_DEVICE;
++    UNICODE_STRING name = RTL_CONSTANT_STRING( L"\\??\\" WHL_LINK ), target = RTL_CONSTANT_STRING( WHL_DEVICE );
++    OBJECT_ATTRIBUTES attr;
++    NTSTATUS status;
++
++    SERVER_START_REQ( create_device_manager )
++    {
++        req->access     = SYNCHRONIZE;
++        req->attributes = 0;
++        if (!(status = wine_server_call( req ))) wh.manager = wine_server_ptr_handle( reply->handle );
++    }
++    SERVER_END_REQ;
++    if (status) return status;
++
++    SERVER_START_REQ( create_device )
++    {
++        req->rootdir  = 0;
++        req->manager  = wine_server_obj_handle( wh.manager );
++        req->user_ptr = wine_server_client_ptr( &wh );
++        wine_server_add_data( req, device, sizeof(device) - sizeof(WCHAR) );
++        status = wine_server_call( req );
++    }
++    SERVER_END_REQ;
++    if (status) return status;
++
++    InitializeObjectAttributes( &attr, &name, OBJ_CASE_INSENSITIVE, NULL, NULL );
++    return NtCreateSymbolicLinkObject( &wh.link, SYMBOLIC_LINK_ALL_ACCESS, &attr, &target );
++}
++
++/* Each open file's queue of input reports: the oldest goes first, and a
++ * full queue drops it, as hidclass's does. */
++static BOOL queue_resize( struct wh_file *file, ULONG length )
++{
++    BYTE (*reports)[WHL_INPUT_SIZE];
++
++    if (!(reports = calloc( length, WHL_INPUT_SIZE ))) return FALSE;
++    free( file->reports );
++    file->reports = reports;
++    file->length = length;
++    file->first = file->count = 0;
++    return TRUE;
++}
++
++static void queue_push( struct wh_file *file, const BYTE *report )
++{
++    if (file->count == file->length)
++    {
++        file->first = (file->first + 1) % file->length;
++        file->count--;
++    }
++    memcpy( file->reports[(file->first + file->count++) % file->length], report, WHL_INPUT_SIZE );
++}
++
++static BOOL queue_pop( struct wh_file *file, BYTE *report )
++{
++    if (!file->count) return FALSE;
++    memcpy( report, file->reports[file->first], WHL_INPUT_SIZE );
++    file->first = (file->first + 1) % file->length;
++    file->count--;
++    return TRUE;
++}
++
++static void complete_irp( HANDLE irp, NTSTATUS status, const void *data, ULONG size )
++{
++    SERVER_START_REQ( set_irp_result )
++    {
++        req->handle = wine_server_obj_handle( irp );
++        req->status = status;
++        req->size   = size;
++        if (size) wine_server_add_data( req, data, size );
++        wine_server_call( req );
++    }
++    SERVER_END_REQ;
++}
++
++static void complete_reads( struct wh_file *file, NTSTATUS status )
++{
++    struct wh_read *read, *next;
++
++    LIST_FOR_EACH_ENTRY_SAFE( read, next, &file->reads, struct wh_read, entry )
++    {
++        complete_irp( read->irp, status, NULL, 0 );
++        list_remove( &read->entry );
++        free( read );
++    }
++}
++
++static struct wh_file *find_file( client_ptr_t ptr )
++{
++    struct wh_file *file;
++
++    LIST_FOR_EACH_ENTRY( file, &wh.files, struct wh_file, entry )
++        if (wine_server_client_ptr( file ) == ptr) return file;
++    return NULL;
++}
++
++/* A report the thread makes: it goes to each open file, to the oldest read
++ * waiting there or else into the queue, and to raw input. */
++static void send_report(void)
++{
++    struct xinput_wheel_input params = {0};
++    UINT buffer[(sizeof(struct hid_packet) + WHL_INPUT_SIZE + sizeof(UINT) - 1) / sizeof(UINT)];
++    struct hid_packet *hid = (struct hid_packet *)buffer;
++    INPUT input = {.type = INPUT_HARDWARE};
++    struct wh_file *file;
++
++    if (wh_call( unix_wheel_input, &params )) return;
++    memcpy( wh.report, params.data, WHL_INPUT_SIZE );
++
++    LIST_FOR_EACH_ENTRY( file, &wh.files, struct wh_file, entry )
++    {
++        struct list *head;
++
++        if (file->closed) continue;
++        if ((head = list_head( &file->reads )))
++        {
++            struct wh_read *read = LIST_ENTRY( head, struct wh_read, entry );
++            complete_irp( read->irp, STATUS_SUCCESS, wh.report, WHL_INPUT_SIZE );
++            list_remove( &read->entry );
++            free( read );
++        }
++        else queue_push( file, wh.report );
++    }
++
++    input.hi.uMsg = WM_INPUT;
++    input.hi.wParamH = HIWORD(RIM_INPUT);
++    input.hi.wParamL = LOWORD(RIM_INPUT);
++    hid->head.device = WHL_RAWINPUT_HANDLE;
++    hid->head.usage = MAKELONG(wh.collection->Usage, wh.collection->UsagePage);
++    hid->head.count = 1;
++    hid->head.length = WHL_INPUT_SIZE;
++    memcpy( hid->data, wh.report, WHL_INPUT_SIZE );
++    NtUserSendHardwareInput( 0, 0, &input, (LPARAM)hid );
++}
++
++static NTSTATUS dispatch_create( obj_handle_t handle )
++{
++    struct wh_file *file;
++    NTSTATUS status;
++
++    if (!(file = calloc( 1, sizeof(*file) ))) return STATUS_NO_MEMORY;
++    list_init( &file->reads );
++    if (!queue_resize( file, WHL_QUEUE_DEFAULT ))
++    {
++        free( file );
++        return STATUS_NO_MEMORY;
++    }
++    SERVER_START_REQ( set_kernel_object_ptr )
++    {
++        req->manager  = wine_server_obj_handle( wh.manager );
++        req->handle   = handle;
++        req->user_ptr = wine_server_client_ptr( file );
++        status = wine_server_call( req );
++    }
++    SERVER_END_REQ;
++    if (status)
++    {
++        free( file->reports );
++        free( file );
++        return status;
++    }
++    list_add_tail( &wh.files, &file->entry );
++    TRACE( "file %p opened\n", file );
++    return STATUS_SUCCESS;
++}
++
++static void dispatch_close( struct wh_file *file )
++{
++    if (!file) return;
++    TRACE( "file %p closed\n", file );
++    file->closed = TRUE;
++    complete_reads( file, STATUS_DEVICE_NOT_CONNECTED );
++    free( file->reports );
++    file->reports = NULL;
++    file->count = 0;
++}
++
++static void dispatch_free( client_ptr_t ptr )
++{
++    struct wh_file *file;
++
++    if (!(file = find_file( ptr ))) return;  /* the device's, or unknown */
++    complete_reads( file, STATUS_DEVICE_NOT_CONNECTED );
++    list_remove( &file->entry );
++    free( file->reports );
++    free( file );
++}
++
++static void dispatch_cancel( client_ptr_t ptr )
++{
++    struct wh_file *file;
++    struct wh_read *read;
++
++    LIST_FOR_EACH_ENTRY( file, &wh.files, struct wh_file, entry )
++    {
++        LIST_FOR_EACH_ENTRY( read, &file->reads, struct wh_read, entry )
++        {
++            if (read->id != ptr) continue;
++            complete_irp( read->irp, STATUS_CANCELLED, NULL, 0 );
++            list_remove( &read->entry );
++            free( read );
++            return;
++        }
++    }
++}
++
++static BYTE *result_data( struct wh_result *result, const void *data, ULONG size )
++{
++    if (!(result->data = malloc( size ? size : 1 ))) return NULL;
++    if (data) memcpy( result->data, data, size );
++    else memset( result->data, 0, size );
++    result->size = size;
++    return result->data;
++}
++
++static void dispatch_read( struct wh_file *file, ULONG size, HANDLE irp, struct wh_result *result )
++{
++    struct wh_read *read;
++    BYTE report[WHL_INPUT_SIZE];
++
++    if (!file || file->closed) result->status = STATUS_INVALID_HANDLE;
++    else if (size < wh.collection->InputLength) result->status = STATUS_INVALID_BUFFER_SIZE;
++    else if (queue_pop( file, report ))
++    {
++        if (!result_data( result, report, WHL_INPUT_SIZE )) result->status = STATUS_NO_MEMORY;
++        else result->info = WHL_INPUT_SIZE;
++    }
++    else if (!(read = malloc( sizeof(*read) ))) result->status = STATUS_NO_MEMORY;
++    else
++    {
++        read->irp = irp;
++        read->id = ++wh.next_read;
++        list_add_tail( &file->reads, &read->entry );
++        result->handle = 0;     /* kept until a report answers it */
++        result->user_ptr = read->id;
++        result->status = STATUS_PENDING;
++        result->pending = 1;
++    }
++}
++
++/* No output reports yet (a G29's force feedback is the next step). */
++static NTSTATUS write_report( const BYTE *report, ULONG size, ULONG_PTR *info )
++{
++    if (!size) return STATUS_INVALID_USER_BUFFER;
++    TRACE( "output report %#x of %lu bytes refused\n", report[0], size );
++    return STATUS_INVALID_PARAMETER;
++}
++
++static NTSTATUS get_string( ULONG code, BYTE *out, ULONG out_size, ULONG_PTR *info )
++{
++    const WCHAR *string = code == IOCTL_HID_GET_PRODUCT_STRING ? L"G29 Driving Force Racing Wheel" :
++                          code == IOCTL_HID_GET_MANUFACTURER_STRING ? L"Logitech" : L"";
++
++    *info = (wcslen( string ) + 1) * sizeof(WCHAR);
++    if (*info > out_size) return STATUS_BUFFER_TOO_SMALL;
++    memcpy( out, string, *info );
++    return STATUS_SUCCESS;
++}
++
++static NTSTATUS hid_ioctl( struct wh_file *file, ULONG code, const BYTE *in, ULONG in_size, BYTE *out,
++                           ULONG out_size, ULONG_PTR *info )
++{
++    switch (code)
++    {
++    case IOCTL_HID_GET_POLL_FREQUENCY_MSEC:
++        if (out_size < sizeof(ULONG)) return STATUS_BUFFER_OVERFLOW;
++        *(ULONG *)out = 0;      /* not polled: it sends reports itself */
++        *info = sizeof(ULONG);
++        return STATUS_SUCCESS;
++    case IOCTL_HID_SET_POLL_FREQUENCY_MSEC:
++        if (in_size < sizeof(ULONG)) return STATUS_BUFFER_TOO_SMALL;
++        return STATUS_SUCCESS;
++    case IOCTL_HID_GET_PRODUCT_STRING:
++    case IOCTL_HID_GET_MANUFACTURER_STRING:
++    case IOCTL_HID_GET_SERIALNUMBER_STRING:
++        return get_string( code, out, out_size, info );
++    case IOCTL_HID_GET_COLLECTION_INFORMATION:
++        *info = sizeof(wh.information);
++        if (out_size < sizeof(wh.information)) return STATUS_BUFFER_OVERFLOW;
++        memcpy( out, &wh.information, sizeof(wh.information) );
++        return STATUS_SUCCESS;
++    case IOCTL_HID_GET_COLLECTION_DESCRIPTOR:
++        *info = wh.collection->PreparsedDataLength;
++        if (out_size < wh.collection->PreparsedDataLength) return STATUS_INVALID_BUFFER_SIZE;
++        memcpy( out, wh.collection->PreparsedData, wh.collection->PreparsedDataLength );
++        return STATUS_SUCCESS;
++    case IOCTL_SET_NUM_DEVICE_INPUT_BUFFERS:
++    {
++        ULONG length;
++
++        if (in_size != sizeof(ULONG)) return STATUS_BUFFER_OVERFLOW;
++        length = *(const ULONG *)in;
++        if (length < WHL_QUEUE_MIN || length > WHL_QUEUE_MAX) return STATUS_INVALID_PARAMETER;
++        if (length == file->length) return STATUS_SUCCESS;
++        return queue_resize( file, length ) ? STATUS_SUCCESS : STATUS_NO_MEMORY;
++    }
++    case IOCTL_GET_NUM_DEVICE_INPUT_BUFFERS:
++        if (out_size < sizeof(ULONG)) return STATUS_BUFFER_TOO_SMALL;
++        *(ULONG *)out = file->length;
++        *info = sizeof(ULONG);
++        return STATUS_SUCCESS;
++    case IOCTL_HID_FLUSH_QUEUE:
++        file->first = file->count = 0;
++        return STATUS_SUCCESS;
++    case IOCTL_HID_GET_INPUT_REPORT:
++        if (!out_size) return STATUS_INVALID_USER_BUFFER;
++        if (out[0] != WHL_INPUT_ID || out_size < wh.collection->InputLength) return STATUS_INVALID_PARAMETER;
++        memcpy( out, wh.report, WHL_INPUT_SIZE );
++        *info = WHL_INPUT_SIZE;
++        return STATUS_SUCCESS;
++    case IOCTL_HID_GET_FEATURE:
++    case IOCTL_HID_SET_FEATURE:
++        return STATUS_INVALID_PARAMETER;   /* no feature reports */
++    case IOCTL_HID_SET_OUTPUT_REPORT:
++        return write_report( in, in_size, info );
++    case IOCTL_HID_GET_WINE_RAWINPUT_HANDLE:
++        if (out_size < sizeof(ULONG)) return STATUS_BUFFER_OVERFLOW;
++        *(ULONG *)out = WHL_RAWINPUT_HANDLE;
++        *info = sizeof(ULONG);
++        return STATUS_SUCCESS;
++    default:
++        FIXME( "unsupported ioctl %#lx\n", code );
++        return STATUS_NOT_SUPPORTED;
++    }
++}
++
++/* As ntoskrnl hands an ioctl to a driver, and returns what it wrote: a
++ * buffered ioctl's output is what it reports writing, a direct one's is
++ * the whole buffer, which arrives after the input. */
++static void dispatch_ioctl( struct wh_file *file, ULONG code, ULONG in_size, ULONG out_size,
++                            struct wh_result *result )
++{
++    BOOL direct = (code & 3) != METHOD_BUFFERED;
++    BYTE *out;
++
++    if (!file || file->closed)
++    {
++        result->status = STATUS_INVALID_HANDLE;
++        return;
++    }
++    if (direct && out_size)
++    {
++        if (in_size < out_size)
++        {
++            result->status = STATUS_INVALID_DEVICE_REQUEST;
++            return;
++        }
++        in_size -= out_size;
++    }
++    if (!(out = result_data( result, direct && out_size ? wh.in + in_size : NULL, out_size )))
++    {
++        result->status = STATUS_NO_MEMORY;
++        return;
++    }
++    result->status = hid_ioctl( file, code, wh.in, in_size, out, out_size, &result->info );
++    if (!direct) result->size = NT_ERROR(result->status) ? 0 : min( result->info, out_size );
++}
++
++static void dispatch_volume( ULONG info_class, ULONG out_size, struct wh_result *result )
++{
++    FILE_FS_DEVICE_INFORMATION info = {.DeviceType = FILE_DEVICE_UNKNOWN};
++
++    if (info_class != FileFsDeviceInformation) result->status = STATUS_NOT_SUPPORTED;
++    else if (out_size < sizeof(info)) result->status = STATUS_INFO_LENGTH_MISMATCH;
++    else if (!result_data( result, &info, sizeof(info) )) result->status = STATUS_NO_MEMORY;
++    else result->info = sizeof(info);
++}
++
++static void dispatch( const union irp_params *params, HANDLE irp, ULONG in_size, struct wh_result *result )
++{
++    result->handle = irp;
++    result->status = STATUS_SUCCESS;
++
++    switch (params->type)
++    {
++    case IRP_CALL_CREATE:
++        result->status = dispatch_create( params->create.file );
++        break;
++    case IRP_CALL_CLOSE:
++        dispatch_close( find_file( params->close.file ) );
++        break;
++    case IRP_CALL_READ:
++        dispatch_read( find_file( params->read.file ), params->read.out_size, irp, result );
++        break;
++    case IRP_CALL_WRITE:
++    {
++        struct wh_file *file = find_file( params->write.file );
++        if (!file || file->closed) result->status = STATUS_INVALID_HANDLE;
++        else result->status = write_report( wh.in, in_size, &result->info );
++        break;
++    }
++    case IRP_CALL_FLUSH:
++        break;
++    case IRP_CALL_IOCTL:
++        dispatch_ioctl( find_file( params->ioctl.file ), params->ioctl.code, in_size, params->ioctl.out_size, result );
++        break;
++    case IRP_CALL_VOLUME:
++        dispatch_volume( params->volume.info_class, params->volume.out_size, result );
++        break;
++    case IRP_CALL_FREE:
++        dispatch_free( params->free.obj );
++        break;
++    case IRP_CALL_CANCEL:
++        dispatch_cancel( params->cancel.irp );
++        break;
++    default:
++        result->status = STATUS_NOT_SUPPORTED;
++        break;
++    }
++}
++
++/* Answers the current call and takes the next one, as ntoskrnl's loop does. */
++static NTSTATUS next_request( struct wh_result *result, union irp_params *params, HANDLE *irp, ULONG *in_size )
++{
++    NTSTATUS status;
++
++    SERVER_START_REQ( get_next_device_request )
++    {
++        req->manager     = wine_server_obj_handle( wh.manager );
++        req->prev        = wine_server_obj_handle( result->handle );
++        req->user_ptr    = result->user_ptr;
++        req->status      = result->status;
++        req->pending     = result->pending;
++        req->iosb_status = result->status;
++        req->result      = result->info;
++        if (result->size) wine_server_add_data( req, result->data, result->size );
++        wine_server_set_reply( req, wh.in, wh.in_capacity );
++        if (!(status = wine_server_call( req )))
++        {
++            *irp     = wine_server_ptr_handle( reply->next );
++            *params  = reply->params;
++            *in_size = reply->in_size;
++        }
++        else if (status == STATUS_BUFFER_OVERFLOW) *in_size = reply->in_size;
++    }
++    SERVER_END_REQ;
++
++    free( result->data );
++    memset( result, 0, sizeof(*result) );
++    return status;
++}
++
++/* The device goes: the server deletes it with the manager, and fails what
++ * waits on it, so a game is not left waiting for good. */
++static void stop_device(void)
++{
++    delete_keys();
++    wh.keys = FALSE;
++    if (wh.link) NtClose( wh.link );
++    NtClose( wh.manager );
++    wh.link = wh.manager = 0;
++}
++
++static DWORD WINAPI wheel_thread( void *arg )
++{
++    struct wh_result result = {0};
++    LARGE_INTEGER frequency, now, next;
++    unsigned int failures = 0;
++    LONGLONG tick;
++
++    SetThreadDescription( GetCurrentThread(), L"wine_xinput_wheel" );
++    QueryPerformanceFrequency( &frequency );
++    tick = frequency.QuadPart * WHL_TICK_US / 1000000;
++    if (tick < 1) tick = 1;
++    QueryPerformanceCounter( &next );
++
++    for (;;)
++    {
++        union irp_params params;
++        HANDLE irp = 0;
++        ULONG in_size = 0;
++        NTSTATUS status = next_request( &result, &params, &irp, &in_size );
++
++        if (status == STATUS_BUFFER_OVERFLOW)
++        {
++            BYTE *in = realloc( wh.in, in_size );
++
++            if (in)
++            {
++                wh.in = in;
++                wh.in_capacity = in_size;
++                continue;
++            }
++            status = STATUS_NO_MEMORY;
++        }
++        if (status == STATUS_SUCCESS)
++        {
++            failures = 0;
++            dispatch( &params, irp, in_size, &result );
++        }
++        else if (status != STATUS_PENDING)
++        {
++            /* as ntoskrnl's loop, go on; but not forever */
++            LARGE_INTEGER pause = {.QuadPart = -10 * 10000};
++
++            if (!failures++) ERR( "the server refused the next request: status %#lx\n", status );
++            if (failures == 500)
++            {
++                ERR( "the wheel stops: status %#lx\n", status );
++                stop_device();
++                return 1;
++            }
++            NtDelayExecution( FALSE, &pause );
++        }
++
++        QueryPerformanceCounter( &now );
++        if (now.QuadPart >= next.QuadPart)
++        {
++            send_report();
++            next.QuadPart += tick;
++            if (next.QuadPart <= now.QuadPart) next.QuadPart = now.QuadPart + tick;  /* late: no burst */
++        }
++        if (status == STATUS_PENDING)
++        {
++            LARGE_INTEGER timeout;
++
++            QueryPerformanceCounter( &now );
++            if (next.QuadPart > now.QuadPart)
++            {
++                timeout.QuadPart = -((next.QuadPart - now.QuadPart) * 10000000 / frequency.QuadPart) - 1;
++                NtWaitForSingleObject( wh.manager, FALSE, &timeout );
++            }
++        }
++    }
++}
++
++void wheel_start(void)
++{
++    UNICODE_STRING name = RTL_CONSTANT_STRING( L"xinput1_3" );
++    struct xinput_dualsense_descriptor descriptor = {0};
++    struct xinput_wheel_input input = {0};
++    unixlib_module_t module;
++    WCHAR value[4];
++    NTSTATUS status;
++    HANDLE thread;
++
++    if (GetEnvironmentVariableW( L"PW_WHEEL", value, ARRAY_SIZE(value) ) != 1 || value[0] != '1') return;
++
++    if ((status = __wine_load_unix_lib( &name, &module, &wh.unix )))
++    {
++        ERR( "no Unix library, status %#lx: no wheel\n", status );
++        return;
++    }
++    if ((status = wh_call( unix_wheel_init, NULL )))
++    {
++        ERR( "no title, status %#lx: no wheel\n", status );
++        return;
++    }
++    if (wh_call( unix_wheel_descriptor, &descriptor ) ||
++        (status = HidP_GetCollectionDescription( descriptor.data, descriptor.size, PagedPool, &wh.desc )) !=
++        HIDP_STATUS_SUCCESS || wh.desc.CollectionDescLength != 1)
++    {
++        ERR( "the report descriptor does not parse, status %#lx: no wheel\n", status );
++        return;
++    }
++    wh.collection = wh.desc.CollectionDesc;
++    wh.information.DescriptorSize = wh.collection->PreparsedDataLength;
++    wh.information.Polled = FALSE;
++    wh.information.VendorID = 0x046d;
++    wh.information.ProductID = 0xc24f;
++    wh.information.VersionNumber = WHL_VERSION;
++    if (!wh_call( unix_wheel_input, &input )) memcpy( wh.report, input.data, WHL_INPUT_SIZE );
++    if (!(wh.in = malloc( 4096 ))) return;
++    wh.in_capacity = 4096;
++
++    if ((status = create_device()))
++    {
++        ERR( "cannot make the device, status %#lx: no wheel\n", status );
++        return;
++    }
++    if (!(wh.keys = create_keys()))
++    {
++        ERR( "cannot register the device: no wheel\n" );
++        delete_keys();
++        return;
++    }
++    if (!(thread = CreateThread( NULL, 0, wheel_thread, NULL, 0, NULL )))
++    {
++        ERR( "cannot start the device's thread, error %lu: no wheel\n", GetLastError() );
++        delete_keys();
++        wh.keys = FALSE;
++        return;
++    }
++    CloseHandle( thread );
++    MESSAGE( "xinput: the wheel is a G29 (046d:c24f, %u-byte reports, %u bytes of preparsed data)\n",
++             wh.collection->InputLength, wh.collection->PreparsedDataLength );
++}
++
++void wheel_stop(void)
++{
++    if (wh.keys) delete_keys();
++    wh.keys = FALSE;
++}
