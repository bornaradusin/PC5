diff --git a/wine/ps5/input/pw_wheel.h b/wine/ps5/input/pw_wheel.h
new file mode 100644
index 0000000..d497dcc
--- /dev/null
+++ b/wine/ps5/input/pw_wheel.h
@@ -0,0 +1,104 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#ifndef PW_WHEEL_H
+#define PW_WHEEL_H
+/*
+ * A steering wheel as a PC sees a Logitech G29 plugged in by USB: a HID
+ * driving device, Logitech's 046d:c24f, steering, accelerator, brake and
+ * clutch, a hat and 24 buttons. A game finds the title's wheel this way
+ * (xinput1_3's wheel.c answers as Windows' HID class driver would): the
+ * title gives the wheel's state (PwWheelState), this file makes the input
+ * report. Wine's DirectInput reads it as a driving device with three pedals:
+ * steering the X axis, the accelerator Y, the brake Rz, the clutch a slider.
+ *
+ * Header only, with no Windows or console headers: Wine's xinput Unix
+ * library includes it (staged beside it by both Wine builds), and so do the
+ * host tests and the title.
+ *
+ * The report is this file's own, not the G29's (whose own layout only
+ * Logitech's driver reads); the pedals go as the G29's do on a PC without
+ * Logitech's software, released at the top of their range and pressed at the
+ * bottom, which the games with a G29 preset take.
+ */
+#include <stddef.h>
+#include <stdint.h>
+#include <string.h>
+
+enum {
+    PW_WHEEL_VENDOR = 0x046d, PW_WHEEL_PRODUCT = 0xc24f, PW_WHEEL_VERSION = 0x0100,
+    PW_WHEEL_INPUT_ID = 1,
+    PW_WHEEL_INPUT_SIZE = 13,        /* report 1, with its id */
+    PW_WHEEL_BUTTONS = 24,
+    PW_WHEEL_HAT_NONE = 8,
+};
+
+/* The title's wheel, laid out alike for 32- and 64-bit code (no pointers,
+ * fixed sizes): what the sink keeps (wine/ps5/pw_wine_sink.h). */
+typedef struct PwWheelState {
+    uint32_t connected;              /* 0: no wheel */
+    uint32_t packet;                 /* the sink's: changes whenever the state does */
+    int16_t steering;                /* -32768 full left to 32767 full right */
+    uint16_t accelerator;            /* 0 released to 65535 fully pressed */
+    uint16_t brake;
+    uint16_t clutch;
+    uint32_t buttons;                /* bit n: HID button n + 1 (pw_wheel_buttons) */
+    uint8_t hat;                     /* 0 up, clockwise to 7 up-left; PW_WHEEL_HAT_NONE */
+    uint8_t gear;                    /* the shifter: 0 neutral, 1-6, 7 reverse */
+    uint8_t reserved[2];
+} PwWheelState;
+
+/* Report 1: steering, accelerator and brake on the simulation page, the
+ * clutch a slider, the hat, the buttons. */
+static const uint8_t pw_wheel_descriptor[] = {
+    0x05, 0x01, 0x09, 0x04, 0xa1, 0x01,             /* Generic Desktop, Joystick, Application */
+    0x85, PW_WHEEL_INPUT_ID,
+    0x05, 0x02, 0x09, 0xc8,                         /* Simulation Controls: Steering */
+    0x16, 0x00, 0x80, 0x26, 0xff, 0x7f,             /* -32768 to 32767 */
+    0x75, 0x10, 0x95, 0x01, 0x81, 0x02,
+    0x09, 0xc4, 0x09, 0xc5,                         /* Accelerator, Brake */
+    0x15, 0x00, 0x27, 0xff, 0xff, 0x00, 0x00,       /* 0 to 65535 */
+    0x75, 0x10, 0x95, 0x02, 0x81, 0x02,
+    0x05, 0x01, 0x09, 0x36,                         /* Generic Desktop: Slider (the clutch) */
+    0x75, 0x10, 0x95, 0x01, 0x81, 0x02,
+    0x09, 0x39,                                     /* Hat switch, 0 to 7, null state */
+    0x15, 0x00, 0x25, 0x07, 0x35, 0x00, 0x46, 0x3b, 0x01, 0x65, 0x14,
+    0x75, 0x04, 0x95, 0x01, 0x81, 0x42,
+    0x65, 0x00, 0x45, 0x00,
+    0x75, 0x04, 0x95, 0x01, 0x81, 0x03,             /* padding */
+    0x05, 0x09, 0x19, 0x01, 0x29, PW_WHEEL_BUTTONS, /* Buttons 1 to 24 */
+    0x15, 0x00, 0x25, 0x01, 0x75, 0x01, 0x95, PW_WHEEL_BUTTONS, 0x81, 0x02,
+    0xc0,
+};
+
+/* The pedals as a G29's are on a PC: released at the top of the range. */
+static inline uint16_t pw_wheel_pedal_report(uint16_t pressed)
+{
+    return (uint16_t)(65535u - pressed);
+}
+
+/* Input report 1 from the state; a disconnected wheel is centred, released. */
+static inline void pw_wheel_input(const PwWheelState *state, uint8_t out[PW_WHEEL_INPUT_SIZE])
+{
+    PwWheelState idle;
+    uint16_t accelerator, brake, clutch, steering;
+
+    if (!state || !state->connected) {
+        memset(&idle, 0, sizeof(idle));
+        idle.hat = PW_WHEEL_HAT_NONE;
+        state = &idle;
+    }
+    steering = (uint16_t)state->steering;
+    accelerator = pw_wheel_pedal_report(state->accelerator);
+    brake = pw_wheel_pedal_report(state->brake);
+    clutch = pw_wheel_pedal_report(state->clutch);
+    out[0] = PW_WHEEL_INPUT_ID;
+    out[1] = (uint8_t)steering; out[2] = (uint8_t)(steering >> 8);
+    out[3] = (uint8_t)accelerator; out[4] = (uint8_t)(accelerator >> 8);
+    out[5] = (uint8_t)brake; out[6] = (uint8_t)(brake >> 8);
+    out[7] = (uint8_t)clutch; out[8] = (uint8_t)(clutch >> 8);
+    out[9] = state->hat < PW_WHEEL_HAT_NONE ? state->hat : 0x0f;   /* outside 0-7: no direction */
+    out[10] = (uint8_t)state->buttons;
+    out[11] = (uint8_t)(state->buttons >> 8);
+    out[12] = (uint8_t)(state->buttons >> 16);
+}
