diff --git a/tests/test_pw_wheel_ps5.c b/tests/test_pw_wheel_ps5.c
new file mode 100644
index 0000000..61b084c
--- /dev/null
+++ b/tests/test_pw_wheel_ps5.c
@@ -0,0 +1,131 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#include "../native/pw_wheel_ps5.h"
+#include <assert.h>
+#include <stdio.h>
+#include <string.h>
+
+/* A console with a wheel on the special port (or as the user's controller). */
+static int wheel_class = PW_WHEEL_PS5_CLASS_STEERING_WHEEL, standard_is_wheel, open_rc = 21, parse_rc, read_rc;
+static int open_calls, close_calls, closed_handle = -1, lines;
+static uint16_t steering = 0x8000, accelerator, brake, clutch;
+static uint8_t gear;
+static uint32_t buttons;
+
+static int pad_open(int32_t user, int32_t type, int32_t index, const void *param)
+{
+    assert(user == 42 && type == PW_WHEEL_PS5_PORT_SPECIAL && index == 0 && !param);
+    open_calls++;
+    return open_rc;
+}
+static int read_state(int32_t handle, PwPadPs5Data *data)
+{
+    assert(handle == 21 || handle == 7);
+    if (read_rc < 0) return read_rc;
+    data->buttons = buttons;
+    data->connected = 1;
+    return 0;
+}
+static int pad_close(int32_t handle) { close_calls++; closed_handle = handle; return 0; }
+static int info(int32_t handle, void *out)
+{
+    uint8_t *answer = out;
+    int32_t device_class = handle == 7 ? (standard_is_wheel ? wheel_class : 0) : wheel_class;
+
+    memcpy(answer + PW_WHEEL_PS5_INFO_CLASS, &device_class, sizeof(device_class));
+    answer[PW_WHEEL_PS5_INFO_CONNECTED] = 1;
+    return 0;
+}
+static int ext_info(int32_t handle, void *out)
+{
+    const uint16_t angle = 900;
+
+    (void)handle;
+    memcpy((uint8_t *)out + PW_WHEEL_PS5_EXT_MAX_ANGLE, &angle, sizeof(angle));
+    return 0;
+}
+static int parse(int32_t handle, const PwPadPs5Data *data, void *out)
+{
+    uint8_t *answer = out;
+    int32_t device_class = PW_WHEEL_PS5_CLASS_STEERING_WHEEL;
+
+    (void)handle; (void)data;
+    if (parse_rc < 0) return parse_rc;
+    memcpy(answer + PW_WHEEL_PS5_DATA_CLASS, &device_class, sizeof(device_class));
+    answer[PW_WHEEL_PS5_DATA_VALID] = 1;
+    memcpy(answer + PW_WHEEL_PS5_DATA_STEERING, &steering, 2);
+    memcpy(answer + PW_WHEEL_PS5_DATA_ACCELERATOR, &accelerator, 2);
+    memcpy(answer + PW_WHEEL_PS5_DATA_BRAKE, &brake, 2);
+    memcpy(answer + PW_WHEEL_PS5_DATA_CLUTCH, &clutch, 2);
+    answer[PW_WHEEL_PS5_DATA_GEAR] = gear;
+    return 0;
+}
+static void log_line(const char *line) { assert(!strncmp(line, "PW_WHEEL ", 9)); lines++; }
+static const PwWheelPs5Ops ops = { pad_open, read_state, pad_close, info, ext_info, parse };
+
+int main(void)
+{
+    PwWheelPs5 wheel;
+    PwWheelPs5Ops none;
+    uint8_t report[PW_WHEEL_INPUT_SIZE];
+
+    assert(pw_wheel_ps5_platform_ops(&none) == PW_ERR_UNSUPPORTED);
+    assert(pw_wheel_ps5_find(NULL, &ops, 42, 7, NULL) == PW_ERR_PRECONDITION);
+
+    /* On the special port: opened, read, closed here. */
+    assert(pw_wheel_ps5_find(&wheel, &ops, 42, 7, log_line) == PW_OK);
+    assert(wheel.found && wheel.owned && wheel.handle == 21 && wheel.port == PW_WHEEL_PS5_PORT_SPECIAL);
+    assert(wheel.max_angle == 900 && open_calls == 1 && lines >= 2);
+    assert(pw_wheel_ps5_read(&wheel) == PW_OK);
+    assert(wheel.state.connected && wheel.state.steering == 0 && !wheel.state.accelerator);
+    assert(wheel.state.hat == PW_WHEEL_HAT_NONE && !wheel.state.buttons);
+
+    steering = 0xffff; accelerator = 65535; brake = 1000; clutch = 2; gear = 7;
+    buttons = 0x4000u | 0x400u | 0x10u | 0x20u | 0x8u;   /* cross, L1, up and right, options */
+    assert(pw_wheel_ps5_read(&wheel) == PW_OK);
+    assert(wheel.state.steering == 32767 && wheel.state.accelerator == 65535 && wheel.state.brake == 1000);
+    assert(wheel.state.gear == 7 && wheel.state.hat == 1);
+    assert(wheel.state.buttons == ((1u << 0) | (1u << 5) | (1u << 9) | (1u << 18)));
+    pw_wheel_input(&wheel.state, report);
+    assert(report[0] == PW_WHEEL_INPUT_ID && report[1] == 0xff && report[2] == 0x7f);
+    assert(report[3] == 0 && report[4] == 0);                 /* accelerator fully pressed: the bottom */
+    assert(report[9] == 1 && report[10] == 0x21 && report[11] == 0x02 && report[12] == 0x04);
+
+    steering = 0;
+    assert(pw_wheel_ps5_read(&wheel) == PW_OK && wheel.state.steering == -32768);
+    lines = 0;
+    pw_wheel_ps5_report(&wheel);
+    assert(lines == 1 && wheel.low[0] == 0xffff && !wheel.high[0]);
+
+    /* A failed parse is a released, centred wheel. */
+    parse_rc = -1;
+    assert(pw_wheel_ps5_read(&wheel) == PW_ERR_STATE && !wheel.state.connected);
+    assert(wheel.state.hat == PW_WHEEL_HAT_NONE && wheel.failures == 1);
+    parse_rc = 0;
+    read_rc = -5;
+    assert(pw_wheel_ps5_read(&wheel) == PW_ERR_STATE && wheel.failures == 2);
+    read_rc = 0;
+    pw_wheel_ps5_close(&wheel);
+    assert(close_calls == 1 && closed_handle == 21 && !wheel.found);
+    assert(pw_wheel_ps5_read(&wheel) == PW_ERR_PRECONDITION);
+
+    /* The user's own controller is the wheel: used, never closed here. */
+    standard_is_wheel = 1; open_calls = close_calls = 0;
+    assert(pw_wheel_ps5_find(&wheel, &ops, 42, 7, log_line) == PW_OK);
+    assert(wheel.handle == 7 && !wheel.owned && wheel.port == PW_WHEEL_PS5_PORT_STANDARD && !open_calls);
+    pw_wheel_ps5_close(&wheel);
+    assert(!close_calls);
+
+    /* No wheel: the special port's controller is something else, closed again. */
+    standard_is_wheel = 0; wheel_class = 0;
+    assert(pw_wheel_ps5_find(&wheel, &ops, 42, 7, log_line) == PW_ERR_NOT_FOUND);
+    assert(!wheel.found && close_calls == 1 && closed_handle == 21);
+    open_rc = -0x7fffffff; close_calls = 0;
+    assert(pw_wheel_ps5_find(&wheel, &ops, 42, 7, NULL) == PW_ERR_NOT_FOUND && !close_calls);
+
+    /* The buttons and the hat alone. */
+    assert(pw_wheel_ps5_buttons(0x100000u, 0) == (1u << 8) && pw_wheel_ps5_buttons(0x1u, 0) == (1u << 8));
+    assert(pw_wheel_ps5_buttons(0, 1) == (1u << 12) && pw_wheel_ps5_buttons(0, 8) == 0);
+    assert(pw_wheel_ps5_hat(0x40u | 0x80u) == 5 && pw_wheel_ps5_hat(0x80u) == 6 && pw_wheel_ps5_hat(0) == PW_WHEEL_HAT_NONE);
+    puts("test_pw_wheel_ps5: ok");
+    return 0;
+}
