+static int same_wheel(const PwWheelState *a,const PwWheelState *b)
+{
+    return a->steering==b->steering && a->accelerator==b->accelerator && a->brake==b->brake &&
+           a->clutch==b->clutch && a->buttons==b->buttons && a->hat==b->hat && a->gear==b->gear;
+}
+void pw_wine_set_wheel(const PwWheelState *state)
+{
+    pthread_mutex_lock(&wheel_lock);
+    int changed=(state!=NULL)!=(wheel_state.connected!=0);
+    if(!state)wheel_state.connected=0;
+    else {
+        uint32_t packet=wheel_state.packet;
+        if(!wheel_state.connected || !same_wheel(state,&wheel_state))
+            packet=packet+1?packet+1:1;   /* 0 is never a packet */
+        wheel_state=*state;wheel_state.connected=1;wheel_state.packet=packet;
+    }
+    pthread_mutex_unlock(&wheel_lock);
+    if(changed)pad_changed();
+}
+int pw_wine_wheel(PwWheelState *state)
+{
+    int connected;
+    if(!state)return 0;
+    pthread_mutex_lock(&wheel_lock);
+    connected=wheel_state.connected!=0;
+    if(connected)*state=wheel_state;
+    else {
+        uint32_t packet=wheel_state.packet;
+        memset(state,0,sizeof(*state));
+        state->packet=packet;state->hat=PW_WHEEL_HAT_NONE;
+    }
+    pthread_mutex_unlock(&wheel_lock);
+    return connected;
+}
