+
+/* Programs a game starts, each a process of its own (title/pc5_children.h): its installers,
+ * hidden. In a test version, or with PW_PC5_CHILDREN=1 in the game's launch settings; =0
+ * turns it off. The loader and Wine's files are given as other processes see them: the
+ * sandbox's app0, not /app0. */
+static void pc5_children_start(const PwWineStart *start, const char *root)
+{
+    static char loader[sizeof(sandbox_app0) + 32], app0[sizeof(sandbox_app0) + 128], ntdll[sizeof(app0) + 64],
+        run_dir[160];
+    const char *wanted = getenv("PW_PC5_CHILDREN");
+    int on = wanted ? !strcmp(wanted, "1") : strchr(PC5_VERSION, '-') != NULL;
+    void (*set_spawn)(int (*)(const char *const *, const char *const *, int)) =
+        (void (*)(int (*)(const char *const *, const char *const *, int)))(uintptr_t)pw_prx_lookup(start->descriptor,
+                                                                                                   "__wine_ps5_set_spawn");
+    void (*set_remote)(int (*)(pid_t, long, int)) =
+        (void (*)(int (*)(pid_t, long, int)))(uintptr_t)pw_prx_lookup(start->descriptor, "__wine_ps5_set_remote_kill");
+    Pc5ChildrenConfig config;
+
+    if (!on || !root) {
+        PS5LOG_LOG("PC5 programs: off%s", on ? " (no runtime)" : "");
+        return;
+    }
+    if (!set_spawn || !set_remote) {
+        PS5LOG_LOG("PC5 programs: off (this ntdll can't start programs)");
+        return;
+    }
+    snprintf(app0, sizeof(app0), "%s", strcmp(root, "/app0") ? root : sandbox_app0);
+    snprintf(loader, sizeof(loader), "%s/pc5child.elf", root);
+    snprintf(ntdll, sizeof(ntdll), "%s" PW_WINE64_RUNTIME "/ntdll.prx", app0);
+    snprintf(run_dir, sizeof(run_dir), "%s/run", library_root);
+    memset(&config, 0, sizeof(config));
+    config.loader = loader;
+    config.app0 = app0;
+    config.ntdll = ntdll;
+    config.run_dir = run_dir;
+    config.log = children_log;
+    if (pc5_children_init(&config)) return;
+    set_remote(pc5_children_signal);
+    set_spawn(pc5_children_spawn);
+}
