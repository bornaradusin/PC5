diff --git a/wine/patches/1000-ntdll-ps5-start-a-program-as-a-process-of-its-own-through-the-title.patch b/wine/patches/1000-ntdll-ps5-start-a-program-as-a-process-of-its-own-through-the-title.patch
new file mode 100644
index 0000000..d8a4ca8
--- /dev/null
+++ b/wine/patches/1000-ntdll-ps5-start-a-program-as-a-process-of-its-own-through-the-title.patch
@@ -0,0 +1,212 @@
+From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
+From: prospero-win <prospero-win@invalid>
+Date: Wed, 4 Nov 2026 18:00:00 +0000
+Subject: [PATCH] ntdll: PS5: start a program as a process of its own through
+ the title.
+
+A PS5 title can't create a process, so NtCreateUserProcess failed (patch
+0550). PC5 can start one: it sends its own loader to elfldr, which runs
+it as a process of its own, and hands it the new process's end of its
+connection to the server (PC5's title/pc5_children.h). With
+__wine_ps5_set_spawn set, NtCreateUserProcess goes on as on other systems
+for the programs that need no picture of their own, run hidden: a game's
+installers (a Visual C++, DirectX, .NET or PhysX setup, Windows
+Installer), a built-in web browser's processes (Chromium's, started with
+--type= in their command line: a game's menus drawn as web pages), and in
+a program started that way, whatever it starts. The new process gets this
+process's environment without the launcher hand-off's (patch 0923), with
+winevulkan off, so nothing in it reaches for the GPU the game holds, and
+PW_CHILD=1. Anything else, or a start the title couldn't make, fails as
+before.
+
+The server runs in the title (patch 0110) and signals threads by their
+kernel id (wine/ps5/pw_wine_threads.h); a started program's threads are
+in another process, so the title forwards those signals
+(__wine_ps5_set_remote_kill, handed to the server module), and in the
+started program PC5's loader keeps the threads' table in place of the
+server module's (__wine_ps5_set_thread_registry).
+---
+diff --git a/dlls/ntdll/unix/process.c b/dlls/ntdll/unix/process.c
+index 552dc57..6e24253 100644
+--- a/dlls/ntdll/unix/process.c
++++ b/dlls/ntdll/unix/process.c
+@@ -396,6 +396,85 @@ static BOOL is_unix_console_handle( HANDLE handle )
+ }
+ 
+ 
++#ifdef __PROSPERO__
++/* PC5 starts a program as a process of its own (title/pc5_children.h), hidden: nothing of it
++ * is on the screen. The game's installers (a Visual C++ or DirectX setup), a built-in web
++ * browser's processes, and anything a program started that way starts in turn: Windows
++ * Installer's own processes, say. Set by the title, and by PC5's loader in a started
++ * program; otherwise starts fail as before. */
++static int (*ps5_spawn)( const char *const *argv, const char *const *envp, int server_fd );
++
++DECLSPEC_EXPORT void __wine_ps5_set_spawn( int (*spawn)( const char *const *, const char *const *, int ) )
++{
++    ps5_spawn = spawn;
++}
++
++static BOOL ps5_spawn_allowed( const char *image, const char *command )
++{
++    static const char * const installers[] =
++    {
++        "vcredist", "vc_redist", "redist", "dxsetup", "dxwebsetup", "dotnet", "physx", "oalinst",
++        "msiexec", "xnafx", "prereq", "vstor",
++    };
++    const char *name = strrchr( image, '\\' );
++    char lower[256];
++    size_t i;
++
++    if (!ps5_spawn) return FALSE;
++    if (getenv( "PW_CHILD" )) return TRUE;   /* a program PC5 started: whatever it starts */
++    /* A built-in web browser's own processes (Chromium's, a game's menus: BeamNG.drive's),
++     * started with their part in the command line: --type=renderer, --type=gpu-process. */
++    if (strstr( command, " --type=" )) return TRUE;
++    name = name ? name + 1 : image;
++    if (strrchr( name, '/' )) name = strrchr( name, '/' ) + 1;
++    for (i = 0; name[i] && i < sizeof(lower) - 1; i++) lower[i] = (name[i] >= 'A' && name[i] <= 'Z') ? name[i] + 32 : name[i];
++    lower[i] = 0;
++    if (!strncmp( lower, "ndp", 3 )) return TRUE;   /* .NET's NDP472-KB4054530-x86-x64-AllOS-ENU.exe */
++    for (i = 0; i < ARRAY_SIZE(installers); i++) if (strstr( lower, installers[i] )) return TRUE;
++    return FALSE;
++}
++
++/* Starts the new process through the title, with this process's environment and the new one's
++ * end of its connection to the server. */
++static NTSTATUS ps5_spawn_process( const RTL_USER_PROCESS_PARAMETERS *params, int socketfd, char *winedebug,
++                                   const char *image )
++{
++    extern char **environ;
++    char **argv = build_argv( &params->CommandLine, 1 ), **envp;
++    size_t count = 0, n = 0, i;
++    int pid;
++
++    if (!argv) return STATUS_NO_MEMORY;
++    argv[0] = (char *)"wine";
++    while (environ[count]) count++;
++    if (!(envp = malloc( (count + 4) * sizeof(*envp) )))
++    {
++        free( argv );
++        return STATUS_NO_MEMORY;
++    }
++    for (i = 0; i < count; i++)
++    {
++        const char *e = environ[i];
++        if (!strncmp( e, "WINESERVERSOCKET=", 17 ) || !strncmp( e, "PW_HANDOFF", 10 ) ||
++            !strncmp( e, "WINEDLLOVERRIDES=", 17 ) || !strncmp( e, "PW_CHILD=", 9 ) ||
++            (winedebug && !strncmp( e, "WINEDEBUG=", 10 )))
++            continue;
++        envp[n++] = environ[i];
++    }
++    if (winedebug) envp[n++] = winedebug;
++    /* Hidden, and without Vulkan: nothing in it reaches for the GPU the game holds. */
++    envp[n++] = (char *)"WINEDLLOVERRIDES=winevulkan=d";
++    envp[n++] = (char *)"PW_CHILD=1";
++    envp[n] = NULL;
++    pid = ps5_spawn( (const char *const *)argv, (const char *const *)envp, socketfd );
++    if (pid > 0) fprintf( stderr, "wine-ps5: %s runs hidden as process %d\n", image, pid );
++    else fprintf( stderr, "wine-ps5: %s could not start as a process of its own (%d)\n", image, errno );
++    free( envp );
++    free( argv );
++    return pid > 0 ? STATUS_SUCCESS : STATUS_NOT_SUPPORTED;
++}
++#endif
++
+ /***********************************************************************
+  *           spawn_process
+  */
+@@ -798,6 +877,9 @@ NTSTATUS WINAPI NtCreateUserProcess( HANDLE *process_handle_ptr, HANDLE *thread_
+     SIZE_T i, attr_count = (ps_attr->TotalLength - sizeof(ps_attr->TotalLength)) / sizeof(PS_ATTRIBUTE);
+     const PS_ATTRIBUTE *handles_attr = NULL, *jobs_attr = NULL;
+     data_size_t handles_size, jobs_size;
++#ifdef __PROSPERO__
++    char ps5_image[1024], ps5_command[4096];
++#endif
+     obj_handle_t *handles, *jobs;
+ 
+     if (thread_flags & THREAD_CREATE_FLAGS_HIDE_FROM_DEBUGGER)
+@@ -873,9 +955,14 @@ NTSTATUS WINAPI NtCreateUserProcess( HANDLE *process_handle_ptr, HANDLE *thread_
+      * there is refused as not supported, unless the title starts it in place of this
+      * program (a game's launcher starting the game). */
+     ps5_hand_off( params, &pe_info );
+-    TRACE( "process creation is not supported on PS5\n" );
+-    status = STATUS_NOT_SUPPORTED;
+-    goto done;
++    ps5_utf8( &params->ImagePathName, ps5_image, sizeof(ps5_image) );
++    ps5_utf8( &params->CommandLine, ps5_command, sizeof(ps5_command) );
++    if (!ps5_spawn_allowed( ps5_image, ps5_command ))
++    {
++        TRACE( "process creation is not supported on PS5\n" );
++        status = STATUS_NOT_SUPPORTED;
++        goto done;
++    }
+ #endif
+     if (!machine)
+     {
+@@ -990,7 +1077,12 @@ NTSTATUS WINAPI NtCreateUserProcess( HANDLE *process_handle_ptr, HANDLE *thread_
+ 
+     /* create the child process */
+ 
++#ifdef __PROSPERO__
++    (void)spawn_process;   /* fork and exec: not on the console */
++    if ((status = ps5_spawn_process( params, socketfd[0], winedebug, ps5_image ))) goto done;
++#else
+     if ((status = spawn_process( params, socketfd[0], unixdir, winedebug, &pe_info ))) goto done;
++#endif
+ 
+     close( socketfd[0] );
+     socketfd[0] = -1;
+diff --git a/dlls/ntdll/unix/server.c b/dlls/ntdll/unix/server.c
+index 92ae9c3..cd94e0e 100644
+--- a/dlls/ntdll/unix/server.c
++++ b/dlls/ntdll/unix/server.c
+@@ -1918,6 +1918,9 @@ void unregister_inprocess_thread(void)
+ #ifdef WINE_INPROCESS_SERVER
+ /* the in-process server signals threads through this table on PS5 */
+ static int (*register_server_thread)( long tid, pthread_t thread );
++#ifdef __PROSPERO__
++static int (*ps5_remote_kill)( pid_t pid, long tid, int signal );   /* __wine_ps5_set_remote_kill */
++#endif
+ 
+ #ifdef __PROSPERO__
+ /* wine/ps5/pw_wine_cwd.h */
+@@ -1989,6 +1992,12 @@ static int connect_inprocess_server(void)
+     if (!(connect_server = dlsym( module, "pw_wineserver_connect" )))
+         fatal_error( "%s has no pw_wineserver_connect\n", module_path );
+     register_server_thread = dlsym( module, "pw_wine_thread_register" );
++#ifdef __PROSPERO__
++    {
++        void (*set_remote)( int (*)( pid_t, long, int ) ) = dlsym( module, "pw_wine_set_remote_kill" );
++        if (set_remote && ps5_remote_kill) set_remote( ps5_remote_kill );
++    }
