++/* Protected data: passed through as it is. */
++
++struct protected_data
++{
++    DWORD magic;
++    DWORD flags;
++};
++
++#define PROTECTED_DATA_MAGIC 0x44505850 /* PXPD */
++
++static HANDLE new_protected_data( DWORD flags )
++{
++    struct protected_data *data;
++
++    if (!(data = malloc( sizeof(*data) ))) return NULL;
++    data->magic = PROTECTED_DATA_MAGIC;
++    data->flags = flags;
++    return data;
++}
++
++static struct protected_data *get_protected_data( HANDLE handle )
++{
++    struct protected_data *data = handle;
++
++    if (!data || data->magic != PROTECTED_DATA_MAGIC) return NULL;
++    return data;
++}
++
++HRESULT WINAPI XLiveCreateProtectedDataContext( XLIVE_PROTECTED_DATA_INFORMATION *info, HANDLE *handle )
++{
++    DWORD flags = info && info->cbSize >= sizeof(*info) ? info->dwFlags : 0;
++
++    TRACE( "%p, %p\n", info, handle );
++    if (!handle) return E_POINTER;
++    if (!(*handle = new_protected_data( flags ))) return E_OUTOFMEMORY;
++    return S_OK;
++}
++
++HRESULT WINAPI XLiveQueryProtectedDataInformation( HANDLE handle, XLIVE_PROTECTED_DATA_INFORMATION *info )
++{
++    struct protected_data *data = get_protected_data( handle );
++
++    TRACE( "%p, %p\n", handle, info );
++    if (!data || !info || info->cbSize < sizeof(*info)) return E_INVALIDARG;
++    info->dwFlags = data->flags;
++    return S_OK;
++}
++
++HRESULT WINAPI XLiveCloseProtectedDataContext( HANDLE handle )
++{
++    struct protected_data *data = get_protected_data( handle );
++
++    TRACE( "%p\n", handle );
++    if (!data) return E_INVALIDARG;
++    data->magic = 0;
++    free( data );
++    return S_OK;
++}
++
++static HRESULT pass_through( const BYTE *in, DWORD in_size, BYTE *out, DWORD *out_size )
++{
++    if (!out_size || (in_size && !in)) return E_INVALIDARG;
++    if (!out || *out_size < in_size)
++    {
++        *out_size = in_size;
++        return HRESULT_FROM_WIN32( ERROR_INSUFFICIENT_BUFFER );
++    }
++    if (in_size) memmove( out, in, in_size );
++    *out_size = in_size;
++    return S_OK;
++}
++
++HRESULT WINAPI XLiveProtectData( const BYTE *in, DWORD in_size, BYTE *out, DWORD *out_size, HANDLE handle )
++{
++    TRACE( "%p, %lu, %p, %p, %p\n", in, in_size, out, out_size, handle );
++    return pass_through( in, in_size, out, out_size );
++}
++
++HRESULT WINAPI XLiveUnprotectData( const BYTE *in, DWORD in_size, BYTE *out, DWORD *out_size, HANDLE *handle )
++{
++    HRESULT hr;
++
++    TRACE( "%p, %lu, %p, %p, %p\n", in, in_size, out, out_size, handle );
++    if (FAILED(hr = pass_through( in, in_size, out, out_size ))) return hr;
++    if (handle && !get_protected_data( *handle ) && !(*handle = new_protected_data( 0 ))) return E_OUTOFMEMORY;
++    return S_OK;
++}
