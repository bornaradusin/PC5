++ * Lesser General Public License for more details.
++ *
++ * You should have received a copy of the GNU Lesser General Public
++ * License along with this library; if not, write to the Free Software
++ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
++ */
++
++/*
++ * A game made for Games for Windows - LIVE imports xlive.dll by ordinal and
++ * doesn't start without it. Live itself is gone; this answers as Live does
++ * for a profile signed in locally, without a network account:
++ *
++ * - one user, index 0, signed in locally (eXUserSigninState_SignedInLocally)
++ *   as "Player" with a fixed offline XUID, so a game lets that profile save;
++ * - the runtime's hooks (XLiveInitialize, XLiveInput, XLiveRender, the device
++ *   calls) succeed and do nothing, and input is never taken from the game;
++ * - protected buffers are plain memory and protected data is passed through
++ *   unchanged (saves made by the real runtime, which encrypts them, can't be
++ *   read);
++ * - profile settings a game writes (its options, often in the title specific
++ *   settings) are kept in the registry, under
++ *   HKCU\Software\Wine\xlive\<the program's file name>;
++ * - achievements are accepted and dropped, enumerations of content, friends
++ *   and the like are empty, and what needs Live (statistics, storage,
++ *   marketplace, invitations, arbitration) fails with ERROR_NOT_LOGGED_ON as
++ *   for a local profile;
++ * - asynchronous calls complete at once: the XOVERLAPPED gets the result and
++ *   its event is set, and the call returns ERROR_IO_PENDING as Live does.
++ *
++ * Unknown signatures (XLiveUninstallTitle, XLiveVerifyArcadeLicense,
++ * XUserEstimateRankForRating) are spec stubs: with stdcall a wrong argument
++ * count would unbalance the caller's stack.
++ */
++
++#include <stdarg.h>
++#include <stdio.h>
++#include <stdlib.h>
++#include <wchar.h>
++
++#include "windef.h"
++#include "winbase.h"
++#include "winerror.h"
++#include "winreg.h"
++#include "winuser.h"
++#include "winsock2.h"
++#include "bcrypt.h"
++
++#include "wine/debug.h"
++
++WINE_DEFAULT_DEBUG_CHANNEL(xlive);
++
++/* Report a call to something offline once a function, then quietly. */
++#define FIXME_ONCE(...) do { static BOOL once; if (!once) { once = TRUE; FIXME(__VA_ARGS__); } else TRACE(__VA_ARGS__); } while (0)
++
++typedef ULONGLONG XUID;
++
++typedef struct _XOVERLAPPED XOVERLAPPED;
++typedef void (WINAPI *PXOVERLAPPED_COMPLETION_ROUTINE)(DWORD error, DWORD count, XOVERLAPPED *overlapped);
++
++struct _XOVERLAPPED
++{
++    ULONG_PTR InternalLow;
++    ULONG_PTR InternalHigh;
++    ULONG_PTR InternalContext;
++    HANDLE hEvent;
++    PXOVERLAPPED_COMPLETION_ROUTINE pCompletionRoutine;
++    DWORD_PTR dwCompletionContext;
++    DWORD dwExtendedError;
++};
++
++typedef struct { BYTE ab[8]; } XNKID;
++typedef struct { BYTE ab[16]; } XNKEY;
++
++typedef struct
++{
++    IN_ADDR ina;
++    IN_ADDR inaOnline;
++    WORD wPortOnline;
++    BYTE abEnet[6];
++    BYTE abOnline[20];
++} XNADDR;
++
++typedef struct
++{
++    XNKID sessionID;
++    XNADDR hostAddress;
++    XNKEY keyExchangeKey;
++} XSESSION_INFO;
++
++typedef struct
++{
++    INT iStatus;
++    UINT cina;
++    IN_ADDR aina[8];
++} XNDNS;
++
++typedef struct
++{
++    BYTE bFlags;
++    BYTE bReserved;
++    WORD cProbesXmit;
++    WORD cProbesRecv;
++    WORD cbData;
++    BYTE *pbData;
++    WORD wRttMinInMsecs;
++    WORD wRttMedInMsecs;
++    DWORD dwUpBitsPerSec;
++    DWORD dwDnBitsPerSec;
++} XNQOSINFO;
++
++typedef struct
++{
++    UINT cxnqos;
++    UINT cxnqosPending;
++    XNQOSINFO axnqosinfo[1];
++} XNQOS;
++
++#define XNET_XNQOSINFO_COMPLETE         0x01
++
++#define XNET_GET_XNADDR_ETHERNET        0x0002
++#define XNET_GET_XNADDR_STATIC          0x0004
++
++#define XNET_ETHERNET_LINK_ACTIVE       0x01
++#define XNET_ETHERNET_LINK_100MBPS      0x02
++#define XNET_ETHERNET_LINK_FULL_DUPLEX  0x08
++
++#define XNET_CONNECT_STATUS_CONNECTED   2
++#define XNET_XNADDR_PLATFORM_WINPC      1
++#define XONLINE_NAT_OPEN                1
++
++#define IPPROTO_VDP 254
++
++typedef enum
++{
++    eXUserSigninState_NotSignedIn,
++    eXUserSigninState_SignedInLocally,
++    eXUserSigninState_SignedInToLive,
++} XUSER_SIGNIN_STATE;
++
++#define XUSER_NAME_SIZE 16
++
++typedef struct
++{
++    XUID xuid;
++    DWORD dwInfoFlags;
++    XUSER_SIGNIN_STATE UserSigninState;
++    DWORD dwGuestNumber;
++    DWORD dwSponsorUserIndex;
++    CHAR szUserName[XUSER_NAME_SIZE];
++} XUSER_SIGNIN_INFO;
++
++typedef struct
++{
++    UINT cbSize;
++    HWND hWnd;
++    UINT uMSG;
++    WPARAM wParam;
++    LPARAM lParam;
++    BOOL fHandled;
++    LRESULT lRet;
++} XLIVE_INPUT_INFO;
++
++typedef struct
++{
++    DWORD cbSize;
++    DWORD dwFlags;
++} XLIVE_PROTECTED_DATA_INFORMATION;
++
++typedef struct
++{
++    WORD wNumStrings;
++    HRESULT *pStringResult;
++} STRING_VERIFY_RESPONSE;
++
++typedef struct
++{
++    DWORD dwSearchResults;
++    void *pResults;
++} XSESSION_SEARCHRESULT_HEADER;
++
++typedef struct
++{
++    DWORD dwUserIndexHost;
++    DWORD dwGameType;
++    DWORD dwGameMode;
++    DWORD dwFlags;
++    DWORD dwMaxPublicSlots;
++    DWORD dwMaxPrivateSlots;
++    DWORD dwAvailablePublicSlots;
++    DWORD dwAvailablePrivateSlots;
++    DWORD dwActualMemberCount;
++    DWORD dwReturnedMemberCount;
++    DWORD eState;
++    ULONGLONG qwNonce;
++    XSESSION_INFO sessionInfo;
++    XNKID xnkidArbitration;
++    void *pSessionMembers;
++} XSESSION_LOCAL_DETAILS;
++
++#define XUSER_DATA_TYPE_INT32    1
++#define XUSER_DATA_TYPE_UNICODE  4
++#define XUSER_DATA_TYPE_BINARY   6
++
++typedef struct
++{
++    BYTE type;
++    union
++    {
++        LONG nData;
++        LONGLONG i64Data;
++        double dblData;
++        struct { DWORD cbData; WCHAR *pwszData; } string;
++        float fData;
++        struct { DWORD cbData; BYTE *pbData; } binary;
++        FILETIME ftData;
++    };
++} XUSER_DATA;
++
++typedef enum
++{
++    XSOURCE_NO_VALUE,
++    XSOURCE_DEFAULT,
++    XSOURCE_TITLE,
++    XSOURCE_PERMISSION_DENIED,
++} XUSER_PROFILE_SOURCE;
++
++typedef struct
++{
++    XUSER_PROFILE_SOURCE source;
++    union
++    {
++        DWORD dwUserIndex;
++        XUID xuid;
++    } user;
++    DWORD dwSettingId;
++    XUSER_DATA data;
++} XUSER_PROFILE_SETTING;
++
++typedef struct
++{
++    DWORD dwSettingsLen;
++    XUSER_PROFILE_SETTING *pSettings;
++} XUSER_READ_PROFILE_SETTING_RESULT;
++
++#ifndef _WIN64
++C_ASSERT(sizeof(XOVERLAPPED) == 28);
++C_ASSERT(sizeof(XNADDR) == 36);
++C_ASSERT(sizeof(XUSER_SIGNIN_INFO) == 40);
++C_ASSERT(sizeof(XUSER_DATA) == 16);
++C_ASSERT(sizeof(XUSER_PROFILE_SETTING) == 40);
++#endif
++
++/* A profile setting's id has its type and its largest size in it. */
++#define SETTING_TYPE(id) (((id) >> 28) & 0xf)
++#define SETTING_SIZE(id) (((id) >> 16) & 0xfff)
++
++/* The one user: signed in locally, so a game lets it save, but not to Live. */
++#define OFFLINE_USER  0
++#define OFFLINE_XUID  0xe000000000000001ull
++static const char user_name[] = "Player";
++
++/* Live's local port for system link and its online port. */
++#define SYSTEM_LINK_PORT 3074
++
++static BOOL user_exists( DWORD index )
++{
++    return index == OFFLINE_USER;
++}
++
++/* Complete an asynchronous call at once: its XOVERLAPPED gets the result and,
++ * if it has one, its event is set; without one the result is returned. */
++static DWORD complete( XOVERLAPPED *overlapped, DWORD result, DWORD count )
++{
++    if (!overlapped) return result;
++    overlapped->InternalLow = result;
++    overlapped->InternalHigh = count;
++    overlapped->dwExtendedError = HRESULT_FROM_WIN32( result );
++    if (overlapped->hEvent) SetEvent( overlapped->hEvent );
++    return ERROR_IO_PENDING;
++}
++
++/* Enumerations, sessions and listeners are events: XCloseHandle closes them. */
++static HANDLE new_handle(void)
++{
++    return CreateEventW( NULL, TRUE, FALSE, NULL );
++}
++
++/* An empty enumeration: the buffer a game makes for it holds the items it asked for. */
++static DWORD empty_enumerator( DWORD items, DWORD item_size, DWORD *buffer_size, HANDLE *handle )
++{
++    if (!handle) return ERROR_INVALID_PARAMETER;
++    if (buffer_size) *buffer_size = max( items, 1 ) * item_size;
++    if (!(*handle = new_handle())) return GetLastError();
++    return ERROR_SUCCESS;
++}
++
++static void random_bytes( void *buffer, ULONG size )
++{
++    static ULONG seed;
++    BYTE *p = buffer;
++
++    if (!BCryptGenRandom( NULL, buffer, size, BCRYPT_USE_SYSTEM_PREFERRED_RNG )) return;
++    if (!seed) seed = GetTickCount() | 1;
++    while (size--) *p++ = (seed = seed * 1103515245 + 12345) >> 16;
++}
++
++static void local_xnaddr( XNADDR *addr )
++{
++    memset( addr, 0, sizeof(*addr) );
++    addr->ina.s_addr = htonl( INADDR_LOOPBACK );
++    addr->wPortOnline = htons( SYSTEM_LINK_PORT );
++    addr->abEnet[0] = 0x02;
++    addr->abEnet[5] = 0x01;
++}
++
++/* Sockets. */
++
++SOCKET WINAPI XSocketCreate( int af, int type, int protocol )
++{
++    TRACE( "%d, %d, %d\n", af, type, protocol );
++    /* VDP, Live's UDP with voice, is plain UDP between two of these. */
++    if (protocol == IPPROTO_VDP) protocol = IPPROTO_UDP;
++    return socket( af, type, protocol );
++}
++
++int WINAPI XWSACancelOverlappedIO( SOCKET s )
++{
++    TRACE( "%#Ix\n", (ULONG_PTR)s );
++    if (CancelIo( (HANDLE)s )) return 0;
++    WSASetLastError( WSAENOTSOCK );
++    return SOCKET_ERROR;
++}
++
++/* Secure network. */
++
++INT WINAPI XNetStartup( const void *params )
++{
++    TRACE( "%p\n", params );
++    return 0;
++}
++
++INT WINAPI XNetStartupEx( const void *params, DWORD version )
++{
++    TRACE( "%p, %#lx\n", params, version );
++    return 0;
++}
++
++INT WINAPI XNetCleanup(void)
++{
++    TRACE( "\n" );
++    return 0;
++}
++
++INT WINAPI XNetRandom( BYTE *buffer, UINT size )
++{
++    TRACE( "%p, %u\n", buffer, size );
++    if (buffer) random_bytes( buffer, size );
++    return 0;
++}
++
++INT WINAPI XNetCreateKey( XNKID *id, XNKEY *key )
++{
++    TRACE( "%p, %p\n", id, key );
++    if (id)
++    {
++        random_bytes( id, sizeof(*id) );
++        id->ab[0] &= ~0xf0; /* a system link key */
++    }
++    if (key) random_bytes( key, sizeof(*key) );
++    return 0;
++}
++
++INT WINAPI XNetRegisterKey( const XNKID *id, const XNKEY *key )
++{
++    TRACE( "%p, %p\n", id, key );
++    return 0;
++}
++
++INT WINAPI XNetUnregisterKey( const XNKID *id )
++{
++    TRACE( "%p\n", id );
++    return 0;
++}
++
++INT WINAPI XNetReplaceKey( const XNKID *old_id, const XNKID *new_id )
++{
++    TRACE( "%p, %p\n", old_id, new_id );
++    return 0;
++}
++
++INT WINAPI XNetXnAddrToInAddr( const XNADDR *addr, const XNKID *id, IN_ADDR *ina )
++{
++    TRACE( "%p, %p, %p\n", addr, id, ina );
++    if (!addr || !ina) return WSAEINVAL;
++    *ina = addr->ina;
++    return 0;
++}
++
++INT WINAPI XNetServerToInAddr( IN_ADDR server, DWORD service, IN_ADDR *ina )
++{
++    TRACE( "%#lx, %#lx, %p\n", server.s_addr, service, ina );
++    if (!ina) return WSAEINVAL;
++    *ina = server;
++    return 0;
++}
++
++INT WINAPI XNetTsAddrToInAddr( const void *tsaddr, DWORD service, const XNKID *id, IN_ADDR *ina )
++{
++    FIXME_ONCE( "%p, %#lx, %p, %p: no terminal servers offline\n", tsaddr, service, id, ina );
++    return WSAEINVAL;
++}
++
++INT WINAPI XNetInAddrToXnAddr( IN_ADDR ina, XNADDR *addr, XNKID *id )
++{
++    TRACE( "%#lx, %p, %p\n", ina.s_addr, addr, id );
