++/* Profile settings: kept in the registry, by program. */
++
++static HKEY open_settings( BOOL create )
++{
++    WCHAR path[MAX_PATH + 32], module[MAX_PATH], *name;
++    HKEY key;
++    LSTATUS status;
++
++    if (!GetModuleFileNameW( NULL, module, ARRAY_SIZE(module) )) return NULL;
++    if ((name = wcsrchr( module, '\\' ))) name++;
++    else name = module;
++    swprintf( path, ARRAY_SIZE(path), L"Software\\Wine\\xlive\\%s", name );
++    if (create) status = RegCreateKeyExW( HKEY_CURRENT_USER, path, 0, NULL, 0, KEY_ALL_ACCESS, NULL, &key, NULL );
++    else status = RegOpenKeyExW( HKEY_CURRENT_USER, path, 0, KEY_READ, &key );
++    return status ? NULL : key;
++}
++
++static BOOL setting_has_data( DWORD id )
++{
++    return SETTING_TYPE( id ) == XUSER_DATA_TYPE_UNICODE || SETTING_TYPE( id ) == XUSER_DATA_TYPE_BINARY;
++}
++
++/* The buffer a reading needs: the settings, each followed by room for its data. */
++static DWORD settings_size( DWORD count, const DWORD *ids )
++{
++    DWORD i, size = sizeof(XUSER_READ_PROFILE_SETTING_RESULT);
++
++    for (i = 0; i < count; i++)
++    {
++        size += sizeof(XUSER_PROFILE_SETTING);
++        if (setting_has_data( ids[i] )) size += (SETTING_SIZE( ids[i] ) + 7) & ~7;
++    }
++    return size;
++}
++
++static void read_setting( HKEY key, BOOL own, DWORD id, XUSER_PROFILE_SETTING *setting, BYTE **data )
++{
++    WCHAR name[16];
++    DWORD size = SETTING_SIZE( id ), type;
++    BYTE value[8] = {0};
++
++    setting->dwSettingId = id;
++    setting->source = XSOURCE_NO_VALUE;
++    setting->data.type = SETTING_TYPE( id );
++    swprintf( name, ARRAY_SIZE(name), L"%08x", id );
++
++    if (setting_has_data( id ))
++    {
++        setting->data.binary.pbData = *data;
++        setting->data.binary.cbData = 0;
++        memset( *data, 0, size );
++        if (own && key && !RegQueryValueExW( key, name, NULL, &type, *data, &size ) && type == REG_BINARY)
++        {
++            setting->data.binary.cbData = size;
++            setting->source = XSOURCE_TITLE;
++        }
++        *data += (SETTING_SIZE( id ) + 7) & ~7;
++        return;
++    }
++    size = sizeof(value);
++    if (own && key && !RegQueryValueExW( key, name, NULL, &type, value, &size ) && type == REG_BINARY)
++    {
++        memcpy( &setting->data.i64Data, value, sizeof(value) );
++        setting->source = XSOURCE_TITLE;
++    }
++}
++
++static DWORD read_settings( DWORD count_xuids, const XUID *xuids, DWORD count, const DWORD *ids, DWORD *size,
++                            XUSER_READ_PROFILE_SETTING_RESULT *results, XOVERLAPPED *overlapped )
++{
++    DWORD i, j, needed;
++    XUSER_PROFILE_SETTING *setting;
++    BYTE *data;
++    HKEY key;
++
++    if (!size || (count && !ids)) return ERROR_INVALID_PARAMETER;
++    needed = sizeof(*results);
++    for (i = 0; i < count_xuids; i++) needed += settings_size( count, ids ) - sizeof(*results);
++    if (!results || *size < needed)
++    {
++        *size = needed;
++        return ERROR_INSUFFICIENT_BUFFER;
++    }
++
++    key = open_settings( FALSE );
++    memset( results, 0, needed );
++    setting = (XUSER_PROFILE_SETTING *)(results + 1);
++    data = (BYTE *)(setting + count_xuids * count);
++    results->dwSettingsLen = count_xuids * count;
++    results->pSettings = setting;
++    for (i = 0; i < count_xuids; i++)
++    {
++        BOOL own = !xuids || xuids[i] == OFFLINE_XUID;
++        for (j = 0; j < count; j++, setting++)
++        {
++            if (xuids) setting->user.xuid = xuids[i];
++            else setting->user.dwUserIndex = OFFLINE_USER;
++            read_setting( key, own, ids[j], setting, &data );
++        }
++    }
++    if (key) RegCloseKey( key );
++    return complete( overlapped, ERROR_SUCCESS, 0 );
++}
++
++DWORD WINAPI XUserReadProfileSettings( DWORD title, DWORD user, DWORD count, const DWORD *ids, DWORD *size,
++                                       XUSER_READ_PROFILE_SETTING_RESULT *results, XOVERLAPPED *overlapped )
++{
++    TRACE( "%#lx, %lu, %lu, %p, %p, %p, %p\n", title, user, count, ids, size, results, overlapped );
++    if (!user_exists( user )) return ERROR_NO_SUCH_USER;
++    return read_settings( 1, NULL, count, ids, size, results, overlapped );
++}
++
++DWORD WINAPI XUserReadProfileSettingsByXuid( DWORD title, DWORD user, DWORD count_xuids, const XUID *xuids,
++                                             DWORD count, const DWORD *ids, DWORD *size,
++                                             XUSER_READ_PROFILE_SETTING_RESULT *results, XOVERLAPPED *overlapped )
++{
++    TRACE( "%#lx, %lu, %lu, %p, %lu, %p, %p, %p, %p\n", title, user, count_xuids, xuids, count, ids, size,
++           results, overlapped );
++    if (!xuids && count_xuids) return ERROR_INVALID_PARAMETER;
++    return read_settings( count_xuids, xuids, count, ids, size, results, overlapped );
++}
++
++DWORD WINAPI XUserWriteProfileSettings( DWORD user, DWORD count, const XUSER_PROFILE_SETTING *settings,
++                                        XOVERLAPPED *overlapped )
++{
++    DWORD i;
++    HKEY key;
++
++    TRACE( "%lu, %lu, %p, %p\n", user, count, settings, overlapped );
++    if (!user_exists( user )) return ERROR_NO_SUCH_USER;
++    if (count && !settings) return ERROR_INVALID_PARAMETER;
++    if (!(key = open_settings( TRUE ))) return complete( overlapped, ERROR_ACCESS_DENIED, 0 );
++    for (i = 0; i < count; i++)
++    {
++        const XUSER_PROFILE_SETTING *setting = &settings[i];
++        const void *value = &setting->data.i64Data;
++        DWORD size = sizeof(setting->data.i64Data);
++        WCHAR name[16];
++
++        if (setting->data.type == XUSER_DATA_TYPE_UNICODE || setting->data.type == XUSER_DATA_TYPE_BINARY)
++        {
++            value = setting->data.binary.pbData;
++            size = min( setting->data.binary.cbData, SETTING_SIZE( setting->dwSettingId ) );
++            if (!value) size = 0;
++        }
++        swprintf( name, ARRAY_SIZE(name), L"%08x", setting->dwSettingId );
++        RegSetValueExW( key, name, 0, REG_BINARY, value, size );
++    }
++    RegCloseKey( key );
++    return complete( overlapped, ERROR_SUCCESS, 0 );
++}
