  * not connected. */
 uint32_t pw_wine_stick_buttons(const PwPadPs5 *pad, PwGameStick mouse, uint32_t previous);
+
+/* The touchpad's own buttons (pw_game_profile.h's PW_GAME_TOUCH_*): its
+ * click on the left or right half (touchpad_mode = zones), a quick swipe
+ * up, down, left or right (zones: down for one read, then up), and a click
+ * with two fingers (any mode); and the touchpad as a laptop's, moving the
+ * pointer (mouse). The DualSense's touchpad reports 0..1919 across and
+ * 0..1079 down. */
+enum { PW_WINE_TOUCH_WIDTH = 1920, PW_WINE_TOUCH_HEIGHT = 1080,
+       PW_WINE_SWIPE_X = 400, PW_WINE_SWIPE_Y = 250,   /* how far a swipe goes, at least */
+       PW_WINE_SWIPE_MS = 700,                          /* and how quickly, at most */
+       PW_WINE_TOUCHPAD_BUTTON = 0x100000u };            /* the click, as scePadRead has it */
+typedef struct PwWineTouch {
+    uint32_t click;            /* the touch buttons the click being held went to */
+    uint32_t swipe;            /* a swipe down this read, up at the next */
+    int touching, clicked;     /* a finger is down; it clicked (no swipe then) */
+    uint8_t finger;            /* the first finger's id */
+    uint16_t start_x, start_y, last_x, last_y;
+    uint64_t start_us;
+    int64_t move_x, move_y;    /* mouse: the pointer's travel, 1/65536 pixels */
+} PwWineTouch;
+/* The touch buttons down after this read of pad (its edges as the game gets
+ * them), and whether the plain touchpad button sends nothing this read
+ * (*quiet: zones, or a two-finger click bound to a key of its own). */
+uint32_t pw_wine_touch_buttons(PwWineTouch *touch, const PwPadPs5 *pad, PwGameTouchMode mode, int two_finger_bound,
+                               uint64_t now_us, int *quiet);
+/* The keys for touch buttons pressed and released, as pw_wine_game_inputs does. */
+size_t pw_wine_touch_inputs(const PwGameInput *input, uint32_t pressed, uint32_t released, PwWineInput *out,
+                            size_t max);
+/* touchpad_mode = mouse: the pointer's move for the first finger's travel since the last read; 1 when
+ * *out has one. */
+int pw_wine_touch_pointer(PwWineTouch *touch, const PwPadPs5 *pad, PwWineInput *out);
 #endif
