 native/pw_wine_display.h     |  31 ++++++++++
 native/wine64_main.c         |  34 +++++++++--
 src/pw_game_profile.c        |  30 ++++++++-
 src/pw_game_profile.h        |  24 ++++++++
 tests/test_pw_wine_display.c | 114 +++++++++++++++++++++++++++++++++++
 6 files changed, 331 insertions(+), 6 deletions(-)

diff --git a/native/pw_wine_display.c b/native/pw_wine_display.c
index 6881711..1d2d475 100644
--- a/native/pw_wine_display.c
+++ b/native/pw_wine_display.c
@@ -264,3 +264,107 @@ int pw_wine_pointer_step(PwWinePointer *pointer, uint8_t stick_x, uint8_t stick_
     *out = (PwWineInput){ PW_WINE_INPUT_MOUSE_MOVE, 0, (int32_t)dx, (int32_t)dy, 0 };
     return 1;
 }
+
+/* ---- the touchpad's own buttons (pw_wine_display.h) ---- */
+
+static uint32_t swipe_of(const PwWineTouch *t, uint64_t now_us)
+{
+    int32_t dx = (int32_t)t->last_x - t->start_x, dy = (int32_t)t->last_y - t->start_y;
+    int32_t ax = dx < 0 ? -dx : dx, ay = dy < 0 ? -dy : dy;
+    if (t->clicked || now_us - t->start_us > (uint64_t)PW_WINE_SWIPE_MS * 1000u) return 0;
+    if (ax >= ay && ax >= PW_WINE_SWIPE_X) return dx < 0 ? PW_GAME_SWIPE_LEFT : PW_GAME_SWIPE_RIGHT;
+    if (ay > ax && ay >= PW_WINE_SWIPE_Y) return dy < 0 ? PW_GAME_SWIPE_UP : PW_GAME_SWIPE_DOWN;
+    return 0;
+}
+
+uint32_t pw_wine_touch_buttons(PwWineTouch *t, const PwPadPs5 *pad, PwGameTouchMode mode, int two_finger_bound,
+                               uint64_t now_us, int *quiet)
+{
+    uint32_t pressed, released;
+    int fingers;
+
+    if (quiet) *quiet = mode == PW_GAME_TOUCH_ZONES;
+    if (!t || !pad || !pad->core.connected) return 0;
+    pressed = pad->core.pressed_edges & PW_WINE_TOUCHPAD_BUTTON;
+    released = pad->core.released_edges & PW_WINE_TOUCHPAD_BUTTON;
+    fingers = pad->touch.fingers;
+    t->swipe = 0;
+    /* A finger down: where a swipe starts. */
+    if (fingers >= 1) {
+        const PwPadPs5Touch *f = &pad->touch.touch[0];
+        if (!t->touching) {
+            t->touching = 1;
+            t->clicked = 0;
+            t->finger = f->finger;
+            t->start_x = t->last_x = f->x;
+            t->start_y = t->last_y = f->y;
+            t->start_us = now_us;
+        } else if (f->finger == t->finger) {
+            t->last_x = f->x;
+            t->last_y = f->y;
+        }
+    }
+    /* The click: two fingers, or with zones the half the first finger is on. */
+    if (pressed) {
+        t->clicked = 1;
+        if (fingers >= 2) t->click = PW_GAME_TWO_FINGER;
+        else if (mode == PW_GAME_TOUCH_ZONES)
+            t->click = (fingers ? pad->touch.touch[0].x : t->last_x) < PW_WINE_TOUCH_WIDTH / 2 ? PW_GAME_TOUCH_LEFT
+                                                                                               : PW_GAME_TOUCH_RIGHT;
+        else t->click = 0;
+        if (!two_finger_bound) t->click &= ~PW_GAME_TWO_FINGER;
+    }
+    /* A two-finger click bound to a key of its own: the plain touchpad button sends nothing, at its
+     * press or its release. */
+    if (quiet && (t->click & PW_GAME_TWO_FINGER)) *quiet = 1;
+    if (released || !(pad->core.previous_buttons & PW_WINE_TOUCHPAD_BUTTON)) t->click = 0;
+    uint32_t held = t->click;
+    /* The finger lifted: a quick, long enough slide without a click is a swipe, down for this read. */
+    if (!fingers && t->touching) {
+        t->touching = 0;
+        if (mode == PW_GAME_TOUCH_ZONES) t->swipe = swipe_of(t, now_us);
+    }
+    return held | t->swipe;
+}
+
+size_t pw_wine_touch_inputs(const PwGameInput *input, uint32_t pressed, uint32_t released, PwWineInput *out,
+                            size_t max)
+{
+    size_t used = 0;
+
+    if (!input || !out) return 0;
+    for (uint32_t down = 0; down <= 1; down++) {
+        uint32_t edges = down ? pressed : released;
+        for (size_t i = 0; i < PW_GAME_TOUCH_COUNT && used < max; i++) {
+            const PwGameBinding *b = &input->touch[i];
+            if (!(edges & (1u << i))) continue;
+            if (b->kind == PW_GAME_BIND_WHEEL) {
+                if (down) out[used++] = (PwWineInput){ PW_WINE_INPUT_MOUSE_WHEEL, 0, b->code ? -1 : 1, 0, 0 };
+                continue;
+            }
+            if (b->kind != PW_GAME_BIND_KEY && b->kind != PW_GAME_BIND_MOUSE) continue;
+            out[used++] = (PwWineInput){ b->kind == PW_GAME_BIND_KEY ? PW_WINE_INPUT_KEY : PW_WINE_INPUT_MOUSE_BUTTON,
+                                         b->code, 0, 0, down };
+        }
+    }
+    return used;
+}
+
+int pw_wine_touch_pointer(PwWineTouch *t, const PwPadPs5 *pad, PwWineInput *out)
+{
+    int64_t dx, dy;
+    if (!t || !pad || !out || !pad->core.connected || pad->touch.fingers < 1) return 0;
+    const PwPadPs5Touch *f = &pad->touch.touch[0];
+    /* The first read of a finger only marks where it is: the pointer doesn't jump. */
+    if (!t->touching || f->finger != t->finger) return 0;
+    /* One and a half pixels for each of the touchpad's, so it crosses the desktop in about one swipe. */
+    t->move_x += ((int64_t)f->x - t->last_x) * 98304;
+    t->move_y += ((int64_t)f->y - t->last_y) * 98304;
+    dx = t->move_x / 65536;
+    dy = t->move_y / 65536;
+    if (!dx && !dy) return 0;
+    t->move_x -= dx * 65536;
+    t->move_y -= dy * 65536;
+    *out = (PwWineInput){ PW_WINE_INPUT_MOUSE_MOVE, 0, (int32_t)dx, (int32_t)dy, 0 };
+    return 1;
+}
