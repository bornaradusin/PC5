+/* The touchpad's own buttons: its halves, swipes and a two-finger click, and the pointer. */
+static void touch_read(PwPadPs5 *pad, int fingers, uint16_t x, uint16_t y, uint8_t id, int click, uint32_t *was)
+{
+    uint32_t now = click ? PW_WINE_TOUCHPAD_BUTTON : 0;
+    pad->touch.fingers = (uint8_t)fingers;
+    pad->touch.touch[0] = (PwPadPs5Touch){ x, y, id, { 0 } };
+    pad->touch.touch[1] = (PwPadPs5Touch){ (uint16_t)(x + 300), y, (uint8_t)(id + 1), { 0 } };
+    pad->core.pressed_edges = now & ~*was;
+    pad->core.released_edges = *was & ~now;
+    pad->core.previous_buttons = now;
+    *was = now;
+}
+
+static void test_touch(void)
+{
+    PwPadPs5 pad;
+    PwWineTouch t;
+    PwGameInput input;
+    PwWineInput events[8];
+    uint32_t was = 0, held;
+    int quiet;
+
+    memset(&pad, 0, sizeof(pad));
+    pad.core.connected = 1;
+    /* zones: a click on the left half, then on the right; the plain touchpad button sends nothing. */
+    memset(&t, 0, sizeof(t));
+    touch_read(&pad, 1, 300, 500, 1, 0, &was);
+    assert(pw_wine_touch_buttons(&t, &pad, PW_GAME_TOUCH_ZONES, 0, 0, &quiet) == 0 && quiet);
+    touch_read(&pad, 1, 300, 500, 1, 1, &was);
+    assert(pw_wine_touch_buttons(&t, &pad, PW_GAME_TOUCH_ZONES, 0, 10000, &quiet) == PW_GAME_TOUCH_LEFT);
+    touch_read(&pad, 1, 300, 500, 1, 1, &was);
+    assert(pw_wine_touch_buttons(&t, &pad, PW_GAME_TOUCH_ZONES, 0, 20000, &quiet) == PW_GAME_TOUCH_LEFT);
+    touch_read(&pad, 1, 300, 500, 1, 0, &was);
+    assert(pw_wine_touch_buttons(&t, &pad, PW_GAME_TOUCH_ZONES, 0, 30000, &quiet) == 0);
+    touch_read(&pad, 0, 0, 0, 0, 0, &was);
+    assert(pw_wine_touch_buttons(&t, &pad, PW_GAME_TOUCH_ZONES, 0, 40000, &quiet) == 0);   /* clicked: no swipe */
+    touch_read(&pad, 1, 1500, 500, 2, 1, &was);
+    assert(pw_wine_touch_buttons(&t, &pad, PW_GAME_TOUCH_ZONES, 0, 50000, &quiet) == PW_GAME_TOUCH_RIGHT);
+    touch_read(&pad, 0, 0, 0, 0, 0, &was);
+    assert(pw_wine_touch_buttons(&t, &pad, PW_GAME_TOUCH_ZONES, 0, 60000, &quiet) == 0);
