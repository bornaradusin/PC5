From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: bornaradusin <bornaradusin@users.noreply.github.com>
Date: Sun, 25 Oct 2026 09:04:12 +0000
Subject: [PATCH] PC5: a session's log keeps how it began, and a run of the
 same line is saved once and counted

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01W9bbTPMqftZ2Yv6sJzUsWv
---
 native/pw_diagnostics.c     | 72 ++++++++++++++++++++++++++++---------
 native/pw_diagnostics.h     |  3 +-
 tests/test_pw_diagnostics.c | 35 +++++++++++++++---
 3 files changed, 89 insertions(+), 21 deletions(-)

diff --git a/native/pw_diagnostics.c b/native/pw_diagnostics.c
index c8a202e..731b9a8 100644
--- a/native/pw_diagnostics.c
+++ b/native/pw_diagnostics.c
@@ -34,12 +34,20 @@ static pthread_cond_t wake = PTHREAD_COND_INITIALIZER;    /* records to write, o
 static pthread_cond_t drained = PTHREAD_COND_INITIALIZER; /* the writer finished a pass */
 static volatile sig_atomic_t fd = -1;
 static int disk_error; /* __atomic: the writer stores it with the lock released */
-static char current[512], previous[512], identity[256];
+static char current[512], previous[512], first[512], identity[256];
 static char buffers[2][PW_DIAGNOSTICS_PENDING];
 static char *pending = buffers[0], *draining = buffers[1];
 static size_t used, bytes;
 static uint64_t sequence, last_signal, dropped_records, dropped_bytes, dropped_total;
 static int writing, writer_started, writer_refused;
+/* Chunks the session has filled: the first is kept as session-N.start.log
+ * (how the session began), the others in turn as session-N.previous.log. */
+static unsigned rotations;
+/* The last message logged, and how many times it came again since: a run of
+ * the same line is saved once and then counted (a game's trace in a loop
+ * filled every chunk and pushed out how its session began). */
+static char last_message[PS5LOG_MAX_LINE];
+static unsigned repeats;
 /* Set while the retry thread reconnects: records then skip the network (they
  * are still saved) instead of waiting for the connect timeout. */
 static int reconnecting; /* __atomic: written by the retry thread */
@@ -71,11 +79,12 @@ static size_t format_record(char *out, size_t capacity, const char *message)
     return n > 0 ? (size_t)n : 0;
 }
 
-/* Lock held: records to save or send, and a file to save them in (or none
- * ever will be: a failed disk still lets them reach the network). */
+/* Lock held: records to save or send (a count of repeats is one), and a file
+ * to save them in (or none ever will be: a failed disk still lets them reach
+ * the network). */
 static int ready(void)
 {
-    return used && (fd >= 0 || __atomic_load_n(&disk_error, __ATOMIC_ACQUIRE));
+    return (used || repeats) && (fd >= 0 || __atomic_load_n(&disk_error, __ATOMIC_ACQUIRE));
 }
 
 static void disk_failed(int error)
@@ -85,12 +94,13 @@ static void disk_failed(int error)
     fd = -1;
 }
 
-/* Writer thread only. The current chunk becomes the previous one and a new
- * one starts with the identity line; records stay in order across them. */
+/* Writer thread only. The current chunk becomes the first one (the first
+ * time) or the previous one, and a new one starts with the identity line;
+ * records stay in order across them. */
 static int rotate(void)
 {
     close(fd); fd = -1;
-    if (rename(current, previous) != 0) { disk_failed(errno); return -1; }
+    if (rename(current, rotations++ ? previous : first) != 0) { disk_failed(errno); return -1; }
     fd = open(current, O_WRONLY | O_CREAT | O_TRUNC, 0600);
     bytes = strlen(identity);
     if (fd < 0 || put_all(fd, identity, bytes) != 0) { disk_failed(errno); return -1; }
@@ -139,10 +149,36 @@ static void send_records(const char *data, size_t length)
     pthread_mutex_unlock(&net_lock);
 }
 
+/* Lock held: the record for a message, or a drop when the buffer is full.
+ * Dropping keeps the caller, a game thread, out of the wait. */
+static void add_record(const char *message)
+{
+    size_t size = format_record(pending + used, PW_DIAGNOSTICS_PENDING - used, message);
+    if (used + size < PW_DIAGNOSTICS_PENDING) {
+        size_t before = used;
+        used += size;
+        if (before < PW_DIAGNOSTICS_PENDING / 2 && used >= PW_DIAGNOSTICS_PENDING / 2) pthread_cond_signal(&wake);
+    } else {
+        /* Full: the writer is behind the records (a slow disk or network). */
+        dropped_records++; dropped_total++; dropped_bytes += size;
+    }
+}
+
+/* Lock held: how many times the last message came again, if it did. */
+static void add_repeats(void)
+{
+    char text[96];
+    if (!repeats) return;
+    snprintf(text, sizeof(text), "PW_WINE64 the line before came %u more times", repeats);
+    repeats = 0;
+    add_record(text);
+}
+
 /* Lock held on entry and return. Takes the pending buffer and saves and
  * sends it with the lock released. */
 static void pass(void)
 {
+    add_repeats();
     char *full = pending;
     size_t length = used;
     pending = draining; draining = full; used = 0;
@@ -248,6 +284,9 @@ int pw_diagnostics_open(const char *root, const char *build, const char *profile
     wait_for_writer();
     if (fd >= 0) { close(fd); fd = -1; }
     disk_error = 0;
+    /* A new session's first line is never taken for a repeat of the last. */
+    last_message[0] = 0;
+    repeats = 0;
     if (!root || snprintf(directory, sizeof(directory), "%s/logs", root) >= (int)sizeof(directory)) {
         disk_error = ENAMETOOLONG; goto out;
     }
@@ -262,7 +301,10 @@ int pw_diagnostics_open(const char *root, const char *build, const char *profile
     next %= PW_DIAGNOSTICS_SESSIONS;
     snprintf(current, sizeof(current), "%s/session-%u.log", directory, next);
     snprintf(previous, sizeof(previous), "%s/session-%u.previous.log", directory, next);
+    snprintf(first, sizeof(first), "%s/session-%u.start.log", directory, next);
     (void)unlink(previous);
+    (void)unlink(first);
+    rotations = 0;
     fd = open(current, O_WRONLY | O_CREAT | O_TRUNC, 0600);
     if (fd < 0) { disk_error = errno; goto out; }
     /* Identity repeats on rotation so a retained tail can be identified. */
@@ -298,16 +340,14 @@ void pw_diagnostics_log(const char *format, ...)
     else if ((size_t)length >= sizeof(message))
         memcpy(message + sizeof(message) - sizeof(marker), marker, sizeof(marker));
     pthread_mutex_lock(&lock);
-    size_t size = format_record(pending + used, PW_DIAGNOSTICS_PENDING - used, message);
-    if (used + size < PW_DIAGNOSTICS_PENDING) {
-        size_t before = used;
-        used += size;
-        if (before < PW_DIAGNOSTICS_PENDING / 2 && used >= PW_DIAGNOSTICS_PENDING / 2) pthread_cond_signal(&wake);
-    } else {
-        /* Full: the writer is behind the records (a slow disk or network).
-         * Dropping keeps the caller, a game thread, out of the wait. */
-        dropped_records++; dropped_total++; dropped_bytes += size;
+    if (last_message[0] && !strcmp(message, last_message)) {
+        repeats++;
+        pthread_mutex_unlock(&lock);
+        return;
     }
+    add_repeats();
+    add_record(message);
+    memcpy(last_message, message, strlen(message) + 1);
     pthread_mutex_unlock(&lock);
 }
 
diff --git a/native/pw_diagnostics.h b/native/pw_diagnostics.h
index 3b2cec7..d681b20 100644
--- a/native/pw_diagnostics.h
+++ b/native/pw_diagnostics.h
@@ -4,7 +4,8 @@
 #include <stddef.h>
 #include <stdint.h>
 
-/* Eight process sessions; two bounded chunks per session. No game data. */
+/* Eight process sessions; three bounded chunks per session (how it began,
+ * the one before the newest, the newest). No game data. */
 #ifndef PW_DIAGNOSTICS_CHUNK
 #define PW_DIAGNOSTICS_CHUNK (1024u * 1024u)
 #endif
diff --git a/tests/test_pw_diagnostics.c b/tests/test_pw_diagnostics.c
index be0db61..b9ba721 100644
--- a/tests/test_pw_diagnostics.c
+++ b/tests/test_pw_diagnostics.c
@@ -40,11 +40,14 @@ static void *writer(void *arg)
 
 static char data[1 << 16];
 
-/* The session's chunk (part 0) or its previous chunk (part 1), as text. */
+/* The session's chunk (part 0), its previous chunk (part 1) or its first
+ * chunk (part 2), as text. */
 static int read_chunk(const char *root, unsigned part)
 {
+    static const char *const names[] = { "%s/logs/session-0.log", "%s/logs/session-0.previous.log",
+                                         "%s/logs/session-0.start.log" };
     char path[512];
-    snprintf(path, sizeof(path), part ? "%s/logs/session-0.previous.log" : "%s/logs/session-0.log", root);
+    snprintf(path, sizeof(path), names[part], root);
     FILE *chunk = fopen(path, "r");
     if (!chunk) { data[0] = 0; return 0; }
     size_t got = fread(data, 1, sizeof(data) - 1, chunk); data[got] = 0; fclose(chunk);
@@ -53,7 +56,7 @@ static int read_chunk(const char *root, unsigned part)
 
 static char *session_has(const char *root, const char *text)
 {
-    for (unsigned part = 0; part < 2; part++) {
+    for (unsigned part = 0; part < 3; part++) {
         if (!read_chunk(root, part)) continue;
         char *at = strstr(data, text);
         if (at) return at;
@@ -136,6 +139,23 @@ int main(void)
     /* Without a tick, the writer's own cadence saves a record within 100 ms. */
     pw_diagnostics_log("cadence-check");
     assert(wait_saved(root, "cadence-check", 1000) < 300);
+    /* A run of the same line is saved once, then counted: every repeat is in
+     * the counts, whichever passes of the writer they fell in. */
+    for (unsigned i = 0; i < 1000; i++) pw_diagnostics_log("same-line %s", "again");
+    pw_diagnostics_log("after-same");
+    pw_diagnostics_test_settle();
+    {
+        unsigned copies = 0, counted = 0;
+        for (unsigned part = 0; part < 3; part++) {
+            if (!read_chunk(root, part)) continue;
+            for (char *at = data; (at = strstr(at, "same-line again\n")); at++) copies++;
+            for (char *at = data; (at = strstr(at, "the line before came ")); at++) {
+                unsigned n = 0; assert(sscanf(at, "the line before came %u more times", &n) == 1); counted += n;
+            }
+        }
+        assert(copies == 1 && counted == 999);
+        assert(seq_of(session_has(root, "after-same")) > seq_of(session_has(root, "same-line again")));
+    }
     /* A message longer than a record is cut, and says so. */
     char longest[3000]; memset(longest, 'x', sizeof(longest) - 1); longest[sizeof(longest) - 1] = 0;
     pw_diagnostics_log("%s", longest);
@@ -152,6 +172,11 @@ int main(void)
     struct stat st; assert(stat(path, &st) == 0 && st.st_size <= PW_DIAGNOSTICS_CHUNK);
     snprintf(path, sizeof(path), "%s/logs/session-0.log", root);
     assert(stat(path, &st) == 0 && st.st_size <= PW_DIAGNOSTICS_CHUNK);
+    /* How the session began is kept, whatever followed: its first record. */
+    assert(read_chunk(root, 2) && !strncmp(data, "PW_REPORT/1 build=test-build", 28) && strstr(data, "before-open\n"));
+    snprintf(path, sizeof(path), "%s/logs/session-0.start.log", root);
+    assert(stat(path, &st) == 0 && st.st_size <= PW_DIAGNOSTICS_CHUNK);
+    snprintf(path, sizeof(path), "%s/logs/session-0.log", root);
     /* Every chunk starts with the identity line, records stay whole across
      * the rotation, and the newest are in the current chunk. */
     assert(read_chunk(root, 0) && !strncmp(data, "PW_REPORT/1 build=test-build", 28) && strstr(data, "record=299 repeated"));
@@ -219,6 +244,7 @@ int main(void)
     }
     assert(read_chunk(root, 0) && strstr(data, "build=next-build") && !strstr(data, "profile=pinball"));
     snprintf(path, sizeof(path), "%s/logs/session-0.previous.log", root); assert(access(path, F_OK) != 0);
+    snprintf(path, sizeof(path), "%s/logs/session-0.start.log", root); assert(access(path, F_OK) != 0);
     assert(pw_diagnostics_open("/dev/null", "build", "game", 0) == -1);
     pw_diagnostics_status(status, sizeof(status)); assert(strstr(status, "UNAVAILABLE"));
     /* Without a file, records still reach the network through the writer. */
@@ -231,9 +257,10 @@ int main(void)
     for (unsigned i = 0; i < PW_DIAGNOSTICS_SESSIONS; i++) {
         snprintf(path, sizeof(path), "%s/logs/session-%u.log", root, i); unlink(path);
         snprintf(path, sizeof(path), "%s/logs/session-%u.previous.log", root, i); unlink(path);
+        snprintf(path, sizeof(path), "%s/logs/session-%u.start.log", root, i); unlink(path);
     }
     snprintf(path, sizeof(path), "%s/logs/next.txt", root); unlink(path);
     snprintf(path, sizeof(path), "%s/logs", root); rmdir(path); rmdir(root);
-    puts("diagnostics passed: bounded retention, writer thread, concurrent writers, fault/end records, off-loop reconnects, no file or network waits in callers, dropped records counted, truncation marker, disk errors");
+    puts("diagnostics passed: bounded retention, session start kept, repeated lines counted, writer thread, concurrent writers, fault/end records, off-loop reconnects, no file or network waits in callers, dropped records counted, truncation marker, disk errors");
     return 0;
 }
