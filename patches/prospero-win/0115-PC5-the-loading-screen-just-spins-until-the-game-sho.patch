 #endif
     (void)pw_wine_launch_parse(argc, argv, catalog, catalog_count, &launch);
 #ifdef PW_PC5
@@ -1632,9 +1600,6 @@ int main(int argc, char **argv)
                launch.start[0] ? launch.start : "-", launch.exit_after);
     if (launch.mode != PW_WINE_LAUNCH_GAME) {
 #ifdef PW_PC5
-        /* A game PC5 asked for that isn't there any more: the launcher opens its own display. */
-        if (video_status == PW_OK) (void)pw_videoout_ps5_close(&video);
-        video_status = PW_ERR_STATE;
         pc5_launcher();
 #endif
         run_launcher();
@@ -1834,9 +1799,6 @@ int main(int argc, char **argv)
                "adopted=%d stats=%d", status, start.stage, (unsigned)start.module,
                start.segment_count, start.module_start_result, start.adopted != NULL,
                start.virtual_stats != NULL);
-#ifdef PW_PC5
-    if (status == PW_OK) start_stats = start.virtual_stats;
-#endif
     install_early_fault_report(&start);
