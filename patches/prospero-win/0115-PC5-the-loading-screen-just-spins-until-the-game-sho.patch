-    if (pc5_early_language[0]) pc5_game_shown_before(&pc5_game, pc5_early_language);   /* the same screen carries on */
+    {
+        char folder[PC5_NAME];
+        pc5_game_folder_name(executable, folder, sizeof(folder));
+        pc5_game_loading_setup(&pc5_game, pc5_language_arg, folder);
+    }
     pc5_game_on = 1;
 }
 
