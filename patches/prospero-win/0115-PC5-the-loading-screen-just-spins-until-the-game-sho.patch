         wine_dlsym_fn = (void *(*)(void *, const char *))(uintptr_t)pw_prx_lookup(start.descriptor, "dlsym");
@@ -1877,7 +1839,7 @@ int main(int argc, char **argv)
             rumble_at = (int (*)(uint32_t, uint32_t *, uint32_t *))
                 (uintptr_t)pw_prx_lookup(start.descriptor, "pw_wine_rumble_at");
         }
-        if (video_status != PW_OK) video_status = pw_videoout_ps5_open(&video);   /* open with PC5's loading screen */
+        video_status = pw_videoout_ps5_open(&video);
         pad_status = pw_pad_ps5_platform_ops(&pad_ops);
         if (pad_status == PW_OK)
             pad_status = pw_pad_ps5_open(&pad, &pad_ops, pad_open_map,
