++/**********************************************************************
++ *           stack_commit_granule
++ *
++ * The host page a fiber stack commits and guards in when it commits what
++ * Windows commits and grows through its guard page, as the Unix side lays
++ * out thread stacks where host pages are larger than Windows pages; 0 to
++ * commit the whole stack. In a PS5 title (WINE_PS5_NTDLL_DIR) every
++ * committed page is direct memory at once, and host pages are 16 KiB; on a
++ * PC, WINE_HOST_PAGE_SIZE keeps larger host pages to run that scheme.
++ */
++static SIZE_T stack_commit_granule(void)
++{
++    static SIZE_T granule = ~(SIZE_T)0;
++    WCHAR value[16];
++    SIZE_T len, size = 0;
++
++    if (granule != ~(SIZE_T)0) return granule;
++    if (!RtlQueryEnvironmentVariable( NULL, L"WINE_HOST_PAGE_SIZE", 19, value, ARRAY_SIZE(value) - 1, &len ))
++    {
++        value[len] = 0;
++        size = wcstoul( value, NULL, 0 );
++        if (size <= page_size || size > 0x10000 || (size & (size - 1))) size = 0;
++    }
++    else if (RtlQueryEnvironmentVariable( NULL, L"WINE_PS5_NTDLL_DIR", 18, value, 0, &len ) != STATUS_VARIABLE_NOT_FOUND)
++        size = 0x4000;
++    return granule = size;
++}
++
++
