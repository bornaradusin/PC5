diff --git a/tests/test_wine_fiber_stacks.py b/tests/test_wine_fiber_stacks.py
new file mode 100644
index 0000000..20e9612
--- /dev/null
+++ b/tests/test_wine_fiber_stacks.py
@@ -0,0 +1,81 @@
+#!/usr/bin/env python3
+# SPDX-License-Identifier: LGPL-2.1-or-later
+"""Fiber and thread stacks commit what Windows commits and grow through their
+guard page, where host pages are larger than Windows pages
+(wine/patches/0604): 3000 fibers with an exe's default 1 MiB reserve and
+4 KiB commit (1000 in a WoW64 process) commit one 16 KiB host page each, a
+fiber and a thread recurse 600 KiB deep through their guard pages, and an
+overflow still raises STATUS_STACK_OVERFLOW.
+
+Needs the host Wine from tools/build_host_wine.sh (PROSPERO_HOST_WINE, default
+.deps/wine-host/install/usr/bin/wine) and the mingw compilers; without them
+the check is skipped with a message. Each program runs twice: with the PC's
+4 KiB host pages, where Wine commits stacks whole as before and only the
+growth and overflow are checked, and with WINE_HOST_PAGE_SIZE=16384, which
+makes the PC's Wine keep 16 KiB host pages as the console's does."""
+from __future__ import annotations
+
+import os
+import re
+import shutil
+import subprocess
+import sys
+import tempfile
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[1]
+SOURCE = ROOT / "tests" / "wine_fiber_stacks.c"
+COMPILERS = (("x86_64-w64-mingw32-gcc", 3000), ("i686-w64-mingw32-gcc", 1000))
+HOST_PAGE = 16384
+
+
+def numbers(output: str, label: str) -> dict[str, int]:
+    line = next((line for line in output.splitlines() if line.startswith(label)), "")
+    return {key: int(value) for key, value in re.findall(r"(\w+)=(\d+)", line)}
+
+
+def main() -> int:
+    wine = os.environ.get("PROSPERO_HOST_WINE", str(ROOT / ".deps/wine-host/install/usr/bin/wine"))
+    compilers = [(shutil.which(name), count) for name, count in COMPILERS]
+    if not os.access(wine, os.X_OK) or not all(compiler for compiler, _ in compilers):
+        print("wine fiber stacks skipped: needs the host Wine and the mingw compilers")
+        return 0
+    results = []
+    with tempfile.TemporaryDirectory() as directory:
+        env = dict(os.environ, WINEPREFIX=str(Path(directory) / "pfx"), WINEDEBUG="-all",
+                   WINEDLLOVERRIDES="winemenubuilder.exe=d")
+        for compiler, count in compilers:
+            arch = Path(compiler).name.split("-")[0]
+            exe = Path(directory) / f"fiber-stacks-{arch}.exe"
+            # The game's exe header: 1 MiB reserved, 4 KiB committed.
+            subprocess.run([compiler, "-O1", "-o", str(exe), str(SOURCE),
+                            "-Xlinker", "--stack", "-Xlinker", "1048576,4096"], check=True)
+            for host_page in (0, HOST_PAGE):
+                run_env = dict(env, WINE_HOST_PAGE_SIZE=str(host_page)) if host_page else env
+                done = subprocess.run([wine, str(exe), str(count)], capture_output=True, text=True,
+                                      env=run_env, timeout=300)
+                label = f"{exe.name} host pages {host_page or 'native'}"
+                assert done.returncode == 0, f"{label}: {done.stdout}{done.stderr}"
+                assert "fiber-stacks verdict=pass" in done.stdout, f"{label}: {done.stdout}"
+                fibers = numbers(done.stdout, "fibers=")
+                assert fibers.get("fibers") == count, f"{label}: {done.stdout}"
+                if host_page:
+                    fiber_growth = numbers(done.stdout, "fiber-growth")
+                    thread_growth = numbers(done.stdout, "thread-growth")
+                    # One host page at the top, and a guard host page under it.
+                    assert fibers["committed_per_fiber"] == host_page, f"{label}: {done.stdout}"
+                    assert fibers["guard_per_fiber"] == host_page, f"{label}: {done.stdout}"
+                    assert fiber_growth["before"] == host_page, f"{label}: {done.stdout}"
+                    # A thread has run its start-up (DLL thread attach) by then.
+                    assert thread_growth["before"] <= 8 * host_page, f"{label}: {done.stdout}"
+                    for growth in (fiber_growth, thread_growth):
+                        assert growth["limit_moved"] >= 512 * 1024, f"{label}: {done.stdout}"
+                results.append(f"{arch} {host_page or 'native'}: {fibers['committed_per_fiber']} bytes"
+                               f" per fiber")
+    print("wine fiber stacks passed: stacks grow through their guard page and overflow; committed "
+          + ", ".join(results))
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/tests/wine_fiber_stacks.c b/tests/wine_fiber_stacks.c
new file mode 100644
index 0000000..4ab749f
--- /dev/null
+++ b/tests/wine_fiber_stacks.c
@@ -0,0 +1,251 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later
+ * Fiber and thread stacks commit what Windows commits and grow through their
+ * guard page (patch 0604). Assetto Corsa EVO creates about 2,750 fibers with
+ * the default sizes of its exe header, 1 MiB reserved and 4 KiB committed; on
+ * the console every committed page is direct memory, and Wine committed each
+ * fiber's whole stack. This creates as many fibers (the count is argv[1]),
+ * with this exe's 1 MiB and 4 KiB, and reports what their stacks commit; then
+ * on a new fiber and a new thread it sends itself a WM_GETTEXT with a
+ * 200 KB buffer, which Wine passes to the window procedure under the stack
+ * pointer, written from its low end past the guard page, and recurses about
+ * 600 KiB deep, which must grow the stack through the guard page; last it
+ * overflows a fiber and a thread, which must still raise
+ * STATUS_STACK_OVERFLOW. */
+#include <windows.h>
+#include <stdio.h>
+#include <stdlib.h>
+
+#define DEPTH 600          /* frames of about 1 KiB */
+#define GROWTH (512 * 1024)
+
+/* The head of a fiber, as Windows and Wine's kernelbase lay it out. */
+struct fiber_head
+{
+    void *param, *except, *stack_base, *stack_limit, *stack_allocation;
+};
+
+#define TEXT_CHARS 100000  /* a WM_GETTEXT buffer of 200 KB */
+
+struct growth
+{
+    SIZE_T before, after, limit_moved;
+    int guard_below, result, callback;
+};
+
+static void *main_fiber, *recover_sp, *overflow_resume;
+static volatile LONG overflows;
+static volatile LONG stop;  /* never set: the recursion of forever() is not provably endless */
+static DWORD overflow_thread;
+static struct growth fiber_growth, thread_growth;
+
+/* What [low, high) commits, less its guard pages, and its guard pages. */
+static SIZE_T committed(const char *low, const char *high, SIZE_T *guard)
+{
+    MEMORY_BASIC_INFORMATION mbi;
+    SIZE_T total = 0;
+
+    if (guard) *guard = 0;
+    while (low < high && VirtualQuery(low, &mbi, sizeof(mbi)))
+    {
+        SIZE_T size = min(mbi.RegionSize, (SIZE_T)(high - low));
+
+        if (mbi.State == MEM_COMMIT && (mbi.Protect & PAGE_GUARD)) { if (guard) *guard += size; }
+        else if (mbi.State == MEM_COMMIT) total += size;
+        low += size;
+    }
+    return total;
+}
+
+/* What the current stack commits, from its allocation base to its top. */
+static SIZE_T own_stack(void)
+{
+    NT_TIB *tib = (NT_TIB *)NtCurrentTeb();
+    MEMORY_BASIC_INFORMATION mbi;
+
+    VirtualQuery(tib->StackLimit, &mbi, sizeof(mbi));
+    return committed(mbi.AllocationBase, tib->StackBase, NULL);
+}
+
+static __attribute__((noinline)) int recurse(int depth)
+{
+    volatile char frame[1000];
+
+    frame[0] = (char)depth;
+    frame[sizeof(frame) - 1] = 1;
+    if (!depth) return frame[0];
+    return recurse(depth - 1) + frame[sizeof(frame) - 1];
+}
+
+static __attribute__((noinline)) int forever(int depth)
+{
+    volatile char frame[1000];
+
+    frame[0] = (char)depth;
+    if (stop) return 0;
+    return forever(depth + 1) + frame[0];
+}
+
+static LRESULT CALLBACK text_proc(HWND hwnd, UINT msg, WPARAM wparam, LPARAM lparam)
+{
+    if (msg == WM_GETTEXT && wparam > 5)
+    {
+        lstrcpyW((WCHAR *)lparam, L"fiber");
+        return 5;
+    }
+    return DefWindowProcW(hwnd, msg, wparam, lparam);
+}
+
+/* A window procedure's WM_GETTEXT buffer, on the current stack. */
+static int large_callback(void)
+{
+    static WCHAR text[TEXT_CHARS];
+    HWND hwnd = CreateWindowExW(0, L"pw_fiber_stacks", L"", 0, 0, 0, 0, 0, HWND_MESSAGE, NULL, NULL, NULL);
+    LRESULT length;
+
+    if (!hwnd) return 0;
+    text[0] = 0;
+    length = SendMessageW(hwnd, WM_GETTEXT, TEXT_CHARS, (LPARAM)text);
+    DestroyWindow(hwnd);
+    return length == 5 && !lstrcmpW(text, L"fiber");
+}
+
+/* Runs a large callback and recurses on the current stack, and records how
+ * it grew. */
+static void grow(struct growth *g)
+{
+    NT_TIB *tib = (NT_TIB *)NtCurrentTeb();
+    char *limit = tib->StackLimit;
+    MEMORY_BASIC_INFORMATION mbi;
+
+    g->before = own_stack();
+    g->callback = large_callback();
+    g->result = recurse(DEPTH);
+    g->after = own_stack();
+    g->limit_moved = limit - (char *)tib->StackLimit;
+    g->guard_below = VirtualQuery((char *)tib->StackLimit - 1, &mbi, sizeof(mbi)) &&
+                     mbi.State == MEM_COMMIT && (mbi.Protect & PAGE_GUARD);
+}
+
+static void print_growth(const char *what, const struct growth *g)
+{
+    printf("%s before=%llu after=%llu limit_moved=%llu guard_below=%d callback=%d\n", what,
+           (unsigned long long)g->before, (unsigned long long)g->after, (unsigned long long)g->limit_moved,
+           g->guard_below, g->callback);
+}
+
+static void WINAPI grow_fiber(void *param)
+{
+    grow(param);
+    SwitchToFiber(main_fiber);
+}
+
+static DWORD WINAPI grow_thread(void *param)
+{
+    grow(param);
+    return 0;
+}
+
+/* Where an overflowed stack resumes, on its top page. */
+static void overflow_fiber_done(void) { SwitchToFiber(main_fiber); }
+static void overflow_thread_done(void) { ExitThread(0); }
+
+static LONG CALLBACK overflow_handler(EXCEPTION_POINTERS *ep)
+{
+    if (ep->ExceptionRecord->ExceptionCode != STATUS_STACK_OVERFLOW) return EXCEPTION_CONTINUE_SEARCH;
+    if (GetCurrentThreadId() != overflow_thread) return EXCEPTION_CONTINUE_SEARCH;
+    InterlockedIncrement(&overflows);
+#ifdef _WIN64
+    ep->ContextRecord->Rsp = (DWORD64)recover_sp;
+    ep->ContextRecord->Rip = (DWORD64)overflow_resume;
+#else
+    ep->ContextRecord->Esp = (DWORD)recover_sp;
+    ep->ContextRecord->Eip = (DWORD)overflow_resume;
+#endif
+    return EXCEPTION_CONTINUE_EXECUTION;
+}
+
+static void overflow_here(void *resume)
+{
+    char *top = ((NT_TIB *)NtCurrentTeb())->StackBase;
+
+    /* A call's return address just pushed, 2 KiB under the top. */
+    recover_sp = (void *)((((UINT_PTR)top - 0x800) & ~(UINT_PTR)15) - sizeof(void *));
+    overflow_resume = resume;
+    forever(0);
+}
+
+static void WINAPI overflow_fiber(void *param)
+{
+    (void)param;
+    overflow_here((void *)overflow_fiber_done);
+}
+
+static DWORD WINAPI overflow_in_thread(void *param)
+{
+    (void)param;
+    overflow_thread = GetCurrentThreadId();
+    overflow_here((void *)overflow_thread_done);
+    return 1;
+}
+
+int main(int argc, char **argv)
+{
+    int count = argc > 1 ? atoi(argv[1]) : 3000, created = 0, i, fiber_overflow, thread_overflow;
+    void **fibers = calloc(count, sizeof(*fibers));
+    SIZE_T total = 0, guard_total = 0, reserve = 0, guard;
+    WNDCLASSW cls = { 0 };
+    HANDLE thread;
+    void *fiber;
+    BOOL ok;
+
+    cls.lpfnWndProc = text_proc;
+    cls.lpszClassName = L"pw_fiber_stacks";
+    main_fiber = ConvertThreadToFiber(NULL);
+    if (!fibers || !main_fiber || !RegisterClassW(&cls)) { printf("fiber-stacks verdict=fail setup\n"); return 1; }
+
+    for (i = 0; i < count; i++)
+    {
+        struct fiber_head *head;
+
+        if (!(fibers[i] = CreateFiberEx(0, 0, 0, grow_fiber, NULL))) break;
+        head = fibers[i];
+        total += committed(head->stack_allocation, head->stack_base, &guard);
+        guard_total += guard;
+        reserve += (char *)head->stack_base - (char *)head->stack_allocation;
+        created++;
+    }
+    printf("fibers=%d reserve_per_fiber=%llu committed=%llu committed_per_fiber=%llu guard_per_fiber=%llu\n",
+           created, (unsigned long long)(created ? reserve / created : 0), (unsigned long long)total,
+           (unsigned long long)(created ? total / created : 0), (unsigned long long)(created ? guard_total / created : 0));
+    for (i = 0; i < created; i++) DeleteFiber(fibers[i]);
+
+    fiber = CreateFiberEx(0, 0, 0, grow_fiber, &fiber_growth);
+    SwitchToFiber(fiber);
+    DeleteFiber(fiber);
+    print_growth("fiber-growth", &fiber_growth);
+
+    thread = CreateThread(NULL, 0, grow_thread, &thread_growth, 0, NULL);
+    WaitForSingleObject(thread, INFINITE);
+    CloseHandle(thread);
+    print_growth("thread-growth", &thread_growth);
+
+    AddVectoredExceptionHandler(1, overflow_handler);
+    overflow_thread = GetCurrentThreadId();
+    fiber = CreateFiberEx(0, 0, 0, overflow_fiber, NULL);
+    SwitchToFiber(fiber);
+    DeleteFiber(fiber);
+    fiber_overflow = overflows;
+    thread = CreateThread(NULL, 0, overflow_in_thread, NULL, 0, NULL);
+    WaitForSingleObject(thread, INFINITE);
+    CloseHandle(thread);
+    thread_overflow = overflows - fiber_overflow;
+    printf("overflow fiber=%d thread=%d\n", fiber_overflow, thread_overflow);
+
+    ok = created == count && fiber_overflow == 1 && thread_overflow == 1;
+    ok = ok && fiber_growth.result == DEPTH && thread_growth.result == DEPTH;
+    ok = ok && fiber_growth.after >= GROWTH && thread_growth.after >= GROWTH;
+    ok = ok && fiber_growth.guard_below && thread_growth.guard_below;
+    ok = ok && fiber_growth.callback && thread_growth.callback;
+    printf("fiber-stacks verdict=%s\n", ok ? "pass" : "fail");
+    return ok ? 0 : 1;
+}
diff --git a/wine/patches/0604-ntdll-ps5-commit-stacks-as-windows-does.patch b/wine/patches/0604-ntdll-ps5-commit-stacks-as-windows-does.patch
new file mode 100644
index 0000000..2abfd5c
--- /dev/null
+++ b/wine/patches/0604-ntdll-ps5-commit-stacks-as-windows-does.patch
@@ -0,0 +1,292 @@
+From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
+From: prospero-win <prospero-win@invalid>
+Date: Wed, 28 Oct 2026 18:00:00 +0100
+Subject: [PATCH] ntdll: Commit thread and fiber stacks as Windows does on PS5.
+
+Wine commits the whole stack of a thread or fiber when it creates it,
+less the guard page at the bottom. On the PS5 every committed page is
+direct memory at once (patch 0600), so each stack cost its whole
+reserve. Assetto Corsa EVO creates about 2,750 fibers at startup, each
+with its exe's 1 MiB reserve and 4 KiB commit, and Wine committed about
+2.7 GiB of direct memory for them.
+
+Where host pages are larger than Windows pages (the console's 16 KiB,
+or a PC with WINE_HOST_PAGE_SIZE), a stack now commits what Windows
+commits: its commit size at the top, rounded up to host pages, with a
+guard host page under it, and the rest stays reserved. It grows through
+the guard page as Wine's stacks always have: grow_thread_stack commits
+that host page and guards the next one down, and SwitchToFiber puts a
+fiber's stack in the TEB, where the fault handler looks for it. The
+Unix side lays out thread stacks this way; a caller that commits all it
+reserves (the WoW64 CPU's 64-bit stack) still gets the whole stack.
+RtlCreateUserStack lays out fiber stacks this way in a PS5 title
+(WINE_PS5_NTDLL_DIR) or with WINE_HOST_PAGE_SIZE set, and returns a
+failed commit instead of ignoring it.
+
+Wine writes some of its own frames on a thread's stack starting from
+their low end, past the guard page: signal_start_thread clears the
+60 KiB under a new thread's initial context, and a user callback's
+arguments can be larger than a guard page (a WM_GETTEXT buffer is
+passed whole). A fault on a reserved page of the current thread's
+stack, under its guard page, now commits everything up to the stack
+limit, as touching each guard page in turn would have;
+virtual_setup_exception does the same before it writes an exception
+frame. So a fiber starts with 16 KiB committed and a thread with
+64 KiB. A PC with 4 KiB host pages keeps committing stacks whole, as
+upstream does.
