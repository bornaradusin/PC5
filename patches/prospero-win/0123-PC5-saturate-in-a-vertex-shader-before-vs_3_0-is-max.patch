new file mode 100644
index 0000000..acef3ae
--- /dev/null
+++ b/wine/patches/0952-vkd3d-shader-saturate-in-a-vertex-shader-before-vs-3-0.patch
@@ -0,0 +1,70 @@
+From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
+From: bornaradusin <bornaradusin@users.noreply.github.com>
+Date: Tue, 3 Nov 2026 13:00:00 +0000
+Subject: [PATCH] vkd3d-shader/hlsl: Saturate with max and min in a vertex
+ shader before vs_3_0.
+
+A vertex shader has no saturate modifier before vs_3_0, but vkd3d-shader
+wrote saturate() as mov_sat in vs_1_x and vs_2_x shaders too. Far Cry
+assembles the listing of each shader it builds with fxc.exe again with
+its own d3dx9 assembler, which refused one ("error X2024: invalid
+instruction modifiers 'mov_sat'") and drew the sun's glow without it.
+saturate(x) is now min(max(x, 0), 1) there, as native fxc writes it.
+
+diff --git a/libs/vkd3d/libs/vkd3d-shader/hlsl_codegen.c b/libs/vkd3d/libs/vkd3d-shader/hlsl_codegen.c
+index a58f605..13289e6 100644
+--- a/libs/vkd3d/libs/vkd3d-shader/hlsl_codegen.c
++++ b/libs/vkd3d/libs/vkd3d-shader/hlsl_codegen.c
+@@ -6203,6 +6203,41 @@ static struct hlsl_ir_node *lower_round(struct hlsl_ctx *ctx, struct hlsl_ir_nod
+     return hlsl_block_add_binary_expr(ctx, block, HLSL_OP2_ADD, sum, neg);
+ }
+ 
++/* Lower SAT to MIN(MAX(x, 0), 1) in vertex shaders before vs_3_0, which have no
++ * saturate modifier: native fxc writes max and min there too, and d3dx9's assembler
++ * refuses mov_sat in a vs_2_0 listing ("invalid instruction modifiers"). */
++static struct hlsl_ir_node *lower_sat_vs2(struct hlsl_ctx *ctx, struct hlsl_ir_node *instr, struct hlsl_block *block)
++{
++    struct hlsl_constant_value zero_value, one_value;
++    struct hlsl_type *type = instr->data_type;
++    struct hlsl_ir_node *arg, *zero, *one, *max;
++    unsigned int i, component_count;
++    struct hlsl_ir_expr *expr;
++
++    if (instr->type != HLSL_IR_EXPR)
++        return NULL;
++    expr = hlsl_ir_expr(instr);
++    if (expr->op != HLSL_OP1_SAT)
++        return NULL;
++    if (ctx->profile->type != VKD3D_SHADER_TYPE_VERTEX || ctx->profile->major_version >= 3)
++        return NULL;
++    if (!hlsl_type_is_floating_point(type) || type->class > HLSL_CLASS_VECTOR)
++        return NULL;
++    arg = expr->operands[0].node;
++
++    component_count = hlsl_type_component_count(type);
++    for (i = 0; i < component_count; ++i)
++    {
++        zero_value.u[i].f = 0.0f;
++        one_value.u[i].f = 1.0f;
++    }
++    zero = hlsl_block_add_constant(ctx, block, type, &zero_value, &instr->loc);
++    one = hlsl_block_add_constant(ctx, block, type, &one_value, &instr->loc);
++
++    max = hlsl_block_add_binary_expr(ctx, block, HLSL_OP2_MAX, arg, zero);
++    return hlsl_block_add_binary_expr(ctx, block, HLSL_OP2_MIN, max, one);
++}
++
+ /* Lower SIN/COS to SINCOS for SM1.  */
+ static struct hlsl_ir_node *lower_trig(struct hlsl_ctx *ctx, struct hlsl_ir_node *instr, struct hlsl_block *block)
+ {
+@@ -16836,6 +16871,7 @@ static void process_entry_function(struct hlsl_ctx *ctx, struct vsir_program *pr
+         replace_ir(ctx, lower_sqrt, body);
+         replace_ir(ctx, lower_dot, body);
+         replace_ir(ctx, lower_round, body);
++        replace_ir(ctx, lower_sat_vs2, body);
+         replace_ir(ctx, lower_trig, body);
+         replace_ir(ctx, lower_comparison_operators, body);
+         replace_ir(ctx, lower_logic_not, body);
+-- 
