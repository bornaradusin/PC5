+/* The console's direct memory still free, which every allocation of the game and of the GPU comes
+ * from: the figure Windows is told (Wine patch 0914, which asks the kernel as MihawkOS's patch
+ * 0912 does). The kernel only says where the first free run in a range is, so each answer splits
+ * the range in two and both are asked in turn; at most 512 questions and 64 ranges waiting, so
+ * the figure is a lower bound. Logged once a minute, so a log that stops shows whether memory had
+ * run out. */
+static size_t direct_memory_free(size_t *total)
+{
+    struct range { long long low, high; } waiting[64], now = { 0, 0 };
+    const size_t alignment = 0x4000;
+    unsigned count = 0, questions = 0;
+    size_t free_bytes = 0;
+
+    *total = sceKernelGetDirectMemorySize();
+    now.high = (long long)*total;
+    for (;;) {
+        long long start = 0;
+        size_t size = 0;
+
+        if (now.high - now.low >= (long long)alignment && questions++ < 512 &&
+            !sceKernelAvailableDirectMemorySize(now.low, now.high, alignment, &start, &size) && size &&
+            start >= now.low && size <= (unsigned long long)(now.high - start)) {
+            struct range after = { start + (long long)size, now.high };
+
+            free_bytes += size;
+            if (after.high - after.low >= (long long)alignment && count < sizeof(waiting) / sizeof(waiting[0]))
+                waiting[count++] = after;
+            now.high = start;
+            continue;
+        }
+        if (!count) break;
+        now = waiting[--count];
+    }
+    return free_bytes;
+}
