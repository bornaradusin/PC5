+unsigned pw_wine_taps(uint32_t pressed, uint32_t released, uint32_t held)
+{
+    uint32_t taps = pressed & released & ~held;
+    unsigned n = 0;
+
+    for (; taps; taps &= taps - 1) n++;
+    return n;
+}
+
+static void held_add(char *out, size_t size, size_t *used, const char *name, const PwGameBinding *b)
+{
+    int n;
+
+    if (*used >= size) return;
+    n = snprintf(out + *used, size - *used, "%s%s=%s %#x", *used ? ", " : "", name,
+                 b->kind == PW_GAME_BIND_KEY ? "key" : "mouse", (unsigned)b->code);
+    if (n < 0) return;
+    *used += (size_t)n < size - *used ? (size_t)n : size - *used - 1;
+}
+
+void pw_wine_held_names(const PwGameInput *input, uint32_t held, uint32_t touch_held, char *out, size_t size)
+{
+    size_t used = 0;
+
+    if (!out || !size) return;
+    out[0] = 0;
+    for (size_t i = 0; input && i < PW_GAME_BUTTON_COUNT; i++) {
+        const PwGameBinding *b = &input->bindings[i];
+        if (!(held & b->mask) || (input->slow_mask && b->mask == input->slow_mask)) continue;
+        if (b->kind == PW_GAME_BIND_KEY || b->kind == PW_GAME_BIND_MOUSE) held_add(out, size, &used, pw_game_button_name(i), b);
+    }
+    for (size_t i = 0; input && i < PW_GAME_TOUCH_COUNT; i++) {
+        const PwGameBinding *b = &input->touch[i];
+        if (!(touch_held & (1u << i))) continue;
+        if (b->kind == PW_GAME_BIND_KEY || b->kind == PW_GAME_BIND_MOUSE) held_add(out, size, &used, pw_game_touch_name(i), b);
+    }
+    if (!used) snprintf(out, size, "none");
+}
