diff --git a/tools/make_ps5_keyboards.py b/tools/make_ps5_keyboards.py
new file mode 100644
index 0000000..4649d7d
--- /dev/null
+++ b/tools/make_ps5_keyboards.py
@@ -0,0 +1,202 @@
+#!/usr/bin/env python3
+# SPDX-License-Identifier: LGPL-2.1-or-later
+"""Writes dlls/win32u/ps5kbd.h: the keyboard layouts the PS5 user driver offers
+(Wine patch 0992), one for each language a PS5 can be set to, from xkeyboard-config
+as libxkbcommon reads it.
+
+    tools/make_ps5_keyboards.py WINE/dlls/win32u/input.c OUT.h
+
+For each layout and each key of a PC keyboard's main block, by its scan code: the
+character it types alone, with Shift, with AltGr and with Shift+AltGr, and the virtual
+key Windows gives it (a letter's own, a digit row key's digit, else the US key's at that
+place, or a free OEM key when that is taken). A dead key types its accent alone. The
+US layout's scan code tables come from Wine's own (input.c), for the keys that don't type."""
+import re
+import ctypes as C
+import sys
+
+LAYOUTS = [
+    # id, xkb layout, xkb variant, a script of its own (Alt+Shift switches to US for Latin)
+    ("gb", "gb", "", False), ("fr", "fr", "", False), ("ca", "ca", "", False),
+    ("de", "de", "", False), ("es", "es", "", False), ("latam", "latam", "", False),
+    ("it", "it", "", False), ("pt", "pt", "", False), ("br", "br", "", False),
+    ("dk", "dk", "", False), ("no", "no", "", False), ("se", "se", "", False),
+    ("fi", "fi", "", False), ("pl", "pl", "", False), ("cz", "cz", "", False),
+    ("hu", "hu", "", False), ("ro", "ro", "", False), ("tr", "tr", "", False),
+    ("ru", "ru", "", True), ("ua", "ua", "", True), ("gr", "gr", "", True),
+]
+
+# The keys that type, by scan code, and the US layout's virtual key for each.
+OEM = {"OEM_1": 0xBA, "OEM_PLUS": 0xBB, "OEM_COMMA": 0xBC, "OEM_MINUS": 0xBD, "OEM_PERIOD": 0xBE,
+       "OEM_2": 0xBF, "OEM_3": 0xC0, "OEM_4": 0xDB, "OEM_5": 0xDC, "OEM_6": 0xDD, "OEM_7": 0xDE,
+       "OEM_8": 0xDF, "OEM_102": 0xE2}
+US = {}
+for i, c in enumerate("1234567890"): US[0x02 + i] = ord(c)
+US.update({0x0C: OEM["OEM_MINUS"], 0x0D: OEM["OEM_PLUS"]})
+for i, c in enumerate("QWERTYUIOP"): US[0x10 + i] = ord(c)
+US.update({0x1A: OEM["OEM_4"], 0x1B: OEM["OEM_6"]})
+for i, c in enumerate("ASDFGHJKL"): US[0x1E + i] = ord(c)
+US.update({0x27: OEM["OEM_1"], 0x28: OEM["OEM_7"], 0x29: OEM["OEM_3"], 0x2B: OEM["OEM_5"]})
+for i, c in enumerate("ZXCVBNM"): US[0x2C + i] = ord(c)
+US.update({0x33: OEM["OEM_COMMA"], 0x34: OEM["OEM_PERIOD"], 0x35: OEM["OEM_2"], 0x56: OEM["OEM_102"]})
+SCANS = sorted(US)
+# the OEM key Windows' US layout gives a character, for a key that types it
+BY_CHAR = {",": "OEM_COMMA", ".": "OEM_PERIOD", "-": "OEM_MINUS", "=": "OEM_PLUS", "+": "OEM_PLUS",
+           ";": "OEM_1", "/": "OEM_2", "`": "OEM_3", "[": "OEM_4", "\\": "OEM_5", "]": "OEM_6", "'": "OEM_7"}
+DEAD = {"dead_grave": "`", "dead_acute": "´", "dead_circumflex": "^", "dead_tilde": "~",
+        "dead_macron": "¯", "dead_breve": "˘", "dead_abovedot": "˙", "dead_diaeresis": "¨",
+        "dead_abovering": "˚", "dead_doubleacute": "˝", "dead_caron": "ˇ", "dead_cedilla": "¸",
+        "dead_ogonek": "˛", "dead_belowdot": ".", "dead_greek": "", "dead_stroke": "/"}
+
+x = C.CDLL("libxkbcommon.so.0")
+
+
+class RMLVO(C.Structure):
+    _fields_ = [("rules", C.c_char_p), ("model", C.c_char_p), ("layout", C.c_char_p),
+                ("variant", C.c_char_p), ("options", C.c_char_p)]
+
+
+x.xkb_context_new.restype = C.c_void_p
+x.xkb_keymap_new_from_names.restype = C.c_void_p
+x.xkb_keymap_new_from_names.argtypes = [C.c_void_p, C.POINTER(RMLVO), C.c_int]
+x.xkb_state_new.restype = C.c_void_p
+x.xkb_state_new.argtypes = [C.c_void_p]
+x.xkb_state_unref.argtypes = [C.c_void_p]
+x.xkb_keymap_unref.argtypes = [C.c_void_p]
+x.xkb_keymap_mod_get_index.argtypes = [C.c_void_p, C.c_char_p]
+x.xkb_state_update_mask.argtypes = [C.c_void_p] + [C.c_uint32] * 6
+x.xkb_state_key_get_one_sym.argtypes = [C.c_void_p, C.c_uint32]
+x.xkb_state_key_get_one_sym.restype = C.c_uint32
+x.xkb_keysym_to_utf32.argtypes = [C.c_uint32]
+x.xkb_keysym_to_utf32.restype = C.c_uint32
+x.xkb_keysym_get_name.argtypes = [C.c_uint32, C.c_char_p, C.c_size_t]
+
+
+def read_layout(ctx, layout, variant):
+    names = RMLVO(b"evdev", b"pc105", layout.encode(), variant.encode(), None)
+    keymap = x.xkb_keymap_new_from_names(ctx, C.byref(names), 0)
+    if not keymap:
+        raise SystemExit(f"xkb has no layout {layout}({variant})")
+    state = x.xkb_state_new(keymap)
+    shift = 1 << x.xkb_keymap_mod_get_index(keymap, b"Shift")
+    level3 = 1 << x.xkb_keymap_mod_get_index(keymap, b"Mod5")
+    keys = {}
+    for scan in SCANS:
+        chars = []
+        for mods in (0, shift, level3, shift | level3):
+            x.xkb_state_update_mask(state, mods, 0, 0, 0, 0, 0)
+            sym = x.xkb_state_key_get_one_sym(state, scan + 8)
+            code = x.xkb_keysym_to_utf32(sym)
+            name = C.create_string_buffer(64)
+            x.xkb_keysym_get_name(sym, name, 64)
+            name = name.value.decode()
+            ch = chr(code) if code >= 0x20 and code != 0x7f else DEAD.get(name, "")
+            chars.append(ch if ch and ord(ch) <= 0xFFFF else "")
+        keys[scan] = chars
+    x.xkb_state_unref(state)
+    x.xkb_keymap_unref(keymap)
+    return keys
+
+
+def virtual_keys(keys):
+    vk, used = {}, set()
+    # 1: where the US layout has a letter: that letter's key if it types one, else the US one
+    for scan in SCANS:
+        if not (ord("A") <= US[scan] <= ord("Z")):
+            continue
+        ch = keys[scan][0]
+        if "a" <= ch <= "z":
+            vk[scan] = ord(ch.upper())
+        elif ch.isalpha():
+            vk[scan] = US[scan]       # another script's letter: Windows keeps the place's key
+        else:
+            continue
+        used.add(vk[scan])
+    # 2: a letter elsewhere (AZERTY's M) takes its own key if it is free
+    for scan in SCANS:
+        if scan in vk:
+            continue
+        ch = keys[scan][0]
+        if "a" <= ch <= "z" and ord(ch.upper()) not in used:
+            vk[scan] = ord(ch.upper())
+            used.add(vk[scan])
+    # 3: the digit row keeps its digits; anything else the US key there, or the OEM key
+    # Windows gives its character, or a free OEM key
+    for scan in SCANS:
+        if 0x02 <= scan <= 0x0B:
+            vk[scan] = US[scan]
+            used.add(vk[scan])
+    for scan in SCANS:
+        if scan in vk:
+            continue
+        want = [US[scan]] if not (ord("A") <= US[scan] <= ord("Z")) else []
+        ch = keys[scan][0]
+        if ch in BY_CHAR:
+            want.insert(0, OEM[BY_CHAR[ch]])
+        want += list(OEM.values())
+        vk[scan] = next(v for v in want if v not in used)
+        used.add(vk[scan])
+    return vk
+
+
+def c_char(ch):
+    if not ch:
+        return "WCH_NONE"
+    if ch == "\\":
+        return "'\\\\'"
+    if ch == "'":
+        return "'\\''"
+    if 0x20 <= ord(ch) < 0x7f:
+        return f"'{ch}'"
+    return f"0x{ord(ch):04x}"
+
+
+def main():
+    if len(sys.argv) != 3:
+        raise SystemExit(__doc__)
+    source = open(sys.argv[1], encoding="utf-8").read()
+    us = []
+    for name, kind in (("vsc_to_vk", "USHORT"), ("vsc_to_vk_e0", "VSC_VK"), ("vsc_to_vk_e1", "VSC_VK")):
+        m = re.search(r"static const %s %s\[\] =\n\{\n(.*?)\n\};" % (kind, name), source, re.S)
+        if not m:
+            raise SystemExit(f"no {name} in {sys.argv[1]}")
+        us.append(f"static const {kind} ps5kbd_us_{name}[] =\n{{\n{m.group(1)}\n}};\n")
+    ctx = x.xkb_context_new(0)
+    out = ["/* SPDX-License-Identifier: LGPL-2.1-or-later */",
+           "/* Generated by prospero-win's tools/make_ps5_keyboards.py from xkeyboard-config",
+           " * (MIT): the PS5 user driver's keyboard layouts (ps5drv.c). Each key: its scan code,",
+           " * virtual key, and what it types alone, with Shift, (Ctrl: nothing), AltGr and",
+           " * Shift+AltGr. */", "", "/* Wine's US layout's scan codes (win32u/input.c) */"] + us + [
+           "/* each scan code's virtual key on the US layout, for the keys that type */",
+           "static const BYTE ps5kbd_us_vk[0x60] =", "{",
+           "    " + ", ".join(f"[0x{s:02x}] = 0x{US[s]:02x}" for s in SCANS[:12]) + ",",
+           "    " + ", ".join(f"[0x{s:02x}] = 0x{US[s]:02x}" for s in SCANS[12:24]) + ",",
+           "    " + ", ".join(f"[0x{s:02x}] = 0x{US[s]:02x}" for s in SCANS[24:36]) + ",",
+           "    " + ", ".join(f"[0x{s:02x}] = 0x{US[s]:02x}" for s in SCANS[36:]) + ",",
+           "};", ""]
+    table = []
+    for ident, layout, variant, own_script in LAYOUTS:
+        keys = read_layout(ctx, layout, variant)
+        vk = virtual_keys(keys)
+        rows = []
+        for scan in SCANS:
+            normal, shifted, altgr, shift_altgr = keys[scan]
+            if not any(keys[scan]):
+                continue
+            caps = "CAPLOK" if normal.isalpha() and shifted == normal.upper() and normal != shifted else "0"
+            rows.append(f"    {{0x{scan:02x}, 0x{vk[scan]:02x}, {caps}, {{{c_char(normal)}, {c_char(shifted)}, WCH_NONE, "
+                        f"{c_char(altgr)}, {c_char(shift_altgr)}}}}},")
+        has_altgr = any(keys[s][2] not in ("", keys[s][0], keys[s][1]) for s in SCANS)
+        out.append(f"static const struct ps5kbd_key ps5kbd_{ident}[] =\n{{")
+        out += rows
+        out.append("    {0}\n};\n")
+        table.append(f"    {{\"{ident}\", ps5kbd_{ident}, {int(has_altgr)}, {int(own_script)}}},")
+    out.append("static const struct ps5kbd_layout ps5kbd_layouts[] =\n{")
+    out += table
+    out.append("};")
+    with open(sys.argv[2], "w", encoding="utf-8") as f:
+        f.write("\n".join(out) + "\n")
+
+
+if __name__ == "__main__":
+    main()
diff --git a/wine/patches/0992-win32u-ps5-keyboard-layouts.patch b/wine/patches/0992-win32u-ps5-keyboard-layouts.patch
new file mode 100644
index 0000000..f33147a
--- /dev/null
+++ b/wine/patches/0992-win32u-ps5-keyboard-layouts.patch
@@ -0,0 +1,1498 @@
+From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
+From: prospero-win <prospero-win@invalid>
+Date: Sun, 1 Nov 2026 10:00:00 +0000
+Subject: [PATCH] win32u: PS5: a USB keyboard types as the console's language's
+ layout.
+
+A keyboard plugged into the PS5 typed as a US one whatever it was: on a
+French AZERTY keyboard the key marked A typed q, and there was no way to
+type @ (AltGr+0) for an e-mail address at a game's login (World of Tanks).
+
+The console sends a keyboard's keys by their place, named as a US
+keyboard names them. The PS5 user driver now sends them, when the title
+names a layout in WINE_PS5_KEYBOARD (PC5: the console's language, or
+PC5's own), as that layout's keys at those places, with its characters:
+a KBDTABLES (pKbdLayerDescriptor) built from dlls/win32u/ps5kbd.h, which
+prospero-win's tools/make_ps5_keyboards.py writes from xkeyboard-config.
+AltGr is Ctrl+Alt, as on Windows; a dead key types its accent alone. A
+layout of another script (Russian, Ukrainian, Greek) switches with the US
+one by Alt+Shift, as on Windows, so a game's login can still be typed.
+
+Nothing else changes: with WINE_PS5_KEYBOARD unset or "us" the keyboard
+is the US one as before, and the keys the controller's button mapping
+names (input type 1) keep their US places under every layout, so a game
+that reads places sees the keys it saw before. Ctrl+letter and the
+number pad are win32u's, as for the US layout.
+---
+diff --git a/dlls/win32u/ps5drv.c b/dlls/win32u/ps5drv.c
+index 602b922..77552fd 100644
+--- a/dlls/win32u/ps5drv.c
++++ b/dlls/win32u/ps5drv.c
+@@ -55,6 +55,7 @@
+ #include "dbt.h"
+ #include "wine/server.h"
+ #include "wine/debug.h"
++#include "kbd.h"
+ #ifdef SONAME_LIBVULKAN
+ #include "wine/vulkan.h"
+ #include "wine/vulkan_driver.h"
+@@ -67,7 +68,8 @@ WINE_DEFAULT_DEBUG_CHANNEL(ps5drv);
+ /* the layout of PwWineInput in wine/ps5/pw_wine_sink.h */
+ struct ps5_input
+ {
+-    UINT type;              /* 1 key, 2 mouse move, 3 mouse button, 4 dialog key, 5 character, 6 wheel */
++    UINT type;              /* 1 key, 2 mouse move, 3 mouse button, 4 dialog key, 5 character, 6 wheel,
++                             * 7 a keyboard's key by its place */
+     UINT code;              /* virtual key, button 0 left 1 right 2 middle, or a UTF-16 unit */
+     INT  x, y;              /* mouse move: relative motion in desktop pixels; wheel: x notches */
+     UINT down;
+@@ -578,6 +580,177 @@ static BOOL is_extended_key( WORD vk )
+     return FALSE;
+ }
+ 
++/***********************************************************************
++ *           keyboard layout
++ *
++ * A keyboard's keys come by their place, as the US layout names them (the
++ * console's HID codes), and are sent as the keys of the layout the title
++ * names in WINE_PS5_KEYBOARD (PC5: the console's language, or PC5's own),
++ * with the characters that layout types (ps5kbd.h, from xkeyboard-config):
++ * on an AZERTY keyboard the key where a US keyboard has Q is A, and AltGr+0
++ * types @. A layout of another script (Russian, Ukrainian, Greek) switches
++ * to the US one and back with Alt+Shift, as on Windows. The controller's
++ * keys (its button mapping names them) stay what they are named.
++ */
++struct ps5kbd_key
++{
++    BYTE scan;
++    BYTE vk;
++    BYTE attributes;
++    WCHAR wch[5];        /* alone, Shift, Ctrl (none), AltGr, Shift+AltGr */
++};
++
++struct ps5kbd_layout
++{
++    const char *name;
++    const struct ps5kbd_key *keys;
++    BOOL altgr;          /* AltGr types: right Alt is Ctrl+Alt, as on Windows */
++    BOOL own_script;     /* Alt+Shift switches it with US */
++};
++
++#include "ps5kbd.h"
++
++static const struct ps5kbd_layout *kbd_layout;
++static BOOL kbd_us;                       /* switched to US with Alt+Shift */
++static BYTE kbd_scan_of_us_vk[256];       /* the place of a US key that types */
++static BYTE kbd_vk_at[0x60];              /* the layout's key at a place */
++static USHORT kbd_vsc_to_vk[ARRAY_SIZE(ps5kbd_us_vsc_to_vk)];
++static VK_TO_WCHARS5 kbd_chars[128];
++static VK_TO_WCHAR_TABLE kbd_char_tables[2];
++static const VK_TO_BIT kbd_vk_to_bit[] =
++{
++    {.Vk = VK_SHIFT, .ModBits = KBDSHIFT},
++    {.Vk = VK_CONTROL, .ModBits = KBDCTRL},
++    {.Vk = VK_MENU, .ModBits = KBDALT},
++    {0},
++};
++/* alone, Shift, Ctrl, (Shift+Ctrl: none), Alt and Shift+Alt as alone and Shift (a menu's
++ * Alt+letter), Ctrl+Alt (AltGr), Shift+Ctrl+Alt. Ctrl+letter and the number pad are win32u's. */
++static const struct
++{
++    const VK_TO_BIT *pVkToBit;
++    WORD wMaxModBits;
++    BYTE ModNumber[8];
++} kbd_modifiers = { kbd_vk_to_bit, 7, {0, 1, 2, 0x0f, 0, 1, 3, 4} };
++static const VSC_LPWSTR kbd_no_names[] = {{0}};
++static KBDTABLES kbd_tables;
++
++/* WINE_PS5_KEYBOARD: one of ps5kbd_layouts' names; anything else is the US layout. */
++static void kbd_init(void)
++{
++    const char *name = getenv( "WINE_PS5_KEYBOARD" );
++    const struct ps5kbd_key *key;
++    UINT i, n = 0;
++
++    if (!name || !*name) return;
++    for (i = 0; i < ARRAY_SIZE(ps5kbd_layouts); i++)
++        if (!strcmp( ps5kbd_layouts[i].name, name )) kbd_layout = &ps5kbd_layouts[i];
++    if (!kbd_layout)
++    {
++        if (strcmp( name, "us" )) ERR( "no keyboard layout %s: US\n", name );
++        return;
++    }
++    for (i = 0; i < ARRAY_SIZE(ps5kbd_us_vk); i++)
++        if (ps5kbd_us_vk[i]) kbd_scan_of_us_vk[ps5kbd_us_vk[i]] = i;
++    memcpy( kbd_vsc_to_vk, ps5kbd_us_vsc_to_vk, sizeof(kbd_vsc_to_vk) );
++    for (key = kbd_layout->keys; key->scan && n < ARRAY_SIZE(kbd_chars) - 16; key++)
++    {
++        kbd_vk_at[key->scan] = key->vk;
++        kbd_vsc_to_vk[key->scan] = key->vk;
++        kbd_chars[n].VirtualKey = key->vk;
++        kbd_chars[n].Attributes = key->attributes;
++        memcpy( kbd_chars[n].wch, key->wch, sizeof(key->wch) );
++        n++;
++    }
++    /* the keys every layout types alike */
++    {
++        static const struct { BYTE vk; WCHAR ch; } same[] =
++        {
++            {VK_SPACE, ' '}, {VK_TAB, '\t'}, {VK_RETURN, '\r'}, {VK_BACK, '\b'}, {VK_ESCAPE, 0x1b},
++            {VK_CANCEL, 0x03}, {VK_DECIMAL, '.'}, {VK_ADD, '+'}, {VK_SUBTRACT, '-'}, {VK_MULTIPLY, '*'},
++            {VK_DIVIDE, '/'},
++        };
++        for (i = 0; i < ARRAY_SIZE(same); i++, n++)
++        {
++            kbd_chars[n].VirtualKey = same[i].vk;
++            kbd_chars[n].wch[0] = kbd_chars[n].wch[1] = same[i].ch;
++            kbd_chars[n].wch[2] = kbd_chars[n].wch[3] = kbd_chars[n].wch[4] = WCH_NONE;
++        }
++    }
++    kbd_char_tables[0].pVkToWchars = (VK_TO_WCHARS1 *)kbd_chars;
++    kbd_char_tables[0].nModifications = 5;
++    kbd_char_tables[0].cbSize = sizeof(kbd_chars[0]);
++    kbd_tables.pCharModifiers = (MODIFIERS *)&kbd_modifiers;
++    kbd_tables.pVkToWcharTable = kbd_char_tables;
++    kbd_tables.pKeyNames = (VSC_LPWSTR *)kbd_no_names;
++    kbd_tables.pKeyNamesExt = (VSC_LPWSTR *)kbd_no_names;
++    kbd_tables.pusVSCtoVK = kbd_vsc_to_vk;
++    kbd_tables.bMaxVSCtoVK = ARRAY_SIZE(kbd_vsc_to_vk) - 1;
++    kbd_tables.pVSCtoVK_E0 = (VSC_VK *)ps5kbd_us_vsc_to_vk_e0;
++    kbd_tables.pVSCtoVK_E1 = (VSC_VK *)ps5kbd_us_vsc_to_vk_e1;
++    kbd_tables.fLocaleFlags = MAKELONG( kbd_layout->altgr ? KLLF_ALTGR : 0, KBD_VERSION );
++    MESSAGE( "wine-ps5: keyboard layout %s\n", kbd_layout->name );
++}
++
++static const KBDTABLES *ps5_KbdLayerDescriptor( HKL layout )
++{
++    return kbd_layout && !kbd_us ? &kbd_tables : NULL;
++}
++
++static void ps5_ReleaseKbdTables( const KBDTABLES *tables )
++{
++}
++
++/* A keyboard's key, by its US name: sent as the layout's key at that place. */
++static void send_keyboard_key( HWND hwnd, WORD us_vk, BOOL down )
++{
++    static BOOL alt, shift;
++    INPUT input = {.type = INPUT_KEYBOARD};
++    BYTE scan = us_vk < 256 ? kbd_scan_of_us_vk[us_vk] : 0;
++    BOOL altgr = kbd_layout && kbd_layout->altgr && !kbd_us && us_vk == VK_RMENU;
++
++    /* Alt+Shift: a layout of another script and US, in turn */
++    if (us_vk == VK_MENU || us_vk == VK_LMENU) alt = down;
++    if (us_vk == VK_SHIFT || us_vk == VK_LSHIFT || us_vk == VK_RSHIFT)
++    {
++        if (down && !shift && alt && kbd_layout && kbd_layout->own_script)
++        {
++            kbd_us = !kbd_us;
++            TRACE( "keyboard layout %s\n", kbd_us ? "us" : kbd_layout->name );
++        }
++        shift = down;
++    }
++    else if ((us_vk == VK_MENU || us_vk == VK_LMENU) && down && shift && kbd_layout && kbd_layout->own_script)
++        kbd_us = !kbd_us;
++
++    input.ki.wVk = us_vk;
++    if (kbd_layout && !kbd_us && scan && kbd_vk_at[scan])
++    {
++        input.ki.wVk = kbd_vk_at[scan];
++        input.ki.wScan = scan;
++    }
++    else input.ki.wScan = NtUserMapVirtualKeyEx( us_vk, MAPVK_VK_TO_VSC, NtUserGetKeyboardLayout( 0 ));
++    input.ki.dwFlags = down ? 0 : KEYEVENTF_KEYUP;
++    if (is_extended_key( us_vk )) input.ki.dwFlags |= KEYEVENTF_EXTENDEDKEY;
++    if (altgr && down)
++    {
++        /* AltGr is Ctrl+Alt: the left Ctrl first */
++        INPUT ctrl = {.type = INPUT_KEYBOARD};
++        ctrl.ki.wVk = VK_LCONTROL;
++        ctrl.ki.wScan = 0x1d;
++        NtUserSendHardwareInput( hwnd, 0, &ctrl, 0 );
++    }
++    NtUserSendHardwareInput( hwnd, 0, &input, 0 );
++    if (altgr && !down)
++    {
++        INPUT ctrl = {.type = INPUT_KEYBOARD};
++        ctrl.ki.wVk = VK_LCONTROL;
++        ctrl.ki.wScan = 0x1d;
++        ctrl.ki.dwFlags = KEYEVENTF_KEYUP;
++        NtUserSendHardwareInput( hwnd, 0, &ctrl, 0 );
++    }
++}
++
+ /* A dialog box: the class of every window DialogBox and MessageBox make. */
+ static BOOL is_dialog( HWND hwnd )
+ {
+@@ -671,11 +844,20 @@ static BOOL ps5_ProcessEvents( DWORD mask )
+             /* fall through */
+         case 1:
+             input.ki.wVk = event.code;
+-            input.ki.wScan = NtUserMapVirtualKeyEx( event.code, MAPVK_VK_TO_VSC, NtUserGetKeyboardLayout( 0 ));
++            /* A key the controller's button mapping names keeps its US place under any
++             * keyboard layout, so a game that reads places sees what it saw before. */
++            if (kbd_layout && event.code < 256 && kbd_scan_of_us_vk[event.code])
++                input.ki.wScan = kbd_scan_of_us_vk[event.code];
++            else
++                input.ki.wScan = NtUserMapVirtualKeyEx( event.code, MAPVK_VK_TO_VSC, NtUserGetKeyboardLayout( 0 ));
+             input.ki.dwFlags = event.down ? 0 : KEYEVENTF_KEYUP;
+             if (is_extended_key( event.code )) input.ki.dwFlags |= KEYEVENTF_EXTENDEDKEY;
+             NtUserSendHardwareInput( hwnd, 0, &input, 0 );
+             break;
++        case 7:
++            /* a keyboard's key, by its place (send_keyboard_key) */
++            if (event.code && event.code < 256) send_keyboard_key( hwnd, event.code, event.down != 0 );
++            break;
+         case 5:
+             /* A character typed on the console's on-screen keyboard, sent as
+              * Windows sends one from an input method: a VK_PACKET key, down and
+@@ -1003,6 +1185,8 @@ static const struct user_driver_funcs ps5_user_driver =
+     .pWindowPosChanged = ps5_WindowPosChanged,
+     .pDestroyWindow = ps5_DestroyWindow,
+     .pProcessEvents = ps5_ProcessEvents,
++    .pKbdLayerDescriptor = ps5_KbdLayerDescriptor,
++    .pReleaseKbdTables = ps5_ReleaseKbdTables,
+     .pGetCursorPos = ps5_GetCursorPos,
+     .pSetCursor = ps5_SetCursor,
+     .pSetCursorPos = ps5_SetCursorPos,
+@@ -1042,6 +1226,7 @@ void ps5_install_user_driver(void)
+     next_input = dlsym( RTLD_DEFAULT, "pw_wine_next_input" );
+     input_fd = dlsym( RTLD_DEFAULT, "pw_wine_input_fd" );
+     pad_changes = dlsym( RTLD_DEFAULT, "pw_wine_pad_changes" );
++    kbd_init();
+ #ifdef SONAME_LIBVULKAN
+     release_display = dlsym( RTLD_DEFAULT, "pw_wine_release_display" );
+ #endif
+diff --git a/dlls/win32u/ps5kbd.h b/dlls/win32u/ps5kbd.h
+new file mode 100644
+index 0000000..a6fe17c
+--- /dev/null
++++ b/dlls/win32u/ps5kbd.h
+@@ -0,0 +1,1224 @@
