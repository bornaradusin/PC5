@@ -81,6 +81,15 @@ static void open_keyboard(PwHidPs5 *hid)
         handle = open(hid->user_id, 0, 0, param);
     }
     if (handle >= 0) hid->keyboard = handle;
+    /* The keyboards after the first: refused where there is none, quietly. */
