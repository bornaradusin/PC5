@@ -128,6 +137,7 @@ int pw_hid_ps5_open(PwHidPs5 *hid, const PwHidPs5Ops *ops, int32_t user_id)
     hid->ops = *ops;
     hid->user_id = user_id;
     hid->keyboard = hid->mouse = -1;
+    for (int i = 0; i < PW_HID_PS5_KEYBOARDS - 1; i++) hid->more_keyboards[i] = -1;
     return pw_hid_ps5_retry(hid);
 }
 
@@ -144,15 +154,32 @@ void pw_hid_ps5_poll(PwHidPs5 *hid, PwHidPs5Poll *poll)
     memset(poll, 0, sizeof(*poll));
     if (!hid) return;
     if (hid->keyboard >= 0) {
-        uint8_t state[PW_HID_PS5_KEYBOARD_STATE] = { 0 };
         PwHidKeyboard now;
+        int read = 0;
+
+        memset(&now, 0, sizeof(now));
+        for (int k = 0; k < PW_HID_PS5_KEYBOARDS; k++) {
+            int32_t handle = k ? hid->more_keyboards[k - 1] : hid->keyboard;
+            uint8_t state[PW_HID_PS5_KEYBOARD_STATE] = { 0 };
+            PwHidKeyboard one;
 
-        if (hid->keyboard_read_state(hid->keyboard, state) == 0) {
-            pw_hid_ps5_keyboard_state(state, &now);
-            if (hid->keyboard_dumps < PW_HID_PS5_DUMPS && (now.keys[0] || now.modifiers)) {
+            if (handle < 0 || hid->keyboard_read_state(handle, state) != 0) continue;
+            read++;
+            pw_hid_ps5_keyboard_state(state, &one);
+            if (hid->keyboard_dumps < PW_HID_PS5_DUMPS && (one.keys[0] || one.modifiers)) {
                 dump(hid, "keyboard state", state, sizeof(state));
                 hid->keyboard_dumps++;
             }
+            /* Held on any keyboard: each key once, as many as a report carries. */
+            now.modifiers |= one.modifiers;
+            for (int i = 0; i < PW_HID_KEYS; i++) {
+                int slot = 0;
+                if (!one.keys[i]) continue;
+                while (slot < PW_HID_KEYS && now.keys[slot] && now.keys[slot] != one.keys[i]) slot++;
+                if (slot < PW_HID_KEYS) now.keys[slot] = one.keys[i];
+            }
+        }
+        if (read) {
             poll->count += pw_hid_keyboard_events(&hid->keys, &now, poll->events + poll->count,
                                                   PW_HID_PS5_EVENTS - poll->count);
             hid->keys = now;
