 static int fake_mouse_read(int32_t handle, void *records, int32_t count)
@@ -164,11 +166,41 @@ static void test_open_and_poll(void)
     assert(poll.count == 0 && !poll.dx && !poll.dy);
 }
 
+/* A wireless mouse's receiver that is a keyboard too came first: the real keyboard is index 1,
+ * and its keys are read with the first one's. */
+static void test_second_keyboard(void)
+{
+    static const uint16_t a[1] = { 0x04 }, b[2] = { 0x05, 0x04 };
+    PwHidPs5 hid;
+    PwHidPs5Poll poll;
+
+    keyboard_loads = 1;
+    mouse_loads = 0;
+    second_keyboard = 1;
+    lines = 0;
+    assert(pw_hid_ps5_open(&hid, &ops, 1000) == PW_OK && hid.keyboard == 3 && hid.more_keyboards[0] == 5 &&
+           hid.more_keyboards[1] < 0 && hid.more_keyboards[2] < 0);
+    keyboard(0, NULL, 0);                                 /* the receiver: nothing held */
+    memcpy(second_state, keyboard_state, sizeof(second_state));
+    put32(second_state + 20, 1);
+    memcpy(second_state + 32, a, 2);                      /* A on the real keyboard */
+    pw_hid_ps5_poll(&hid, &poll);
+    assert(poll.count == 1 && poll.events[0].code == 'A' && poll.events[0].down);
+    /* B and A, A held on both: A once, B new. */
+    keyboard(0, a, 1);
+    put32(second_state + 20, 2);
+    memcpy(second_state + 32, b, 4);
+    pw_hid_ps5_poll(&hid, &poll);
+    assert(poll.count == 1 && poll.events[0].code == 'B' && poll.events[0].down);
+    second_keyboard = 0;
+}
+
 int main(void)
 {
     test_keyboard_layout();
     test_mouse_layout();
     test_open_and_poll();
+    test_second_keyboard();
     puts("ps5 usb keyboard and mouse passed");
     return 0;
 }
diff --git a/wine/patches/0904-wined3d-a-16-bit-back-buffer-presents-through-an-8-bit-vulkan-swapchain.patch b/wine/patches/0904-wined3d-a-16-bit-back-buffer-presents-through-an-8-bit-vulkan-swapchain.patch
new file mode 100644
index 0000000..83f5b19
--- /dev/null
+++ b/wine/patches/0904-wined3d-a-16-bit-back-buffer-presents-through-an-8-bit-vulkan-swapchain.patch
@@ -0,0 +1,34 @@
+From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
+From: bornaradusin <bornaradusin@users.noreply.github.com>
+Date: Wed, 4 Nov 2026 10:00:00 +0000
+Subject: [PATCH] wined3d: A 16-bit back buffer presents through an 8-bit Vulkan
+ swapchain.
+
+A display that offers no 16-bit swapchain format (the PS5's) left a
+DirectDraw game's 565 or 1555 mode without a swapchain on the Vulkan
+renderer: "Failed to find Vulkan swapchain format for
+WINED3DFMT_B5G6R5_UNORM", and SetCooperativeLevel failed. The Legend of
+Heroes: A Tear of Vermillion then fell back to a 640x480 window in the
+middle of a 1080p screen. The present already blits the back buffer into
+the swapchain's image, and Vulkan requires every device to blit from
+these two formats, so the swapchain is B8G8R8A8 and the blit converts.
+
+diff --git a/dlls/wined3d/swapchain.c b/dlls/wined3d/swapchain.c
+index 6609219..03138a4 100644
+--- a/dlls/wined3d/swapchain.c
++++ b/dlls/wined3d/swapchain.c
+@@ -753,6 +753,11 @@ static VkFormat get_swapchain_fallback_format(VkFormat vk_format)
+         case VK_FORMAT_R8G8B8A8_UNORM:
+         case VK_FORMAT_A2B10G10R10_UNORM_PACK32:
+         case VK_FORMAT_R16G16B16A16_SFLOAT:
++        /* A 16-bit picture (an old DirectDraw game's 565 or 1555 mode): the present blits
++         * it into the swapchain's image, which converts it, as the formats Vulkan requires
++         * every device to blit from. */
++        case VK_FORMAT_R5G6B5_UNORM_PACK16:
++        case VK_FORMAT_A1R5G5B5_UNORM_PACK16:
+             return VK_FORMAT_B8G8R8A8_UNORM;
+         default:
+             WARN("Unhandled format %#x.\n", vk_format);
+-- 
+2.43.0
+
