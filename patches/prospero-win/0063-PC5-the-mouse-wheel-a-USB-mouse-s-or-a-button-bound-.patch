+/* A button bound to the wheel turns it a notch as it is pressed (up away from the player),
+ * and nothing as it is released; the button that slows the pointer sends nothing and slows
+ * it by its percent while held. */
+static void test_wheel_and_slow(void)
+{
+    static const char text[] = "[input]\nmode = keyboard\nmouse = right_stick\nmouse_speed = 1200\n"
+                               "l1 = mouse_wheel_up\nr1 = mouse_wheel_down\nl2 = space\nmouse_slow = l2\n"
+                               "mouse_slow_percent = 75\n";
+    PwGameInput input;
+    PwWineInput events[8];
+
+    pw_game_input_init(&input);
+    assert(pw_game_input_parse((const uint8_t *)text, sizeof(text) - 1, &input) == PW_OK);
+    assert(pw_wine_game_inputs(&input, L1, 0, events, 8) == 1);
+    assert(events[0].type == PW_WINE_INPUT_MOUSE_WHEEL && events[0].x == 1 && !events[0].y);
+    assert(pw_wine_game_inputs(&input, R1, L1, events, 8) == 1 && events[0].x == -1);
+    assert(pw_wine_game_inputs(&input, 0, R1, events, 8) == 0);
+    assert(pw_wine_game_inputs(&input, L2, 0, events, 8) == 0 && pw_wine_game_inputs(&input, 0, L2, events, 8) == 0);
+    assert(pw_wine_pointer_speed(&input, 0) == 1200 && pw_wine_pointer_speed(&input, L1) == 1200);
+    assert(pw_wine_pointer_speed(&input, L2) == 300 && pw_wine_pointer_speed(&input, L2 | L1) == 300);
+    /* Without a slow button, the speed is the profile's whatever is held. */
+    pw_game_input_init(&input);
+    assert(input.slow_percent == 50 && !input.slow_mask);
+    assert(pw_wine_pointer_speed(&input, 0xffffffffu) == PW_GAME_MOUSE_SPEED_DEFAULT);
+    assert(pw_wine_pointer_speed(NULL, 0) == 0);
+}
+
