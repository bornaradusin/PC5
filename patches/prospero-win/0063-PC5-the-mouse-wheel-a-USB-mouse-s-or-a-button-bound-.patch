diff --git a/wine/patches/0942-win32u-ps5-turn-the-mouse-wheel.patch b/wine/patches/0942-win32u-ps5-turn-the-mouse-wheel.patch
new file mode 100644
index 0000000..2c87701
--- /dev/null
+++ b/wine/patches/0942-win32u-ps5-turn-the-mouse-wheel.patch
@@ -0,0 +1,47 @@
+From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
+From: prospero-win <prospero-win@invalid>
+Date: Fri, 30 Oct 2026 12:00:00 +0000
+Subject: [PATCH] win32u: Turn the mouse wheel on PS5.
+
+The title read a USB mouse's wheel but had no way to send it, and a
+controller button couldn't be bound to it: games that scroll or step
+back with the wheel (a visual novel's rollback, a strategy game's zoom)
+didn't. Event 6 is the wheel, x notches away from the player positive,
+sent as MOUSEEVENTF_WHEEL of x times WHEEL_DELTA.
+---
+diff --git a/dlls/win32u/ps5drv.c b/dlls/win32u/ps5drv.c
+--- a/dlls/win32u/ps5drv.c
++++ b/dlls/win32u/ps5drv.c
+@@ -66,9 +66,9 @@ WINE_DEFAULT_DEBUG_CHANNEL(ps5drv);
+ /* the layout of PwWineInput in wine/ps5/pw_wine_sink.h */
+ struct ps5_input
+ {
+-    UINT type;              /* 1 key, 2 mouse move, 3 mouse button, 4 dialog key, 5 character */
++    UINT type;              /* 1 key, 2 mouse move, 3 mouse button, 4 dialog key, 5 character, 6 wheel */
+     UINT code;              /* virtual key, button 0 left 1 right 2 middle, or a UTF-16 unit */
+-    INT  x, y;              /* mouse move: relative motion in desktop pixels */
++    INT  x, y;              /* mouse move: relative motion in desktop pixels; wheel: x notches */
+     UINT down;
+ };
+ 
+@@ -675,6 +675,17 @@ static BOOL ps5_ProcessEvents( DWORD mask )
+         case 3:
+             if (event.code < 3) send_mouse( hwnd, button_flags[event.code][event.down != 0], 0, 0 );
+             break;
++        case 6:
++            /* The wheel: x notches, away from the player positive, as a mouse's
++             * wheel turned (a USB mouse's, or a button bound to it). */
++            if (event.x && event.x >= -120 && event.x <= 120)
++            {
++                INPUT wheel = {.type = INPUT_MOUSE};
++                wheel.mi.mouseData = (DWORD)(event.x * WHEEL_DELTA);
++                wheel.mi.dwFlags = MOUSEEVENTF_WHEEL;
++                NtUserSendHardwareInput( hwnd, 0, &wheel, 0 );
++            }
++            break;
+         }
+     }
+     /* The wake pipe is every GUI thread's queue fd, so a byte sets QS_DRIVER
+-- 
+2.43.0
+
diff --git a/wine/ps5/pw_wine_sink.c b/wine/ps5/pw_wine_sink.c
index de2aa28..ae7a283 100644
--- a/wine/ps5/pw_wine_sink.c
+++ b/wine/ps5/pw_wine_sink.c
@@ -108,6 +108,7 @@ static int valid(const PwWineInput *e)
     case PW_WINE_INPUT_MOUSE_MOVE:return 1;
     case PW_WINE_INPUT_MOUSE_BUTTON:return e->code<=2 && e->down<=1;
     case PW_WINE_INPUT_CHAR:return e->code>0 && e->code<=0xffff && e->down==1;
+    case PW_WINE_INPUT_MOUSE_WHEEL:return e->x!=0 && e->x>=-120 && e->x<=120;
     default:return 0;
     }
 }
diff --git a/wine/ps5/pw_wine_sink.h b/wine/ps5/pw_wine_sink.h
index b53d8bc..c02f491 100644
--- a/wine/ps5/pw_wine_sink.h
+++ b/wine/ps5/pw_wine_sink.h
@@ -31,13 +31,14 @@ typedef int (*PwWinePresentSink)(void *context,const void *bgra,uint32_t width,u
  * CHAR: one UTF-16 unit of text typed on the console's on-screen keyboard,
  * which the driver types as Windows types a character from an input method
  * (Wine patch 0922); a character beyond the BMP is its two surrogates. */
+/* MOUSE_WHEEL: x notches of the wheel, away from the player positive (Wine patch 0942). */
 enum { PW_WINE_INPUT_KEY=1,PW_WINE_INPUT_MOUSE_MOVE,PW_WINE_INPUT_MOUSE_BUTTON,PW_WINE_INPUT_DIALOG_KEY,
-       PW_WINE_INPUT_CHAR,PW_WINE_INPUT_QUEUE=256 };
+       PW_WINE_INPUT_CHAR,PW_WINE_INPUT_MOUSE_WHEEL,PW_WINE_INPUT_QUEUE=256 };
 typedef struct PwWineInput {
     uint32_t type;
     uint32_t code;      /* KEY, DIALOG_KEY: Windows virtual key; MOUSE_BUTTON: 0 left, 1 right, 2 middle;
                            CHAR: a UTF-16 unit */
-    int32_t x,y;        /* MOUSE_MOVE: relative motion in desktop pixels */
+    int32_t x,y;        /* MOUSE_MOVE: relative motion in desktop pixels; MOUSE_WHEEL: x notches */
     uint32_t down;      /* KEY, MOUSE_BUTTON: 1 pressed, 0 released; CHAR: 1 */
 } PwWineInput;
 
