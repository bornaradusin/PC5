index 0000000..23ee1a3
--- /dev/null
+++ b/wine/patches/0973-win32u-ps5-show-a-mode-sized-window-where-it-is.patch
@@ -0,0 +1,58 @@
+From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
+From: bornaradusin <bornaradusin@users.noreply.github.com>
+Date: Mon, 2 Nov 2026 17:55:00 +0000
+Subject: [PATCH] win32u: PS5: show a mode-sized window where it is.
+
+Heroes of Might and Magic IV in 2D only (DirectDraw drawing with GDI) at
+1024x768 on a 1920x1080 desktop drew its picture scaled to 1440x1080 from
+the desktop's top left, while the driver showed the part win32u maps the
+mode to, 240,0 to 1680,1080 (patch 0932): the picture's left side was cut
+off and the right was black, more at 1280x1024. A shown window of that
+part's size (within 2 pixels) at another place on the desktop is now what
+frames show, and where the pointer stops. A window where the mode is, and a
+mode that covers the whole desktop, are shown as before.
+
+diff --git a/dlls/win32u/ps5drv.c b/dlls/win32u/ps5drv.c
+index 5d8b340..339865f 100644
+--- a/dlls/win32u/ps5drv.c
++++ b/dlls/win32u/ps5drv.c
+@@ -160,11 +160,39 @@ static void draw_cursor( UINT32 *out, POINT origin, INT width, INT height )
+ }
+ 
+ /* screen_lock held: the part of the screen a frame shows */
++/* screen_lock held: a shown window the size of the part a display mode covers, but not at it:
++ * where it is, or NULL. DirectDraw drawing with GDI (Heroes of Might and Magic IV in 2D only)
++ * sizes its window to the mode as win32u maps it, from the desktop's top left, while win32u maps
++ * the mode about the desktop's centre: frames showed the centred part, the picture's left side
++ * cut off and black on the right. */
++static const RECT *mode_window(void)
++{
++    INT width = content.right - content.left, height = content.bottom - content.top;
++    UINT i;
++
++    if (width == (INT)screen_width && height == (INT)screen_height) return NULL;
++    for (i = 0; i < window_count; i++)
++    {
++        const RECT *rect = &windows[i].visible;
++
++        if (!windows[i].shown || abs( rect->right - rect->left - width ) > 2 ||
++            abs( rect->bottom - rect->top - height ) > 2)
++            continue;
++        if (rect->left == content.left && rect->top == content.top) return NULL;   /* where the mode is */
++        if (rect->left >= 0 && rect->top >= 0 && rect->right <= (INT)screen_width &&
++            rect->bottom <= (INT)screen_height)
++            return rect;
++    }
++    return NULL;
++}
++
+ static RECT view_rect(void)
+ {
+     RECT box = {0, 0, 0, 0};
++    const RECT *window;
+     UINT i;
+ 
++    if ((window = mode_window())) return *window;
+     if (!view_windows) return content;
+     for (i = 0; i < window_count; i++)
+         if (windows[i].shown) union_rect( &box, &box, &windows[i].visible );
-- 
