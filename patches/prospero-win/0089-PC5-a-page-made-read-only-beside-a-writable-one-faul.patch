new file mode 100644
index 0000000..84bec6e
--- /dev/null
+++ b/tests/test_wine_subpage_protect.py
@@ -0,0 +1,50 @@
+#!/usr/bin/env python3
+# SPDX-License-Identifier: LGPL-2.1-or-later
+"""A read-only or inaccessible Windows page faults on access although its host
+page is larger and its neighbours stay writable, and the neighbours work
+without faults the program sees, in 64-bit and WoW64 processes
+(wine/patches/0974).
+
+Needs the host Wine from tools/build_host_wine.sh (PROSPERO_HOST_WINE, default
+.deps/wine-host/install/usr/bin/wine) and the mingw compilers; without them
+the check is skipped with a message. Each program runs twice: with the PC's
+4 KiB host pages, and with WINE_HOST_PAGE_SIZE=16384, which makes the PC's
+Wine keep 16 KiB host pages as the console's does."""
+from __future__ import annotations
+
+import os
+import shutil
+import subprocess
+import sys
+import tempfile
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[1]
+SOURCE = ROOT / "tests" / "wine_subpage_protect.c"
+COMPILERS = ("x86_64-w64-mingw32-gcc", "i686-w64-mingw32-gcc")
+
+
+def main() -> int:
+    wine = os.environ.get("PROSPERO_HOST_WINE", str(ROOT / ".deps/wine-host/install/usr/bin/wine"))
+    compilers = [shutil.which(name) for name in COMPILERS]
+    if not os.access(wine, os.X_OK) or not all(compilers):
+        print("wine subpage protect skipped: needs the host Wine and the mingw compilers")
+        return 0
+    with tempfile.TemporaryDirectory() as directory:
+        env = dict(os.environ, WINEPREFIX=str(Path(directory) / "pfx"), WINEDEBUG="-all",
+                   WINEDLLOVERRIDES="winemenubuilder.exe=d")
+        for compiler in compilers:
+            exe = Path(directory) / f"subpage-{Path(compiler).name.split('-')[0]}.exe"
+            subprocess.run([compiler, "-O1", "-o", str(exe), str(SOURCE)], check=True)
+            for host_page in ("", "16384"):
+                run_env = dict(env, WINE_HOST_PAGE_SIZE=host_page) if host_page else env
+                done = subprocess.run([wine, str(exe)], capture_output=True, text=True, env=run_env)
+                label = f"{exe.name} host pages {host_page or 'native'}"
+                assert done.returncode == 0, f"{label}: {done.stdout}{done.stderr}"
+                assert "subpage verdict=pass" in done.stdout, f"{label}: {done.stdout}"
+    print("wine subpage protect passed: protected pages fault, their neighbours do not")
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/tests/wine_subpage_protect.c b/tests/wine_subpage_protect.c
new file mode 100644
index 0000000..54cb515
--- /dev/null
+++ b/tests/wine_subpage_protect.c
@@ -0,0 +1,110 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later
+ * A Windows page made read-only or inaccessible faults on access even when
+ * its host page is larger and holds pages that stay writable (the PS5's are
+ * 16 KiB), and those neighbours keep working without faults the program sees.
+ * Emulators that recompile code protect the 4 KiB pages holding it and expect
+ * the fault that tells them the code changed (DuckStation, for one). */
+#include <windows.h>
+#include <stdio.h>
+
+#define PAGE 4096
+#define PAGES 16
+
+static unsigned char *base;
+static volatile LONG faults, fault_page, fault_write;
+
+/* Records the fault and makes the page writable again, as an emulator does
+ * after it drops the code it compiled from that page. */
+static LONG CALLBACK handler(EXCEPTION_POINTERS *info)
+{
+    const EXCEPTION_RECORD *rec = info->ExceptionRecord;
+    unsigned char *addr = (unsigned char *)rec->ExceptionInformation[1];
+    DWORD old;
+
+    if (rec->ExceptionCode != EXCEPTION_ACCESS_VIOLATION || addr < base || addr >= base + PAGES * PAGE)
+        return EXCEPTION_CONTINUE_SEARCH;
+    faults++;
+    fault_page = (LONG)((addr - base) / PAGE);
+    fault_write = rec->ExceptionInformation[0] == 1;
+    VirtualProtect(base + fault_page * PAGE, PAGE, PAGE_READWRITE, &old);
+    return EXCEPTION_CONTINUE_EXECUTION;
+}
+
+static int protect(int page, DWORD prot)
+{
+    DWORD old;
+
+    if (VirtualProtect(base + page * PAGE, PAGE, prot, &old)) return 1;
+    printf("subpage protect %d %#lx failed %lu\n", page, prot, GetLastError());
+    return 0;
+}
+
+/* Writes one byte to each page in turn; returns how many faults the program saw. */
+static LONG write_pages(int first, int count, unsigned char value)
+{
+    LONG before = faults;
+    int page;
+
+    for (page = first; page < first + count; page++) ((volatile unsigned char *)base)[page * PAGE + 123] = value;
+    return faults - before;
+}
+
+static int expect(const char *what, LONG got, LONG want)
+{
+    printf("subpage %s: %ld fault(s), expected %ld\n", what, got, want);
+    return got == want;
+}
+
+int main(void)
+{
+    LARGE_INTEGER freq, start, end;
+    volatile unsigned char sink;
+    LONG got;
+    int i, ok;
+
+    base = VirtualAlloc(NULL, PAGES * PAGE, MEM_COMMIT | MEM_RESERVE, PAGE_READWRITE);
+    ok = base && AddVectoredExceptionHandler(1, handler);
+
+    /* A read-only page inside a host page whose other pages stay writable. */
+    ok = ok && protect(1, PAGE_READONLY);
+    ok = ok && expect("writes beside a read-only page", write_pages(0, 1, 1) + write_pages(2, 2, 2), 0);
+    got = write_pages(1, 1, 3);
+    ok = ok && expect("write to the read-only page", got, 1) && fault_page == 1 && fault_write;
+    ok = ok && base[PAGE + 123] == 3;
+    ok = ok && expect("second write after the handler made it writable", write_pages(1, 1, 4), 0);
+
+    /* Read-only pages on both sides of a host page boundary, writable ones between. */
+    ok = ok && protect(3, PAGE_READONLY) && protect(4, PAGE_READONLY);
+    ok = ok && expect("writes between read-only pages", write_pages(0, 3, 5) + write_pages(5, 3, 6), 0);
+    ok = ok && expect("writes to both read-only pages", write_pages(3, 2, 7), 2);
+
+    /* An inaccessible page faults on a read too. */
+    ok = ok && protect(9, PAGE_NOACCESS);
+    got = faults;
+    sink = base[8 * PAGE] + base[10 * PAGE];
+    ok = ok && expect("reads beside an inaccessible page", faults - got, 0);
+    got = faults;
+    sink = base[9 * PAGE + 7];
+    ok = ok && expect("read of the inaccessible page", faults - got, 1) && fault_page == 9 && !fault_write;
+    (void)sink;
+
+    /* Many writes beside a protected page: the first ones are stepped over unseen;
+     * when they keep coming, Wine reports one write to the protected page itself
+     * (the handler then makes it writable, as an emulator does), and none after. */
+    ok = ok && protect(13, PAGE_READONLY);
+    QueryPerformanceFrequency(&freq);
+    QueryPerformanceCounter(&start);
+    got = faults;
+    for (i = 0; i < 20000; i++) ((volatile unsigned char *)base)[12 * PAGE + (i & 4095)] = (unsigned char)i;
+    QueryPerformanceCounter(&end);
+    got = faults - got;
+    printf("subpage 20000 writes beside a read-only page: %ld fault(s), expected at most 1 on that page\n", got);
+    ok = ok && (got == 0 || (got == 1 && fault_page == 13 && fault_write));
+    printf("subpage neighbour writes: %.2f us each\n",
+           (double)(end.QuadPart - start.QuadPart) * 1e6 / freq.QuadPart / 20000);
+    ok = ok && base[12 * PAGE + 19999 % 4096] == (unsigned char)19999;
+
+    printf("subpage verdict=%s\n", ok ? "pass" : "fail");
+    fflush(stdout);
+    return ok ? 0 : 1;
+}
diff --git a/wine/patches/0974-ntdll-fault-on-protected-pages-that-share-a-host-page.patch b/wine/patches/0974-ntdll-fault-on-protected-pages-that-share-a-host-page.patch
new file mode 100644
index 0000000..9f0cc0d
--- /dev/null
+++ b/wine/patches/0974-ntdll-fault-on-protected-pages-that-share-a-host-page.patch
@@ -0,0 +1,359 @@
+From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
+From: prospero-win <prospero-win@invalid>
+Date: Sun, 25 Oct 2026 16:00:00 +0200
+Subject: [PATCH] ntdll: Fault on protected pages that share a host page with
+ writable ones.
+
+With host pages larger than Windows pages (16 KiB on the PS5), a host
+page's protection was the union of its four pages'. A page made
+read-only or inaccessible next to a writable one stayed writable, so a
+write to it raised nothing. Emulators that recompile code protect the
+4 KiB pages holding it and rely on that fault to drop stale code:
+DuckStation ran Dino Crisis 2's old code after the game loaded new code
+over it, and jumped into garbage.
+
+Outside images, a host page now loses writing (or all access) when one
+of its committed pages lacks it. An access that faults only because of
+such a neighbour is let through: the host page is opened for one
+instruction, single-stepped, and closed again on the trap, with no
+exception for the program. When a host page has had 256 such writes,
+the next one is reported as a write to its read-only page instead: a
+program that protects pages to learn when they change drops that
+protection, and the host page stops faulting (on the PS5 a step costs
+far more than on a PC, and DuckStation took twelve thousand a second
+beside one code page; it switches such a page to checking its code
+instead). The count starts again after a report, so a program that
+keeps the page read-only is not caught in a loop. Images keep the
+union, so code and data sections sharing a host page cost nothing.
+Guard and write-watch pages keep their existing handling.
+
+WINE_HOST_PAGE_SIZE (x86-64 PC builds only) makes the PC's Wine keep
+larger host pages, to run the console's scheme there:
+tests/test_wine_subpage_protect.py uses it.
+---
+  dlls/ntdll/unix/signal_x86_64.c |  13 +++-
+  dlls/ntdll/unix/unix_private.h  |   3 +
+  dlls/ntdll/unix/virtual.c       | 160 ++++++++++++++++++++++++++++++++++++++--
+  server/mapping.c                |   8 ++
+  4 files changed, 174 insertions(+), 10 deletions(-)
+
+diff --git a/dlls/ntdll/unix/signal_x86_64.c b/dlls/ntdll/unix/signal_x86_64.c
+index 69706ec..8592cb4 100644
+--- a/dlls/ntdll/unix/signal_x86_64.c
++++ b/dlls/ntdll/unix/signal_x86_64.c
+@@ -3135,6 +3135,8 @@ static void __attribute__((used)) segv_handler( int signal, siginfo_t *siginfo,
+ #endif
+             )
+         {
++            /* a neighbour's protection only: run the instruction, then close the host page */
++            if (data->subpage_step) EFL_sig(sigcontext) |= 0x100;
+             leave_handler( data, sigcontext );
+             return;
+         }
+@@ -3199,6 +3201,13 @@ static void __attribute__((used)) trap_handler( int signal, siginfo_t *siginfo,
+ 
+     if (handle_syscall_trap( data, sigcontext, siginfo )) return;
+ 
++    if (TRAP_sig(sigcontext) == TRAP_x86_TRCTRAP && virtual_subpage_step_done( data ))
++    {
++        EFL_sig(sigcontext) &= ~0x100;  /* the step virtual_handle_fault asked for */
++        leave_handler( data, sigcontext );
++        return;
++    }
++
+     save_context( data, &context, sigcontext );
+ 
+     switch (TRAP_sig(sigcontext))
+@@ -3644,13 +3653,13 @@ void signal_init_process( TEB *teb )
+ 
+     /* sneak in a syscall dispatcher pointer at a fixed address (7ffe1000) */
+     ptr = (char *)user_shared_data + page_size;
+-    if ((size_t)sysconf( _SC_PAGESIZE ) > page_size)
++    if (virtual_host_page_size() > page_size)
+     {
+         /* With host pages larger than 4 KiB (16 KiB on PS5) this slot shares
+          * a host page with KUSER_SHARED_DATA, which is already mapped as a
+          * read-only view of the USD section (the server sizes that section
+          * to a host page). Store the pointer through that view. */
+-        const size_t host_page = sysconf( _SC_PAGESIZE );
++        const size_t host_page = virtual_host_page_size();
+ 
+         mprotect( user_shared_data, host_page, PROT_READ | PROT_WRITE );
+         *(void **)ptr = __wine_syscall_dispatcher;
+diff --git a/dlls/ntdll/unix/unix_private.h b/dlls/ntdll/unix/unix_private.h
+index a1fcb5b..4108ec1 100644
+--- a/dlls/ntdll/unix/unix_private.h
++++ b/dlls/ntdll/unix/unix_private.h
+@@ -122,6 +122,7 @@ struct thread_data
+     unsigned int ps5_mutex_token; /* occupies the padding before ps5_sleep_asked on x86_64 */
+ #endif
+     LONGLONG     ps5_sleep_asked;   /* microseconds of sleep asked since then */
++    void        *subpage_step;      /* host page to close again after a single step (virtual_handle_fault) */
+     char         debug_info[0x800]; /* debug_info structure */
+     char         signal_stack[];    /* signal stack */
+     /* char kernel_stack[] */
+@@ -332,7 +333,9 @@ extern NTSTATUS virtual_alloc_thread_stack( INITIAL_TEB *stack, ULONG_PTR limit_
+                                             SIZE_T reserve_size, SIZE_T commit_size, BOOL guard_page );
+ extern void virtual_map_user_shared_data(void);
+ extern void virtual_init_user_shared_data(void);
++extern SIZE_T virtual_host_page_size(void);
+ extern NTSTATUS virtual_handle_fault( struct thread_data *data, EXCEPTION_RECORD *rec, void *stack );
++extern BOOL virtual_subpage_step_done( struct thread_data *data );
+ extern unsigned int virtual_locked_server_call( void *req_ptr );
+ extern ssize_t virtual_locked_read( int fd, void *addr, size_t size );
+ extern ssize_t virtual_locked_pread( int fd, void *addr, size_t size, off_t offset );
+diff --git a/dlls/ntdll/unix/virtual.c b/dlls/ntdll/unix/virtual.c
+index 4790798..490531a 100644
+--- a/dlls/ntdll/unix/virtual.c
++++ b/dlls/ntdll/unix/virtual.c
+@@ -401,8 +401,9 @@ static const UINT_PTR page_mask = 0xfff;
+ static const UINT_PTR granularity_mask = 0xffff;
+ 
+ /* PS5 hosts use 16 KiB pages: keep 4 KiB Windows pages over a larger host
+- * page, the same scheme as 16 KiB-page aarch64 hosts. */
+-#if defined(__aarch64__) || defined(__PROSPERO__)
++ * page, the same scheme as 16 KiB-page aarch64 hosts. An x86-64 PC can keep
++ * larger host pages too (WINE_HOST_PAGE_SIZE), to run the console's scheme. */
++#if defined(__aarch64__) || defined(__PROSPERO__) || defined(__x86_64__)
+ static UINT_PTR host_page_size;
+ static UINT_PTR host_page_mask;
+ #else
+@@ -668,6 +669,16 @@ static void mmap_add_reserved_area( void *addr, SIZE_T size )
+     struct list *ptr, *next;
+     void *end, *area_end;
+ 
++#if defined(__x86_64__) && !defined(__PROSPERO__)
++    if (host_page_size > page_size)  /* WINE_HOST_PAGE_SIZE: the preloader's areas are 4 KiB-aligned */
++    {
++        char *start = ROUND_ADDR( (char *)addr + host_page_mask, host_page_mask );
++        char *limit = ROUND_ADDR( (char *)addr + size, host_page_mask );
++        if (limit <= start) return;
++        size = limit - start;
++        addr = start;
++    }
++#endif
+     assert( !((UINT_PTR)addr & host_page_mask) );
+     assert( !(size & host_page_mask) );
+ 
+@@ -1399,6 +1410,17 @@ static BYTE get_page_vprot( const void *addr )
+ }
+ 
+ 
++/***********************************************************************
++ *           virtual_host_page_size
++ *
++ * The host page Wine keeps: the system's, or a larger one (WINE_HOST_PAGE_SIZE).
++ */
++SIZE_T virtual_host_page_size(void)
++{
++    return host_page_size;
++}
++
++
+ /***********************************************************************
+  *           get_host_page_vprot
+  *
+@@ -2293,6 +2315,40 @@ static inline int mprotect_exec( void *base, size_t size, int unix_prot )
+ }
+ 
+ 
++/***********************************************************************
++ *           get_host_page_unix_prot
++ *
++ * The protection to give a host page that holds several pages. It is the union of
++ * theirs, except in memory that is not an image: there a committed page that is
++ * read-only, or inaccessible, takes writing, or all access, away from the whole
++ * host page, so that touching it faults as on Windows. Accesses that only fault
++ * because of such a neighbour are stepped over in virtual_handle_fault.
++ */
++static int get_host_page_unix_prot( const void *addr, const char *start, const char *end, BYTE set, BYTE clear )
++{
++    const char *page = ROUND_ADDR( addr, host_page_mask );
++    struct file_view *view;
++    int prot, page_prot;
++    BYTE vprot;
++    size_t i;
++
++    prot = get_unix_prot( (get_host_page_vprot( addr ) & ~clear) | set );
++    if (host_page_size == page_size || !(prot & (PROT_READ | PROT_WRITE))) return prot;
++    if (!(view = find_view( addr, 0 )) || (view->protect & SEC_IMAGE)) return prot;
++    for (i = 0; i < host_page_size; i += page_size)
++    {
++        vprot = get_page_vprot( page + i );
++        /* set and clear apply to the range being changed, not to its neighbours */
