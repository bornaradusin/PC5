diff --git a/wine/patches/1022-server-ps5-say-what-holds-the-files-when-an-open-runs-out.patch b/wine/patches/1022-server-ps5-say-what-holds-the-files-when-an-open-runs-out.patch
new file mode 100644
index 0000000..30a03f4
--- /dev/null
+++ b/wine/patches/1022-server-ps5-say-what-holds-the-files-when-an-open-runs-out.patch
@@ -0,0 +1,117 @@
+From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
+From: prospero-win <prospero-win@invalid>
+Date: Sun, 8 Nov 2026 19:20:00 +0100
+Subject: [PATCH] server: Say what holds the files when an open runs out of
+ them on PS5.
+
+Patch 0993 parks read-only files to keep a PS5 title under its limit of
+about 249 open files, and parks every live one when open() still fails
+with EMFILE. When even that leaves no slot, every file is held by an fd
+the pool doesn't park, and nothing said which.
+
+That failure now logs the server's descriptors by class: pinned (cached
+by the client), live (parkable), held by a section (a dup of the file's
+descriptor, which keeps the open file even when the file is parked),
+opened for writing, busy (asyncs, a completion port, locks or a poll),
+other, and closed (a handle closed while its locks remain), with the
+parked files, directories, inodes and the two limits. The first four
+failures are logged, then one in 64.
+---
+ server/fd.c | 67 +++++++++++++++++++++++++++++++++++++++++++++++++++++
+ 1 file changed, 67 insertions(+)
+
+diff --git a/server/fd.c b/server/fd.c
+index 8aed7b1..f2e0e84 100644
+--- a/server/fd.c
++++ b/server/fd.c
+@@ -2136,6 +2136,71 @@ static void ps5_trim_live_files( unsigned int limit, struct fd *keep, int force
+     if (!force && ps5_live_count > limit + limit / 2) ps5_trim_live_files( limit + limit / 2, keep, 1 );
+ }
+ 
++/* open() failed with EMFILE, even after parking what could be: say what
++ * holds the server's descriptors, by class, so the reason is in the log.
++ * Each fd is counted once, in the first class that fits; a section's fd is
++ * a dup() of its file's, which keeps the open file alive even when that
++ * file is parked. The first few failures are logged, then one in 64. */
++static void ps5_log_file_slots( const char *name )
++{
++    static unsigned int failures;
++    unsigned int pinned = 0, live = 0, section = 0, writable = 0, busy = 0, other = 0, open_fds = 0;
++    unsigned int parked = 0, inodes = 0, kept = 0, i, j;
++    struct device *device;
++    struct inode *inode;
++    struct fd *fd;
++    int saved = errno;
++
++    failures++;
++    if (failures > 4 && failures % 64) goto done;
++    for (i = 0; i < DEVICE_HASH_SIZE; i++)
++    {
++        if (!device_hash[i].next) continue;
++        LIST_FOR_EACH_ENTRY( device, &device_hash[i], struct device, entry )
++        {
++            for (j = 0; j < INODE_HASH_SIZE; j++)
++            {
++                LIST_FOR_EACH_ENTRY( inode, &device->inode_hash[j], struct inode, entry )
++                {
++                    struct closed_fd *closed;
++                    int held = 0;
++
++                    LIST_FOR_EACH_ENTRY( fd, &inode->open, struct fd, inode_entry )
++                    {
++                        if (fd->ps5_file && fd->ps5_parked) parked++;
++                        if (fd->unix_fd == -1) continue;
++                        held = 1;
++                        open_fds++;
++                        if (fd->ps5_pinned) pinned++;
++                        else if (fd->ps5_live) live++;
++                        else if (fd->user && fd->user->ops->type == &mapping_type) section++;
++                        else if (fd->access & (FILE_WRITE_DATA | FILE_APPEND_DATA)) writable++;
++                        else if (fd->completion || !list_empty( &fd->locks ) || async_queued( &fd->read_q ) ||
++                                 async_queued( &fd->write_q ) || async_queued( &fd->wait_q ) ||
++                                 (fd->poll_index != -1 && pollfd[fd->poll_index].fd != -1))
++                            busy++;
++                        else other++;
++                    }
++                    /* a handle closed while its locks remain keeps its descriptor here */
++                    LIST_FOR_EACH_ENTRY( closed, &inode->closed, struct closed_fd, entry )
++                    {
++                        if (closed->unix_fd == -1) continue;
++                        held = 1;
++                        kept++;
++                    }
++                    inodes += held;
++                }
++            }
++        }
++    }
++    fprintf( stderr, "wineserver: EMFILE #%u opening %s: inodes=%u fds=%u pinned=%u live=%u parked=%u section=%u "
++             "write=%u busy=%u other=%u closed=%u directories=%u (limits: cached=%u live=%u)\n",
++             failures, name, inodes, open_fds, pinned, live, parked, section, writable, busy, other, kept,
++             ps5_directory_fds, ps5_cached_files_limit(), ps5_live_files_limit() );
++done:
++    errno = saved;
++}
++
+ /* open() failed with EMFILE: park every live file that can be, so that a
+  * budget set too high for what else the title holds costs reopens instead
+  * of failing; non-zero when one was parked and the open is worth a retry */
+@@ -2202,6 +2267,7 @@ static int ps5_reopen_file( struct fd *fd )
+     ps5_trim_live_files( ps5_live_files_limit() ? ps5_live_files_limit() - 1 : 0, fd, 0 );
+     if ((unix_fd = open( fd->unix_name, fd->ps5_park_flags )) == -1 && errno == EMFILE && ps5_free_files( fd ))
+         unix_fd = open( fd->unix_name, fd->ps5_park_flags );
++    if (unix_fd == -1 && errno == EMFILE) ps5_log_file_slots( fd->unix_name );
+     if (unix_fd == -1)
+     {
+         static int told;
+@@ -2630,6 +2696,7 @@ struct fd *open_fd( struct fd *root, const char *name, struct unicode_str nt_nam
+ #ifdef PS5_PARK_FILES
+     if (fd->unix_fd == -1 && errno == EMFILE && ps5_free_files( NULL ))
+         fd->unix_fd = open( name, rw_mode | (flags & ~O_TRUNC), *mode );
++    if (fd->unix_fd == -1 && errno == EMFILE) ps5_log_file_slots( name );
+ #endif
+     if (fd->unix_fd == -1)
+     {
+-- 
+2.43.0
+
diff --git a/wine/patches/1023-server-ps5-park-files-bound-to-a-completion-port.patch b/wine/patches/1023-server-ps5-park-files-bound-to-a-completion-port.patch
new file mode 100644
index 0000000..051e05f
--- /dev/null
+++ b/wine/patches/1023-server-ps5-park-files-bound-to-a-completion-port.patch
@@ -0,0 +1,49 @@
+From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
+From: prospero-win <prospero-win@invalid>
+Date: Mon, 9 Nov 2026 22:00:00 +0100
+Subject: [PATCH] server: Park files bound to a completion port on PS5.
+
+Patch 0993 left every file with a completion port live. A game that reads
+its archives with overlapped I/O through one port binds each of them, so
+none could be parked: Euro Truck Simulator 2 opens every archive in its
+mod folder that way at start, and with a few hundred of them the title
+ran out of files (patch 1022's log: live=183 parked=0) and the game
+crashed, or failed to create or load a profile.
+
+The port, its key and the completion flags belong to the fd, which stays;
+parking closes only the unix descriptor. A read through such a handle on a
+regular file is done by the client with a descriptor it asks the server
+for, which opens a parked file again, and then posts its completion
+through the handle. A file with an async queued in the server still keeps
+its descriptor.
+---
+ server/fd.c | 6 +++++-
+ 1 file changed, 5 insertions(+), 1 deletion(-)
+
+diff --git a/server/fd.c b/server/fd.c
+index f2e0e84..2a3bd89 100644
+--- a/server/fd.c
++++ b/server/fd.c
+@@ -2095,6 +2095,10 @@ static unsigned long long ps5_now_ms(void)
+     return (unsigned long long)ts.tv_sec * 1000 + ts.tv_nsec / 1000000;
+ }
+ 
++/* A file bound to a completion port is parked like any other: the port, its
++ * key and flags stay with the fd, and a read through such a handle is done by
++ * the client with a descriptor it asks for, which opens a parked file again.
++ * Only an async queued here needs the descriptor kept, checked below. */
+ static int ps5_park_file( struct fd *fd, int force )
+ {
+     struct stat st;
+@@ -2103,7 +2107,7 @@ static int ps5_park_file( struct fd *fd, int force )
+     if (fd->unix_fd == -1 || !fd->closed || fd->closed->unix_fd != fd->unix_fd ||
+         !list_empty( &fd->inode->locks ) || !list_empty( &fd->locks ) ||
+         async_queued( &fd->read_q ) || async_queued( &fd->write_q ) || async_queued( &fd->wait_q ) ||
+-        fd->completion || ps5_inode_deleting( fd->inode ))
++        ps5_inode_deleting( fd->inode ))
+         return 0;
+     if (!force && fd->ps5_lent_ms && ps5_now_ms() - fd->ps5_lent_ms < PS5_LENT_GRACE_MS) return 0;
+     /* every fd has a poll slot; one that is polled keeps its descriptor */
+-- 
+2.43.0
+
diff --git a/wine/patches/1024-server-ps5-watch-many-directories.patch b/wine/patches/1024-server-ps5-watch-many-directories.patch
new file mode 100644
index 0000000..260001f
--- /dev/null
+++ b/wine/patches/1024-server-ps5-watch-many-directories.patch
@@ -0,0 +1,537 @@
+From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
+From: prospero-win <prospero-win@invalid>
+Date: Wed, 11 Nov 2026 18:00:00 +0100
+Subject: [PATCH] server: Watch many directories on PS5.
+
+A PS5 title can hold about 256 open files, and every watched directory
+kept one. Java's watch service opens each folder it watches for
+overlapped I/O, reads its file information, binds it to a completion port
+and keeps a ReadDirectoryChangesW pending on it. Project Zomboid watches
+the 1704 folders of its media tree that way, and its title ran out of
+files at about the 240th. Patch 0871 parks a directory past the first 64,
+but opens it again for good the first time it is used, and patch 0993
+keeps every fd with an async queued, which a pending change watch is.
+
+- A directory parked past that threshold now shares patch 0993's budget
+  for read-only files: once it is opened again it is live, the client
+  gets its descriptor uncached, and the least recently used is parked
+  again. A directory has no position to restore; the name must still lead
+  to a directory with the same device and inode. With
+  WINE_PS5_PARK_FILES=0 it stays open once used, as before.
+- Patch 0884 lists a watched directory by its name, so the change watches
+  queued on a directory it polls do not keep the descriptor.
+- One timer lists every watch in turn, instead of one timer each: every
+  25 ms it lists the watches that are due, least recently listed first,
+  for at most 1 ms (WINE_PS5_POLL_BUDGET_US), and the others wait for the
+  next tick. A watch is still listed at most every 25 ms, and less often
+  when its listing takes long. On a PC, 1500 watches with a timer each
+  took 31% of a core while nothing changed; under the budget they take
+  about 4%, and a change is reported in about 200 ms.
+- A listing that fails for want of a descriptor or of memory is dropped
+  rather than compared, which reported every entry missing from it as
+  removed.
+- -DPS5_POLL_CHANGES builds the polling on a PC, in place of inotify, so
+  the console's code can be tested there.
+
+tests/test_wine_directory_watch.py watches 1500 folders as Java does and
+checks that a created and a renamed file are reported, and nothing else.
+Under a host Wine and a 512-descriptor limit, the server without this
+patch, built with PS5_PARK_DIRECTORIES and PS5_PARK_FILES, fails it with
+STATUS_TOO_MANY_OPENED_FILES at the 244th folder; with this patch and
+PS5_POLL_CHANGES as well it passes.
+---
+ server/change.c | 195 +++++++++++++++++++++++++++++++++++++-----------
+ server/fd.c     |  49 +++++++++---
+ server/file.h   |   1 +
+ 3 files changed, 191 insertions(+), 54 deletions(-)
+
+diff --git a/server/change.c b/server/change.c
+index fdc2188..aef717f 100644
+--- a/server/change.c
++++ b/server/change.c
+@@ -21,6 +21,16 @@
+ 
+ #include "config.h"
+ 
++/* Changes found by listing watched directories (see poll_tick): always on the
++ * console, which has no inotify; -DPS5_POLL_CHANGES uses them elsewhere too,
++ * in place of inotify, so the console's code can be tested on a PC. */
++#if defined(__PROSPERO__) && !defined(PS5_POLL_CHANGES)
++#define PS5_POLL_CHANGES
++#endif
++#ifdef PS5_POLL_CHANGES
++#undef HAVE_SYS_INOTIFY_H
++#endif
++
+ #include <assert.h>
+ #include <fcntl.h>
+ #include <stdio.h>
+@@ -71,7 +81,7 @@ static void free_inode( struct inode *inode );
+ 
+ static struct fd *inotify_fd;
+ 
+-#ifdef __PROSPERO__
++#ifdef PS5_POLL_CHANGES
+ struct poll_watch;
+ #endif
+ 
+@@ -98,12 +108,12 @@ struct dir
+     struct process *client_process;  /* client process that has a cache for this directory */
+     int             client_entry;    /* entry in client process cache */
+     struct list    kernel_object;    /* list of kernel object pointers */
+-#ifdef __PROSPERO__
++#ifdef PS5_POLL_CHANGES
+     struct poll_watch *poll; /* notifications by polling, where there is no inotify */
+ #endif
+ };
+ 
+-#ifdef __PROSPERO__
++#ifdef PS5_POLL_CHANGES
+ static void poll_watch_free( struct dir *dir );
+ #endif
+ 
+@@ -429,7 +439,7 @@ static void dir_destroy( struct object *obj )
+     if (dir->filter)
+         remove_change( dir );
+ 
+-#ifdef __PROSPERO__
++#ifdef PS5_POLL_CHANGES
+     poll_watch_free( dir );
+ #endif
+ 
+@@ -1118,7 +1128,7 @@ static int init_inotify( void )
+     return 0;
+ }
+ 
+-#ifdef __PROSPERO__
++#ifdef PS5_POLL_CHANGES
+ /* The console has no inotify, no dnotify and no kqueue. A directory that is watched is polled: its entries
+  * (and those below it, when the whole subtree is watched) are listed with their identity, size and times,
+  * the list is compared with the last one, and what differs is reported the way inotify would: a name that
+@@ -1132,6 +1142,16 @@ static int init_inotify( void )
+ #define POLL_MAX_ITEMS      200000
+ #define POLL_MAX_DEPTH      32
+ 
++/* Every watch is listed by one timer, in turn, instead of each by its own: a
++ * tick every POLL_MIN_INTERVAL lists the watches that are due, in the order
++ * they were last listed, until it has spent its budget (WINE_PS5_POLL_BUDGET_US,
++ * 1 ms by default), and those left wait for the next tick. Java's watch service
++ * keeps a watch on each folder it is given, and Project Zomboid gives it the
++ * 1704 folders of its media tree: listed every 25 ms each, they would take
++ * the server's thread. With the budget, many watches are each listed less
++ * often instead, and a change takes longer to be reported. */
++#define POLL_TICK_BUDGET_US 1000
++
+ struct poll_item
+ {
+     char   *path;        /* relative to the watched directory, '/' separated */
+@@ -1145,13 +1165,19 @@ struct poll_item
+ 
+ struct poll_watch
+ {
+-    struct timeout_user *timeout;
+-    struct poll_item    *items;
++    struct list          entry;     /* entry in poll_watches, least recently listed first */
++    struct dir          *dir;       /* the directory watched */
++    struct poll_item    *items;     /* its last listing, sorted by path */
+     unsigned int         count;
+-    timeout_t            interval;
++    unsigned int         listed;    /* has a listing to compare the next one with */
++    timeout_t            interval;  /* time between two listings */
++    timeout_t            due;       /* when it is next to be listed */
+     unsigned int         cookie;
+ };
+ 
++static struct list poll_watches = LIST_INIT( poll_watches );
++static struct timeout_user *poll_timer;
++
+ static void poll_free_items( struct poll_item *items, unsigned int count )
+ {
+     unsigned int i;
+@@ -1189,22 +1215,27 @@ static int poll_add_item( struct poll_item **items, unsigned int *count, unsigne
+     return 1;
+ }
+ 
+-static void poll_scan( const char *base, const char *rel, int subtree, int depth,
+-                       struct poll_item **items, unsigned int *count, unsigned int *size )
++/* -1 when a directory could not be listed for want of a descriptor or of
++ * memory: the listing is then incomplete, and comparing it would report
++ * every entry missing from it as removed */
++static int poll_scan( const char *base, const char *rel, int subtree, int depth,
++                      struct poll_item **items, unsigned int *count, unsigned int *size )
+ {
+     DIR *dp;
+     struct dirent *entry;
+     char *path;
+     size_t len = strlen( base ) + strlen( rel ) + 2;
++    int ret = 0;
+ 
+-    if (!(path = malloc( len + 1 ))) return;
++    if (!(path = malloc( len + 1 ))) return -1;
+     snprintf( path, len + 1, "%s%s%s", base, rel[0] ? "/" : "", rel );
+     if (!(dp = opendir( path )))
+     {
++        ret = errno == EMFILE || errno == ENFILE || errno == ENOMEM ? -1 : 0;
+         free( path );
+-        return;
++        return ret;
+     }
+-    while ((entry = readdir( dp )))
++    while (!ret && (entry = readdir( dp )))
+     {
+         char *child, *full;
+         struct stat st;
+@@ -1212,18 +1243,19 @@ static void poll_scan( const char *base, const char *rel, int subtree, int depth
+ 
+         if (!strcmp( entry->d_name, "." ) || !strcmp( entry->d_name, ".." )) continue;
+         child_len = strlen( rel ) + strlen( entry->d_name ) + 2;
+-        if (!(child = malloc( child_len + 1 ))) break;
++        if (!(child = malloc( child_len + 1 ))) { ret = -1; break; }
+         snprintf( child, child_len + 1, "%s%s%s", rel, rel[0] ? "/" : "", entry->d_name );
+-        if (!(full = malloc( strlen( base ) + child_len + 2 ))) { free( child ); break; }
++        if (!(full = malloc( strlen( base ) + child_len + 2 ))) { free( child ); ret = -1; break; }
+         sprintf( full, "%s/%s", base, child );
+         if (!lstat( full, &st ) && poll_add_item( items, count, size, child, &st ) &&
+             subtree && S_ISDIR(st.st_mode) && depth < POLL_MAX_DEPTH)
+-            poll_scan( base, child, subtree, depth + 1, items, count, size );
++            ret = poll_scan( base, child, subtree, depth + 1, items, count, size );
+         free( full );
+         free( child );
+     }
+     closedir( dp );
+     free( path );
++    return ret;
+ }
+ 
+ static int poll_compare( const void *a, const void *b )
+@@ -1318,38 +1350,104 @@ done:
+     free( new_added );
+ }
+ 
+-static void poll_timeout( void *private );
++/* the directory's entries, sorted by path; -1 when they could not all be listed */
++static int poll_list( struct dir *dir, struct poll_item **items, unsigned int *count )
++{
++    const char *base = get_fd_unix_name( dir->fd );
++    unsigned int size = 0;
++
++    *items = NULL;
++    *count = 0;
++    if (!base || poll_scan( base, "", dir->subtree, 0, items, count, &size ) == -1)
++    {
++        poll_free_items( *items, *count );
++        *items = NULL;
++        *count = 0;
++        return -1;
++    }
++    if (*items) qsort( *items, *count, sizeof(**items), poll_compare );
++    return 0;
++}
+ 
+-static void poll_arm( struct dir *dir )
++static long long poll_elapsed_us( const struct timespec *since )
+ {
+-    dir->poll->timeout = add_timeout_user( current_time + dir->poll->interval, poll_timeout, dir );
++    struct timespec now;
++
++    clock_gettime( CLOCK_MONOTONIC, &now );
++    return ((long long)(now.tv_sec - since->tv_sec) * 1000000000 + (now.tv_nsec - since->tv_nsec)) / 1000;
+ }
+ 
+-static void poll_timeout( void *private )
++/* list a watch again, report what changed and set when it is next due */
++static void poll_watch_list( struct poll_watch *watch )
+ {
+-    struct dir *dir = private;
+-    struct poll_watch *watch = dir->poll;
+-    struct poll_item *items = NULL;
+-    unsigned int count = 0, size = 0;
+-    struct timespec before, after;
+-    const char *base;
++    struct dir *dir = watch->dir;
++    struct poll_item *items;
++    unsigned int count;
++    struct timespec before;
+     long long took;
+ 
+-    watch->timeout = NULL;
+-    if (!(base = get_fd_unix_name( dir->fd ))) return;
+     clock_gettime( CLOCK_MONOTONIC, &before );
+-    poll_scan( base, "", dir->subtree, 0, &items, &count, &size );
+-    clock_gettime( CLOCK_MONOTONIC, &after );
+-    if (items) qsort( items, count, sizeof(*items), poll_compare );
+-    poll_compare_lists( dir, watch->items, watch->count, items, count );
+-    poll_free_items( watch->items, watch->count );
+-    watch->items = items;
+-    watch->count = count;
++    if (!poll_list( dir, &items, &count ))
++    {
++        if (watch->listed) poll_compare_lists( dir, watch->items, watch->count, items, count );
++        poll_free_items( watch->items, watch->count );
++        watch->items = items;
++        watch->count = count;
++        watch->listed = 1;
++    }
+     /* a listing that takes long is made less often: eight times as long between two */
+-    took = ((long long)(after.tv_sec - before.tv_sec) * 1000000000 + (after.tv_nsec - before.tv_nsec)) / 100;
++    took = poll_elapsed_us( &before ) * 10;
+     watch->interval = took * 8 < POLL_MIN_INTERVAL ? POLL_MIN_INTERVAL
+                       : took * 8 > POLL_MAX_INTERVAL ? POLL_MAX_INTERVAL : took * 8;
+-    poll_arm( dir );
++    watch->due = current_time + watch->interval;
++}
++
++static long long poll_budget_us(void)
++{
++    static long long budget = -1;
++
++    if (budget == -1)
++    {
++        const char *value = getenv( "WINE_PS5_POLL_BUDGET_US" );
++        budget = value && *value ? atoll( value ) : POLL_TICK_BUDGET_US;
++        if (budget < 0) budget = POLL_TICK_BUDGET_US;
++    }
++    return budget;
++}
++
++static void poll_tick( void *private )
++{
++    unsigned int turns = list_count( &poll_watches ), listed = 0;
++    struct timespec start;
++
++    poll_timer = NULL;
++    clock_gettime( CLOCK_MONOTONIC, &start );
++    /* a directory released below may take its watch off the list */
