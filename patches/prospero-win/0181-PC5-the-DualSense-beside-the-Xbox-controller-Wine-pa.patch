diff --git a/wine/patches/1048-xinput1-3-dinput-ps5-the-dualsense-beside-the-xbox-controller.patch b/wine/patches/1048-xinput1-3-dinput-ps5-the-dualsense-beside-the-xbox-controller.patch
new file mode 100644
