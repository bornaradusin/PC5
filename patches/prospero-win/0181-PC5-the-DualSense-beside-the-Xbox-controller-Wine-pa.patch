+From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
+From: prospero-win <prospero-win@invalid>
+Date: Fri, 27 Nov 2026 13:00:00 +0000
+Subject: [PATCH] xinput1_3, dinput: PS5: the DualSense beside the Xbox
+ controller.
+
+With PW_DUALSENSE=2 the title's controller is the game's Xbox controller
+through XInput and, at the same time, the USB DualSense xinput1_3 makes
+(patch 0475), for a game that plays with XInput while a mod of it drives
+the DualSense over HID (GTA IV's adaptive-trigger mods, PC5 #739). The mod
+finds the DualSense through SetupAPI and HID as in dualsense mode. So that
+a game reading DirectInput or raw input doesn't find two controllers, the
+DualSense sends no raw input in this mode and DirectInput leaves it out;
+the Xbox controller stays there (patch 0927). ntdll loads xinput1_3 at the
+start for 2 as it does for 1 (patch 0476).
+---
+ dlls/dinput/joystick_hid.c |  9 +++++++++
+ dlls/ntdll/loader.c        |  5 +++--
+ dlls/xinput1_3/dualsense.c | 12 +++++++++++-
+ 3 files changed, 23 insertions(+), 3 deletions(-)
+
+diff --git a/dlls/dinput/joystick_hid.c b/dlls/dinput/joystick_hid.c
+index cb1c66b..c42d595 100644
+--- a/dlls/dinput/joystick_hid.c
++++ b/dlls/dinput/joystick_hid.c
+@@ -1716,6 +1716,15 @@ static HRESULT hid_joystick_device_try_open( WCHAR *path, HANDLE *device, PHIDP_
+ 
+     if (!HidD_GetPreparsedData( device_file, &preparsed_data )) goto failed;
+     if (!HidD_GetAttributes( device_file, attrs )) goto failed;
++    /* PW_DUALSENSE=2 (a PS5 title): the DualSense xinput1_3 makes is there for a mod's HID, beside
++     * the Xbox controller the game has through XInput and here (title_pad.c), so DirectInput leaves
++     * it out: one controller, not two. */
++    if (attrs->VendorID == 0x054c && attrs->ProductID == 0x0ce6)
++    {
++        WCHAR value[4];
++        if (GetEnvironmentVariableW( L"PW_DUALSENSE", value, ARRAY_SIZE(value) ) == 1 && value[0] == '2')
++            goto failed;
++    }
+     if (HidP_GetCaps( preparsed_data, caps ) != HIDP_STATUS_SUCCESS) goto failed;
+ 
+     switch (MAKELONG( caps->Usage, caps->UsagePage ))
+diff --git a/dlls/ntdll/loader.c b/dlls/ntdll/loader.c
+index 55d9376..87faf3a 100644
+--- a/dlls/ntdll/loader.c
++++ b/dlls/ntdll/loader.c
+@@ -4443,7 +4443,8 @@ static void init_wow64( CONTEXT *context )
+ #endif
+ 
+ 
+-/* dualsense mode (PW_DUALSENSE=1, which a PS5 title sets): xinput1_3 makes
++/* dualsense mode (PW_DUALSENSE=1, which a PS5 title sets, or 2 for the DualSense beside the
++ * Xbox controller): xinput1_3 makes
+  * the title's controller a DualSense (its dualsense.c), which must be there
+  * before the game looks for controllers. It comes from the system
+  * directory: a game's own xinput1_3.dll has no DualSense. */
+@@ -4463,7 +4464,7 @@ static void load_dualsense(void)
+      * an Xbox 360 controller's HID collection, which Unity's raw input lists before it loads
+      * any xinput, so it is made here as well. */
+     if ((RtlQueryEnvironmentVariable( NULL, variable, wcslen( variable ), value, ARRAY_SIZE(value), &len ) ||
+-         len != 1 || value[0] != '1') &&
++         len != 1 || (value[0] != '1' && value[0] != '2')) &&
+         (RtlQueryEnvironmentVariable( NULL, pad, wcslen( pad ), value, ARRAY_SIZE(value), &len ) ||
+          len != 1 || value[0] != '2'))
+         return;
+diff --git a/dlls/xinput1_3/dualsense.c b/dlls/xinput1_3/dualsense.c
+index d02ed69..0207ffb 100644
+--- a/dlls/xinput1_3/dualsense.c
++++ b/dlls/xinput1_3/dualsense.c
+@@ -161,6 +161,11 @@ static const BYTE xbox360_report_desc[] =
+ 
+ /* The profile's names, made at the start. */
+ static const struct ds_profile *profile;
++/* PW_DUALSENSE=2: the DualSense beside the Xbox controller XInput has, for a game that plays with
++ * XInput while a mod of it drives the DualSense over HID (GTA IV's adaptive-trigger mods, #739).
++ * The mod finds it through SetupAPI and HID as before; it sends no raw input, and DirectInput
++ * leaves it out (dinput's joystick_hid.c), so a game reading those has one controller, not two. */
++static BOOL beside_xinput;
+ static WCHAR ds_instance[96], ds_link[160], ds_enum_key[160], ds_class_key[288];
+ 
+ enum
+@@ -417,6 +422,7 @@ static void send_report(void)
+         else queue_push( file, ds.report );
+     }
+ 
++    if (beside_xinput) return;
+     input.hi.uMsg = WM_INPUT;
+     input.hi.wParamH = HIWORD(RIM_INPUT);
+     input.hi.wParamL = LOWORD(RIM_INPUT);
+@@ -861,8 +867,12 @@ void dualsense_start(void)
+     NTSTATUS status;
+     HANDLE thread;
+ 
+-    if (GetEnvironmentVariableW( L"PW_DUALSENSE", value, ARRAY_SIZE(value) ) == 1 && value[0] == '1')
++    if (GetEnvironmentVariableW( L"PW_DUALSENSE", value, ARRAY_SIZE(value) ) == 1 &&
++        (value[0] == '1' || value[0] == '2'))
++    {
+         profile = &dualsense_profile;
++        beside_xinput = value[0] == '2';
++    }
+     else if (GetEnvironmentVariableW( L"PW_RAWINPUT_PAD", value, ARRAY_SIZE(value) ) == 1 && value[0] == '2')
+         profile = &xbox360_profile;
+     else
