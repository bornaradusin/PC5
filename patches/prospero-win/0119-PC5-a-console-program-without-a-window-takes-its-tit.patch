+From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
+From: bornaradusin <bornaradusin@users.noreply.github.com>
+Date: Tue, 3 Nov 2026 08:20:00 +0000
+Subject: [PATCH] kernelbase: A console without a window takes its title.
+
+Streets of Rage 4 (.NET, a console program) sets Console.Title first
+thing. Started without a console window, as the PS5's title starts every
+game, its console handle is CONSOLE_HANDLE_SHELL_NO_WINDOW, and
+SetConsoleTitleW failed with ERROR_INVALID_ACCESS: .NET threw
+System.IO.IOException and the game ended before it started. On Windows the
+program would have had a console window, so setting its title succeeds;
+here there is nowhere to show it, and it succeeds without doing anything.
+
+diff --git a/dlls/kernelbase/console.c b/dlls/kernelbase/console.c
+index 8f9fa58..b2ad149 100644
+--- a/dlls/kernelbase/console.c
++++ b/dlls/kernelbase/console.c
+@@ -1728,6 +1728,12 @@ BOOL WINAPI DECLSPEC_HOTPATCH SetConsoleTitleW( LPCWSTR title )
+ {
+     TRACE( "%s\n", debugstr_w( title ));
+ 
++    /* A console program started without a window (as a title starts a game: Streets of Rage 4)
++     * has nowhere to show its title, where Windows would have opened a console window for it;
++     * failing made .NET's Console.Title throw before the game started. */
++    if (RtlGetCurrentPeb()->ProcessParameters->ConsoleHandle == CONSOLE_HANDLE_SHELL_NO_WINDOW)
++        return TRUE;
++
+     return console_ioctl( RtlGetCurrentPeb()->ProcessParameters->ConsoleHandle, IOCTL_CONDRV_SET_TITLE,
+                           (void *)title, lstrlenW(title) * sizeof(WCHAR), NULL, 0, NULL );
+ }
+-- 
