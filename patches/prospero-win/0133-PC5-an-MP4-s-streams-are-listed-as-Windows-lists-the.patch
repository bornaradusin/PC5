From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: bornaradusin <bornaradusin@users.noreply.github.com>
Date: Fri, 6 Nov 2026 10:30:00 +0000
Subject: [PATCH 133/133] PC5: an MP4's streams are listed as Windows lists them (Wine
 patch 1004)

---
 ...ams-are-listed-as-Windows-lists-them.patch | 186 ++++++++++++++++++
 1 file changed, 186 insertions(+)
 create mode 100644 wine/patches/1004-winegstreamer-ps5-an-MP4-s-streams-are-listed-as-Windows-lists-them.patch

diff --git a/wine/patches/1004-winegstreamer-ps5-an-MP4-s-streams-are-listed-as-Windows-lists-them.patch b/wine/patches/1004-winegstreamer-ps5-an-MP4-s-streams-are-listed-as-Windows-lists-them.patch
new file mode 100644
index 0000000..4e4d52f
--- /dev/null
+++ b/wine/patches/1004-winegstreamer-ps5-an-MP4-s-streams-are-listed-as-Windows-lists-them.patch
@@ -0,0 +1,186 @@
+From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
+From: bornaradusin <bornaradusin@users.noreply.github.com>
+Date: Fri, 6 Nov 2026 10:00:00 +0000
+Subject: [PATCH] winegstreamer: An MPEG-4 file's streams are listed as Windows
+ lists them.
+
+Windows' MPEG-4 source lists a file's audio streams first, then its video,
+then the rest, numbered from 1, as Wine's own mfsrcsnk does
+(media_source_init_stream_map). The GStreamer byte-stream handler, which
+plays MP4 on the console (FFmpeg-backed, patch 0490), listed them in the
+parser's order, video first, numbered from 0. A game written for Windows may
+take the first stream for the sound: Sacred 2 Remaster asked its splash
+video's stream 0 for its sound format (MFCreateWaveFormatExFromMFMediaType),
+got the picture's, and stopped with its own error.
+
+An MPEG-4 file (its first box "ftyp", or QuickTime's "moov", "mdat", "wide"
+or "free", read from the byte stream before the parser starts) now has its
+streams in that order, with identifiers from 1; Start maps an identifier back
+to its stream. Every other file (ASF/WMV, AVI, MPEG, Ogg...) keeps the
+parser's order and identifiers from 0, as before.
+---
+ dlls/winegstreamer/media_source.c | 87 ++++++++++++++++++++++++++++---
+ 1 file changed, 81 insertions(+), 6 deletions(-)
+
+diff --git a/dlls/winegstreamer/media_source.c b/dlls/winegstreamer/media_source.c
+index 4e33d92..d6445d3 100644
+--- a/dlls/winegstreamer/media_source.c
++++ b/dlls/winegstreamer/media_source.c
+@@ -189,6 +189,9 @@ struct media_source
+     IMFStreamDescriptor **descriptors;
+     struct media_stream **streams;
+     ULONG stream_count;
++    /* The first stream's identifier: 1 for an MPEG-4 file, as Windows' MPEG-4 source numbers
++     * them (streams[i]'s is i + id_base), 0 for any other. */
++    UINT32 id_base;
+ 
+     enum
+     {
+@@ -622,10 +625,10 @@ static HRESULT media_source_start(struct media_source *source, IMFPresentationDe
+         {
+             if (FAILED(hr = IMFStreamDescriptor_GetStreamIdentifier(stream_descriptor, &id)))
+                 WARN("Failed to get stream descriptor id, hr %#lx\n", hr);
+-            else if (id >= source->stream_count)
++            else if (id < source->id_base || id - source->id_base >= source->stream_count)
+                 WARN("Invalid stream descriptor id %lu, hr %#lx\n", id, hr);
+             else if (selected)
+-                IMFStreamDescriptor_AddRef((descriptors[id] = stream_descriptor));
++                IMFStreamDescriptor_AddRef((descriptors[id - source->id_base] = stream_descriptor));
+ 
+             IMFStreamDescriptor_Release(stream_descriptor);
+         }
+@@ -1640,12 +1643,77 @@ static void media_source_init_descriptors(struct media_source *source)
+     }
+ }
+ 
++/* An MPEG-4 file (MP4, M4V, MOV, 3GP): its first box, at 4, is "ftyp" (QuickTime files may
++ * start with "moov", "mdat", "wide" or "free"). Read before the parser reads it. */
++static BOOL byte_stream_is_mp4(IMFByteStream *stream)
++{
++    static const char boxes[][4] = { {'f','t','y','p'}, {'m','o','o','v'}, {'m','d','a','t'}, {'w','i','d','e'}, {'f','r','e','e'} };
++    BYTE header[8];
++    QWORD position;
++    ULONG size = 0;
++    unsigned int i;
++    BOOL found = FALSE;
++
++    if (FAILED(IMFByteStream_GetCurrentPosition(stream, &position)))
++        return FALSE;
++    if (SUCCEEDED(IMFByteStream_SetCurrentPosition(stream, 0))
++            && SUCCEEDED(IMFByteStream_Read(stream, header, sizeof(header), &size)) && size == sizeof(header))
++    {
++        for (i = 0; i < ARRAY_SIZE(boxes) && !found; ++i)
++            found = !memcmp(header + 4, boxes[i], 4);
++    }
++    IMFByteStream_SetCurrentPosition(stream, position);
++    return found;
++}
++
++/* 1 for an audio stream, 2 for a video stream, 0 for any other. */
++static int wg_stream_kind(wg_parser_stream_t wg_stream)
++{
++    struct wg_format format;
++
++    wg_parser_stream_get_current_format(wg_stream, &format);
++    if (format.major_type >= WG_MAJOR_TYPE_AUDIO && format.major_type <= WG_MAJOR_TYPE_AUDIO_WMA)
++        return 1;
++    if (format.major_type >= WG_MAJOR_TYPE_VIDEO && format.major_type <= WG_MAJOR_TYPE_VIDEO_MPEG1)
++        return 2;
++    return 0;
++}
++
++/* The parser's streams in the order the source lists them: as they come, or, for an MPEG-4
++ * file, as Windows' MPEG-4 source lists them (and Wine's mfsrcsnk, media_source_init_stream_map):
++ * its audio first, then its video, then the rest, each from the last. A game written for
++ * Windows may take its first stream for the sound (Sacred 2 Remaster: its splash video's
++ * picture, listed first, taken for the sound, and it stopped). */
++static void media_source_init_stream_order(struct media_source *source, BOOL mp4, unsigned int stream_count,
++        unsigned int *order)
++{
++    unsigned int n = 0;
++    int i, kind;
++
++    if (!mp4)
++    {
++        for (n = 0; n < stream_count; ++n)
++            order[n] = n;
++        return;
++    }
++    for (kind = 1; kind <= 2; ++kind)
++        for (i = (int)stream_count - 1; i >= 0; --i)
++            if (wg_stream_kind(wg_parser_get_stream(source->wg_parser, i)) == kind)
++                order[n++] = i;
++    for (i = (int)stream_count - 1; i >= 0; --i)
++        if (!wg_stream_kind(wg_parser_get_stream(source->wg_parser, i)))
++            order[n++] = i;
++    for (n = 0; n < stream_count; ++n)
++        TRACE("source %p stream %u is the parser's stream %u\n", source, n, order[n]);
++}
++
+ static HRESULT media_source_create(struct object_context *context, IMFMediaSource **out)
+ {
+-    unsigned int stream_count = UINT_MAX;
++    unsigned int stream_count = UINT_MAX, *order = NULL;
+     struct media_source *object;
+     wg_parser_t parser;
+     unsigned int i;
++    BOOL mp4;
+     HRESULT hr;
+ 
+     if (!(object = calloc(1, sizeof(*object))))
+@@ -1677,6 +1745,9 @@ static HRESULT media_source_create(struct object_context *context, IMFMediaSourc
+     }
+     object->wg_parser = parser;
+ 
++    mp4 = byte_stream_is_mp4(context->stream);
++    object->id_base = mp4 ? 1 : 0;
++
+     object->read_thread = CreateThread(NULL, 0, read_thread, object, 0, NULL);
+ 
+     object->state = SOURCE_OPENING;
+@@ -1687,21 +1758,23 @@ static HRESULT media_source_create(struct object_context *context, IMFMediaSourc
+     stream_count = wg_parser_get_stream_count(parser);
+ 
+     if (!(object->descriptors = calloc(stream_count, sizeof(*object->descriptors)))
+-            || !(object->streams = calloc(stream_count, sizeof(*object->streams))))
++            || !(object->streams = calloc(stream_count, sizeof(*object->streams)))
++            || !(order = calloc(stream_count, sizeof(*order))))
+     {
+         hr = E_OUTOFMEMORY;
+         goto fail;
+     }
++    media_source_init_stream_order(object, mp4, stream_count, order);
+ 
+     for (i = 0; i < stream_count; ++i)
+     {
+-        wg_parser_stream_t wg_stream = wg_parser_get_stream(object->wg_parser, i);
++        wg_parser_stream_t wg_stream = wg_parser_get_stream(object->wg_parser, order[i]);
+         IMFStreamDescriptor *descriptor;
+         struct media_stream *stream;
+         struct wg_format format;
+ 
+         wg_parser_stream_get_current_format(wg_stream, &format);
+-        if (FAILED(hr = stream_descriptor_create(i, &format, &descriptor)))
++        if (FAILED(hr = stream_descriptor_create(i + object->id_base, &format, &descriptor)))
+             goto fail;
+         if (FAILED(hr = media_stream_create(&object->IMFMediaSource_iface, descriptor, wg_stream, &stream)))
+         {
+@@ -1716,6 +1789,7 @@ static HRESULT media_source_create(struct object_context *context, IMFMediaSourc
+         object->stream_count++;
+     }
+ 
++    free(order);
+     media_source_init_descriptors(object);
+     object->state = SOURCE_STOPPED;
+ 
+@@ -1734,6 +1808,7 @@ fail:
+     }
+     free(object->descriptors);
+     free(object->streams);
++    free(order);
+ 
+     if (stream_count != UINT_MAX)
+         wg_parser_disconnect(object->wg_parser);
+-- 
+2.43.0
+
-- 
2.43.0

