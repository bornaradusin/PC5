      if (raw_dx || raw_dy) send_motion( hwnd, dx, dy, raw_dx, raw_dy );
      if (!server_cursor_pos( &pos )) return;
      pthread_mutex_lock( &screen_lock );
@@ -98,7 +101,7 @@ index 602b922..cc5a6c9 100644
      if (cursor.x != pos.x || cursor.y != pos.y)
      {
          cursor = pos;
-@@ -692,7 +733,18 @@ static BOOL ps5_ProcessEvents( DWORD mask )
+@@ -692,7 +734,18 @@ static BOOL ps5_ProcessEvents( DWORD mask )
              move_cursor( hwnd, event.x, event.y );
              break;
          case 3:
@@ -118,7 +121,7 @@ index 602b922..cc5a6c9 100644
              break;
          case 6:
              /* The wheel: x notches, away from the player positive, as a mouse's
-@@ -873,7 +925,7 @@ void ps5drv_vulkan_cursor( void *vulkan_handle )
+@@ -873,7 +926,7 @@ void ps5drv_vulkan_cursor( void *vulkan_handle )
      }
      if (!show) return;
      pthread_mutex_lock( &screen_lock );
@@ -127,6 +130,15 @@ index 602b922..cc5a6c9 100644
            cursor.x - cursor_hotspot.x, cursor.y - cursor_hotspot.y, screen_width, screen_height );
      pthread_mutex_unlock( &screen_lock );
  }
+@@ -888,6 +941,8 @@ static BOOL ps5_GetCursorPos( POINT *pos )
+ static BOOL ps5_SetCursorPos( INT x, INT y )
+ {
+     pthread_mutex_lock( &screen_lock );
++    /* a game that moves its pointer itself, by the controller (Grim Dawn), is using it too */
++    if (cursor.x != x || cursor.y != y) cursor_use();
+     cursor.x = x;
+     cursor.y = y;
+     if (cursor_image) present_screen();
