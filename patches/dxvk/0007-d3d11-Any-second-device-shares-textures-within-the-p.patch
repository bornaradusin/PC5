From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: bornaradusin <bornaradusin@users.noreply.github.com>
Date: Sat, 21 Nov 2026 22:40:00 +0000
Subject: [PATCH] d3d11: Any second device shares textures within the process,
 and ReleaseSync orders them

Patch 0006 runs a video device (D3D11_CREATE_DEVICE_VIDEO_SUPPORT) on
the DxvkDevice of a D3D11 device that lives, so its shared textures can
be opened there without external memory (Unity's movies). Unreal
Engine's Media Foundation player makes its decoding device without that
flag: its pictures were listed within the process on a DxvkDevice of
their own, the main device's OpenSharedResource found no image of its
own under the handle ("Handle not found", once a frame), and the
tutorial videos and cinematics showed green (The Thaumaturge, Burning
Sword: Death Sun, with -dx11).

- Any D3D11 device made while another lives now runs on that device's
  DxvkDevice where external memory is missing (d3d11.shareDevice =
  False turns this off for a device that isn't a video device).
- Without keyed mutexes, ReleaseSync on a texture waits until what this
  device did to it is finished, so the device that acquires it next
  reads the whole picture, as the keyed mutex orders them. AcquireSync
  still succeeds at once.
---
 src/d3d11/d3d11_main.cpp     | 21 +++++++++++++--------
 src/d3d11/d3d11_resource.cpp | 17 +++++++++++++++--
 2 files changed, 28 insertions(+), 10 deletions(-)

diff --git a/src/d3d11/d3d11_main.cpp b/src/d3d11/d3d11_main.cpp
index 02c15d0..8a6a635 100644
--- a/src/d3d11/d3d11_main.cpp
+++ b/src/d3d11/d3d11_main.cpp
@@ -91,19 +91,24 @@ extern "C" {
     try {
       Logger::info(str::format("D3D11InternalCreateDevice: Using feature level ", devFeatureLevel));
 
-      // Without VK_KHR_external_memory_win32, a video device (D3D11_CREATE_DEVICE_VIDEO_SUPPORT)
-      // made while another D3D11 device lives runs on that device's DxvkDevice, so the
-      // textures it shares are shared within the process (util_local_share.h): Unity decodes
-      // its movies on a device of their own and hands each picture to its main device
-      // through a shared texture. D3D11 devices on an adapter all enable the same features.
+      // Without VK_KHR_external_memory_win32, a D3D11 device made while another D3D11 device
+      // lives runs on that device's DxvkDevice, so the textures they share are shared within
+      // the process (util_local_share.h): Unity decodes its movies on a video device of their
+      // own (D3D11_CREATE_DEVICE_VIDEO_SUPPORT), Unreal Engine's Media Foundation player on a
+      // device made without that flag, and each hands every picture to the main device
+      // through a shared texture, which another DxvkDevice can't open (green tutorial videos).
+      // D3D11 devices on an adapter all enable the same features. d3d11.shareVideoDevice =
+      // False keeps a video device on a DxvkDevice of its own, d3d11.shareDevice = False any
+      // other device.
       Rc<DxvkDevice> dxvkDevice;
+      const bool video = (Flags & D3D11_CREATE_DEVICE_VIDEO_SUPPORT) != 0;
 
-      if ((Flags & D3D11_CREATE_DEVICE_VIDEO_SUPPORT) && !dxvkAdapter->features().khrExternalMemoryWin32
-       && dxvkInstance->config().getOption<bool>("d3d11.shareVideoDevice", true)) {
+      if (!dxvkAdapter->features().khrExternalMemoryWin32
+       && dxvkInstance->config().getOption<bool>(video ? "d3d11.shareVideoDevice" : "d3d11.shareDevice", true)) {
         dxvkDevice = local_share::findDevice(dxvkAdapter->devicePropertiesExt().vk11.deviceUUID);
 
         if (dxvkDevice != nullptr)
-          Logger::info("D3D11: A video device shares a Direct3D 11 device's Vulkan device, for textures shared within the process");
+          Logger::info(str::format("D3D11: A ", video ? "video " : "", "device shares a Direct3D 11 device's Vulkan device, for textures shared within the process"));
       }
 
       if (dxvkDevice == nullptr) {
diff --git a/src/d3d11/d3d11_resource.cpp b/src/d3d11/d3d11_resource.cpp
index 27836bd..9ce1cdd 100644
--- a/src/d3d11/d3d11_resource.cpp
+++ b/src/d3d11/d3d11_resource.cpp
@@ -87,7 +87,7 @@ namespace dxvk {
     if (!m_supported) {
       if (!m_warned) {
         m_warned = true;
-        Logger::err("D3D11DXGIKeyedMutex::AcquireSync: Not supported");
+        Logger::warn("D3D11DXGIKeyedMutex::AcquireSync: No keyed mutexes; ReleaseSync waits for the texture's use instead");
       }
       return S_OK;
     }
@@ -107,8 +107,21 @@ namespace dxvk {
 
   HRESULT STDMETHODCALLTYPE D3D11DXGIKeyedMutex::ReleaseSync(
           UINT64                  Key) {
-    if (!m_supported)
+    if (!m_supported) {
+      // Without keyed mutexes, a texture shared within the process (util_local_share.h) is
+      // used by D3D11 devices on one DxvkDevice: what this device did to it is finished
+      // before the device that acquires it next uses it, as the keyed mutex would order
+      // them (Unreal Engine's video player writes each picture on a device of its own).
+      D3D11CommonTexture* texture = GetCommonTexture(m_resource);
+
+      if (texture) {
+        D3D11ImmediateContext* context = m_device->GetContext();
+        D3D10DeviceLock lock = context->LockContext();
+        context->WaitForResource(*texture->GetImage(), DxvkCsThread::SynchronizeAll, D3D11_MAP_READ_WRITE, 0);
+      }
+
       return S_OK;
+    }
 
     D3D11CommonTexture* texture = GetCommonTexture(m_resource);
     Rc<DxvkDevice> dxvkDevice = m_device->GetDXVKDevice();
-- 
2.43.0

