#, c-format
msgid "PC5's Windows template is missing %s."
msgstr "Templat Windows PC5 tidak memiliki %s."

#: title/pc5_library.c:2461
#, c-format
msgid "PC5 can't copy %s: %s."
msgstr "PC5 tidak bisa menyalin %s: %s."

