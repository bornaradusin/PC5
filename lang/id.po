#: title/pc5_web_page.html:139 title/pc5_web_page.html:165
msgctxt "web"
msgid "Save"
msgstr "Simpan"

#. Web page text.
#: title/pc5_web_page.html:142 title/pc5_web_page.html:168
msgctxt "web"
msgid "Saving…"
msgstr "Menyimpan…"

#. Web page text.
#: title/pc5_web_page.html:146
msgctxt "web"
msgid ""
"Saved: its cover, background and details are fetched again when PC5 opens."
msgstr ""
"Tersimpan: sampul, latar belakang, dan detailnya diambil lagi saat PC5 "
"dibuka."

#. Web page text.
#: title/pc5_web_page.html:147
msgctxt "web"
msgid "Cleared: PC5 reads the game's folder again."
msgstr "Dikosongkan: PC5 membaca folder game lagi."

#. Web page text.
#. %s and %d are filled in by the page; %1$s, %2$s put them in another order.
#: title/pc5_web_page.html:149 title/pc5_web_page.html:174
#, c-format
msgctxt "web"
msgid "Not saved: %s"
msgstr "Tidak tersimpan: %s"

#. Web page text.
#. %s and %d are filled in by the page; %1$s, %2$s put them in another order.
#: title/pc5_web_page.html:152
#, c-format
msgctxt "web"
msgid "; GOG product %s"
msgstr "; produk GOG %s"

#. Web page text.
#. %s and %d are filled in by the page; %1$s, %2$s put them in another order.
#: title/pc5_web_page.html:153
#, c-format
msgctxt "web"
msgid ""
"PC5 picks the game's cover, background and details by this number (%s%s). "
"If they are another game's, type the number from the game's Steam store "
"link (store.steampowered.com/app/<number>). Empty: PC5 reads the folder "
"again."
msgstr ""
"PC5 memilih sampul, latar belakang, dan detail game berdasarkan nomor ini "
"(%s%s). Jika ternyata milik game lain, ketik nomor dari tautan toko Steam "
"game itu (store.steampowered.com/app/<nomor>). Kosong: PC5 membaca folder "
"lagi."

#. Web page text.
#: title/pc5_web_page.html:172
msgctxt "web"
msgid "Saved: used at the game's next start."
msgstr "Tersimpan: dipakai saat game dijalankan berikutnya."

#. Web page text.
#: title/pc5_web_page.html:187
msgctxt "web"
msgid "No games yet."
msgstr "Belum ada game."

#. Web page text.
#: title/pc5_web_page.html:190
msgctxt "web"
msgid "USB drive"
msgstr "Drive USB"

#. Web page text.
#: title/pc5_web_page.html:191
msgctxt "web"
msgid "can't start"
msgstr "tidak bisa dimulai"

#. Web page text.
#. %s and %d are filled in by the page; %1$s, %2$s put them in another order.
#: title/pc5_web_page.html:196
#, c-format
msgctxt "web"
msgid "Settings: %s"
msgstr "Pengaturan: %s"

#. Web page text.
#: title/pc5_web_page.html:199
msgctxt "web"
msgid "Newest log"
msgstr "Log terbaru"

#. Web page text.
#: title/pc5_web_page.html:201
msgctxt "web"
msgid "Report a problem"
msgstr "Laporkan masalah"

#. Web page text.
#: title/pc5_web_page.html:202
msgctxt "web"
msgid ""
"Downloads the newest log and opens GitHub's form, filled in: attach the "
"log there."
msgstr ""
"Mengunduh log terbaru dan membuka formulir GitHub yang sudah terisi: "
"lampirkan log-nya di sana."

#. Web page text.
#: title/pc5_web_page.html:208
msgctxt "web"
msgid "Launch options (launch.txt)"
msgstr "Opsi peluncuran (launch.txt)"

#. Web page text.
#: title/pc5_web_page.html:209
msgctxt "web"
msgid ""
"The first line that isn't empty or a comment (# or ;) is added to the "
"program's command line."
msgstr ""
"Baris pertama yang tidak kosong dan bukan komentar (# atau ;) ditambahkan "
"ke baris perintah program."

#. Web page text.
#: title/pc5_web_page.html:212
msgctxt "web"
msgid "Environment variables (env.txt)"
msgstr "Variabel lingkungan (env.txt)"

#. Web page text.
#: title/pc5_web_page.html:212
msgctxt "web"
msgid "One NAME=value a line, set before the game starts."
msgstr "Satu NAMA=nilai per baris, diatur sebelum game dimulai."

#. Web page text.
#: title/pc5_web_page.html:213
msgctxt "web"
msgid "Extra logging (winedebug.txt)"
msgstr "Log tambahan (winedebug.txt)"

#. Web page text.
#: title/pc5_web_page.html:214
msgctxt "web"
msgid ""
"Only when an issue asks for it, for example err+all,+seh. Empty it "
"afterwards: it slows the game down."
msgstr ""
"Hanya jika diminta di issue, misalnya err+all,+seh. Kosongkan lagi "
"setelahnya: ini memperlambat game."

#. Web page text.
#. %s and %d are filled in by the page; %1$s, %2$s put them in another order.
#: title/pc5_web_page.html:219
#, c-format
msgctxt "web"
msgid "The games didn't load: %s"
msgstr "Game tidak termuat: %s"

#. Web page text.
#: title/pc5_web_page.html:232
msgctxt "web"
msgid "No logs kept."
msgstr "Tidak ada log yang disimpan."

#. Web page text.
#: title/pc5_web_page.html:236
msgctxt "web"
msgid "had a problem"
msgstr "mengalami masalah"

#. Web page text.
#. %s and %d are filled in by the page; %1$s, %2$s put them in another order.
#: title/pc5_web_page.html:239
#, c-format
msgctxt "web"
msgid "The logs didn't load: %s"
msgstr "Log tidak termuat: %s"

#. Web page text.
#: title/pc5_web_page.html:248
msgctxt "web"
msgid "the connection was lost"
msgstr "koneksi terputus"

#. Web page text.
#. %s and %d are filled in by the page; %1$s, %2$s put them in another order.
#: title/pc5_web_page.html:265
#, c-format
msgctxt "web"
msgid "Sending %d of %d: %s"
msgstr "Mengirim %d dari %d: %s"

#. Web page text.
#. %s and %d are filled in by the page; %1$s, %2$s put them in another order.
#: title/pc5_web_page.html:269
#, c-format
msgctxt "web"
msgid "Stopped at %s: %s"
msgstr "Berhenti di %s: %s"

#. Web page text.
#. %s and %d are filled in by the page; %1$s, %2$s put them in another order.
#: title/pc5_web_page.html:276
#, c-format
msgctxt "web"
msgid "Sent %d files (%s). PC5 asks to install the game in a moment."
msgstr ""
"%d file terkirim (%s). Sebentar lagi PC5 akan menawarkan untuk menginstal "
"game."

#. Web page text.
#: title/pc5_web_page.html:285
msgctxt "web"
msgid "Type the game's folder name first (no / or \\)."
msgstr "Ketik dulu nama folder game (tanpa / atau \\)."
