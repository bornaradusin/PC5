#, c-format
msgctxt "web"
msgid "Not saved: %s"
msgstr "Δεν αποθηκεύτηκε: %s"

#. Web page text.
#. %s and %d are filled in by the page; %1$s, %2$s put them in another order.
#: title/pc5_web_page.html:156
#, c-format
