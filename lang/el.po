#: title/pc5_library.c:2658
msgid "Out of memory."
msgstr "Η μνήμη εξαντλήθηκε."

#: title/pc5_library.c:2335
msgid "A path in the Windows template is too long."
msgstr "Μια διαδρομή στο πρότυπο Windows είναι πολύ μεγάλη."

