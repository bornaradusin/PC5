msgstr "Έλεγχος τώρα"

#: title/pc5_ui.c:2647
#, c-format
msgid ""
"PC5 %s is out: copy it over this one from github.com/bornaradusin/PC5"
msgstr ""
"Κυκλοφόρησε το PC5 %s: αντιγράψτε το πάνω σε αυτό από το "
"github.com/bornaradusin/PC5"

#. A menu row's name (about 30 characters fit).
#: title/pc5_ui.c:2653
msgid "Startup sound"
msgstr "Ήχος εκκίνησης"

#: title/pc5_ui.c:2654
msgid "On the controller's speaker when PC5 opens"
msgstr "Στο ηχείο του χειριστηρίου όταν ανοίγει το PC5"

#. A menu row's name (about 30 characters fit).
#: title/pc5_ui.c:2658
msgid "Startup sound volume"
msgstr "Ένταση ήχου εκκίνησης"

#: title/pc5_ui.c:2659
msgid "How loud the startup sound plays"
msgstr "Πόσο δυνατά παίζει ο ήχος εκκίνησης"

#. A menu row's name (about 30 characters fit).
#: title/pc5_ui.c:2665
msgid "Language"
msgstr "Γλώσσα"

#: title/pc5_ui.c:2667
