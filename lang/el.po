msgid "There is no other program in its folder to start."
msgstr "Δεν υπάρχει άλλο πρόγραμμα στον φάκελό του για εκκίνηση."

#: title/pc5_ui.c:4928
#, c-format
msgid "%s wasn't uninstalled"
msgstr "Το %s δεν απεγκαταστάθηκε"

