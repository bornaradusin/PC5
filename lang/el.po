msgstr "Μια διαδρομή στον φάκελο είναι πολύ μεγάλη."

#: title/pc5_source.c:320
#, c-format
msgid "PC5 can't read %.200s."
msgstr "Το PC5 δεν μπορεί να διαβάσει το %.200s."

#: title/pc5_source.c:334
#, c-format
msgid "Windows can't use the name \"%.180s\"."
msgstr "Τα Windows δεν μπορούν να χρησιμοποιήσουν το όνομα «%.180s»."

