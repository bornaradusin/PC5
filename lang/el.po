#: title/pc5_ui.c:5781 title/pc5_ui_enhancements_input.h:56
msgid "The keyboard didn't open"
msgstr "Το πληκτρολόγιο δεν άνοιξε"

#: title/pc5_ui.c:4463 title/pc5_ui.c:4564 title/pc5_ui.c:5196
#: title/pc5_ui.c:5781 title/pc5_ui_enhancements_input.h:56
msgid "The console's on-screen keyboard can't be used just now."
msgstr ""
"Το πληκτρολόγιο οθόνης της κονσόλας δεν μπορεί να χρησιμοποιηθεί αυτή τη "
"στιγμή."

#: title/pc5_ui.c:4503
msgid "PC5 can't open it as text"
msgstr "Το PC5 δεν μπορεί να το ανοίξει ως κείμενο"

