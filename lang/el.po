msgid "Password (empty: none)"
msgstr "Κωδικός πρόσβασης (κενό: κανένας)"

#: title/pc5_ui.c:4940
msgid "Appearance wasn't changed"
msgstr "Η εμφάνιση δεν άλλαξε"

