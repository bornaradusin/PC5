msgid "Top left"
msgstr "Πάνω αριστερά"

#: title/pc5_settings.c:13
msgid "Top right"
msgstr "Πάνω δεξιά"

#: title/pc5_settings.c:13
msgid "Bottom left"
msgstr "Κάτω αριστερά"

#: title/pc5_settings.c:13
msgid "Bottom right"
msgstr "Κάτω δεξιά"

#: title/pc5_settings.c:15
msgid "Game's colour"
msgstr "Χρώμα παιχνιδιού"

#: title/pc5_settings.c:15
