msgstr ""
"Οι οθόνες και η ιστοσελίδα του PC5· η Προεπιλογή ακολουθεί την κονσόλα"

#: title/pc5_ui.c:2670
#, c-format
msgid "As the console: %s"
msgstr "Όπως η κονσόλα: %s"

#. the Language setting's value when PC5 follows the console's language.
