msgid "Game's colour"
msgstr "Χρώμα παιχνιδιού"

#: title/pc5_settings.c:15
msgid "Follows the screen"
msgstr "Ακολουθεί την οθόνη"

#: title/pc5_settings.c:15
msgid "Console's colour"
msgstr "Χρώμα κονσόλας"

