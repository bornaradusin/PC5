msgid "No logs kept."
msgstr "Δεν κρατήθηκαν αρχεία καταγραφής."

#. Web page text.
#: title/pc5_web_page.html:349
msgctxt "web"
msgid "had a problem"
msgstr "είχε πρόβλημα"

