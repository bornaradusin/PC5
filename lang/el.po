msgstr "Το %s δεν μπορεί να ξεκινήσει"

#: title/pc5_ui.c:4868
#, c-format
msgid ""
"%s You can uninstall it from its menu (Triangle) and install it again."
msgstr ""
"%s Μπορείτε να το απεγκαταστήσετε από το μενού του (Τρίγωνο) και να το "
"εγκαταστήσετε ξανά."

#: title/pc5_ui.c:4869 title/pc5_ui.c:5429
msgid "Something it needs is missing."
msgstr "Λείπει κάτι που χρειάζεται."

