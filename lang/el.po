msgstr "Έχετε την %s: το PC5 κατεβάζει ολόκληρη την εφαρμογή (%s)"

#: title/pc5_ui.c:1548 title/pc5_ui.c:4653
msgid "PC5 didn't install this game"
msgstr "Το PC5 δεν εγκατέστησε αυτό το παιχνίδι"

#: title/pc5_ui.c:1549
msgid ""
"Its cover can only be changed as in Covers on the wiki: a picture of your "
"own."
msgstr ""
"Το εξώφυλλό του αλλάζει μόνο όπως στη σελίδα Covers του wiki: με δική σας "
"εικόνα."

#: title/pc5_ui.c:1550
