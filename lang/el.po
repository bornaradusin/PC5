#, c-format
msgid "PC5's Windows template is missing %s."
msgstr "Από το πρότυπο Windows του PC5 λείπει το %s."

#: title/pc5_library.c:2364
#, c-format
msgid "PC5 can't copy %s: %s."
msgstr "Το PC5 δεν μπορεί να αντιγράψει το %s: %s."

#: title/pc5_library.c:2389
#, c-format
msgid "PC5 can't read %s on the USB drive: %s."
msgstr "Το PC5 δεν μπορεί να διαβάσει το %s στη μονάδα USB: %s."

#: title/pc5_library.c:2430 title/pc5_library.c:2854
#, c-format
msgid "PC5 can't read back %s: %s."
msgstr "Το PC5 δεν μπορεί να ξαναδιαβάσει το %s: %s."

#: title/pc5_library.c:2430
#, c-format
msgid "The USB drive stopped answering while PC5 copied %s (%s)."
msgstr ""
"Η μονάδα USB σταμάτησε να αποκρίνεται ενώ το PC5 αντέγραφε το %s (%s)."

#: title/pc5_library.c:2458 title/pc5_library.c:2470
#, c-format
msgid ""
"The game couldn't be put back in the INSTALL folder: it is in %.180s."
msgstr ""
"Το παιχνίδι δεν μπόρεσε να επιστρέψει στον φάκελο INSTALL: βρίσκεται στο "
"%.180s."

#: title/pc5_library.c:2509
#, c-format
msgid "PC5 can't save the cover: %s."
msgstr "Το PC5 δεν μπορεί να αποθηκεύσει το εξώφυλλο: %s."

#: title/pc5_library.c:2516
#, c-format
msgid "PC5 can't put the game in place: %s."
msgstr "Το PC5 δεν μπορεί να τοποθετήσει το παιχνίδι: %s."

#: title/pc5_library.c:2623
msgid "PC5 didn't install this game, so it can't update it."
msgstr ""
"Το PC5 δεν εγκατέστησε αυτό το παιχνίδι, οπότε δεν μπορεί να το ενημερώσει."

#: title/pc5_library.c:2625
#, c-format
msgid ""
"%s plays from its USB drive: copy the newer version over its folder %s "
"there."
msgstr ""
"Το %s παίζει από τη μονάδα USB του: αντιγράψτε τη νεότερη έκδοση πάνω στον "
"φάκελό του %s εκεί."

#: title/pc5_library.c:2630
msgid "The game's folder is missing: uninstall it and install it again."
msgstr ""
"Ο φάκελος του παιχνιδιού λείπει: απεγκαταστήστε το και εγκαταστήστε το "
"ξανά."

#: title/pc5_library.c:2633
#, c-format
msgid ""
"This folder doesn't have %s, the program %s starts. Choose the folder of a "
"newer copy of %s."
msgstr ""
"Αυτός ο φάκελος δεν έχει το %s, το πρόγραμμα που ξεκινά το %s. Επιλέξτε "
"τον φάκελο ενός νεότερου αντιγράφου του %s."

#: title/pc5_library.c:2647
#, c-format
msgid "Not enough space: the update needs %s and the console has %s free."
msgstr ""
"Δεν υπάρχει αρκετός χώρος: η ενημέρωση χρειάζεται %s και η κονσόλα έχει %s "
"ελεύθερα."

#: title/pc5_library.c:2653
msgid ""
"An earlier update of this game isn't finished: close PC5 and open it again "
"to finish it."
msgstr ""
"Μια παλιότερη ενημέρωση αυτού του παιχνιδιού δεν ολοκληρώθηκε: κλείστε το "
"PC5 και ανοίξτε το ξανά για να ολοκληρωθεί."

#: title/pc5_library.c:2655
#, c-format
msgid "PC5 can't start the update: %s."
msgstr "Το PC5 δεν μπορεί να ξεκινήσει την ενημέρωση: %s."

#: title/pc5_library.c:2684
msgid ""
"Kept saves can't be put back for a game that plays from its USB drive."
msgstr ""
"Οι αποθηκεύσεις που κρατήθηκαν δεν μπορούν να επιστρέψουν σε παιχνίδι που "
"παίζει από τη μονάδα USB του."

#: title/pc5_library.c:2688
msgid "The install has begun already."
msgstr "Η εγκατάσταση έχει ήδη ξεκινήσει."

#: title/pc5_library.c:2704
msgid "PC5 can't read the kept saves."
msgstr "Το PC5 δεν μπορεί να διαβάσει τις αποθηκεύσεις που κρατήθηκαν."

#: title/pc5_library.c:2704
msgid "The kept saves are damaged: they have no registry."
msgstr ""
"Οι αποθηκεύσεις που κρατήθηκαν είναι κατεστραμμένες: δεν έχουν μητρώο."

#: title/pc5_library.c:2781
#, c-format
msgid "PC5 can't make the game's folder on the USB drive: %s."
msgstr ""
"Το PC5 δεν μπορεί να δημιουργήσει τον φάκελο του παιχνιδιού στη μονάδα "
"USB: %s."

#: title/pc5_library.c:2854
#, c-format
msgid "PC5 can't open %s on the USB drive: %s."
msgstr "Το PC5 δεν μπορεί να ανοίξει το %s στη μονάδα USB: %s."

#: title/pc5_library.c:2892
#, c-format
msgid ""
"The copy of %s doesn't match the USB drive. The drive or its cable may be "
"failing; nothing was kept."
msgstr ""
"Το αντίγραφο του %s δεν ταιριάζει με τη μονάδα USB. Η μονάδα ή το καλώδιό "
"της μπορεί να χαλάει· δεν κρατήθηκε τίποτα."

