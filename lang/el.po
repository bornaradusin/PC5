#: title/pc5_files.c:100
msgid "The name is empty."
msgstr "Το όνομα είναι κενό."

#: title/pc5_files.c:101
#, c-format
msgid "\"%s\" can't be a name."
msgstr "Το «%s» δεν μπορεί να είναι όνομα."

#: title/pc5_files.c:102
msgid "The name is too long: 255 bytes at most."
msgstr "Το όνομα είναι πολύ μεγάλο: έως 255 byte."

#: title/pc5_files.c:105
#, c-format
msgid "A name can't have %s in it."
msgstr "Ένα όνομα δεν μπορεί να περιέχει %s."

#: title/pc5_files.c:108
msgid "A name can't end in a space or a dot."
msgstr "Ένα όνομα δεν μπορεί να τελειώνει σε κενό ή τελεία."

#: title/pc5_files.c:240
#, c-format
msgid "%s has folders too deep to copy."
msgstr "Το %s έχει φακέλους πολύ βαθιά για αντιγραφή."

#: title/pc5_files.c:241 title/pc5_files.c:251 title/pc5_files.c:381
#: title/pc5_files.c:398
#, c-format
msgid "PC5 can't read %s: %s."
msgstr "Το PC5 δεν μπορεί να διαβάσει το %s: %s."

#: title/pc5_files.c:256
#, c-format
msgid "A path in %s is too long."
msgstr "Μια διαδρομή στο %s είναι πολύ μεγάλη."

#: title/pc5_files.c:267
msgid "PC5 ran out of memory planning the copy."
msgstr "Το PC5 έμεινε χωρίς μνήμη κατά τον σχεδιασμό της αντιγραφής."

#: title/pc5_files.c:281
msgid "Nothing is chosen."
msgstr "Δεν έχει επιλεγεί τίποτα."

#: title/pc5_files.c:284 title/pc5_files.c:289 title/pc5_tile.c:631
#: title/pc5_upgrade.c:637
msgid "PC5 ran out of memory."
msgstr "Το PC5 έμεινε χωρίς μνήμη."

#: title/pc5_files.c:288
msgid "The folder to paste into isn't there any more."
msgstr "Ο φάκελος επικόλλησης δεν υπάρχει πια."

#: title/pc5_files.c:296
#, c-format
msgid "%s isn't there any more."
msgstr "Το %s δεν υπάρχει πια."

#: title/pc5_files.c:300
#, c-format
msgid "%s can't go into itself or a folder inside it."
msgstr "Το %s δεν μπορεί να μπει στον εαυτό του ή σε φάκελο μέσα του."

#: title/pc5_files.c:304
#, c-format
msgid "The path of %s would be too long."
msgstr "Η διαδρομή του %s θα ήταν πολύ μεγάλη."

#: title/pc5_files.c:319
#, c-format
msgid "PC5 can't find a free name for %s."
msgstr "Το PC5 δεν βρίσκει ελεύθερο όνομα για το %s."

#: title/pc5_files.c:351
#, c-format
msgid "There isn't room: it needs %s and the drive has %s free."
msgstr "Δεν υπάρχει χώρος: χρειάζονται %s και η μονάδα έχει %s ελεύθερα."

#: title/pc5_files.c:357
msgid "PC5 ran out of memory planning the work."
msgstr "Το PC5 έμεινε χωρίς μνήμη κατά τον σχεδιασμό της εργασίας."

#: title/pc5_files.c:385 title/pc5_files.c:406 title/pc5_files.c:419
#: title/pc5_library.c:2446 title/pc5_library.c:2535 title/pc5_library.c:2959
#: title/pc5_library.c:2974 title/pc5_library.c:2980
#, c-format
msgid "PC5 can't write %s: %s."
msgstr "Το PC5 δεν μπορεί να γράψει το %s: %s."

#: title/pc5_files.c:391
#, c-format
msgid "PC5 ran out of memory copying %s."
msgstr "Το PC5 έμεινε χωρίς μνήμη κατά την αντιγραφή του %s."

#: title/pc5_files.c:427 title/pc5_library.c:1860
#, c-format
msgid "PC5 can't put %s in place: %s."
msgstr "Το PC5 δεν μπορεί να τοποθετήσει το %s: %s."

#: title/pc5_files.c:453
#, c-format
msgid "PC5 can't make the folder %s: %s."
msgstr "Το PC5 δεν μπορεί να δημιουργήσει τον φάκελο %s: %s."

#: title/pc5_files.c:459
#, c-format
msgid "PC5 can't move %s: %s."
msgstr "Το PC5 δεν μπορεί να μετακινήσει το %s: %s."

#: title/pc5_files.c:464
#, c-format
msgid "PC5 ran out of memory deleting %s."
msgstr "Το PC5 έμεινε χωρίς μνήμη κατά τη διαγραφή του %s."

#: title/pc5_ftp.c:626 title/pc5_web.c:1061
msgid "There's no network here."
msgstr "Δεν υπάρχει δίκτυο εδώ."

#: title/pc5_ftp.c:628 title/pc5_ui.c:2654
msgid "PC5's INSTALL folder isn't there."
msgstr "Ο φάκελος INSTALL του PC5 δεν υπάρχει."

#: title/pc5_ftp.c:633 title/pc5_web.c:1067
#, c-format
msgid "Port %u is taken, or there's no network."
msgstr "Η θύρα %u είναι κατειλημμένη ή δεν υπάρχει δίκτυο."

#: title/pc5_ftp.c:647 title/pc5_web.c:1081
msgid "PC5 can't start it."
msgstr "Το PC5 δεν μπορεί να το ξεκινήσει."

#: title/pc5_game.c:544
msgid "The app's path is too long."
msgstr "Η διαδρομή της εφαρμογής είναι πολύ μεγάλη."

#: title/pc5_game.c:550
msgid "PC5 can't read the app's .NET runtime."
msgstr ""
"Το PC5 δεν μπορεί να διαβάσει το περιβάλλον εκτέλεσης .NET της εφαρμογής."

#: title/pc5_game.c:575
msgid "A path of the .NET runtime is too long."
msgstr "Μια διαδρομή του περιβάλλοντος εκτέλεσης .NET είναι πολύ μεγάλη."

#: title/pc5_game.c:580
msgid "PC5 can't make the .NET runtime's folders: is the console full?"
msgstr ""
"Το PC5 δεν μπορεί να δημιουργήσει τους φακέλους του περιβάλλοντος "
"εκτέλεσης .NET: μήπως η κονσόλα είναι γεμάτη;"

#: title/pc5_game.c:591
#, c-format
msgid ""
"The app's .NET runtime has no %.80s. Copy the PPSA11018 folder to the "
"console again."
msgstr ""
"Από το περιβάλλον εκτέλεσης .NET της εφαρμογής λείπει το %.80s. Αντιγράψτε "
"ξανά τον φάκελο PPSA11018 στην κονσόλα."

#: title/pc5_game.c:597
msgid "PC5 can't copy the .NET runtime: is the console full?"
msgstr ""
"Το PC5 δεν μπορεί να αντιγράψει το περιβάλλον εκτέλεσης .NET: μήπως η "
"κονσόλα είναι γεμάτη;"

#: title/pc5_game.c:605
msgid "PC5 can't finish the .NET runtime's copy."
msgstr ""
"Το PC5 δεν μπορεί να ολοκληρώσει την αντιγραφή του περιβάλλοντος εκτέλεσης "
".NET."

#: title/pc5_home.c:157
msgid "The tile's program is missing from PC5's app (pc5/forwarder)."
msgstr ""
"Το πρόγραμμα του πλακιδίου λείπει από την εφαρμογή PC5 (pc5/forwarder)."

#: title/pc5_home.c:161
#, c-format
msgid "PC5 can't use %s: %s."
msgstr "Το PC5 δεν μπορεί να χρησιμοποιήσει το %s: %s."

#: title/pc5_home.c:165
msgid "PC5 ran out of memory making the tile's picture."
msgstr ""
"Το PC5 έμεινε χωρίς μνήμη κατά τη δημιουργία της εικόνας του πλακιδίου."

#: title/pc5_home.c:180
#, c-format
msgid "PC5 can't write the tile in %s: %s."
msgstr "Το PC5 δεν μπορεί να γράψει το πλακίδιο στο %s: %s."

#: title/pc5_library.c:169
#, c-format
msgid ""
"Plug in the USB drive with %.100s: it plays from the folder %.200s on it."
msgstr ""
"Συνδέστε τη μονάδα USB με το %.100s: παίζει από τον φάκελο %.200s σε αυτήν."

#: title/pc5_library.c:175 title/pc5_library.c:2855 title/pc5_library.c:2906
#, c-format
msgid "PC5 can't make the game's folder: %s."
msgstr "Το PC5 δεν μπορεί να δημιουργήσει τον φάκελο του παιχνιδιού: %s."

#: title/pc5_library.c:195
#, c-format
msgid "PC5 can't link the game's folder on the USB drive: %s."
msgstr ""
"Το PC5 δεν μπορεί να συνδέσει τον φάκελο του παιχνιδιού στη μονάδα USB: %s."

#: title/pc5_library.c:595 title/pc5_library.c:612
msgid "Choose one of the game's programs."
msgstr "Επιλέξτε ένα από τα προγράμματα του παιχνιδιού."

#: title/pc5_library.c:608 title/pc5_library.c:758 title/pc5_library.c:982
msgid "PC5's notes on this game are missing."
msgstr "Οι σημειώσεις του PC5 για αυτό το παιχνίδι λείπουν."

#: title/pc5_library.c:620
msgid "That program is too deep in the game's folder for Windows."
msgstr ""
"Αυτό το πρόγραμμα είναι πολύ βαθιά στον φάκελο του παιχνιδιού για τα "
"Windows."

#: title/pc5_library.c:625 title/pc5_library.c:1877 title/pc5_library.c:2590
#: title/pc5_library.c:2593 title/pc5_library.c:2602 title/pc5_library.c:2676
#: title/pc5_library.c:2868
#, c-format
msgid "PC5 can't write its notes: %s."
msgstr "Το PC5 δεν μπορεί να γράψει τις σημειώσεις του: %s."

#: title/pc5_library.c:646
msgid "PC5 is out of memory."
msgstr "Το PC5 δεν έχει αρκετή μνήμη."

#: title/pc5_library.c:650
#, c-format
msgid "%.200s doesn't start any of the game's programs."
msgstr "Το %.200s δεν ξεκινά κανένα από τα προγράμματα του παιχνιδιού."

#: title/pc5_library.c:850
msgid "The game's launch options are too long: 511 characters at most."
msgstr ""
"Οι επιλογές εκκίνησης του παιχνιδιού είναι πολύ μεγάλες: έως 511 "
"χαρακτήρες."

#: title/pc5_library.c:867
msgid "The game's path is too long for Windows."
msgstr "Η διαδρομή του παιχνιδιού είναι πολύ μεγάλη για τα Windows."

#: title/pc5_library.c:883 title/pc5_library.c:1061
#, c-format
msgid "PC5 can't write the game's profile: %s."
msgstr "Το PC5 δεν μπορεί να γράψει το προφίλ του παιχνιδιού: %s."

#: title/pc5_library.c:1007
#, c-format
msgid "The program its launcher started isn't one of the game's: %.200s"
msgstr ""
"Το πρόγραμμα που ξεκίνησε ο εκκινητής του δεν ανήκει στο παιχνίδι: %.200s"

#: title/pc5_library.c:1021
msgid "The arguments its launcher gave are too long."
msgstr "Τα ορίσματα που έδωσε ο εκκινητής του είναι πολύ μεγάλα."

#: title/pc5_library.c:1043
#, c-format
msgid "Its programs kept starting each other: %d hand-offs in a row."
msgstr ""
"Τα προγράμματά του ξεκινούσαν συνέχεια το ένα το άλλο: %d μεταβιβάσεις στη "
"σειρά."

#: title/pc5_library.c:1057
msgid "The program's path is too long for Windows."
msgstr "Η διαδρομή του προγράμματος είναι πολύ μεγάλη για τα Windows."

#: title/pc5_library.c:1116
#, c-format
msgid "Its profile has a mistake (%s)."
msgstr "Το προφίλ του έχει λάθος (%s)."

#: title/pc5_library.c:1133
msgid "Its Windows folder is missing."
msgstr "Ο φάκελος Windows του λείπει."

#: title/pc5_library.c:1273
#, c-format
msgid "PC5 can't delete %s: %s."
msgstr "Το PC5 δεν μπορεί να διαγράψει το %s: %s."

#: title/pc5_library.c:1372 title/pc5_library.c:1647 title/pc5_library.c:1702
#, c-format
msgid "PC5 can't move the game's folder: %s."
msgstr "Το PC5 δεν μπορεί να μετακινήσει τον φάκελο του παιχνιδιού: %s."

#: title/pc5_library.c:1381 title/pc5_library.c:1652
#, c-format
msgid "PC5 can't delete the game's profile: %s."
msgstr "Το PC5 δεν μπορεί να διαγράψει το προφίλ του παιχνιδιού: %s."

#: title/pc5_library.c:1395 title/pc5_library.c:1639 title/pc5_library.c:2741
#: title/pc5_library.c:2749
msgid "A path is too long."
msgstr "Μια διαδρομή είναι πολύ μεγάλη."

#: title/pc5_library.c:1598
msgid "PC5 can't read the game's folder."
msgstr "Το PC5 δεν μπορεί να διαβάσει τον φάκελο του παιχνιδιού."

#: title/pc5_library.c:1606 title/pc5_library.c:1857 title/pc5_library.c:2936
#, c-format
msgid "A path in the game is too long: %s."
msgstr "Μια διαδρομή στο παιχνίδι είναι πολύ μεγάλη: %s."

#: title/pc5_library.c:1615
#, c-format
msgid "PC5 can't keep %s: %s."
msgstr "Το PC5 δεν μπορεί να κρατήσει το %s: %s."

#: title/pc5_library.c:1671
#, c-format
msgid "PC5 can't put the saves in place: %s."
msgstr "Το PC5 δεν μπορεί να τοποθετήσει τις αποθηκεύσεις: %s."

#: title/pc5_library.c:1685
msgid "This game's saves can't be kept apart from it."
msgstr ""
"Οι αποθηκεύσεις αυτού του παιχνιδιού δεν μπορούν να κρατηθούν χωριστά από "
"αυτό."

#: title/pc5_library.c:1691
#, c-format
msgid "PC5 can't make its saves folder: %s."
msgstr "Το PC5 δεν μπορεί να δημιουργήσει τον φάκελο αποθηκεύσεων: %s."

#: title/pc5_library.c:1695
msgid "PC5 is still keeping this game's saves from before: start PC5 again."
msgstr ""
"Το PC5 κρατά ακόμα τις παλιότερες αποθηκεύσεις αυτού του παιχνιδιού: "
"ξεκινήστε ξανά το PC5."

#: title/pc5_library.c:1728
#, c-format
msgid "PC5 can't move the saves: %s."
msgstr "Το PC5 δεν μπορεί να μετακινήσει τις αποθηκεύσεις: %s."

#: title/pc5_library.c:1815
#, c-format
msgid "A path in the update is too long: %s."
msgstr "Μια διαδρομή στην ενημέρωση είναι πολύ μεγάλη: %s."

#: title/pc5_library.c:1897
#, c-format
msgid "PC5 can't write the game's list of files: %s."
msgstr "Το PC5 δεν μπορεί να γράψει τη λίστα αρχείων του παιχνιδιού: %s."

#: title/pc5_library.c:2215
msgid ""
"PC5's Windows template is missing from the app: copy the PC5 folder again."
msgstr ""
"Το πρότυπο Windows του PC5 λείπει από την εφαρμογή: αντιγράψτε ξανά τον "
"φάκελο PC5."

#: title/pc5_library.c:2239
msgid "PC5's Windows template is damaged: copy the PC5 folder again."
msgstr ""
"Το πρότυπο Windows του PC5 είναι κατεστραμμένο: αντιγράψτε ξανά τον φάκελο "
"PC5."

#: title/pc5_library.c:2321 title/pc5_library.c:2381
#, c-format
msgid "PC5 can't make its folders in %s: %s."
msgstr "Το PC5 δεν μπορεί να δημιουργήσει τους φακέλους του στο %s: %s."

#: title/pc5_library.c:2332
#, c-format
msgid "PC5 can't make its folder on the USB drive: %s."
msgstr "Το PC5 δεν μπορεί να δημιουργήσει τον φάκελό του στη μονάδα USB: %s."

#: title/pc5_library.c:2335
msgid "PC5 can't name the game's folder on the USB drive."
msgstr ""
"Το PC5 δεν μπορεί να ονομάσει τον φάκελο του παιχνιδιού στη μονάδα USB."

#: title/pc5_library.c:2353
#, c-format
msgid ""
"The drive reads at %.0f MB/s here, too slow to play from (%.0f needed). "
"Plug it into a port on the back or the front USB-C port. Installing to the "
"console still works."
msgstr ""
"Η μονάδα διαβάζει εδώ με %.0f MB/s, πολύ αργά για να παίξετε από αυτήν "
"(χρειάζονται %.0f). Συνδέστε τη σε μια θύρα στο πίσω μέρος ή στη μπροστινή "
"θύρα USB-C. Η εγκατάσταση στην κονσόλα λειτουργεί κανονικά."

#: title/pc5_library.c:2361
#, c-format
msgid ""
"Not enough space on the USB drive: the game needs %s and it has %s free."
msgstr ""
"Δεν υπάρχει αρκετός χώρος στη μονάδα USB: το παιχνίδι χρειάζεται %s και η "
"μονάδα έχει %s ελεύθερα."

#: title/pc5_library.c:2365
msgid ""
"Only a game on a USB drive can play from it: this folder isn't on one."
msgstr ""
"Μόνο ένα παιχνίδι σε μονάδα USB μπορεί να παίξει από αυτήν: αυτός ο "
"φάκελος δεν βρίσκεται σε μονάδα USB."

#: title/pc5_library.c:2367
msgid "A game in PC5's INSTALL folder is installed, not played from there."
msgstr ""
"Ένα παιχνίδι στον φάκελο INSTALL του PC5 εγκαθίσταται, δεν παίζεται από "
"εκεί."

#: title/pc5_library.c:2372
#, c-format
msgid ""
"The drive reads at %.0f MB/s in this USB port, too slow to play from (at "
"least %.0f is needed). On the original PS5 the front USB-A port is the "
"slow one: plug the drive into a port on the back, or the front USB-C port. "
"Install still works from this port."
msgstr ""
"Η μονάδα διαβάζει με %.0f MB/s σε αυτή τη θύρα USB, πολύ αργά για να "
"παίξετε από αυτήν (χρειάζονται τουλάχιστον %.0f). Στο αρχικό PS5 η "
"μπροστινή θύρα USB-A είναι η αργή: συνδέστε τη μονάδα σε μια θύρα στο πίσω "
"μέρος ή στη μπροστινή θύρα USB-C. Η εγκατάσταση από αυτή τη θύρα "
"λειτουργεί κανονικά."

#: title/pc5_library.c:2378
msgid "The game's program is too deep in its folder for Windows."
msgstr ""
"Το πρόγραμμα του παιχνιδιού είναι πολύ βαθιά στον φάκελό του για τα "
"Windows."

#: title/pc5_library.c:2386
#, c-format
msgid "Not enough space: the game needs %s and the console has %s free."
msgstr ""
"Δεν υπάρχει αρκετός χώρος: το παιχνίδι χρειάζεται %s και η κονσόλα έχει %s "
"ελεύθερα."

#: title/pc5_library.c:2389
msgid "PC5 can't name the game."
msgstr "Το PC5 δεν μπορεί να ονομάσει το παιχνίδι."

#: title/pc5_library.c:2392
#, c-format
msgid "PC5 can't start the install: %s."
msgstr "Το PC5 δεν μπορεί να ξεκινήσει την εγκατάσταση: %s."

#: title/pc5_library.c:2399 title/pc5_library.c:2472 title/pc5_library.c:2508
#: title/pc5_library.c:2757
msgid "Out of memory."
msgstr "Η μνήμη εξαντλήθηκε."

#: title/pc5_library.c:2432
msgid "A path in the Windows template is too long."
msgstr "Μια διαδρομή στο πρότυπο Windows είναι πολύ μεγάλη."

#: title/pc5_library.c:2435 title/pc5_library.c:2440 title/pc5_library.c:2943
#: title/pc5_tile.c:519
#, c-format
msgid "PC5 can't make %s: %s."
msgstr "Το PC5 δεν μπορεί να δημιουργήσει το %s: %s."

#: title/pc5_library.c:2443
#, c-format
msgid "PC5's Windows template is missing %s."
msgstr "Από το πρότυπο Windows του PC5 λείπει το %s."

#: title/pc5_library.c:2461
#, c-format
msgid "PC5 can't copy %s: %s."
msgstr "Το PC5 δεν μπορεί να αντιγράψει το %s: %s."

#: title/pc5_library.c:2486
#, c-format
msgid "PC5 can't read %s on the USB drive: %s."
msgstr "Το PC5 δεν μπορεί να διαβάσει το %s στη μονάδα USB: %s."

#: title/pc5_library.c:2527 title/pc5_library.c:2953
#, c-format
msgid "PC5 can't read back %s: %s."
msgstr "Το PC5 δεν μπορεί να ξαναδιαβάσει το %s: %s."

#: title/pc5_library.c:2527
#, c-format
msgid "The USB drive stopped answering while PC5 copied %s (%s)."
msgstr ""
"Η μονάδα USB σταμάτησε να αποκρίνεται ενώ το PC5 αντέγραφε το %s (%s)."

#: title/pc5_library.c:2555 title/pc5_library.c:2567
#, c-format
msgid ""
"The game couldn't be put back in the INSTALL folder: it is in %.180s."
msgstr ""
"Το παιχνίδι δεν μπόρεσε να επιστρέψει στον φάκελο INSTALL: βρίσκεται στο "
"%.180s."

#: title/pc5_library.c:2606
#, c-format
msgid "PC5 can't save the cover: %s."
msgstr "Το PC5 δεν μπορεί να αποθηκεύσει το εξώφυλλο: %s."

#: title/pc5_library.c:2613
#, c-format
msgid "PC5 can't put the game in place: %s."
msgstr "Το PC5 δεν μπορεί να τοποθετήσει το παιχνίδι: %s."

#: title/pc5_library.c:2722
msgid "PC5 didn't install this game, so it can't update it."
msgstr ""
"Το PC5 δεν εγκατέστησε αυτό το παιχνίδι, οπότε δεν μπορεί να το ενημερώσει."

#: title/pc5_library.c:2724
#, c-format
msgid ""
"%s plays from its USB drive: copy the newer version over its folder %s "
"there."
msgstr ""
"Το %s παίζει από τη μονάδα USB του: αντιγράψτε τη νεότερη έκδοση πάνω στον "
"φάκελό του %s εκεί."

#: title/pc5_library.c:2729
msgid "The game's folder is missing: uninstall it and install it again."
msgstr ""
"Ο φάκελος του παιχνιδιού λείπει: απεγκαταστήστε το και εγκαταστήστε το "
"ξανά."

#: title/pc5_library.c:2732
#, c-format
msgid ""
"This folder doesn't have %s, the program %s starts. Choose the folder of a "
"newer copy of %s."
msgstr ""
"Αυτός ο φάκελος δεν έχει το %s, το πρόγραμμα που ξεκινά το %s. Επιλέξτε "
"τον φάκελο ενός νεότερου αντιγράφου του %s."

#: title/pc5_library.c:2746
#, c-format
msgid "Not enough space: the update needs %s and the console has %s free."
msgstr ""
"Δεν υπάρχει αρκετός χώρος: η ενημέρωση χρειάζεται %s και η κονσόλα έχει %s "
"ελεύθερα."

#: title/pc5_library.c:2752
msgid ""
"An earlier update of this game isn't finished: close PC5 and open it again "
"to finish it."
msgstr ""
"Μια παλιότερη ενημέρωση αυτού του παιχνιδιού δεν ολοκληρώθηκε: κλείστε το "
"PC5 και ανοίξτε το ξανά για να ολοκληρωθεί."

#: title/pc5_library.c:2754
#, c-format
msgid "PC5 can't start the update: %s."
msgstr "Το PC5 δεν μπορεί να ξεκινήσει την ενημέρωση: %s."

#: title/pc5_library.c:2783
msgid ""
"Kept saves can't be put back for a game that plays from its USB drive."
msgstr ""
"Οι αποθηκεύσεις που κρατήθηκαν δεν μπορούν να επιστρέψουν σε παιχνίδι που "
"παίζει από τη μονάδα USB του."

#: title/pc5_library.c:2787
msgid "The install has begun already."
msgstr "Η εγκατάσταση έχει ήδη ξεκινήσει."

#: title/pc5_library.c:2803
msgid "PC5 can't read the kept saves."
msgstr "Το PC5 δεν μπορεί να διαβάσει τις αποθηκεύσεις που κρατήθηκαν."

#: title/pc5_library.c:2803
msgid "The kept saves are damaged: they have no registry."
msgstr ""
"Οι αποθηκεύσεις που κρατήθηκαν είναι κατεστραμμένες: δεν έχουν μητρώο."

#: title/pc5_library.c:2880
#, c-format
msgid "PC5 can't make the game's folder on the USB drive: %s."
msgstr ""
"Το PC5 δεν μπορεί να δημιουργήσει τον φάκελο του παιχνιδιού στη μονάδα "
"USB: %s."

#: title/pc5_library.c:2953
#, c-format
msgid "PC5 can't open %s on the USB drive: %s."
msgstr "Το PC5 δεν μπορεί να ανοίξει το %s στη μονάδα USB: %s."

#: title/pc5_library.c:2991
#, c-format
msgid ""
"The copy of %s doesn't match the USB drive. The drive or its cable may be "
"failing; nothing was kept."
msgstr ""
"Το αντίγραφο του %s δεν ταιριάζει με τη μονάδα USB. Η μονάδα ή το καλώδιό "
"της μπορεί να χαλάει· δεν κρατήθηκε τίποτα."

#. over the loading screen's spinning circle while a game starts, shown in capitals where the language has them.
#: title/pc5_matrix.c:58
msgid "Launching game"
msgstr "Εκκίνηση παιχνιδιού"

