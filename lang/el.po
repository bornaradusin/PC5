#, c-format
msgid "%d-bit"
msgstr "%d-bit"

#: title/pc5_ui.c:6669
msgid "Frame gen"
msgstr "Δημ. καρέ"

#: title/pc5_ui.c:6670
#, c-format
msgid "Controller: %s"
msgstr "Χειριστήριο: %s"

#: title/pc5_ui.c:6759
msgid "No games yet."
msgstr "Δεν υπάρχουν ακόμα παιχνίδια."

#: title/pc5_ui.c:6759
msgid "Nothing played yet: games show here once you play them."
msgstr ""
"Δεν έχετε παίξει τίποτα ακόμα: τα παιχνίδια εμφανίζονται εδώ μόλις τα "
"παίξετε."

#: title/pc5_ui.c:6760
msgid "No favourites yet: press Square on a game to add it."
msgstr ""
"Δεν υπάρχουν ακόμα αγαπημένα: πατήστε Τετράγωνο σε ένα παιχνίδι για να το "
"προσθέσετε."

#: title/pc5_ui.c:6761
msgid "No game is played from a USB drive."
msgstr "Κανένα παιχνίδι δεν παίζει από μονάδα USB."

#: title/pc5_ui.c:6761
