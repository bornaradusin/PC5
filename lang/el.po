msgstr "Οι L2 και R2 αντιστέκονται όταν τις πατάτε"

#: title/pc5_ui.c:2625
msgid "L2 and R2 push back, and buzz with the rumble"
msgstr "Οι L2 και R2 αντιστέκονται και βουίζουν με τη δόνηση"

#: title/pc5_ui.c:2626
msgid "Rumble, resistance or both on L2 and R2"
msgstr "Δόνηση, αντίσταση ή και τα δύο στις L2 και R2"

#. A menu row's name (about 30 characters fit).
#: title/pc5_ui.c:2630
msgid "Trigger rumble"
msgstr "Δόνηση σκανδαλών"

#: title/pc5_ui.c:2631
msgid "How strongly L2 and R2 vibrate"
msgstr "Πόσο δυνατά δονούνται οι L2 και R2"

#. A menu row's name (about 30 characters fit).
#: title/pc5_ui.c:2635
msgid "Trigger resistance"
msgstr "Αντίσταση σκανδαλών"

#: title/pc5_ui.c:2636
msgid "How firmly L2 and R2 push back"
msgstr "Πόσο σταθερά αντιστέκονται οι L2 και R2"

#. A menu row's name (about 30 characters fit).
#: title/pc5_ui.c:2640
