msgstr "Γραμμή %d"

#: title/pc5_ui.c:4558
msgid "New line"
msgstr "Νέα γραμμή"

#: title/pc5_ui.c:4672
msgid "Choose a writable folder"
msgstr "Επιλέξτε φάκελο με δικαίωμα εγγραφής"

#: title/pc5_ui.c:4672
msgid ""
"Open a folder on internal storage or a USB drive, then choose Save here."
msgstr ""
"Ανοίξτε έναν φάκελο στον χώρο αποθήκευσης της κονσόλας ή σε μονάδα USB και "
"επιλέξτε «Αποθήκευση εδώ»."

