msgstr "Δεν αντιγράφηκε τίποτα"

#: title/pc5_ui.c:4370
msgid "Nothing was pasted"
msgstr "Δεν επικολλήθηκε τίποτα"

#: title/pc5_ui.c:4370
msgid "Those items are here already, and were left as they were."
msgstr "Αυτά τα στοιχεία υπάρχουν ήδη εδώ και έμειναν όπως ήταν."

