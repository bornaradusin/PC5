msgstr "Esticada para preencher o ecrã: uma imagem 4:3 fica mais larga"

#: title/pc5_ui.c:6724
msgid "The picture's own shape, with bars beside a 4:3 one"
msgstr "A forma original da imagem, com barras ao lado numa 4:3"

