msgid "PC5 didn't install this game, so it can't update it."
msgstr "O PC5 não instalou este jogo, por isso não o consegue atualizar."

#: title/pc5_library.c:2724
#, c-format
msgid ""
"%s plays from its USB drive: copy the newer version over its folder %s "
"there."
msgstr ""
"%s é jogado a partir da sua unidade USB: copia a versão mais recente por "
"cima da pasta %s nessa unidade."

#: title/pc5_library.c:2729
msgid "The game's folder is missing: uninstall it and install it again."
msgstr "Falta a pasta do jogo: desinstala-o e instala-o novamente."

#: title/pc5_library.c:2732
#, c-format
msgid ""
"This folder doesn't have %s, the program %s starts. Choose the folder of a "
"newer copy of %s."
msgstr ""
"Esta pasta não tem %s, o programa que %s inicia. Escolhe a pasta de uma "
"cópia mais recente de %s."

#: title/pc5_library.c:2746
#, c-format
msgid "Not enough space: the update needs %s and the console has %s free."
msgstr ""
"Não há espaço suficiente: a atualização precisa de %s e a consola tem %s "
"livres."

#: title/pc5_library.c:2752
msgid ""
"An earlier update of this game isn't finished: close PC5 and open it again "
"to finish it."
msgstr ""
"Uma atualização anterior deste jogo não terminou: fecha o PC5 e abre-o "
"novamente para a terminar."

#: title/pc5_library.c:2754
#, c-format
msgid "PC5 can't start the update: %s."
msgstr "O PC5 não consegue começar a atualização: %s."

#: title/pc5_library.c:2783
msgid ""
"Kept saves can't be put back for a game that plays from its USB drive."
msgstr ""
"Os dados guardados não podem ser repostos num jogo que é jogado a partir "
"da sua unidade USB."

#: title/pc5_library.c:2787
msgid "The install has begun already."
msgstr "A instalação já começou."

#: title/pc5_library.c:2803
msgid "PC5 can't read the kept saves."
msgstr "O PC5 não consegue ler os dados guardados."

#: title/pc5_library.c:2803
msgid "The kept saves are damaged: they have no registry."
msgstr "Os dados guardados estão danificados: não têm registo do Windows."

#: title/pc5_library.c:2880
#, c-format
msgid "PC5 can't make the game's folder on the USB drive: %s."
msgstr "O PC5 não consegue criar a pasta do jogo na unidade USB: %s."

#: title/pc5_library.c:2953
#, c-format
msgid "PC5 can't open %s on the USB drive: %s."
msgstr "O PC5 não consegue abrir %s na unidade USB: %s."

#: title/pc5_library.c:2991
#, c-format
msgid ""
"The copy of %s doesn't match the USB drive. The drive or its cable may be "
"failing; nothing was kept."
msgstr ""
"A cópia de %s não coincide com a unidade USB. A unidade ou o cabo podem "
"estar a falhar; nada foi guardado."

