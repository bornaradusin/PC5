#, c-format
msgid "PC5 ran out of memory copying %s."
msgstr "O PC5 ficou sem memória ao copiar %s."

#: title/pc5_files.c:427 title/pc5_library.c:1709
#, c-format
msgid "PC5 can't put %s in place: %s."
msgstr "O PC5 não consegue colocar %s no lugar: %s."

#: title/pc5_files.c:453
#, c-format
msgid "PC5 can't make the folder %s: %s."
msgstr "O PC5 não consegue criar a pasta %s: %s."

#: title/pc5_files.c:459
#, c-format
msgid "PC5 can't move %s: %s."
msgstr "O PC5 não consegue mover %s: %s."

#: title/pc5_files.c:464
#, c-format
msgid "PC5 ran out of memory deleting %s."
msgstr "O PC5 ficou sem memória ao eliminar %s."

#: title/pc5_ftp.c:626 title/pc5_web.c:884
msgid "There's no network here."
msgstr "Não há rede."

#: title/pc5_ftp.c:628 title/pc5_ui.c:2466
msgid "PC5's INSTALL folder isn't there."
msgstr "A pasta INSTALL do PC5 não existe."

#: title/pc5_ftp.c:633 title/pc5_web.c:889
#, c-format
msgid "Port %u is taken, or there's no network."
msgstr "A porta %u está ocupada ou não há rede."

#: title/pc5_ftp.c:647 title/pc5_web.c:903
msgid "PC5 can't start it."
msgstr "O PC5 não consegue iniciá-lo."

#: title/pc5_game.c:415
msgid "The app's path is too long."
msgstr "O caminho da aplicação é demasiado longo."

#: title/pc5_game.c:421
msgid "PC5 can't read the app's .NET runtime."
msgstr "O PC5 não consegue ler o ambiente de execução .NET da aplicação."

#: title/pc5_game.c:446
msgid "A path of the .NET runtime is too long."
msgstr "Um caminho do ambiente de execução .NET é demasiado longo."

#: title/pc5_game.c:451
msgid "PC5 can't make the .NET runtime's folders: is the console full?"
msgstr ""
"O PC5 não consegue criar as pastas do ambiente .NET: a consola está cheia?"

#: title/pc5_game.c:462
#, c-format
msgid ""
"The app's .NET runtime has no %.80s. Copy the PPSA11018 folder to the "
"console again."
msgstr ""
"Falta %.80s ao ambiente .NET da aplicação. Copia novamente a pasta "
"PPSA11018 para a consola."

#: title/pc5_game.c:468
msgid "PC5 can't copy the .NET runtime: is the console full?"
msgstr "O PC5 não consegue copiar o ambiente .NET: a consola está cheia?"

#: title/pc5_game.c:476
msgid "PC5 can't finish the .NET runtime's copy."
msgstr "O PC5 não consegue terminar a cópia do ambiente .NET."

#: title/pc5_home.c:157
msgid "The tile's program is missing from PC5's app (pc5/forwarder)."
msgstr "Falta o programa do ícone na aplicação do PC5 (pc5/forwarder)."

#: title/pc5_home.c:161
#, c-format
msgid "PC5 can't use %s: %s."
msgstr "O PC5 não consegue usar %s: %s."

#: title/pc5_home.c:165
msgid "PC5 ran out of memory making the tile's picture."
msgstr "O PC5 ficou sem memória ao criar a imagem do ícone."

#: title/pc5_home.c:180
#, c-format
msgid "PC5 can't write the tile in %s: %s."
msgstr "O PC5 não consegue escrever o ícone em %s: %s."

#: title/pc5_library.c:169
#, c-format
msgid ""
"Plug in the USB drive with %.100s: it plays from the folder %.200s on it."
msgstr ""
"Liga a unidade USB com %.100s: o jogo corre a partir da pasta %.200s."

#: title/pc5_library.c:175 title/pc5_library.c:2702 title/pc5_library.c:2753
#, c-format
msgid "PC5 can't make the game's folder: %s."
msgstr "O PC5 não consegue criar a pasta do jogo: %s."

#: title/pc5_library.c:195
#, c-format
msgid "PC5 can't link the game's folder on the USB drive: %s."
msgstr "O PC5 não consegue ligar a pasta do jogo na unidade USB: %s."

#: title/pc5_library.c:451 title/pc5_library.c:468
msgid "Choose one of the game's programs."
msgstr "Escolhe um dos programas do jogo."

#: title/pc5_library.c:464 title/pc5_library.c:614 title/pc5_library.c:831
msgid "PC5's notes on this game are missing."
msgstr "Faltam as notas do PC5 sobre este jogo."

#: title/pc5_library.c:476
msgid "That program is too deep in the game's folder for Windows."
msgstr "Esse programa está demasiado fundo na pasta do jogo para o Windows."

#: title/pc5_library.c:481 title/pc5_library.c:1726 title/pc5_library.c:2439
#: title/pc5_library.c:2442 title/pc5_library.c:2451 title/pc5_library.c:2523
#: title/pc5_library.c:2715
#, c-format
msgid "PC5 can't write its notes: %s."
msgstr "O PC5 não consegue escrever as suas notas: %s."

#: title/pc5_library.c:502
msgid "PC5 is out of memory."
msgstr "O PC5 ficou sem memória."

#: title/pc5_library.c:506
#, c-format
msgid "%.200s doesn't start any of the game's programs."
msgstr "%.200s não inicia nenhum dos programas do jogo."

#: title/pc5_library.c:706
msgid "The game's launch options are too long: 511 characters at most."
msgstr ""
"As opções de arranque do jogo são demasiado longas: 511 caracteres no "
"máximo."

#: title/pc5_library.c:716
msgid "The game's path is too long for Windows."
msgstr "O caminho do jogo é demasiado longo para o Windows."

#: title/pc5_library.c:732 title/pc5_library.c:910
#, c-format
msgid "PC5 can't write the game's profile: %s."
msgstr "O PC5 não consegue escrever o perfil do jogo: %s."

#: title/pc5_library.c:856
#, c-format
msgid "The program its launcher started isn't one of the game's: %.200s"
msgstr "O programa que o iniciador abriu não é do jogo: %.200s"

#: title/pc5_library.c:870
msgid "The arguments its launcher gave are too long."
msgstr "Os argumentos dados pelo iniciador são demasiado longos."

#: title/pc5_library.c:892
#, c-format
msgid "Its programs kept starting each other: %d hand-offs in a row."
msgstr ""
"Os seus programas iniciaram-se uns aos outros sem parar: %d passagens "
"seguidas."

#: title/pc5_library.c:906
msgid "The program's path is too long for Windows."
msgstr "O caminho do programa é demasiado longo para o Windows."

#: title/pc5_library.c:965
#, c-format
msgid "Its profile has a mistake (%s)."
msgstr "O seu perfil tem um erro (%s)."

#: title/pc5_library.c:982
msgid "Its Windows folder is missing."
msgstr "Falta a sua pasta do Windows."

#: title/pc5_library.c:1122
#, c-format
msgid "PC5 can't delete %s: %s."
msgstr "O PC5 não consegue eliminar %s: %s."

#: title/pc5_library.c:1221 title/pc5_library.c:1496 title/pc5_library.c:1551
#, c-format
msgid "PC5 can't move the game's folder: %s."
msgstr "O PC5 não consegue mover a pasta do jogo: %s."

#: title/pc5_library.c:1230 title/pc5_library.c:1501
#, c-format
msgid "PC5 can't delete the game's profile: %s."
msgstr "O PC5 não consegue eliminar o perfil do jogo: %s."

#: title/pc5_library.c:1244 title/pc5_library.c:1488 title/pc5_library.c:2588
#: title/pc5_library.c:2596
msgid "A path is too long."
msgstr "Um caminho é demasiado longo."

#: title/pc5_library.c:1447
msgid "PC5 can't read the game's folder."
msgstr "O PC5 não consegue ler a pasta do jogo."

#: title/pc5_library.c:1455 title/pc5_library.c:1706 title/pc5_library.c:2783
#, c-format
msgid "A path in the game is too long: %s."
msgstr "Um caminho no jogo é demasiado longo: %s."

#: title/pc5_library.c:1464
#, c-format
msgid "PC5 can't keep %s: %s."
msgstr "O PC5 não consegue guardar %s: %s."

#: title/pc5_library.c:1520
#, c-format
msgid "PC5 can't put the saves in place: %s."
msgstr "O PC5 não consegue colocar os dados guardados no lugar: %s."

#: title/pc5_library.c:1534
msgid "This game's saves can't be kept apart from it."
msgstr "Os dados guardados deste jogo não podem ser guardados à parte."

#: title/pc5_library.c:1540
#, c-format
msgid "PC5 can't make its saves folder: %s."
msgstr "O PC5 não consegue criar a pasta de dados guardados: %s."

#: title/pc5_library.c:1544
msgid "PC5 is still keeping this game's saves from before: start PC5 again."
msgstr ""
"O PC5 ainda está a guardar os dados guardados anteriores deste jogo: "
"inicia o PC5 novamente."

#: title/pc5_library.c:1577
#, c-format
msgid "PC5 can't move the saves: %s."
msgstr "O PC5 não consegue mover os dados guardados: %s."

#: title/pc5_library.c:1664
#, c-format
msgid "A path in the update is too long: %s."
msgstr "Um caminho na atualização é demasiado longo: %s."

#: title/pc5_library.c:1746
#, c-format
msgid "PC5 can't write the game's list of files: %s."
msgstr "O PC5 não consegue escrever a lista de ficheiros do jogo: %s."

#: title/pc5_library.c:2064
msgid ""
"PC5's Windows template is missing from the app: copy the PC5 folder again."
msgstr ""
"Falta o modelo do Windows na aplicação do PC5: copia novamente a pasta PC5."

#: title/pc5_library.c:2088
msgid "PC5's Windows template is damaged: copy the PC5 folder again."
msgstr ""
"O modelo do Windows do PC5 está danificado: copia novamente a pasta PC5."

#: title/pc5_library.c:2170 title/pc5_library.c:2230
#, c-format
msgid "PC5 can't make its folders in %s: %s."
msgstr "O PC5 não consegue criar as suas pastas em %s: %s."

#: title/pc5_library.c:2181
#, c-format
msgid "PC5 can't make its folder on the USB drive: %s."
msgstr "O PC5 não consegue criar a sua pasta na unidade USB: %s."

#: title/pc5_library.c:2184
msgid "PC5 can't name the game's folder on the USB drive."
msgstr "O PC5 não consegue dar nome à pasta do jogo na unidade USB."

#: title/pc5_library.c:2202
#, c-format
msgid ""
"The drive reads at %.0f MB/s here, too slow to play from (%.0f needed). "
"Plug it into a port on the back or the front USB-C port. Installing to the "
"console still works."
msgstr ""
"A unidade lê a %.0f MB/s aqui, demasiado lento para jogar a partir dela "
"(são precisos %.0f). Liga-a a uma porta traseira ou à porta USB-C frontal. "
"Instalar na consola continua a funcionar."

#: title/pc5_library.c:2210
#, c-format
msgid ""
"Not enough space on the USB drive: the game needs %s and it has %s free."
msgstr ""
"Não há espaço suficiente na unidade USB: o jogo precisa de %s e ela tem %s "
"livres."

#: title/pc5_library.c:2214
msgid ""
"Only a game on a USB drive can play from it: this folder isn't on one."
msgstr ""
"Só um jogo numa unidade USB pode ser jogado a partir dela: esta pasta não "
"está numa."

#: title/pc5_library.c:2216
msgid "A game in PC5's INSTALL folder is installed, not played from there."
msgstr ""
"Um jogo na pasta INSTALL do PC5 é instalado, não é jogado a partir dali."

#: title/pc5_library.c:2221
#, c-format
msgid ""
"The drive reads at %.0f MB/s in this USB port, too slow to play from (at "
"least %.0f is needed). On the original PS5 the front USB-A port is the "
"slow one: plug the drive into a port on the back, or the front USB-C port. "
"Install still works from this port."
msgstr ""
"A unidade lê a %.0f MB/s nesta porta USB, demasiado lento para jogar a "
"partir dela (são precisos pelo menos %.0f). Na PS5 original, a porta USB-A "
"frontal é a lenta: liga a unidade a uma porta traseira ou à porta USB-C "
"frontal. Instalar continua a funcionar a partir desta porta."

#: title/pc5_library.c:2227
msgid "The game's program is too deep in its folder for Windows."
msgstr "O programa do jogo está demasiado fundo na sua pasta para o Windows."

#: title/pc5_library.c:2235
#, c-format
msgid "Not enough space: the game needs %s and the console has %s free."
msgstr ""
"Não há espaço suficiente: o jogo precisa de %s e a consola tem %s livres."

#: title/pc5_library.c:2238
msgid "PC5 can't name the game."
msgstr "O PC5 não consegue dar nome ao jogo."

#: title/pc5_library.c:2241
#, c-format
msgid "PC5 can't start the install: %s."
msgstr "O PC5 não consegue começar a instalação: %s."

#: title/pc5_library.c:2248 title/pc5_library.c:2321 title/pc5_library.c:2357
#: title/pc5_library.c:2604
msgid "Out of memory."
msgstr "Sem memória."

#: title/pc5_library.c:2281
msgid "A path in the Windows template is too long."
msgstr "Um caminho no modelo do Windows é demasiado longo."

#: title/pc5_library.c:2284 title/pc5_library.c:2289 title/pc5_library.c:2790
#: title/pc5_tile.c:519
#, c-format
msgid "PC5 can't make %s: %s."
msgstr "O PC5 não consegue criar %s: %s."

#: title/pc5_library.c:2292
#, c-format
msgid "PC5's Windows template is missing %s."
msgstr "Falta %s ao modelo do Windows do PC5."

#: title/pc5_library.c:2310
#, c-format
msgid "PC5 can't copy %s: %s."
msgstr "O PC5 não consegue copiar %s: %s."

#: title/pc5_library.c:2335
#, c-format
msgid "PC5 can't read %s on the USB drive: %s."
msgstr "O PC5 não consegue ler %s na unidade USB: %s."

#: title/pc5_library.c:2376 title/pc5_library.c:2800
#, c-format
msgid "PC5 can't read back %s: %s."
msgstr "O PC5 não consegue reler %s: %s."

#: title/pc5_library.c:2376
#, c-format
msgid "The USB drive stopped answering while PC5 copied %s (%s)."
msgstr "A unidade USB deixou de responder enquanto o PC5 copiava %s (%s)."

#: title/pc5_library.c:2404 title/pc5_library.c:2416
#, c-format
msgid ""
"The game couldn't be put back in the INSTALL folder: it is in %.180s."
msgstr "Não foi possível devolver o jogo à pasta INSTALL: está em %.180s."

#: title/pc5_library.c:2455
#, c-format
msgid "PC5 can't save the cover: %s."
msgstr "O PC5 não consegue guardar a capa: %s."

#: title/pc5_library.c:2462
#, c-format
msgid "PC5 can't put the game in place: %s."
msgstr "O PC5 não consegue colocar o jogo no lugar: %s."

#: title/pc5_library.c:2569
msgid "PC5 didn't install this game, so it can't update it."
msgstr "O PC5 não instalou este jogo, por isso não o consegue atualizar."

#: title/pc5_library.c:2571
#, c-format
msgid ""
"%s plays from its USB drive: copy the newer version over its folder %s "
"there."
msgstr ""
"%s é jogado a partir da sua unidade USB: copia a versão mais recente por "
"cima da pasta %s nessa unidade."

#: title/pc5_library.c:2576
msgid "The game's folder is missing: uninstall it and install it again."
msgstr "Falta a pasta do jogo: desinstala-o e instala-o novamente."

#: title/pc5_library.c:2579
#, c-format
msgid ""
"This folder doesn't have %s, the program %s starts. Choose the folder of a "
"newer copy of %s."
msgstr ""
"Esta pasta não tem %s, o programa que %s inicia. Escolhe a pasta de uma "
"cópia mais recente de %s."

#: title/pc5_library.c:2593
#, c-format
msgid "Not enough space: the update needs %s and the console has %s free."
msgstr ""
"Não há espaço suficiente: a atualização precisa de %s e a consola tem %s "
"livres."

#: title/pc5_library.c:2599
msgid ""
"An earlier update of this game isn't finished: close PC5 and open it again "
"to finish it."
msgstr ""
"Uma atualização anterior deste jogo não terminou: fecha o PC5 e abre-o "
"novamente para a terminar."

#: title/pc5_library.c:2601
#, c-format
msgid "PC5 can't start the update: %s."
msgstr "O PC5 não consegue começar a atualização: %s."

#: title/pc5_library.c:2630
msgid ""
"Kept saves can't be put back for a game that plays from its USB drive."
msgstr ""
"Os dados guardados não podem ser repostos num jogo que é jogado a partir "
"da sua unidade USB."

