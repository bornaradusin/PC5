msgid "PC5 can't make the tile's sce_sys."
msgstr "O PC5 não consegue criar o sce_sys do ícone."

#: title/pc5_tile.c:398
msgid "PC5 can't make the tile's picture."
msgstr "O PC5 não consegue criar a imagem do ícone."

#: title/pc5_tile.c:412
msgid "PC5 can't write the tile's pictures."
msgstr "O PC5 não consegue escrever as imagens do ícone."

#: title/pc5_tile.c:444
msgid "PC5 can't write the tile's param.json from its own."
msgstr "O PC5 não consegue escrever o param.json do ícone a partir do seu."

#: title/pc5_tile.c:496
msgid "PC5 doesn't know where to make the tile."
msgstr "O PC5 não sabe onde criar o ícone."

#: title/pc5_tile.c:501
#, c-format
msgid "PC5 can't find a free title ID for the tile in %s."
msgstr "O PC5 não encontra um ID de título livre para o ícone em %s."

#: title/pc5_tile.c:511
msgid "The tiles' folder path is too long."
msgstr "O caminho da pasta dos ícones é demasiado longo."

#: title/pc5_tile.c:527
#, c-format
msgid "PC5 can't replace the tile: %s."
msgstr "O PC5 não consegue substituir o ícone: %s."

#: title/pc5_tile.c:533
#, c-format
msgid "PC5 can't put the tile in place: %s."
msgstr "O PC5 não consegue colocar o ícone no lugar: %s."

#: title/pc5_tile.c:636 title/pc5_ui.c:4481
msgid ""
"It isn't in PC5 any more. Take the tile off the home screen, or install "
"the game again."
msgstr ""
"Já não está no PC5. Retira o ícone do ecrã inicial ou instala o jogo "
"novamente."

#: title/pc5_tile.c:697
