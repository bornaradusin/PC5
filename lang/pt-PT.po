msgid "About"
msgstr "Sobre"

#: title/pc5_ui.c:7197 title/pc5_ui.c:7931
msgid "Receive from phone"
msgstr "Receber do telemóvel"

#: title/pc5_ui.c:7225
msgid "Touchpad + OPTIONS for 2 s still leaves the game"
msgstr "Painel tátil + OPTIONS durante 2 s continua a sair do jogo"

#: title/pc5_ui.c:7227
msgid "Two fingers: PC5's on-screen keyboard, or a key of its own"
msgstr "Dois dedos: o teclado no ecrã do PC5 ou uma tecla própria"

#: title/pc5_ui.c:7230
msgid "A key for each half's click and each quick swipe"
msgstr "Uma tecla para o clique de cada metade e cada deslizamento rápido"

#: title/pc5_ui.c:7231
msgid "A finger moves the pointer; a click sends its key"
msgstr "Um dedo move o ponteiro; um clique envia a sua tecla"

#: title/pc5_ui.c:7232
msgid "The whole touchpad is one button"
msgstr "Todo o painel tátil é um só botão"

#: title/pc5_ui.c:7242
msgid "Right stick"
msgstr "Manípulo direito"

#: title/pc5_ui.c:7242
