#, c-format
msgid "PC5's folder path is too long for a tile (%d characters at most)."
msgstr ""
"O caminho da pasta do PC5 é demasiado longo para um ícone (%d caracteres "
"no máximo)."

#: title/pc5_tile.c:254
msgid "PC5 can't read its own program to copy into the tile."
msgstr ""
"O PC5 não consegue ler o seu próprio programa para o copiar para o ícone."

#: title/pc5_tile.c:259
msgid "PC5's folder has no lapy.elf."
msgstr "A pasta do PC5 não tem lapy.elf."

#: title/pc5_tile.c:270
msgid "PC5 ran out of memory making the tile."
msgstr "O PC5 ficou sem memória ao criar o ícone."

#: title/pc5_tile.c:274
msgid "PC5 can't make the tile's folders."
msgstr "O PC5 não consegue criar as pastas do ícone."

