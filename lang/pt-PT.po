msgid "PC5 can't copy its sce_module/libc.prx into the tile."
msgstr "O PC5 não consegue copiar o seu sce_module/libc.prx para o ícone."

#: title/pc5_tile.c:283
msgid "PC5 can't write the tile's lapy.elf."
msgstr "O PC5 não consegue escrever o lapy.elf do ícone."

#: title/pc5_tile.c:287
#, c-format
msgid "PC5 can't write the tile's %s."
msgstr "O PC5 não consegue escrever o ficheiro %s do ícone."

#: title/pc5_tile.c:291
msgid "PC5 can't copy its eboot.bin into the tile."
msgstr "O PC5 não consegue copiar o seu eboot.bin para o ícone."

