#: title/pc5_ui.c:6765 title/pc5_ui.c:7693
msgid "Background image"
msgstr "Imagem de fundo"

#: title/pc5_ui.c:6766
msgid ""
"Choose a still image; it also appears when video playback is unavailable"
msgstr ""
"Escolhe uma imagem fixa; também aparece quando não é possível reproduzir o "
"vídeo"

#: title/pc5_ui.c:6771
msgid "Choose or remove this game's silent background video"
msgstr "Escolhe ou remove o vídeo de fundo sem som deste jogo"

#. A menu row's name (about 30 characters fit).
#: title/pc5_ui.c:6775
