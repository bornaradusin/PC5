msgstr "Escolher ficheiro de vídeo"

#: title/pc5_ui.c:6776
msgid ""
"Import H.264 video to console storage; experimental 1080p/60, without audio"
msgstr ""
"Importa um vídeo H.264 para o armazenamento da consola; 1080p/60 "
"experimental, sem áudio"

#. A menu row's name (about 30 characters fit).
#: title/pc5_ui.c:6780
msgid "Remove background video"
msgstr "Remover vídeo de fundo"

#: title/pc5_ui.c:6781
msgid ""
"Delete the imported video and return to the background image; keep the "
"source file"
msgstr ""
"Elimina o vídeo importado e volta à imagem de fundo; o ficheiro de origem "
"é mantido"

#: title/pc5_ui.c:6786
msgid "Choose or remove the music that plays on this game's cover"
msgstr "Escolhe ou remove a música que toca na capa deste jogo"

#. A menu row's name (about 30 characters fit).
#: title/pc5_ui.c:6790
msgid "Choose music file"
msgstr "Escolher ficheiro de música"

#: title/pc5_ui.c:6791
msgid ""
"Import MP3 or WAV to console storage: plays on this cover, even without USB"
msgstr ""
"Importa MP3 ou WAV para o armazenamento da consola: toca nesta capa, mesmo "
"sem USB"

#. A menu row's name (about 30 characters fit).
#: title/pc5_ui.c:6795
msgid "Media settings and backup"
msgstr "Multimédia e cópia de segurança"

#: title/pc5_ui.c:6796
msgid ""
"Music volume and start, video loop, framing, darkness and appearance backup"
msgstr ""
"Volume e início da música, ciclo do vídeo, enquadramento, escurecimento e "
"cópia de segurança do aspeto"

#. A menu row's name (about 30 characters fit).
#: title/pc5_ui.c:6800
msgid "Remove library music"
msgstr "Remover música da biblioteca"

#: title/pc5_ui.c:6801
msgid "Delete this game's imported music; the original source file is kept"
msgstr ""
"Elimina a música importada deste jogo; o ficheiro de origem é mantido"

#. A menu row's name (about 30 characters fit).
#: title/pc5_ui.c:6805 title/pc5_ui.c:7693
msgid "Tile picture"
msgstr "Imagem do ícone"

#: title/pc5_ui.c:6806
msgid ""
"Its home screen tile's picture: a square one found online, or one made "
"from its cover"
msgstr ""
"A imagem do seu ícone no ecrã inicial: uma quadrada encontrada na internet "
"ou uma criada a partir da capa"

#: title/pc5_ui.c:6810
#, c-format
msgid "Its tile, %.40s, starts the game"
msgstr "O seu ícone, %.40s, inicia o jogo"

#. A menu row's name (about 30 characters fit).
#: title/pc5_ui.c:6811
msgid "Home screen tile"
msgstr "Ícone no ecrã inicial"

#: title/pc5_ui.c:6812
msgid "A tile on the PS5's home screen that starts it"
msgstr "Um ícone no ecrã inicial da PS5 que o inicia"

#: title/pc5_ui.c:6817
#, c-format
msgid "Now: %.150s"
msgstr "Agora: %.150s"

