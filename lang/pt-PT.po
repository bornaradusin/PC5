msgstr "encontrado em %s"

#. Web page text.
#: title/pc5_web_page.html:134
msgctxt "web"
msgid "none found"
msgstr "não encontrado"

#. Web page text.
#. %s and %d are filled in by the page; %1$s, %2$s put them in another order.
#: title/pc5_web_page.html:135
#, c-format
msgctxt "web"
msgid "Which game it is (Steam app ID: %s)"
msgstr "Que jogo é (ID da aplicação do Steam: %s)"

#. Web page text.
#: title/pc5_web_page.html:135
msgctxt "web"
msgid "none"
msgstr "nenhum"

