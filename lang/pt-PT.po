msgstr ""
"Escolhe uma imagem JPEG ou PNG legível, com 20 MB no máximo. A tua imagem "
"anterior foi mantida."

#: title/pc5_ui.c:3856 title/pc5_ui.c:3872
msgid "Loading screen saved"
msgstr "Ecrã de carregamento guardado"

#: title/pc5_ui.c:3856
msgid "It shows the next time the game starts."
msgstr "Aparece da próxima vez que o jogo iniciar."

