#, c-format
msgid "A path in %s is too long."
msgstr "Jedna ze ścieżek w %s jest za długa."

#: title/pc5_files.c:267
msgid "PC5 ran out of memory planning the copy."
msgstr "PC5 zabrakło pamięci na przygotowanie kopiowania."

#: title/pc5_files.c:281
msgid "Nothing is chosen."
msgstr "Nic nie wybrano."

#: title/pc5_files.c:284 title/pc5_files.c:289 title/pc5_tile.c:631
#: title/pc5_upgrade.c:637
msgid "PC5 ran out of memory."
msgstr "PC5 zabrakło pamięci."

