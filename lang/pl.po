msgid ""
"The slowest way, but it starts the most games; Auto if it doesn't help"
msgstr ""
"Najwolniejszy sposób, ale uruchamia najwięcej gier; Auto, jeśli nie pomoże"

#: title/pc5_ui.c:7300
msgid ""
"Held at 40 fps, two frames made between each two: for a game that can't "
"hold 60"
msgstr ""
"Utrzymane na 40 kl./s, dwie klatki tworzone między każdymi dwiema: dla "
"gry, która nie utrzyma 60"

