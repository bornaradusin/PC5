#, c-format
msgctxt "web"
msgid "Stopped at %s: %s"
msgstr "Zatrzymano na %s: %s"

#. Web page text.
#. %s and %d are filled in by the page; %1$s, %2$s put them in another order.
#: title/pc5_web_page.html:408
#, c-format
msgctxt "web"
msgid "Sent %d files (%s). PC5 asks to install the game in a moment."
msgstr "Wysłane pliki: %d (%s). Za chwilę PC5 zapyta o instalację gry."

#. Web page text.
#: title/pc5_web_page.html:417
msgctxt "web"
msgid "Type the game's folder name first (no / or \\)."
msgstr "Najpierw wpisz nazwę folderu gry (bez / ani \\)."

#~ msgid "Maximum: all of it, for a game that says there is too little."
#~ msgstr "Maksimum: cała, dla gry, która twierdzi, że jest jej za mało."

#~ msgid "Loading"
#~ msgstr "Wczytywanie"

#~ msgid "Wine's VKD3D"
#~ msgstr "VKD3D z Wine"

#~ msgid "WineD3D on Vulkan"
#~ msgstr "WineD3D na Vulkan"

#~ msgid "SoC temperature"
#~ msgstr "Temperatura SoC"

#~ msgid "Its program is set in its prospero-win profile."
#~ msgstr "Jej program jest ustawiony w jej profilu prospero-win."

#~ msgid "Hides when unused"
#~ msgstr "Ukrywa się"

#~ msgid "Game controlled"
#~ msgstr "Ustala gra"

#~ msgid "Wine's own Direct3D draws it; change it only if the picture is wrong"
#~ msgstr "Rysuje własny Direct3D Wine; zmieniaj tylko, gdy obraz jest zły"

#~ msgid "Wine's own Direct3D 12; if it doesn't help, set it back to Auto"
#~ msgstr "Własny Direct3D 12 Wine; jeśli nie pomoże, wróć do Auto"

#~ msgid ""
#~ "Wine's own Direct3D on Vulkan; if it doesn't help, set it back to Auto"
#~ msgstr "Własny Direct3D Wine na Vulkan; jeśli nie pomoże, wróć do Auto"

#~ msgid ""
#~ "Wine's own Direct3D on OpenGL; if it doesn't help, set it back to Auto"
#~ msgstr "Własny Direct3D Wine na OpenGL; jeśli nie pomoże, wróć do Auto"

#~ msgid "Graphics API"
#~ msgstr "API grafiki"

#~ msgid "As Windows: 4 GB for a game made for it, otherwise 2 GB"
#~ msgstr "Jak w Windows: 4 GB dla gry do tego przystosowanej, inaczej 2 GB"

#~ msgid "Video memory"
#~ msgstr "Pamięć wideo"

#~ msgid "2 GB at most, a number older games' checks can read"
#~ msgstr "Najwyżej 2 GB, liczba zrozumiała dla starszych gier"

#~ msgid "Full"
#~ msgstr "Pełna"

#~ msgid "CPU sharing"
#~ msgstr "Dzielenie CPU"

#~ msgid "Its threads take turns, as on a PC: steadier for some games"
#~ msgstr "Wątki działają na zmianę, jak na PC: stabilniej w niektórych grach"

#~ msgid ""
#~ "PC5's choice: VKD3D-Proton turns the game's Direct3D 12 into Vulkan. The "
#~ "fastest, and what most games want."
#~ msgstr ""
#~ "Wybór PC5: VKD3D-Proton zamienia Direct3D 12 gry na Vulkan. Najszybszy i "
#~ "tego chce większość gier."

#~ msgid ""
#~ "PC5's choice: Wine's own Direct3D draws the game's DirectDraw with OpenGL."
#~ msgstr "Wybór PC5: własny Direct3D Wine rysuje DirectDraw gry przez OpenGL."

#~ msgid ""
#~ "PC5's choice: DXVK turns the game's Direct3D into Vulkan. The fastest, and "
#~ "what most games want."
#~ msgstr ""
#~ "Wybór PC5: DXVK zamienia Direct3D gry na Vulkan. Najszybszy i tego chce "
#~ "większość gier."

#~ msgid ""
#~ "Wine's own Direct3D 12 (VKD3D). Slower than Auto; try it if the game won't "
#~ "start or draws wrong."
#~ msgstr ""
#~ "Własny Direct3D 12 Wine (VKD3D). Wolniejszy niż Auto; spróbuj, jeśli gra "
#~ "się nie uruchamia lub źle rysuje."

#~ msgid ""
#~ "Wine's own Direct3D, drawing with Vulkan. Try it if the game draws wrong "
#~ "with Auto; often faster than WineD3D."
#~ msgstr ""
#~ "Własny Direct3D Wine, rysujący przez Vulkan. Spróbuj, jeśli z Auto gra źle "
#~ "rysuje; często szybszy niż WineD3D."

#~ msgid ""
#~ "Wine's own Direct3D, drawing with OpenGL. The slowest; try it if the game "
#~ "won't start with the others."
#~ msgstr ""
#~ "Własny Direct3D Wine, rysujący przez OpenGL. Najwolniejszy; spróbuj, jeśli "
#~ "gra nie uruchamia się z innymi."

#~ msgid ""
#~ "A .NET program: it runs with Wine Mono, which PC5 sets up the first time a "
#~ ".NET game starts."
#~ msgstr ""
#~ "Program .NET: działa z Wine Mono, które PC5 przygotowuje przy pierwszym "
#~ "uruchomieniu gry .NET."

#~ msgid "Games players have tried, on your phone with a QR code"
#~ msgstr "Gry sprawdzone przez graczy, na telefonie przez kod QR"

#~ msgid "Focus mode"
#~ msgstr "Tryb skupienia"

#~ msgid "Shown"
#~ msgstr "Widoczny"

#~ msgid ""
#~ "Scan the code with your phone: PC5's wiki opens on the list of games "
#~ "players have tried, how each ran and the settings that helped."
#~ msgstr ""
#~ "Zeskanuj kod telefonem: wiki PC5 otworzy się na liście gier sprawdzonych "
#~ "przez graczy, z tym, jak działały i jakie ustawienia pomogły."

#~ msgid ""
#~ "On your phone or computer, open "
#~ "github.com/bornaradusin/PC5/wiki/Game-compatibility: the games players "
#~ "have tried, how each ran and the settings that helped."
#~ msgstr ""
#~ "Na telefonie lub komputerze otwórz "
#~ "github.com/bornaradusin/PC5/wiki/Game-compatibility: gry sprawdzone przez "
#~ "graczy, jak działały i jakie ustawienia pomogły."

#~ msgid ""
#~ "Got a game running? Add a game, at the top of the list's page: the form "
#~ "takes a minute. You need a GitHub account."
#~ msgstr ""
#~ "Gra działa? Kliknij Add a game u góry strony listy: formularz zajmuje "
#~ "minutę. Potrzebne jest konto GitHub."

#~ msgid "Keep changing"
#~ msgstr "Edytuj dalej"

#~ msgid "Vibration, light bar and triggers"
#~ msgstr "Wibracje, pasek świetlny i spusty"

#~ msgid "Off. On holds the game at 30 fps and shows 60"
#~ msgstr "Wył. Wł. trzyma grę na 30 kl./s i pokazuje 60"
