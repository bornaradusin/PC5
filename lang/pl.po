msgid "version %s"
msgstr "wersja %s"

#: title/pc5_ui.c:7413
msgid "Like PC5?"
msgstr "Podoba ci się PC5?"

#: title/pc5_ui.c:7416
msgid "Buy me a coffee"
msgstr "Postaw mi kawę"

