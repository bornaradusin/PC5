msgstr "PS5:n aloitusnäytön kuvake, joka käynnistää sen"

#: title/pc5_ui.c:6834
#, c-format
msgid "Now: %.150s"
msgstr "Nyt: %.150s"

#. A menu row's name (about 30 characters fit).
#. A button hint along the bottom of the screen, beside a button's picture: keep it short (one or two words).
#: title/pc5_ui.c:6835 title/pc5_ui.c:7458
msgid "Change program"
