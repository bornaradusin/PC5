msgstr "Asennus on jo alkanut."

#: title/pc5_library.c:2797
msgid "PC5 can't read the kept saves."
msgstr "PC5 ei voi lukea säilytettyjä tallennuksia."

#: title/pc5_library.c:2797
msgid "The kept saves are damaged: they have no registry."
msgstr "Säilytetyt tallennukset ovat vioittuneet: niistä puuttuu rekisteri."

#: title/pc5_library.c:2874
#, c-format
msgid "PC5 can't make the game's folder on the USB drive: %s."
msgstr "PC5 ei voi luoda pelin kansiota USB-asemalle: %s."

#: title/pc5_library.c:2947
#, c-format
msgid "PC5 can't open %s on the USB drive: %s."
msgstr "PC5 ei voi avata kohdetta %s USB-asemalla: %s."

#: title/pc5_library.c:2985
#, c-format
msgid ""
"The copy of %s doesn't match the USB drive. The drive or its cable may be "
"failing; nothing was kept."
msgstr ""
"Kohteen %s kopio ei vastaa USB-asemaa. Asema tai sen kaapeli voi olla "
"vioittumassa; mitään ei säilytetty."

