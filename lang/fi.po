msgid "PC5 can't write the tile's lapy.elf."
msgstr "PC5 ei voi kirjoittaa kuvakkeen lapy.elf-tiedostoa."

#: title/pc5_tile.c:287
#, c-format
msgid "PC5 can't write the tile's %s."
msgstr "PC5 ei voi kirjoittaa kuvakkeen tiedostoa %s."

