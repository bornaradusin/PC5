msgstr "PC5 ne peut pas écrire %s : %s."

#: title/pc5_files.c:391
#, c-format
msgid "PC5 ran out of memory copying %s."
msgstr "PC5 manque de mémoire pour copier %s."

#: title/pc5_files.c:427 title/pc5_library.c:1860
#, c-format
msgid "PC5 can't put %s in place: %s."
msgstr "PC5 ne peut pas mettre %s en place : %s."

