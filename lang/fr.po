msgstr ""
"L'image de sa vignette sur l'écran d'accueil : une image carrée trouvée en "
"ligne, ou créée à partir de sa jaquette"

#: title/pc5_ui.c:6817
#, c-format
msgid "Its tile, %.40s, starts the game"
msgstr "Sa vignette, %.40s, lance le jeu"

#. A menu row's name (about 30 characters fit).
#: title/pc5_ui.c:6818
msgid "Home screen tile"
msgstr "Vignette sur l'écran d'accueil"

#: title/pc5_ui.c:6819
msgid "A tile on the PS5's home screen that starts it"
msgstr "Une vignette sur l'écran d'accueil de la PS5 qui le lance"

#: title/pc5_ui.c:6824
#, c-format
msgid "Now: %.150s"
msgstr "Actuel : %.150s"

#. A menu row's name (about 30 characters fit).
#. A button hint along the bottom of the screen, beside a button's picture: keep it short (one or two words).
