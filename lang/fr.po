#: title/pc5_files.c:100
msgid "The name is empty."
msgstr "Le nom est vide."

#: title/pc5_files.c:101
#, c-format
msgid "\"%s\" can't be a name."
msgstr "« %s » ne peut pas être un nom."

#: title/pc5_files.c:102
msgid "The name is too long: 255 bytes at most."
msgstr "Le nom est trop long : 255 octets au maximum."

#: title/pc5_files.c:105
#, c-format
msgid "A name can't have %s in it."
msgstr "Un nom ne peut pas contenir %s."

#: title/pc5_files.c:108
msgid "A name can't end in a space or a dot."
msgstr "Un nom ne peut pas se terminer par un espace ou un point."

#: title/pc5_files.c:240
#, c-format
msgid "%s has folders too deep to copy."
msgstr "%s contient des dossiers trop profonds pour être copiés."

#: title/pc5_files.c:241 title/pc5_files.c:251 title/pc5_files.c:381
#: title/pc5_files.c:398
#, c-format
msgid "PC5 can't read %s: %s."
msgstr "PC5 ne peut pas lire %s : %s."

#: title/pc5_files.c:256
#, c-format
msgid "A path in %s is too long."
msgstr "Un chemin dans %s est trop long."

#: title/pc5_files.c:267
msgid "PC5 ran out of memory planning the copy."
msgstr "PC5 manque de mémoire pour préparer la copie."

#: title/pc5_files.c:281
msgid "Nothing is chosen."
msgstr "Rien n'est sélectionné."

#: title/pc5_files.c:284 title/pc5_files.c:289 title/pc5_tile.c:631
#: title/pc5_upgrade.c:637
msgid "PC5 ran out of memory."
msgstr "PC5 manque de mémoire."

#: title/pc5_files.c:288
msgid "The folder to paste into isn't there any more."
msgstr "Le dossier où coller n'existe plus."

#: title/pc5_files.c:296
#, c-format
msgid "%s isn't there any more."
msgstr "%s n'existe plus."

#: title/pc5_files.c:300
#, c-format
msgid "%s can't go into itself or a folder inside it."
msgstr "%s ne peut pas aller dans lui-même ni dans un de ses sous-dossiers."

#: title/pc5_files.c:304
#, c-format
msgid "The path of %s would be too long."
msgstr "Le chemin de %s serait trop long."

#: title/pc5_files.c:319
#, c-format
msgid "PC5 can't find a free name for %s."
msgstr "PC5 ne trouve pas de nom libre pour %s."

#: title/pc5_files.c:351
#, c-format
msgid "There isn't room: it needs %s and the drive has %s free."
msgstr "Il n'y a pas assez de place : il faut %s et le disque a %s de libre."

#: title/pc5_files.c:357
msgid "PC5 ran out of memory planning the work."
msgstr "PC5 manque de mémoire pour préparer l'opération."

#: title/pc5_files.c:385 title/pc5_files.c:406 title/pc5_files.c:419
#: title/pc5_library.c:2440 title/pc5_library.c:2529 title/pc5_library.c:2953
#: title/pc5_library.c:2968 title/pc5_library.c:2974
#, c-format
msgid "PC5 can't write %s: %s."
msgstr "PC5 ne peut pas écrire %s : %s."

#: title/pc5_files.c:391
#, c-format
msgid "PC5 ran out of memory copying %s."
msgstr "PC5 manque de mémoire pour copier %s."

#: title/pc5_files.c:427 title/pc5_library.c:1854
#, c-format
msgid "PC5 can't put %s in place: %s."
msgstr "PC5 ne peut pas mettre %s en place : %s."

#: title/pc5_files.c:453
#, c-format
msgid "PC5 can't make the folder %s: %s."
msgstr "PC5 ne peut pas créer le dossier %s : %s."

#: title/pc5_files.c:459
#, c-format
msgid "PC5 can't move %s: %s."
msgstr "PC5 ne peut pas déplacer %s : %s."

#: title/pc5_files.c:464
#, c-format
msgid "PC5 ran out of memory deleting %s."
msgstr "PC5 manque de mémoire pour supprimer %s."

#: title/pc5_ftp.c:626 title/pc5_web.c:1061
msgid "There's no network here."
msgstr "Il n'y a pas de réseau ici."

#: title/pc5_ftp.c:628 title/pc5_ui.c:2626
msgid "PC5's INSTALL folder isn't there."
msgstr "Le dossier INSTALL de PC5 n'existe pas."

#: title/pc5_ftp.c:633 title/pc5_web.c:1067
#, c-format
msgid "Port %u is taken, or there's no network."
msgstr "Le port %u est occupé, ou il n'y a pas de réseau."

#: title/pc5_ftp.c:647 title/pc5_web.c:1081
msgid "PC5 can't start it."
msgstr "PC5 ne peut pas le démarrer."

#: title/pc5_game.c:511
msgid "The app's path is too long."
msgstr "Le chemin de l'application est trop long."

#: title/pc5_game.c:517
msgid "PC5 can't read the app's .NET runtime."
msgstr "PC5 ne peut pas lire le runtime .NET de l'application."

#: title/pc5_game.c:542
msgid "A path of the .NET runtime is too long."
msgstr "Un chemin du runtime .NET est trop long."

#: title/pc5_game.c:547
msgid "PC5 can't make the .NET runtime's folders: is the console full?"
msgstr ""
"PC5 ne peut pas créer les dossiers du runtime .NET : la console est-elle "
"pleine ?"

#: title/pc5_game.c:558
#, c-format
msgid ""
"The app's .NET runtime has no %.80s. Copy the PPSA11018 folder to the "
"console again."
msgstr ""
"Il manque %.80s au runtime .NET de l'application. Copiez de nouveau le "
"dossier PPSA11018 sur la console."

#: title/pc5_game.c:564
msgid "PC5 can't copy the .NET runtime: is the console full?"
msgstr ""
"PC5 ne peut pas copier le runtime .NET : la console est-elle pleine ?"

#: title/pc5_game.c:572
msgid "PC5 can't finish the .NET runtime's copy."
msgstr "PC5 ne peut pas terminer la copie du runtime .NET."

#: title/pc5_home.c:157
msgid "The tile's program is missing from PC5's app (pc5/forwarder)."
msgstr ""
"Le programme des vignettes manque dans l'application PC5 (pc5/forwarder)."

#: title/pc5_home.c:161
#, c-format
msgid "PC5 can't use %s: %s."
msgstr "PC5 ne peut pas utiliser %s : %s."

#: title/pc5_home.c:165
msgid "PC5 ran out of memory making the tile's picture."
msgstr "PC5 manque de mémoire pour créer l'image de la vignette."

#: title/pc5_home.c:180
#, c-format
msgid "PC5 can't write the tile in %s: %s."
msgstr "PC5 ne peut pas écrire la vignette dans %s : %s."

#: title/pc5_library.c:169
#, c-format
msgid ""
"Plug in the USB drive with %.100s: it plays from the folder %.200s on it."
msgstr ""
"Branchez le disque USB qui contient %.100s : le jeu se lance depuis son "
"dossier %.200s."

#: title/pc5_library.c:175 title/pc5_library.c:2849 title/pc5_library.c:2900
#, c-format
msgid "PC5 can't make the game's folder: %s."
msgstr "PC5 ne peut pas créer le dossier du jeu : %s."

#: title/pc5_library.c:195
#, c-format
msgid "PC5 can't link the game's folder on the USB drive: %s."
msgstr "PC5 ne peut pas lier le dossier du jeu sur le disque USB : %s."

#: title/pc5_library.c:589 title/pc5_library.c:606
msgid "Choose one of the game's programs."
msgstr "Choisissez l'un des programmes du jeu."

#: title/pc5_library.c:602 title/pc5_library.c:752 title/pc5_library.c:976
msgid "PC5's notes on this game are missing."
msgstr "Les notes de PC5 sur ce jeu sont introuvables."

#: title/pc5_library.c:614
msgid "That program is too deep in the game's folder for Windows."
msgstr "Ce programme est trop profond dans le dossier du jeu pour Windows."

#: title/pc5_library.c:619 title/pc5_library.c:1871 title/pc5_library.c:2584
#: title/pc5_library.c:2587 title/pc5_library.c:2596 title/pc5_library.c:2670
#: title/pc5_library.c:2862
#, c-format
msgid "PC5 can't write its notes: %s."
msgstr "PC5 ne peut pas écrire ses notes : %s."

#: title/pc5_library.c:640
msgid "PC5 is out of memory."
msgstr "PC5 manque de mémoire."

#: title/pc5_library.c:644
#, c-format
msgid "%.200s doesn't start any of the game's programs."
msgstr "%.200s ne lance aucun des programmes du jeu."

#: title/pc5_library.c:844
msgid "The game's launch options are too long: 511 characters at most."
msgstr ""
"Les options de lancement du jeu sont trop longues : 511 caractères au "
"maximum."

#: title/pc5_library.c:861
msgid "The game's path is too long for Windows."
msgstr "Le chemin du jeu est trop long pour Windows."

#: title/pc5_library.c:877 title/pc5_library.c:1055
#, c-format
msgid "PC5 can't write the game's profile: %s."
msgstr "PC5 ne peut pas écrire le profil du jeu : %s."

#: title/pc5_library.c:1001
#, c-format
msgid "The program its launcher started isn't one of the game's: %.200s"
msgstr ""
"Le programme lancé par son lanceur n'est pas l'un de ceux du jeu : %.200s"

#: title/pc5_library.c:1015
msgid "The arguments its launcher gave are too long."
msgstr "Les arguments transmis par son lanceur sont trop longs."

#: title/pc5_library.c:1037
#, c-format
msgid "Its programs kept starting each other: %d hand-offs in a row."
msgstr ""
"Ses programmes se lançaient sans fin les uns les autres : %d relais "
"d'affilée."

#: title/pc5_library.c:1051
msgid "The program's path is too long for Windows."
msgstr "Le chemin du programme est trop long pour Windows."

#: title/pc5_library.c:1110
#, c-format
msgid "Its profile has a mistake (%s)."
msgstr "Son profil contient une erreur (%s)."

#: title/pc5_library.c:1127
msgid "Its Windows folder is missing."
msgstr "Son dossier Windows est introuvable."

#: title/pc5_library.c:1267
#, c-format
msgid "PC5 can't delete %s: %s."
msgstr "PC5 ne peut pas supprimer %s : %s."

#: title/pc5_library.c:1366 title/pc5_library.c:1641 title/pc5_library.c:1696
#, c-format
msgid "PC5 can't move the game's folder: %s."
msgstr "PC5 ne peut pas déplacer le dossier du jeu : %s."

#: title/pc5_library.c:1375 title/pc5_library.c:1646
#, c-format
msgid "PC5 can't delete the game's profile: %s."
msgstr "PC5 ne peut pas supprimer le profil du jeu : %s."

#: title/pc5_library.c:1389 title/pc5_library.c:1633 title/pc5_library.c:2735
#: title/pc5_library.c:2743
msgid "A path is too long."
msgstr "Un chemin est trop long."

#: title/pc5_library.c:1592
msgid "PC5 can't read the game's folder."
msgstr "PC5 ne peut pas lire le dossier du jeu."

#: title/pc5_library.c:1600 title/pc5_library.c:1851 title/pc5_library.c:2930
#, c-format
msgid "A path in the game is too long: %s."
msgstr "Un chemin dans le jeu est trop long : %s."

#: title/pc5_library.c:1609
#, c-format
msgid "PC5 can't keep %s: %s."
msgstr "PC5 ne peut pas conserver %s : %s."

#: title/pc5_library.c:1665
#, c-format
msgid "PC5 can't put the saves in place: %s."
msgstr "PC5 ne peut pas remettre les sauvegardes en place : %s."

#: title/pc5_library.c:1679
msgid "This game's saves can't be kept apart from it."
msgstr "Les sauvegardes de ce jeu ne peuvent pas être conservées à part."

#: title/pc5_library.c:1685
#, c-format
msgid "PC5 can't make its saves folder: %s."
msgstr "PC5 ne peut pas créer son dossier de sauvegardes : %s."

#: title/pc5_library.c:1689
msgid "PC5 is still keeping this game's saves from before: start PC5 again."
msgstr ""
"PC5 est encore en train de conserver les anciennes sauvegardes de ce jeu : "
"relancez PC5."

#: title/pc5_library.c:1722
#, c-format
msgid "PC5 can't move the saves: %s."
msgstr "PC5 ne peut pas déplacer les sauvegardes : %s."

#: title/pc5_library.c:1809
#, c-format
msgid "A path in the update is too long: %s."
msgstr "Un chemin dans la mise à jour est trop long : %s."

#: title/pc5_library.c:1891
#, c-format
msgid "PC5 can't write the game's list of files: %s."
msgstr "PC5 ne peut pas écrire la liste des fichiers du jeu : %s."

#: title/pc5_library.c:2209
msgid ""
"PC5's Windows template is missing from the app: copy the PC5 folder again."
msgstr ""
"Le modèle Windows de PC5 manque dans l'application : copiez de nouveau le "
"dossier PC5."

#: title/pc5_library.c:2233
msgid "PC5's Windows template is damaged: copy the PC5 folder again."
msgstr ""
"Le modèle Windows de PC5 est endommagé : copiez de nouveau le dossier PC5."

#: title/pc5_library.c:2315 title/pc5_library.c:2375
#, c-format
msgid "PC5 can't make its folders in %s: %s."
msgstr "PC5 ne peut pas créer ses dossiers dans %s : %s."

#: title/pc5_library.c:2326
#, c-format
msgid "PC5 can't make its folder on the USB drive: %s."
msgstr "PC5 ne peut pas créer son dossier sur le disque USB : %s."

#: title/pc5_library.c:2329
msgid "PC5 can't name the game's folder on the USB drive."
msgstr "PC5 ne peut pas nommer le dossier du jeu sur le disque USB."

#: title/pc5_library.c:2347
#, c-format
msgid ""
"The drive reads at %.0f MB/s here, too slow to play from (%.0f needed). "
"Plug it into a port on the back or the front USB-C port. Installing to the "
"console still works."
msgstr ""
"Le disque lit à %.0f Mo/s ici, trop lentement pour y jouer (%.0f "
"nécessaires). Branchez-le sur un port à l'arrière ou sur le port USB-C "
"avant. L'installation sur la console fonctionne toujours."

#: title/pc5_library.c:2355
#, c-format
msgid ""
"Not enough space on the USB drive: the game needs %s and it has %s free."
msgstr ""
"Pas assez d'espace sur le disque USB : le jeu a besoin de %s et il reste "
"%s de libre."

#: title/pc5_library.c:2359
msgid ""
"Only a game on a USB drive can play from it: this folder isn't on one."
msgstr ""
"Seul un jeu sur un disque USB peut se lancer depuis celui-ci : ce dossier "
"n'est pas sur un disque USB."

#: title/pc5_library.c:2361
msgid "A game in PC5's INSTALL folder is installed, not played from there."
msgstr ""
"Un jeu du dossier INSTALL de PC5 s'installe, il ne se lance pas depuis ce "
"dossier."

#: title/pc5_library.c:2366
#, c-format
msgid ""
"The drive reads at %.0f MB/s in this USB port, too slow to play from (at "
"least %.0f is needed). On the original PS5 the front USB-A port is the "
"slow one: plug the drive into a port on the back, or the front USB-C port. "
"Install still works from this port."
msgstr ""
"Le disque lit à %.0f Mo/s sur ce port USB, trop lentement pour y jouer (il "
"faut au moins %.0f). Sur la PS5 d'origine, le port USB-A avant est le plus "
"lent : branchez le disque sur un port à l'arrière ou sur le port USB-C "
"avant. L'installation fonctionne toujours depuis ce port."

#: title/pc5_library.c:2372
msgid "The game's program is too deep in its folder for Windows."
msgstr "Le programme du jeu est trop profond dans son dossier pour Windows."

#: title/pc5_library.c:2380
#, c-format
msgid "Not enough space: the game needs %s and the console has %s free."
msgstr ""
"Pas assez d'espace : le jeu a besoin de %s et la console a %s de libre."

#: title/pc5_library.c:2383
msgid "PC5 can't name the game."
msgstr "PC5 ne peut pas nommer le jeu."

#: title/pc5_library.c:2386
#, c-format
msgid "PC5 can't start the install: %s."
msgstr "PC5 ne peut pas lancer l'installation : %s."

#: title/pc5_library.c:2393 title/pc5_library.c:2466 title/pc5_library.c:2502
#: title/pc5_library.c:2751
msgid "Out of memory."
msgstr "Mémoire insuffisante."

#: title/pc5_library.c:2426
msgid "A path in the Windows template is too long."
msgstr "Un chemin du modèle Windows est trop long."

#: title/pc5_library.c:2429 title/pc5_library.c:2434 title/pc5_library.c:2937
#: title/pc5_tile.c:519
#, c-format
msgid "PC5 can't make %s: %s."
msgstr "PC5 ne peut pas créer %s : %s."

#: title/pc5_library.c:2437
#, c-format
msgid "PC5's Windows template is missing %s."
msgstr "Il manque %s au modèle Windows de PC5."

#: title/pc5_library.c:2455
#, c-format
msgid "PC5 can't copy %s: %s."
msgstr "PC5 ne peut pas copier %s : %s."

#: title/pc5_library.c:2480
#, c-format
msgid "PC5 can't read %s on the USB drive: %s."
msgstr "PC5 ne peut pas lire %s sur le disque USB : %s."

#: title/pc5_library.c:2521 title/pc5_library.c:2947
#, c-format
msgid "PC5 can't read back %s: %s."
msgstr "PC5 ne peut pas relire %s : %s."

#: title/pc5_library.c:2521
#, c-format
msgid "The USB drive stopped answering while PC5 copied %s (%s)."
msgstr "Le disque USB a cessé de répondre pendant que PC5 copiait %s (%s)."

#: title/pc5_library.c:2549 title/pc5_library.c:2561
#, c-format
msgid ""
"The game couldn't be put back in the INSTALL folder: it is in %.180s."
msgstr ""
"Le jeu n'a pas pu être remis dans le dossier INSTALL : il se trouve dans "
"%.180s."

#: title/pc5_library.c:2600
#, c-format
msgid "PC5 can't save the cover: %s."
msgstr "PC5 ne peut pas enregistrer la jaquette : %s."

#: title/pc5_library.c:2607
#, c-format
msgid "PC5 can't put the game in place: %s."
msgstr "PC5 ne peut pas mettre le jeu en place : %s."

#: title/pc5_library.c:2716
msgid "PC5 didn't install this game, so it can't update it."
msgstr "PC5 n'a pas installé ce jeu, il ne peut donc pas le mettre à jour."

#: title/pc5_library.c:2718
#, c-format
msgid ""
"%s plays from its USB drive: copy the newer version over its folder %s "
"there."
msgstr ""
"%s se lance depuis son disque USB : copiez-y la version plus récente "
"par-dessus son dossier %s."

#: title/pc5_library.c:2723
msgid "The game's folder is missing: uninstall it and install it again."
msgstr ""
"Le dossier du jeu est introuvable : désinstallez-le puis réinstallez-le."

#: title/pc5_library.c:2726
#, c-format
msgid ""
"This folder doesn't have %s, the program %s starts. Choose the folder of a "
"newer copy of %s."
msgstr ""
"Ce dossier ne contient pas %s, le programme que lance %s. Choisissez le "
"dossier d'une copie plus récente de %s."

#: title/pc5_library.c:2740
#, c-format
msgid "Not enough space: the update needs %s and the console has %s free."
msgstr ""
"Pas assez d'espace : la mise à jour a besoin de %s et la console a %s de "
"libre."

#: title/pc5_library.c:2746
msgid ""
"An earlier update of this game isn't finished: close PC5 and open it again "
"to finish it."
msgstr ""
"Une mise à jour précédente de ce jeu n'est pas terminée : fermez PC5 et "
"rouvrez-le pour la terminer."

#: title/pc5_library.c:2748
#, c-format
msgid "PC5 can't start the update: %s."
