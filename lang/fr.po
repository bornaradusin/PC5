#: title/pc5_source.c:320
#, c-format
msgid "PC5 can't read %.200s."
msgstr "PC5 ne peut pas lire %.200s."

#: title/pc5_source.c:334
#, c-format
msgid "Windows can't use the name \"%.180s\"."
msgstr "Windows ne peut pas utiliser le nom « %.180s »."

#: title/pc5_source.c:338
msgid "The folder goes too many levels deep."
msgstr "Le dossier a trop de niveaux de profondeur."

#: title/pc5_source.c:462
msgid "There is no Windows program in this folder."
msgstr "Ce dossier ne contient aucun programme Windows."

#: title/pc5_source.c:464
msgid "This folder only has installers and tools, not a game."
msgstr ""
"Ce dossier ne contient que des programmes d'installation et des outils, "
"pas un jeu."

#: title/pc5_textdoc.c:142 title/pc5_textdoc.c:246
msgid "It's larger than 8 MB: PC5 changes text files up to that size."
msgstr ""
"Il fait plus de 8 Mo : PC5 modifie les fichiers texte jusqu'à cette taille."

#: title/pc5_textdoc.c:155
msgid "It's UTF-16 big-endian text, which PC5 doesn't change."
msgstr "C'est du texte UTF-16 gros-boutiste, que PC5 ne modifie pas."

#: title/pc5_textdoc.c:163 title/pc5_textdoc.c:177 title/pc5_textdoc.c:195
msgid ""
"It isn't text: PC5 changes only text files (.ini, .cfg, .txt and the like)."
msgstr ""
"Ce n'est pas du texte : PC5 ne modifie que les fichiers texte (.ini, .cfg, "
".txt et autres)."

#: title/pc5_textdoc.c:182 title/pc5_textdoc.c:200 title/pc5_textdoc.c:209
msgid "There isn't memory enough to open it."
msgstr "Il n'y a pas assez de mémoire pour l'ouvrir."

#: title/pc5_textdoc.c:230
msgid "It has more lines than PC5 can show."
msgstr "Il a plus de lignes que PC5 ne peut en afficher."

#: title/pc5_textdoc.c:374
#, c-format
msgid ""
"This file is in an older encoding with room for Western letters only, and "
"“%s” isn't one of them."
msgstr ""
"Ce fichier utilise un ancien encodage qui ne contient que des lettres "
"occidentales, et « %s » n'en fait pas partie."

#: title/pc5_textdoc.c:406 title/pc5_textdoc.c:408
msgid "There isn't memory enough to save it."
msgstr "Il n'y a pas assez de mémoire pour l'enregistrer."

#: title/pc5_tile.c:55
msgid "The tile's folder path is too long."
msgstr "Le chemin du dossier de la vignette est trop long."

#: title/pc5_tile.c:60
#, c-format
msgid "The tile's %s can't be read."
msgstr "Impossible de lire le fichier %s de la vignette."

#: title/pc5_tile.c:66
msgid "The tile was made by a PC5 this one doesn't know: make it again."
msgstr ""
"La vignette a été créée par une version de PC5 que celle-ci ne connaît "
"pas : recréez-la."

#: title/pc5_tile.c:73
msgid "The tile doesn't say which game it starts: make it again."
msgstr "La vignette n'indique pas quel jeu elle lance : recréez-la."

#: title/pc5_tile.c:82
msgid "The tile doesn't say where PC5 is: make it again."
msgstr "La vignette n'indique pas où se trouve PC5 : recréez-la."

#: title/pc5_tile.c:116
msgid "A tile's ID is PPSA and five digits."
msgstr "L'ID d'une vignette est PPSA suivi de cinq chiffres."

#: title/pc5_tile.c:140
#, c-format
msgid ""
"PC5's lapy.elf isn't the one this PC5 can make tiles from (%d compares, %d "
"names)."
msgstr ""
"Le lapy.elf de PC5 n'est pas celui à partir duquel cette version peut "
"créer des vignettes (%d comparaisons, %d noms)."

#: title/pc5_tile.c:249
#, c-format
msgid "PC5's folder path is too long for a tile (%d characters at most)."
msgstr ""
"Le chemin du dossier de PC5 est trop long pour une vignette (%d caractères "
"au maximum)."

#: title/pc5_tile.c:254
msgid "PC5 can't read its own program to copy into the tile."
msgstr ""
"PC5 ne peut pas lire son propre programme pour le copier dans la vignette."

#: title/pc5_tile.c:259
msgid "PC5's folder has no lapy.elf."
msgstr "Le dossier de PC5 ne contient pas de lapy.elf."

#: title/pc5_tile.c:270
msgid "PC5 ran out of memory making the tile."
msgstr "PC5 manque de mémoire pour créer la vignette."

#: title/pc5_tile.c:274
msgid "PC5 can't make the tile's folders."
msgstr "PC5 ne peut pas créer les dossiers de la vignette."

#: title/pc5_tile.c:279
msgid "PC5 can't copy its sce_module/libc.prx into the tile."
msgstr "PC5 ne peut pas copier son sce_module/libc.prx dans la vignette."

#: title/pc5_tile.c:283
msgid "PC5 can't write the tile's lapy.elf."
msgstr "PC5 ne peut pas écrire le lapy.elf de la vignette."

#: title/pc5_tile.c:287
#, c-format
msgid "PC5 can't write the tile's %s."
msgstr "PC5 ne peut pas écrire le fichier %s de la vignette."

#: title/pc5_tile.c:291
msgid "PC5 can't copy its eboot.bin into the tile."
msgstr "PC5 ne peut pas copier son eboot.bin dans la vignette."

#: title/pc5_tile.c:394 title/pc5_tile.c:437
msgid "PC5 can't make the tile's sce_sys."
msgstr "PC5 ne peut pas créer le dossier sce_sys de la vignette."

#: title/pc5_tile.c:398
msgid "PC5 can't make the tile's picture."
msgstr "PC5 ne peut pas créer l'image de la vignette."

#: title/pc5_tile.c:412
msgid "PC5 can't write the tile's pictures."
msgstr "PC5 ne peut pas écrire les images de la vignette."

#: title/pc5_tile.c:444
msgid "PC5 can't write the tile's param.json from its own."
msgstr ""
"PC5 ne peut pas écrire le param.json de la vignette à partir du sien."

#: title/pc5_tile.c:496
msgid "PC5 doesn't know where to make the tile."
msgstr "PC5 ne sait pas où créer la vignette."

#: title/pc5_tile.c:501
#, c-format
msgid "PC5 can't find a free title ID for the tile in %s."
msgstr "PC5 ne trouve pas d'ID de titre libre pour la vignette dans %s."

#: title/pc5_tile.c:511
msgid "The tiles' folder path is too long."
msgstr "Le chemin du dossier des vignettes est trop long."

#: title/pc5_tile.c:527
#, c-format
msgid "PC5 can't replace the tile: %s."
msgstr "PC5 ne peut pas remplacer la vignette : %s."

#: title/pc5_tile.c:533
#, c-format
msgid "PC5 can't put the tile in place: %s."
msgstr "PC5 ne peut pas mettre la vignette en place : %s."

#: title/pc5_tile.c:636 title/pc5_ui.c:4489
msgid ""
"It isn't in PC5 any more. Take the tile off the home screen, or install "
"the game again."
msgstr ""
"Il n'est plus dans PC5. Retirez la vignette de l'écran d'accueil ou "
"réinstallez le jeu."

#: title/pc5_tile.c:697
msgid "PC5 lost its place readying the game."
msgstr "PC5 s'est perdu en préparant le jeu."

