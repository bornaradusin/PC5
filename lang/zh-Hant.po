msgstr "說明"

#: title/pc5_ui.c:7197 title/pc5_ui.c:7931
msgid "Receive from phone"
msgstr "從手機接收"

#: title/pc5_ui.c:7225
msgid "Touchpad + OPTIONS for 2 s still leaves the game"
msgstr "按住觸控板+OPTIONS 2秒仍可離開遊戲"

#: title/pc5_ui.c:7227
msgid "Two fingers: PC5's on-screen keyboard, or a key of its own"
msgstr "雙指：PC5 的螢幕鍵盤，或專屬的按鍵"

#: title/pc5_ui.c:7230
msgid "A key for each half's click and each quick swipe"
msgstr "每半邊的按下和每次快速滑動各對應一個按鍵"

#: title/pc5_ui.c:7231
msgid "A finger moves the pointer; a click sends its key"
msgstr "手指移動指標；按下送出對應的按鍵"

#: title/pc5_ui.c:7232
msgid "The whole touchpad is one button"
msgstr "整個觸控板是一個按鈕"

#: title/pc5_ui.c:7242
msgid "Right stick"
msgstr "右類比搖桿"

#: title/pc5_ui.c:7242
msgid "Left stick"
msgstr "左類比搖桿"

#: title/pc5_ui.c:7250
msgid "Pointer speed"
msgstr "指標速度"

