#: title/pc5_web_page.html:55
msgctxt "web"
msgid "Choose a folder"
msgstr "Choisir un dossier"

#. Web page text.
#: title/pc5_web_page.html:57
msgctxt "web"
msgid ""
"A phone that can't choose a folder: type the game's folder name, then "
"choose its files."
msgstr ""
"Sur un téléphone qui ne peut pas choisir de dossier : saisissez le nom du "
"dossier du jeu, puis choisissez ses fichiers."

#. Web page text.
#: title/pc5_web_page.html:60
msgctxt "web"
msgid "Choose files"
msgstr "Choisir des fichiers"

#. Web page text.
#: title/pc5_web_page.html:66
msgctxt "web"
msgid "Games"
msgstr "Jeux"

#. Web page text.
#: title/pc5_web_page.html:66
msgctxt "web"
msgid "Refresh"
msgstr "Actualiser"

#. Web page text.
#: title/pc5_web_page.html:68 title/pc5_web_page.html:74
msgctxt "web"
msgid "Loading…"
msgstr "Chargement…"

