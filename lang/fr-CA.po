msgstr "Les jeux ne se sont pas chargés : %s"

#. Web page text.
#: title/pc5_web_page.html:232
msgctxt "web"
msgid "No logs kept."
msgstr "Aucun journal conservé."

#. Web page text.
#: title/pc5_web_page.html:236
msgctxt "web"
msgid "had a problem"
msgstr "a eu un problème"

#. Web page text.
#. %s and %d are filled in by the page; %1$s, %2$s put them in another order.
#: title/pc5_web_page.html:239
#, c-format
msgctxt "web"
msgid "The logs didn't load: %s"
msgstr "Les journaux ne se sont pas chargés : %s"

#. Web page text.
#: title/pc5_web_page.html:248
msgctxt "web"
msgid "the connection was lost"
msgstr "la connexion a été perdue"

#. Web page text.
#. %s and %d are filled in by the page; %1$s, %2$s put them in another order.
#: title/pc5_web_page.html:265
#, c-format
msgctxt "web"
msgid "Sending %d of %d: %s"
msgstr "Envoi de %d sur %d : %s"

#. Web page text.
#. %s and %d are filled in by the page; %1$s, %2$s put them in another order.
#: title/pc5_web_page.html:269
#, c-format
msgctxt "web"
msgid "Stopped at %s: %s"
msgstr "Arrêté à %s : %s"

#. Web page text.
#. %s and %d are filled in by the page; %1$s, %2$s put them in another order.
#: title/pc5_web_page.html:276
#, c-format
msgctxt "web"
msgid "Sent %d files (%s). PC5 asks to install the game in a moment."
msgstr ""
"%d fichiers envoyés (%s). PC5 va proposer d'installer le jeu dans un "
"instant."

#. Web page text.
#: title/pc5_web_page.html:285
msgctxt "web"
msgid "Type the game's folder name first (no / or \\)."
msgstr "Saisissez d'abord le nom du dossier du jeu (sans / ni \\)."

