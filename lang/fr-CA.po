#, c-format
msgctxt "web"
msgid "Which game it is (Steam app ID: %s)"
msgstr "De quel jeu il s'agit (ID d'app Steam : %s)"

#. Web page text.
#: title/pc5_web_page.html:135
msgctxt "web"
msgid "none"
msgstr "aucun"

