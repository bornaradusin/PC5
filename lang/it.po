#: title/pc5_web_page.html:320
msgctxt "web"
msgid "Environment variables (env.txt)"
msgstr "Variabili d'ambiente (env.txt)"

#. Web page text.
#: title/pc5_web_page.html:320
msgctxt "web"
msgid "One NAME=value a line, set before the game starts."
msgstr "Un NOME=valore per riga, impostato prima dell'avvio del gioco."

