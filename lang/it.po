msgid "UTF-8 with its mark"
msgstr "UTF-8 con BOM"

#. Web page text.
#: title/pc5_web_page.html:254
msgctxt "web"
msgid "Western (one byte a letter)"
msgstr "Occidentale (un byte per lettera)"

#. Web page text.
#. %s and %d are filled in by the page; %1$s, %2$s put them in another order.
#: title/pc5_web_page.html:255
#, c-format
msgctxt "web"
msgid ""
"%s · %s line ends · %d lines · %s. Saved as it was: the same encoding and "
"line ends. A game reads it at its next start."
msgstr ""
"%s · fine riga %s · %d righe · %s. Salvato com'era: stessa codifica e "
"stessi fine riga. Il gioco lo legge al prossimo avvio."

#. Web page text.
#: title/pc5_web_page.html:257
msgctxt "web"
msgid "Close"
msgstr "Chiudi"

#. Web page text.
#: title/pc5_web_page.html:265
msgctxt "web"
msgid "Saved."
msgstr "Salvato."

#. Web page text.
#: title/pc5_web_page.html:273
msgctxt "web"
msgid "Close without saving the changes?"
msgstr "Chiudere senza salvare le modifiche?"

#. Web page text.
#: title/pc5_web_page.html:278
msgctxt "web"
msgid ""
"Wine writes its .reg files while a game plays: change them only when no "
"game is running."
msgstr ""
"Wine scrive i suoi file .reg mentre un gioco è in esecuzione: modificali "
"solo quando nessun gioco è avviato."

#. Web page text.
#. %s and %d are filled in by the page; %1$s, %2$s put them in another order.
