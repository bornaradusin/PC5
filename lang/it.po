#: title/pc5_files.c:100
msgid "The name is empty."
msgstr "Il nome è vuoto."

#: title/pc5_files.c:101
#, c-format
msgid "\"%s\" can't be a name."
msgstr "“%s” non può essere un nome."

#: title/pc5_files.c:102
msgid "The name is too long: 255 bytes at most."
msgstr "Il nome è troppo lungo: massimo 255 byte."

#: title/pc5_files.c:105
#, c-format
msgid "A name can't have %s in it."
msgstr "Un nome non può contenere %s."

#: title/pc5_files.c:108
msgid "A name can't end in a space or a dot."
msgstr "Un nome non può finire con uno spazio o un punto."

#: title/pc5_files.c:240
#, c-format
msgid "%s has folders too deep to copy."
msgstr "%s ha cartelle troppo profonde per essere copiate."

#: title/pc5_files.c:241 title/pc5_files.c:251 title/pc5_files.c:381
#: title/pc5_files.c:398
#, c-format
msgid "PC5 can't read %s: %s."
msgstr "PC5 non riesce a leggere %s: %s."

#: title/pc5_files.c:256
#, c-format
msgid "A path in %s is too long."
msgstr "Un percorso in %s è troppo lungo."

#: title/pc5_files.c:267
msgid "PC5 ran out of memory planning the copy."
msgstr "PC5 ha esaurito la memoria preparando la copia."

#: title/pc5_files.c:281
msgid "Nothing is chosen."
msgstr "Non hai selezionato niente."

#: title/pc5_files.c:284 title/pc5_files.c:289 title/pc5_tile.c:631
#: title/pc5_upgrade.c:637
msgid "PC5 ran out of memory."
msgstr "PC5 ha esaurito la memoria."

#: title/pc5_files.c:288
msgid "The folder to paste into isn't there any more."
msgstr "La cartella in cui incollare non c'è più."

#: title/pc5_files.c:296
#, c-format
msgid "%s isn't there any more."
msgstr "%s non c'è più."

#: title/pc5_files.c:300
#, c-format
msgid "%s can't go into itself or a folder inside it."
msgstr "%s non può andare dentro sé stesso o in una sua sottocartella."

#: title/pc5_files.c:304
#, c-format
msgid "The path of %s would be too long."
msgstr "Il percorso di %s sarebbe troppo lungo."

#: title/pc5_files.c:319
#, c-format
msgid "PC5 can't find a free name for %s."
msgstr "PC5 non trova un nome libero per %s."

#: title/pc5_files.c:351
#, c-format
msgid "There isn't room: it needs %s and the drive has %s free."
msgstr "Non c'è spazio: servono %s e l'unità ha %s liberi."

#: title/pc5_files.c:357
msgid "PC5 ran out of memory planning the work."
msgstr "PC5 ha esaurito la memoria preparando l'operazione."

#: title/pc5_files.c:385 title/pc5_files.c:406 title/pc5_files.c:419
#: title/pc5_library.c:2352 title/pc5_library.c:2441 title/pc5_library.c:2863
#: title/pc5_library.c:2878 title/pc5_library.c:2884
#, c-format
msgid "PC5 can't write %s: %s."
msgstr "PC5 non riesce a scrivere %s: %s."

#: title/pc5_files.c:391
#, c-format
msgid "PC5 ran out of memory copying %s."
msgstr "PC5 ha esaurito la memoria copiando %s."

#: title/pc5_files.c:427 title/pc5_library.c:1766
#, c-format
msgid "PC5 can't put %s in place: %s."
msgstr "PC5 non riesce a mettere %s al suo posto: %s."

#: title/pc5_files.c:453
#, c-format
msgid "PC5 can't make the folder %s: %s."
msgstr "PC5 non riesce a creare la cartella %s: %s."

#: title/pc5_files.c:459
#, c-format
msgid "PC5 can't move %s: %s."
msgstr "PC5 non riesce a spostare %s: %s."

#: title/pc5_files.c:464
#, c-format
msgid "PC5 ran out of memory deleting %s."
msgstr "PC5 ha esaurito la memoria eliminando %s."

#: title/pc5_ftp.c:626 title/pc5_web.c:1061
msgid "There's no network here."
msgstr "Qui non c'è rete."

#: title/pc5_ftp.c:628 title/pc5_ui.c:2613
msgid "PC5's INSTALL folder isn't there."
msgstr "La cartella INSTALL di PC5 non c'è."

#: title/pc5_ftp.c:633 title/pc5_web.c:1066
#, c-format
msgid "Port %u is taken, or there's no network."
msgstr "La porta %u è occupata, oppure non c'è rete."

#: title/pc5_ftp.c:647 title/pc5_web.c:1080
msgid "PC5 can't start it."
msgstr "PC5 non riesce ad avviarlo."

#: title/pc5_game.c:510
msgid "The app's path is too long."
msgstr "Il percorso dell'app è troppo lungo."

#: title/pc5_game.c:516
msgid "PC5 can't read the app's .NET runtime."
msgstr "PC5 non riesce a leggere il runtime .NET dell'app."

#: title/pc5_game.c:541
msgid "A path of the .NET runtime is too long."
msgstr "Un percorso del runtime .NET è troppo lungo."

#: title/pc5_game.c:546
msgid "PC5 can't make the .NET runtime's folders: is the console full?"
msgstr ""
"PC5 non riesce a creare le cartelle del runtime .NET: la console è piena?"

#: title/pc5_game.c:557
#, c-format
msgid ""
"The app's .NET runtime has no %.80s. Copy the PPSA11018 folder to the "
"console again."
msgstr ""
"Nel runtime .NET dell'app manca %.80s. Copia di nuovo la cartella "
"PPSA11018 sulla console."

#: title/pc5_game.c:563
msgid "PC5 can't copy the .NET runtime: is the console full?"
msgstr "PC5 non riesce a copiare il runtime .NET: la console è piena?"

#: title/pc5_game.c:571
msgid "PC5 can't finish the .NET runtime's copy."
msgstr "PC5 non riesce a completare la copia del runtime .NET."

#: title/pc5_home.c:157
msgid "The tile's program is missing from PC5's app (pc5/forwarder)."
msgstr "Nell'app di PC5 manca il programma dei riquadri (pc5/forwarder)."

#: title/pc5_home.c:161
#, c-format
msgid "PC5 can't use %s: %s."
msgstr "PC5 non riesce a usare %s: %s."

#: title/pc5_home.c:165
msgid "PC5 ran out of memory making the tile's picture."
msgstr "PC5 ha esaurito la memoria creando l'immagine del riquadro."

#: title/pc5_home.c:180
#, c-format
msgid "PC5 can't write the tile in %s: %s."
msgstr "PC5 non riesce a scrivere il riquadro in %s: %s."

#: title/pc5_library.c:169
#, c-format
msgid ""
"Plug in the USB drive with %.100s: it plays from the folder %.200s on it."
msgstr ""
"Collega l'unità USB con %.100s: il gioco si avvia dalla sua cartella "
"%.200s."

#: title/pc5_library.c:175 title/pc5_library.c:2759 title/pc5_library.c:2810
#, c-format
msgid "PC5 can't make the game's folder: %s."
msgstr "PC5 non riesce a creare la cartella del gioco: %s."

#: title/pc5_library.c:195
#, c-format
msgid "PC5 can't link the game's folder on the USB drive: %s."
msgstr "PC5 non riesce a collegare la cartella del gioco sull'unità USB: %s."

#: title/pc5_library.c:501 title/pc5_library.c:518
msgid "Choose one of the game's programs."
msgstr "Scegli uno dei programmi del gioco."

#: title/pc5_library.c:514 title/pc5_library.c:664 title/pc5_library.c:888
msgid "PC5's notes on this game are missing."
msgstr "Mancano le note di PC5 su questo gioco."

#: title/pc5_library.c:526
msgid "That program is too deep in the game's folder for Windows."
msgstr ""
"Questo programma è troppo in profondità nella cartella del gioco per "
"Windows."

#: title/pc5_library.c:531 title/pc5_library.c:1783 title/pc5_library.c:2496
#: title/pc5_library.c:2499 title/pc5_library.c:2508 title/pc5_library.c:2580
#: title/pc5_library.c:2772
#, c-format
msgid "PC5 can't write its notes: %s."
msgstr "PC5 non riesce a scrivere le sue note: %s."

#: title/pc5_library.c:552
msgid "PC5 is out of memory."
msgstr "PC5 ha esaurito la memoria."

#: title/pc5_library.c:556
#, c-format
msgid "%.200s doesn't start any of the game's programs."
msgstr "%.200s non avvia nessuno dei programmi del gioco."

#: title/pc5_library.c:756
msgid "The game's launch options are too long: 511 characters at most."
msgstr ""
"Le opzioni di avvio del gioco sono troppo lunghe: massimo 511 caratteri."

#: title/pc5_library.c:773
msgid "The game's path is too long for Windows."
msgstr "Il percorso del gioco è troppo lungo per Windows."

#: title/pc5_library.c:789 title/pc5_library.c:967
#, c-format
msgid "PC5 can't write the game's profile: %s."
msgstr "PC5 non riesce a scrivere il profilo del gioco: %s."

#: title/pc5_library.c:913
#, c-format
msgid "The program its launcher started isn't one of the game's: %.200s"
msgstr ""
"Il programma avviato dal suo launcher non è uno di quelli del gioco: %.200s"

#: title/pc5_library.c:927
msgid "The arguments its launcher gave are too long."
msgstr "Gli argomenti passati dal suo launcher sono troppo lunghi."

#: title/pc5_library.c:949
#, c-format
msgid "Its programs kept starting each other: %d hand-offs in a row."
msgstr ""
"I suoi programmi continuavano ad avviarsi a vicenda: %d passaggi di fila."

#: title/pc5_library.c:963
msgid "The program's path is too long for Windows."
msgstr "Il percorso del programma è troppo lungo per Windows."

#: title/pc5_library.c:1022
#, c-format
msgid "Its profile has a mistake (%s)."
msgstr "Il suo profilo contiene un errore (%s)."

#: title/pc5_library.c:1039
msgid "Its Windows folder is missing."
msgstr "Manca la sua cartella Windows."

#: title/pc5_library.c:1179
#, c-format
msgid "PC5 can't delete %s: %s."
msgstr "PC5 non riesce a eliminare %s: %s."

#: title/pc5_library.c:1278 title/pc5_library.c:1553 title/pc5_library.c:1608
#, c-format
msgid "PC5 can't move the game's folder: %s."
msgstr "PC5 non riesce a spostare la cartella del gioco: %s."

#: title/pc5_library.c:1287 title/pc5_library.c:1558
#, c-format
msgid "PC5 can't delete the game's profile: %s."
msgstr "PC5 non riesce a eliminare il profilo del gioco: %s."

#: title/pc5_library.c:1301 title/pc5_library.c:1545 title/pc5_library.c:2645
#: title/pc5_library.c:2653
msgid "A path is too long."
msgstr "Un percorso è troppo lungo."

#: title/pc5_library.c:1504
msgid "PC5 can't read the game's folder."
msgstr "PC5 non riesce a leggere la cartella del gioco."

#: title/pc5_library.c:1512 title/pc5_library.c:1763 title/pc5_library.c:2840
#, c-format
msgid "A path in the game is too long: %s."
msgstr "Un percorso nel gioco è troppo lungo: %s."

#: title/pc5_library.c:1521
#, c-format
msgid "PC5 can't keep %s: %s."
msgstr "PC5 non riesce a conservare %s: %s."

#: title/pc5_library.c:1577
#, c-format
msgid "PC5 can't put the saves in place: %s."
msgstr "PC5 non riesce a rimettere a posto i salvataggi: %s."

#: title/pc5_library.c:1591
msgid "This game's saves can't be kept apart from it."
msgstr "I salvataggi di questo gioco non possono essere conservati a parte."

#: title/pc5_library.c:1597
#, c-format
msgid "PC5 can't make its saves folder: %s."
msgstr "PC5 non riesce a creare la cartella dei salvataggi: %s."

#: title/pc5_library.c:1601
msgid "PC5 is still keeping this game's saves from before: start PC5 again."
msgstr ""
"PC5 sta ancora conservando i vecchi salvataggi di questo gioco: riavvia "
"PC5."

#: title/pc5_library.c:1634
#, c-format
msgid "PC5 can't move the saves: %s."
msgstr "PC5 non riesce a spostare i salvataggi: %s."

#: title/pc5_library.c:1721
#, c-format
msgid "A path in the update is too long: %s."
msgstr "Un percorso nell'aggiornamento è troppo lungo: %s."

#: title/pc5_library.c:1803
#, c-format
msgid "PC5 can't write the game's list of files: %s."
msgstr "PC5 non riesce a scrivere l'elenco dei file del gioco: %s."

#: title/pc5_library.c:2121
msgid ""
"PC5's Windows template is missing from the app: copy the PC5 folder again."
msgstr ""
"Nell'app manca il modello Windows di PC5: copia di nuovo la cartella PC5."

#: title/pc5_library.c:2145
msgid "PC5's Windows template is damaged: copy the PC5 folder again."
msgstr ""
"Il modello Windows di PC5 è danneggiato: copia di nuovo la cartella PC5."

#: title/pc5_library.c:2227 title/pc5_library.c:2287
#, c-format
msgid "PC5 can't make its folders in %s: %s."
msgstr "PC5 non riesce a creare le sue cartelle in %s: %s."

#: title/pc5_library.c:2238
#, c-format
msgid "PC5 can't make its folder on the USB drive: %s."
msgstr "PC5 non riesce a creare la sua cartella sull'unità USB: %s."

#: title/pc5_library.c:2241
msgid "PC5 can't name the game's folder on the USB drive."
msgstr ""
"PC5 non riesce a dare un nome alla cartella del gioco sull'unità USB."

#: title/pc5_library.c:2259
#, c-format
msgid ""
"The drive reads at %.0f MB/s here, too slow to play from (%.0f needed). "
"Plug it into a port on the back or the front USB-C port. Installing to the "
"console still works."
msgstr ""
"Qui l'unità legge a %.0f MB/s, troppo lenta per giocarci (ne servono "
"%.0f). Collegala a una porta posteriore o alla porta USB-C anteriore. "
"L'installazione sulla console funziona comunque."

#: title/pc5_library.c:2267
#, c-format
msgid ""
"Not enough space on the USB drive: the game needs %s and it has %s free."
msgstr ""
"Spazio insufficiente sull'unità USB: il gioco richiede %s e ne restano %s "
"liberi."

#: title/pc5_library.c:2271
msgid ""
"Only a game on a USB drive can play from it: this folder isn't on one."
msgstr ""
"Solo un gioco su un'unità USB può avviarsi da lì: questa cartella non è su "
"un'unità USB."

#: title/pc5_library.c:2273
msgid "A game in PC5's INSTALL folder is installed, not played from there."
msgstr ""
"Un gioco nella cartella INSTALL di PC5 si installa, non si avvia da lì."

#: title/pc5_library.c:2278
#, c-format
msgid ""
"The drive reads at %.0f MB/s in this USB port, too slow to play from (at "
"least %.0f is needed). On the original PS5 the front USB-A port is the "
"slow one: plug the drive into a port on the back, or the front USB-C port. "
"Install still works from this port."
msgstr ""
"Su questa porta USB l'unità legge a %.0f MB/s, troppo lenta per giocarci "
"(ne servono almeno %.0f). Sulla PS5 originale la porta lenta è quella "
"USB-A anteriore: collega l'unità a una porta posteriore o alla porta USB-C "
"anteriore. L'installazione da questa porta funziona comunque."

#: title/pc5_library.c:2284
msgid "The game's program is too deep in its folder for Windows."
msgstr ""
"Il programma del gioco è troppo in profondità nella sua cartella per "
"Windows."

#: title/pc5_library.c:2292
#, c-format
msgid "Not enough space: the game needs %s and the console has %s free."
msgstr ""
"Spazio insufficiente: il gioco richiede %s e la console ha %s liberi."

#: title/pc5_library.c:2295
msgid "PC5 can't name the game."
msgstr "PC5 non riesce a dare un nome al gioco."

#: title/pc5_library.c:2298
#, c-format
msgid "PC5 can't start the install: %s."
msgstr "PC5 non riesce ad avviare l'installazione: %s."

#: title/pc5_library.c:2305 title/pc5_library.c:2378 title/pc5_library.c:2414
#: title/pc5_library.c:2661
msgid "Out of memory."
msgstr "Memoria esaurita."

#: title/pc5_library.c:2338
msgid "A path in the Windows template is too long."
msgstr "Un percorso del modello Windows è troppo lungo."

#: title/pc5_library.c:2341 title/pc5_library.c:2346 title/pc5_library.c:2847
#: title/pc5_tile.c:519
#, c-format
msgid "PC5 can't make %s: %s."
msgstr "PC5 non riesce a creare %s: %s."

#: title/pc5_library.c:2349
#, c-format
msgid "PC5's Windows template is missing %s."
msgstr "Nel modello Windows di PC5 manca %s."

#: title/pc5_library.c:2367
#, c-format
msgid "PC5 can't copy %s: %s."
msgstr "PC5 non riesce a copiare %s: %s."

#: title/pc5_library.c:2392
#, c-format
msgid "PC5 can't read %s on the USB drive: %s."
msgstr "PC5 non riesce a leggere %s sull'unità USB: %s."

#: title/pc5_library.c:2433 title/pc5_library.c:2857
#, c-format
msgid "PC5 can't read back %s: %s."
msgstr "PC5 non riesce a rileggere %s: %s."

#: title/pc5_library.c:2433
#, c-format
msgid "The USB drive stopped answering while PC5 copied %s (%s)."
msgstr "L'unità USB ha smesso di rispondere mentre PC5 copiava %s (%s)."

#: title/pc5_library.c:2461 title/pc5_library.c:2473
#, c-format
msgid ""
"The game couldn't be put back in the INSTALL folder: it is in %.180s."
msgstr ""
"Non è stato possibile rimettere il gioco nella cartella INSTALL: si trova "
"in %.180s."

#: title/pc5_library.c:2512
#, c-format
msgid "PC5 can't save the cover: %s."
msgstr "PC5 non riesce a salvare la copertina: %s."

#: title/pc5_library.c:2519
#, c-format
msgid "PC5 can't put the game in place: %s."
msgstr "PC5 non riesce a mettere il gioco al suo posto: %s."

#: title/pc5_library.c:2626
msgid "PC5 didn't install this game, so it can't update it."
msgstr "PC5 non ha installato questo gioco, quindi non può aggiornarlo."

#: title/pc5_library.c:2628
#, c-format
msgid ""
"%s plays from its USB drive: copy the newer version over its folder %s "
"there."
msgstr ""
"%s si avvia dalla sua unità USB: copia lì la versione più recente sopra la "
"sua cartella %s."

#: title/pc5_library.c:2633
msgid "The game's folder is missing: uninstall it and install it again."
msgstr "Manca la cartella del gioco: disinstallalo e installalo di nuovo."

#: title/pc5_library.c:2636
#, c-format
msgid ""
"This folder doesn't have %s, the program %s starts. Choose the folder of a "
"newer copy of %s."
msgstr ""
"Questa cartella non contiene %s, il programma che avvia %s. Scegli la "
"cartella di una copia più recente di %s."

#: title/pc5_library.c:2650
#, c-format
msgid "Not enough space: the update needs %s and the console has %s free."
msgstr ""
"Spazio insufficiente: l'aggiornamento richiede %s e la console ha %s "
"liberi."

#: title/pc5_library.c:2656
msgid ""
"An earlier update of this game isn't finished: close PC5 and open it again "
"to finish it."
msgstr ""
"Un aggiornamento precedente di questo gioco non è finito: chiudi PC5 e "
"riaprilo per completarlo."

#: title/pc5_library.c:2658
#, c-format
msgid "PC5 can't start the update: %s."
msgstr "PC5 non riesce ad avviare l'aggiornamento: %s."

#: title/pc5_library.c:2687
msgid ""
"Kept saves can't be put back for a game that plays from its USB drive."
msgstr ""
"I salvataggi conservati non si possono ripristinare per un gioco che si "
"avvia dalla sua unità USB."

#: title/pc5_library.c:2691
msgid "The install has begun already."
msgstr "L'installazione è già iniziata."

#: title/pc5_library.c:2707
msgid "PC5 can't read the kept saves."
msgstr "PC5 non riesce a leggere i salvataggi conservati."

#: title/pc5_library.c:2707
msgid "The kept saves are damaged: they have no registry."
msgstr "I salvataggi conservati sono danneggiati: manca il registro."

#: title/pc5_library.c:2784
#, c-format
msgid "PC5 can't make the game's folder on the USB drive: %s."
msgstr "PC5 non riesce a creare la cartella del gioco sull'unità USB: %s."

#: title/pc5_library.c:2857
#, c-format
msgid "PC5 can't open %s on the USB drive: %s."
msgstr "PC5 non riesce ad aprire %s sull'unità USB: %s."

#: title/pc5_library.c:2895
#, c-format
msgid ""
"The copy of %s doesn't match the USB drive. The drive or its cable may be "
"failing; nothing was kept."
msgstr ""
"La copia di %s non corrisponde all'unità USB. L'unità o il cavo potrebbero "
"essere guasti; non è stato conservato niente."

