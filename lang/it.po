#, c-format
msgid "PC5 can't read %.200s."
msgstr "PC5 non riesce a leggere %.200s."

#: title/pc5_source.c:321
#, c-format
msgid "Windows can't use the name \"%.180s\"."
msgstr "Windows non può usare il nome “%.180s”."

