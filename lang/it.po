msgid "There is no other program in its folder to start."
msgstr "Nella sua cartella non c'è nessun altro programma da avviare."

#: title/pc5_ui.c:5636
#, c-format
msgid "%s wasn't uninstalled"
msgstr "%s non è stato disinstallato"

#: title/pc5_ui.c:5637
#, c-format
msgid "%s Nothing was changed."
msgstr "%s Non è cambiato niente."

