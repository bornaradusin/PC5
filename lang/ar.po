#: title/pc5_ui.c:7037
msgid "Delete this game's imported music; the original source file is kept"
msgstr "حذف موسيقى اللعبة المستوردة؛ يبقى ملف المصدر الأصلي"

#. A menu row's name (about 30 characters fit).
#: title/pc5_ui.c:7041 title/pc5_ui.c:7970
msgid "Tile picture"
msgstr "صورة الاختصار"

#: title/pc5_ui.c:7042
msgid ""
"Its home screen tile's picture: a square one found online, or one made "
