msgctxt "web"
msgid "Sent %d files (%s). PC5 asks to install the game in a moment."
msgstr ""
"Se enviaron %d archivos (%s). PC5 pedirá instalar el juego en un momento."

#. Web page text.
#: title/pc5_web_page.html:393
msgctxt "web"
msgid "Type the game's folder name first (no / or \\)."
msgstr "Escribe primero el nombre de la carpeta del juego (sin / ni \\)."

