msgstr "Su imagen y su fondo"

#: title/pc5_ui.c:7089
msgid "A newer one may have fixed it"
msgstr "Puede que una versión más reciente lo haya solucionado"

#: title/pc5_ui.c:7092
#, c-format
msgid "Update to PC5 %s first?"
msgstr "¿Actualizar primero a PC5 %s?"

#: title/pc5_ui.c:7094
#, c-format
msgid "You have %s"
msgstr "Tienes la %s"

#: title/pc5_ui.c:7095
#, c-format
msgid ""
"This may already be fixed in it. Update, try the game again, and report it "
