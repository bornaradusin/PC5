msgid "The install has begun already."
msgstr "Установка уже началась."

#: title/pc5_library.c:2650
msgid "PC5 can't read the kept saves."
msgstr "PC5 не может прочитать оставленные сохранения."

#: title/pc5_library.c:2650
msgid "The kept saves are damaged: they have no registry."
msgstr "Оставленные сохранения повреждены: в них нет реестра."

#: title/pc5_library.c:2727
#, c-format
msgid "PC5 can't make the game's folder on the USB drive: %s."
msgstr "PC5 не может создать папку игры на USB-накопителе: %s."

#: title/pc5_library.c:2800
#, c-format
msgid "PC5 can't open %s on the USB drive: %s."
msgstr "PC5 не может открыть %s на USB-накопителе: %s."

#: title/pc5_library.c:2838
#, c-format
msgid ""
"The copy of %s doesn't match the USB drive. The drive or its cable may be "
"failing; nothing was kept."
msgstr ""
"Копия %s не совпадает с USB-накопителем. Возможно, неисправен накопитель "
"или кабель; ничего не сохранено."

