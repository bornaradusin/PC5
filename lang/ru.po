#, c-format
msgid "PC5 can't save the cover: %s."
msgstr "PC5 не может сохранить обложку: %s."

#: title/pc5_library.c:2462
#, c-format
msgid "PC5 can't put the game in place: %s."
msgstr "PC5 не может поставить игру на место: %s."

