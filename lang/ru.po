#, c-format
msgctxt "web"
msgid "Not opened: %s"
msgstr "Не открыто: %s"

#. Web page text.
#: title/pc5_web_page.html:281
msgctxt "web"
msgid ""
"Text files only (.ini, .cfg, .txt, .json, .reg and the like), up to 8 MB. "
"The console's File manager changes them too, a line at a time."
msgstr ""
"Только текстовые файлы (.ini, .cfg, .txt, .json, .reg и подобные), до 8 "
"МБ. Файловый менеджер консоли тоже их меняет, по строке."

#. Web page text.
#: title/pc5_web_page.html:292
msgctxt "web"
msgid "No games yet."
msgstr "Игр пока нет."

#. Web page text.
#: title/pc5_web_page.html:295
msgctxt "web"
msgid "USB drive"
msgstr "USB-накопитель"

#. Web page text.
#: title/pc5_web_page.html:296
msgctxt "web"
msgid "can't start"
msgstr "не запускается"

