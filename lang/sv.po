#: title/pc5_web_page.html:320
msgctxt "web"
msgid "Environment variables (env.txt)"
msgstr "Miljövariabler (env.txt)"

#. Web page text.
#: title/pc5_web_page.html:320
msgctxt "web"
msgid "One NAME=value a line, set before the game starts."
msgstr "En NAMN=värde per rad, sätts innan spelet startar."

#. Web page text.
#: title/pc5_web_page.html:321
msgctxt "web"
msgid "Extra logging (winedebug.txt)"
msgstr "Extra loggning (winedebug.txt)"

#. Web page text.
#: title/pc5_web_page.html:322
msgctxt "web"
msgid ""
"Only when an issue asks for it, for example err+all,+seh. Empty it "
"afterwards: it slows the game down."
msgstr ""
"Bara när ett ärende ber om det, till exempel err+all,+seh. Töm det "
"efteråt: det gör spelet långsammare."

