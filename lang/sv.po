#: title/pc5_web_page.html:201
msgctxt "web"
msgid "Report a problem"
msgstr "Rapportera ett problem"

#. Web page text.
#: title/pc5_web_page.html:202
msgctxt "web"
msgid ""
"Downloads the newest log and opens GitHub's form, filled in: attach the "
"log there."
msgstr ""
"Laddar ned den senaste loggen och öppnar GitHubs formulär, ifyllt: bifoga "
"loggen där."

