msgstr "Öppnades inte: %s"

#. Web page text.
#: title/pc5_web_page.html:283
msgctxt "web"
msgid ""
"Text files only (.ini, .cfg, .txt, .json, .reg and the like), up to 8 MB. "
"The console's File manager changes them too, a line at a time."
msgstr ""
"Bara textfiler (.ini, .cfg, .txt, .json, .reg och liknande), upp till 8 "
"MB. Konsolens filhanterare ändrar dem också, en rad i taget."

#. Web page text.
#: title/pc5_web_page.html:294
msgctxt "web"
msgid "No games yet."
msgstr "Inga spel än."

#. Web page text.
#: title/pc5_web_page.html:297
msgctxt "web"
msgid "USB drive"
msgstr "USB-enhet"

#. Web page text.
#: title/pc5_web_page.html:298
msgctxt "web"
msgid "can't start"
msgstr "kan inte starta"

