msgstr "PC5 fick slut på minne när %s kopierades."

#: title/pc5_files.c:427 title/pc5_library.c:1709
#, c-format
msgid "PC5 can't put %s in place: %s."
msgstr "PC5 kan inte lägga %s på plats: %s."

