msgstr "Miljövariabler (env.txt)"

#. Web page text.
#: title/pc5_web_page.html:212
msgctxt "web"
msgid "One NAME=value a line, set before the game starts."
msgstr "En NAMN=värde per rad, sätts innan spelet startar."

#. Web page text.
#: title/pc5_web_page.html:213
