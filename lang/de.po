#, c-format
msgid "PC5 ran out of memory copying %s."
msgstr "PC5 hatte beim Kopieren von %s nicht genug Speicher."

#: title/pc5_files.c:427 title/pc5_library.c:1766
#, c-format
msgid "PC5 can't put %s in place: %s."
msgstr "PC5 kann %s nicht an seinen Platz bringen: %s."

