msgid "Stopped at %s: %s"
msgstr "Angehalten bei %s: %s"

#. Web page text.
#. %s and %d are filled in by the page; %1$s, %2$s put them in another order.
#: title/pc5_web_page.html:382
#, c-format
msgctxt "web"
msgid "Sent %d files (%s). PC5 asks to install the game in a moment."
msgstr ""
"%d Dateien gesendet (%s). PC5 fragt gleich, ob das Spiel installiert "
"werden soll."

#. Web page text.
#: title/pc5_web_page.html:391
msgctxt "web"
msgid "Type the game's folder name first (no / or \\)."
msgstr "Gib zuerst den Ordnernamen des Spiels ein (ohne / oder \\)."

#~ msgid "Maximum: all of it, for a game that says there is too little."
#~ msgstr "Maximum: alles, für ein Spiel, das meldet, es sei zu wenig."

#~ msgid "Loading"
#~ msgstr "Wird geladen"

#~ msgid "Wine's VKD3D"
#~ msgstr "VKD3D von Wine"

#~ msgid "WineD3D on Vulkan"
#~ msgstr "WineD3D über Vulkan"

#~ msgid "SoC temperature"
#~ msgstr "SoC-Temperatur"

#~ msgid "Its program is set in its prospero-win profile."
#~ msgstr "Sein Programm ist in seinem prospero-win-Profil festgelegt."

#~ msgid "Hides when unused"
#~ msgstr "Blendet sich aus"

#~ msgid "Game controlled"
#~ msgstr "Spielgesteuert"

#~ msgid "Wine's own Direct3D draws it; change it only if the picture is wrong"
#~ msgstr ""
#~ "Wines eigenes Direct3D zeichnet es; nur ändern, wenn das Bild falsch ist"

#~ msgid "Wine's own Direct3D 12; if it doesn't help, set it back to Auto"
#~ msgstr ""
#~ "Wines eigenes Direct3D 12; wenn es nicht hilft, stell es zurück auf Auto"

#~ msgid ""
#~ "Wine's own Direct3D on Vulkan; if it doesn't help, set it back to Auto"
#~ msgstr ""
#~ "Wines eigenes Direct3D über Vulkan; wenn es nicht hilft, stell es zurück "
#~ "auf Auto"

#~ msgid ""
#~ "Wine's own Direct3D on OpenGL; if it doesn't help, set it back to Auto"
#~ msgstr ""
#~ "Wines eigenes Direct3D über OpenGL; wenn es nicht hilft, stell es zurück "
#~ "auf Auto"

#~ msgid "Graphics API"
#~ msgstr "Grafik-API"

#~ msgid "As Windows: 4 GB for a game made for it, otherwise 2 GB"
#~ msgstr "Wie Windows: 4 GB für ein Spiel, das dafür gemacht ist, sonst 2 GB"

#~ msgid "Video memory"
#~ msgstr "Videospeicher"

#~ msgid "2 GB at most, a number older games' checks can read"
#~ msgstr ""
#~ "Höchstens 2 GB, eine Zahl, die die Prüfungen älterer Spiele lesen können"

#~ msgid "Full"
#~ msgstr "Voll"

#~ msgid "CPU sharing"
#~ msgstr "CPU-Teilung"

#~ msgid "Its threads take turns, as on a PC: steadier for some games"
#~ msgstr ""
#~ "Seine Threads wechseln sich ab, wie am PC: stabiler bei manchen Spielen"

#~ msgid ""
#~ "PC5's choice: VKD3D-Proton turns the game's Direct3D 12 into Vulkan. The "
#~ "fastest, and what most games want."
#~ msgstr ""
#~ "Wahl von PC5: VKD3D-Proton wandelt das Direct3D 12 des Spiels in Vulkan "
#~ "um. Am schnellsten, und was die meisten Spiele wollen."

#~ msgid ""
#~ "PC5's choice: Wine's own Direct3D draws the game's DirectDraw with OpenGL."
#~ msgstr ""
#~ "Wahl von PC5: Wines eigenes Direct3D zeichnet das DirectDraw des Spiels "
#~ "mit OpenGL."

#~ msgid ""
#~ "PC5's choice: DXVK turns the game's Direct3D into Vulkan. The fastest, and "
#~ "what most games want."
#~ msgstr ""
#~ "Wahl von PC5: DXVK wandelt das Direct3D des Spiels in Vulkan um. Am "
#~ "schnellsten, und was die meisten Spiele wollen."

#~ msgid ""
#~ "Wine's own Direct3D 12 (VKD3D). Slower than Auto; try it if the game won't "
#~ "start or draws wrong."
#~ msgstr ""
#~ "Wines eigenes Direct3D 12 (VKD3D). Langsamer als Auto; probier es, wenn "
#~ "das Spiel nicht startet oder falsch zeichnet."

#~ msgid ""
#~ "Wine's own Direct3D, drawing with Vulkan. Try it if the game draws wrong "
#~ "with Auto; often faster than WineD3D."
#~ msgstr ""
#~ "Wines eigenes Direct3D, zeichnet mit Vulkan. Probier es, wenn das Spiel "
#~ "mit Auto falsch zeichnet; oft schneller als WineD3D."

#~ msgid ""
#~ "Wine's own Direct3D, drawing with OpenGL. The slowest; try it if the game "
#~ "won't start with the others."
#~ msgstr ""
#~ "Wines eigenes Direct3D, zeichnet mit OpenGL. Am langsamsten; probier es, "
#~ "wenn das Spiel mit den anderen nicht startet."

#~ msgid ""
#~ "A .NET program: it runs with Wine Mono, which PC5 sets up the first time a "
#~ ".NET game starts."
#~ msgstr ""
#~ "Ein .NET-Programm: Es läuft mit Wine Mono, das PC5 beim ersten Start eines "
#~ ".NET-Spiels einrichtet."

#~ msgid "Games players have tried, on your phone with a QR code"
#~ msgstr "Von Spielern getestete Spiele, per QR-Code auf deinem Handy"

#~ msgid "Focus mode"
#~ msgstr "Fokusmodus"

#~ msgid "Shown"
#~ msgstr "Angezeigt"

#~ msgid ""
#~ "Scan the code with your phone: PC5's wiki opens on the list of games "
#~ "players have tried, how each ran and the settings that helped."
#~ msgstr ""
#~ "Scanne den Code mit deinem Handy: Das Wiki von PC5 öffnet sich mit der "
#~ "Liste der Spiele, die Spieler getestet haben, wie jedes lief und welche "
#~ "Einstellungen geholfen haben."

#~ msgid ""
#~ "On your phone or computer, open "
#~ "github.com/bornaradusin/PC5/wiki/Game-compatibility: the games players "
#~ "have tried, how each ran and the settings that helped."
#~ msgstr ""
#~ "Öffne auf deinem Handy oder Computer "
#~ "github.com/bornaradusin/PC5/wiki/Game-compatibility: die Spiele, die "
#~ "Spieler getestet haben, wie jedes lief und welche Einstellungen geholfen "
#~ "haben."

#~ msgid ""
#~ "Got a game running? Add a game, at the top of the list's page: the form "
#~ "takes a minute. You need a GitHub account."
#~ msgstr ""
#~ "Läuft ein Spiel bei dir? „Add a game“ oben auf der Seite der Liste: Das "
#~ "Formular dauert eine Minute. Du brauchst ein GitHub-Konto."

#~ msgid "Keep changing"
#~ msgstr "Weiter ändern"

#~ msgid "Vibration, light bar and triggers"
#~ msgstr "Vibration, Lichtleiste und Trigger"

#~ msgid "Off. On holds the game at 30 fps and shows 60"
#~ msgstr "Aus. An hält das Spiel bei 30 fps und zeigt 60"
