#, c-format
msgid "version %s"
msgstr "Version %s"

#: title/pc5_ui.c:7632
msgid "Like PC5?"
msgstr "Gefällt dir PC5?"

#: title/pc5_ui.c:7635
msgid "Buy me a coffee"
msgstr "Spendier mir einen Kaffee"

#: title/pc5_ui.c:7639
#, c-format
msgid "Games are kept in %.150s"
msgstr "Spiele liegen in %.150s"

#: title/pc5_ui.c:7643
#, c-format
msgid "%s free on the console"
msgstr "%s frei auf der Konsole"

#: title/pc5_ui.c:7708
msgid "INSTALL folder"
msgstr "INSTALL-Ordner"

#: title/pc5_ui.c:7710
#, c-format
msgid "INSTALL folder, %.20s"
msgstr "INSTALL-Ordner, %.20s"

#: title/pc5_ui.c:7726
msgid "No program found: it will be skipped"
msgstr "Kein Programm gefunden: Es wird übersprungen"

