msgid "There isn't memory enough to open it."
msgstr "Zum Öffnen reicht der Speicher nicht."

#: title/pc5_textdoc.c:230
msgid "It has more lines than PC5 can show."
msgstr "Sie hat mehr Zeilen, als PC5 zeigen kann."

#: title/pc5_textdoc.c:374
#, c-format
msgid ""
"This file is in an older encoding with room for Western letters only, and "
"“%s” isn't one of them."
msgstr ""
"Diese Datei hat eine ältere Kodierung, die nur westliche Buchstaben kennt, "
"und „%s“ gehört nicht dazu."

