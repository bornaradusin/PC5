#, c-format
msgid "The USB drive stopped answering while PC5 copied %s (%s)."
msgstr "USB-enheten sluttet å svare mens PC5 kopierte %s (%s)."

#: title/pc5_library.c:2555 title/pc5_library.c:2567
#, c-format
msgid ""
"The game couldn't be put back in the INSTALL folder: it is in %.180s."
msgstr ""
"Spillet kunne ikke legges tilbake i INSTALL-mappen: det ligger i %.180s."

#: title/pc5_library.c:2606
#, c-format
msgid "PC5 can't save the cover: %s."
msgstr "PC5 kan ikke lagre omslaget: %s."

#: title/pc5_library.c:2613
#, c-format
msgid "PC5 can't put the game in place: %s."
msgstr "PC5 kan ikke legge spillet på plass: %s."

