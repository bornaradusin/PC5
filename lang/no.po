msgstr ""
"PC5 holder fortsatt på med spillets tidligere lagringsfiler: start PC5 på "
"nytt."

#: title/pc5_library.c:1728
#, c-format
msgid "PC5 can't move the saves: %s."
msgstr "PC5 kan ikke flytte lagringsfilene: %s."

