msgstr ""
"Appens .NET-kjøremiljø mangler %.80s. Kopier mappen PPSA11018 til "
"konsollen på nytt."

#: title/pc5_game.c:597
msgid "PC5 can't copy the .NET runtime: is the console full?"
msgstr "PC5 kan ikke kopiere .NET-kjøremiljøet: er konsollen full?"

#: title/pc5_game.c:605
msgid "PC5 can't finish the .NET runtime's copy."
msgstr "PC5 får ikke fullført kopieringen av .NET-kjøremiljøet."

