#, c-format
msgid "%s closed soon after starting"
msgstr ""

#: title/pc5_ui.c:3372 title/pc5_ui.c:3377
#, c-format
msgid "Its log is kept as %.120s in %.120s."
msgstr "Loggen er lagret som %.120s i %.120s."

