#, c-format
msgid "PC5 can't make the folder %s: %s."
msgstr "PC5 nu poate crea folderul %s: %s."

#: title/pc5_files.c:459
#, c-format
msgid "PC5 can't move %s: %s."
msgstr "PC5 nu poate muta %s: %s."

#: title/pc5_files.c:464
#, c-format
msgid "PC5 ran out of memory deleting %s."
msgstr "PC5 a rămas fără memorie în timp ce ștergea %s."

#: title/pc5_ftp.c:626 title/pc5_web.c:884
msgid "There's no network here."
msgstr "Nu există rețea aici."

#: title/pc5_ftp.c:628 title/pc5_ui.c:2454
msgid "PC5's INSTALL folder isn't there."
msgstr "Folderul INSTALL al PC5 nu există."

#: title/pc5_ftp.c:633 title/pc5_web.c:889
#, c-format
msgid "Port %u is taken, or there's no network."
msgstr "Portul %u e ocupat sau nu există rețea."

#: title/pc5_ftp.c:647 title/pc5_web.c:903
msgid "PC5 can't start it."
msgstr "PC5 nu îl poate porni."

#: title/pc5_game.c:415
msgid "The app's path is too long."
msgstr "Calea aplicației e prea lungă."

#: title/pc5_game.c:421
msgid "PC5 can't read the app's .NET runtime."
msgstr "PC5 nu poate citi runtime-ul .NET al aplicației."

#: title/pc5_game.c:446
msgid "A path of the .NET runtime is too long."
msgstr "O cale din runtime-ul .NET e prea lungă."

#: title/pc5_game.c:451
msgid "PC5 can't make the .NET runtime's folders: is the console full?"
msgstr "PC5 nu poate crea folderele runtime-ului .NET: e consola plină?"

#: title/pc5_game.c:462
#, c-format
msgid ""
"The app's .NET runtime has no %.80s. Copy the PPSA11018 folder to the "
"console again."
msgstr ""
"Runtime-ul .NET al aplicației nu are %.80s. Copiază din nou folderul "
"PPSA11018 pe consolă."

#: title/pc5_game.c:468
msgid "PC5 can't copy the .NET runtime: is the console full?"
msgstr "PC5 nu poate copia runtime-ul .NET: e consola plină?"

#: title/pc5_game.c:476
msgid "PC5 can't finish the .NET runtime's copy."
msgstr "PC5 nu poate termina copierea runtime-ului .NET."

#: title/pc5_home.c:157
msgid "The tile's program is missing from PC5's app (pc5/forwarder)."
msgstr "Programul scurtăturii lipsește din aplicația PC5 (pc5/forwarder)."

#: title/pc5_home.c:161
#, c-format
msgid "PC5 can't use %s: %s."
msgstr "PC5 nu poate folosi %s: %s."

#: title/pc5_home.c:165
msgid "PC5 ran out of memory making the tile's picture."
msgstr "PC5 a rămas fără memorie la crearea imaginii scurtăturii."

#: title/pc5_home.c:180
#, c-format
msgid "PC5 can't write the tile in %s: %s."
msgstr "PC5 nu poate scrie scurtătura în %s: %s."

#: title/pc5_library.c:169
#, c-format
msgid ""
"Plug in the USB drive with %.100s: it plays from the folder %.200s on it."
msgstr ""
"Conectează unitatea USB cu %.100s: rulează din folderul %.200s de pe ea."

#: title/pc5_library.c:175 title/pc5_library.c:2692 title/pc5_library.c:2743
#, c-format
msgid "PC5 can't make the game's folder: %s."
msgstr "PC5 nu poate crea folderul jocului: %s."

#: title/pc5_library.c:195
#, c-format
msgid "PC5 can't link the game's folder on the USB drive: %s."
msgstr "PC5 nu poate lega folderul jocului de pe unitatea USB: %s."

#: title/pc5_library.c:454 title/pc5_library.c:604 title/pc5_library.c:821
msgid "PC5's notes on this game are missing."
msgstr "Notițele PC5 despre acest joc lipsesc."

#: title/pc5_library.c:458
msgid "Choose one of the game's programs."
msgstr "Alege unul dintre programele jocului."

#: title/pc5_library.c:466
msgid "That program is too deep in the game's folder for Windows."
msgstr "Programul acela e prea adânc în folderul jocului pentru Windows."

#: title/pc5_library.c:471 title/pc5_library.c:1716 title/pc5_library.c:2429
#: title/pc5_library.c:2432 title/pc5_library.c:2441 title/pc5_library.c:2513
#: title/pc5_library.c:2705
#, c-format
msgid "PC5 can't write its notes: %s."
msgstr "PC5 nu își poate scrie notițele: %s."

#: title/pc5_library.c:492
msgid "PC5 is out of memory."
msgstr "PC5 nu mai are memorie."

#: title/pc5_library.c:496
#, c-format
msgid "%.200s doesn't start any of the game's programs."
msgstr "%.200s nu pornește niciunul dintre programele jocului."

#: title/pc5_library.c:696
msgid "The game's launch options are too long: 511 characters at most."
msgstr ""
"Opțiunile de lansare ale jocului sunt prea lungi: cel mult 511 caractere."

#: title/pc5_library.c:706
msgid "The game's path is too long for Windows."
msgstr "Calea jocului e prea lungă pentru Windows."

#: title/pc5_library.c:722 title/pc5_library.c:900
#, c-format
msgid "PC5 can't write the game's profile: %s."
msgstr "PC5 nu poate scrie profilul jocului: %s."

#: title/pc5_library.c:846
#, c-format
msgid "The program its launcher started isn't one of the game's: %.200s"
msgstr "Programul pornit de launcherul lui nu e al jocului: %.200s"

#: title/pc5_library.c:860
msgid "The arguments its launcher gave are too long."
msgstr "Argumentele date de launcherul lui sunt prea lungi."

#: title/pc5_library.c:882
#, c-format
msgid "Its programs kept starting each other: %d hand-offs in a row."
msgstr "Programele lui se tot porneau unul pe altul: %d predări la rând."

#: title/pc5_library.c:896
msgid "The program's path is too long for Windows."
msgstr "Calea programului e prea lungă pentru Windows."

#: title/pc5_library.c:955
#, c-format
msgid "Its profile has a mistake (%s)."
msgstr "Profilul lui are o greșeală (%s)."

#: title/pc5_library.c:972
msgid "Its Windows folder is missing."
msgstr "Folderul lui Windows lipsește."

#: title/pc5_library.c:1112
#, c-format
msgid "PC5 can't delete %s: %s."
msgstr "PC5 nu poate șterge %s: %s."

#: title/pc5_library.c:1211 title/pc5_library.c:1486 title/pc5_library.c:1541
#, c-format
msgid "PC5 can't move the game's folder: %s."
msgstr "PC5 nu poate muta folderul jocului: %s."

#: title/pc5_library.c:1220 title/pc5_library.c:1491
#, c-format
msgid "PC5 can't delete the game's profile: %s."
msgstr "PC5 nu poate șterge profilul jocului: %s."

#: title/pc5_library.c:1234 title/pc5_library.c:1478 title/pc5_library.c:2578
#: title/pc5_library.c:2586
msgid "A path is too long."
msgstr "O cale e prea lungă."

#: title/pc5_library.c:1437
msgid "PC5 can't read the game's folder."
msgstr "PC5 nu poate citi folderul jocului."

#: title/pc5_library.c:1445 title/pc5_library.c:1696 title/pc5_library.c:2773
#, c-format
msgid "A path in the game is too long: %s."
msgstr "O cale din joc e prea lungă: %s."

#: title/pc5_library.c:1454
#, c-format
msgid "PC5 can't keep %s: %s."
msgstr "PC5 nu poate păstra %s: %s."

#: title/pc5_library.c:1510
#, c-format
msgid "PC5 can't put the saves in place: %s."
msgstr "PC5 nu poate pune salvările la locul lor: %s."

#: title/pc5_library.c:1524
msgid "This game's saves can't be kept apart from it."
msgstr "Salvările acestui joc nu pot fi păstrate separat de el."

#: title/pc5_library.c:1530
#, c-format
msgid "PC5 can't make its saves folder: %s."
msgstr "PC5 nu poate crea folderul de salvări: %s."

#: title/pc5_library.c:1534
msgid "PC5 is still keeping this game's saves from before: start PC5 again."
msgstr ""
"PC5 încă păstrează salvările de dinainte ale acestui joc: pornește PC5 din "
"nou."

#: title/pc5_library.c:1567
#, c-format
msgid "PC5 can't move the saves: %s."
msgstr "PC5 nu poate muta salvările: %s."

#: title/pc5_library.c:1654
#, c-format
msgid "A path in the update is too long: %s."
msgstr "O cale din actualizare e prea lungă: %s."

#: title/pc5_library.c:1736
#, c-format
msgid "PC5 can't write the game's list of files: %s."
msgstr "PC5 nu poate scrie lista de fișiere a jocului: %s."

#: title/pc5_library.c:2054
msgid ""
"PC5's Windows template is missing from the app: copy the PC5 folder again."
msgstr ""
"Șablonul Windows al PC5 lipsește din aplicație: copiază din nou folderul "
"PC5."

#: title/pc5_library.c:2078
msgid "PC5's Windows template is damaged: copy the PC5 folder again."
msgstr "Șablonul Windows al PC5 e deteriorat: copiază din nou folderul PC5."

#: title/pc5_library.c:2160 title/pc5_library.c:2220
#, c-format
msgid "PC5 can't make its folders in %s: %s."
msgstr "PC5 nu își poate crea folderele în %s: %s."

#: title/pc5_library.c:2171
#, c-format
msgid "PC5 can't make its folder on the USB drive: %s."
msgstr "PC5 nu își poate crea folderul pe unitatea USB: %s."

#: title/pc5_library.c:2174
msgid "PC5 can't name the game's folder on the USB drive."
msgstr "PC5 nu poate denumi folderul jocului de pe unitatea USB."

#: title/pc5_library.c:2192
#, c-format
msgid ""
"The drive reads at %.0f MB/s here, too slow to play from (%.0f needed). "
"Plug it into a port on the back or the front USB-C port. Installing to the "
"console still works."
msgstr ""
"Unitatea citește aici cu %.0f MB/s, prea încet pentru a juca de pe ea (e "
"nevoie de %.0f). Conecteaz-o la un port din spate sau la portul USB-C din "
"față. Instalarea pe consolă funcționează în continuare."

#: title/pc5_library.c:2200
#, c-format
msgid ""
"Not enough space on the USB drive: the game needs %s and it has %s free."
msgstr ""
"Nu e destul loc pe unitatea USB: jocul are nevoie de %s, iar ea are %s "
"liberi."

#: title/pc5_library.c:2204
msgid ""
"Only a game on a USB drive can play from it: this folder isn't on one."
msgstr ""
"Doar un joc aflat pe o unitate USB poate rula de pe ea: folderul acesta nu "
"e pe una."

#: title/pc5_library.c:2206
msgid "A game in PC5's INSTALL folder is installed, not played from there."
msgstr ""
"Un joc din folderul INSTALL al PC5 se instalează, nu se joacă de acolo."

#: title/pc5_library.c:2211
#, c-format
msgid ""
"The drive reads at %.0f MB/s in this USB port, too slow to play from (at "
"least %.0f is needed). On the original PS5 the front USB-A port is the "
"slow one: plug the drive into a port on the back, or the front USB-C port. "
"Install still works from this port."
msgstr ""
"Unitatea citește cu %.0f MB/s în acest port USB, prea încet pentru a juca "
"de pe ea (e nevoie de cel puțin %.0f). Pe PS5-ul original, portul USB-A "
"din față e cel lent: conectează unitatea la un port din spate sau la "
"portul USB-C din față. Instalarea funcționează și din acest port."

#: title/pc5_library.c:2217
msgid "The game's program is too deep in its folder for Windows."
msgstr "Programul jocului e prea adânc în folderul lui pentru Windows."

#: title/pc5_library.c:2225
#, c-format
msgid "Not enough space: the game needs %s and the console has %s free."
msgstr "Nu e destul loc: jocul are nevoie de %s, iar consola are %s liberi."

#: title/pc5_library.c:2228
msgid "PC5 can't name the game."
msgstr "PC5 nu poate denumi jocul."

#: title/pc5_library.c:2231
#, c-format
msgid "PC5 can't start the install: %s."
msgstr "PC5 nu poate porni instalarea: %s."

#: title/pc5_library.c:2238 title/pc5_library.c:2311 title/pc5_library.c:2347
#: title/pc5_library.c:2594
msgid "Out of memory."
msgstr "Memorie insuficientă."

#: title/pc5_library.c:2271
msgid "A path in the Windows template is too long."
msgstr "O cale din șablonul Windows e prea lungă."

#: title/pc5_library.c:2274 title/pc5_library.c:2279 title/pc5_library.c:2780
#: title/pc5_tile.c:519
#, c-format
msgid "PC5 can't make %s: %s."
msgstr "PC5 nu poate crea %s: %s."

#: title/pc5_library.c:2282
#, c-format
msgid "PC5's Windows template is missing %s."
msgstr "Șablonului Windows al PC5 îi lipsește %s."

#: title/pc5_library.c:2300
#, c-format
msgid "PC5 can't copy %s: %s."
msgstr "PC5 nu poate copia %s: %s."

#: title/pc5_library.c:2325
#, c-format
msgid "PC5 can't read %s on the USB drive: %s."
msgstr "PC5 nu poate citi %s de pe unitatea USB: %s."

#: title/pc5_library.c:2366 title/pc5_library.c:2790
#, c-format
msgid "PC5 can't read back %s: %s."
msgstr "PC5 nu poate reciti %s: %s."

#: title/pc5_library.c:2366
#, c-format
msgid "The USB drive stopped answering while PC5 copied %s (%s)."
msgstr "Unitatea USB a încetat să răspundă în timp ce PC5 copia %s (%s)."

#: title/pc5_library.c:2394 title/pc5_library.c:2406
#, c-format
msgid ""
"The game couldn't be put back in the INSTALL folder: it is in %.180s."
msgstr ""
"Jocul nu a putut fi pus înapoi în folderul INSTALL: se află în %.180s."

#: title/pc5_library.c:2445
#, c-format
msgid "PC5 can't save the cover: %s."
msgstr "PC5 nu poate salva coperta: %s."

#: title/pc5_library.c:2452
#, c-format
msgid "PC5 can't put the game in place: %s."
msgstr "PC5 nu poate pune jocul la locul lui: %s."

#: title/pc5_library.c:2559
msgid "PC5 didn't install this game, so it can't update it."
msgstr "PC5 nu a instalat acest joc, așa că nu îl poate actualiza."

#: title/pc5_library.c:2561
#, c-format
msgid ""
"%s plays from its USB drive: copy the newer version over its folder %s "
"there."
msgstr ""
"%s rulează de pe unitatea lui USB: copiază versiunea mai nouă peste "
"folderul lui %s de acolo."

#: title/pc5_library.c:2566
msgid "The game's folder is missing: uninstall it and install it again."
msgstr "Folderul jocului lipsește: dezinstalează-l și instalează-l din nou."

#: title/pc5_library.c:2569
#, c-format
msgid ""
"This folder doesn't have %s, the program %s starts. Choose the folder of a "
"newer copy of %s."
msgstr ""
"Folderul acesta nu are %s, programul pe care îl pornește %s. Alege "
"folderul unei copii mai noi a lui %s."

#: title/pc5_library.c:2583
#, c-format
msgid "Not enough space: the update needs %s and the console has %s free."
msgstr ""
"Nu e destul loc: actualizarea are nevoie de %s, iar consola are %s liberi."

#: title/pc5_library.c:2589
msgid ""
"An earlier update of this game isn't finished: close PC5 and open it again "
"to finish it."
msgstr ""
"O actualizare anterioară a acestui joc nu e terminată: închide PC5 și "
"deschide-l din nou ca să o termine."

#: title/pc5_library.c:2591
#, c-format
msgid "PC5 can't start the update: %s."
msgstr "PC5 nu poate porni actualizarea: %s."

#: title/pc5_library.c:2620
msgid ""
"Kept saves can't be put back for a game that plays from its USB drive."
msgstr ""
