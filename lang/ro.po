#, c-format
msgid "PC5 can't read %.200s."
msgstr "PC5 nu poate citi %.200s."

#: title/pc5_source.c:321
#, c-format
msgid "Windows can't use the name \"%.180s\"."
msgstr "Windows nu poate folosi numele „%.180s”."

