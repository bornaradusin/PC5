#: title/pc5_web_page.html:255
msgctxt "web"
msgid "Close"
msgstr "Închide"

#. Web page text.
#: title/pc5_web_page.html:263
msgctxt "web"
msgid "Saved."
msgstr "Salvat."

#. Web page text.
#: title/pc5_web_page.html:271
msgctxt "web"
msgid "Close without saving the changes?"
msgstr "Închizi fără să salvezi modificările?"

#. Web page text.
#: title/pc5_web_page.html:276
msgctxt "web"
msgid ""
"Wine writes its .reg files while a game plays: change them only when no "
"game is running."
msgstr ""
"Wine scrie fișierele .reg în timp ce rulează un joc: modifică-le doar când "
"nu rulează niciun joc."

#. Web page text.
#. %s and %d are filled in by the page; %1$s, %2$s put them in another order.
