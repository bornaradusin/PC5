#, c-format
msgid "PC5 ran out of memory copying %s."
msgstr "PC5 a rămas fără memorie în timp ce copia %s."

#: title/pc5_files.c:427 title/pc5_library.c:1699
#, c-format
msgid "PC5 can't put %s in place: %s."
msgstr "PC5 nu poate pune %s la locul lui: %s."

