msgid "A path in the folder is too long."
msgstr "Cesta ve složce je příliš dlouhá."

#: title/pc5_source.c:320
#, c-format
msgid "PC5 can't read %.200s."
msgstr "PC5 nemůže přečíst %.200s."

#: title/pc5_source.c:334
#, c-format
msgid "Windows can't use the name \"%.180s\"."
msgstr "Windows nemůže použít název „%.180s“."

