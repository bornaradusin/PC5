#: title/pc5_web_page.html:146 title/pc5_web_page.html:172
#: title/pc5_web_page.html:258
msgctxt "web"
msgid "Saving…"
msgstr "Ukládání…"

#. Web page text.
#: title/pc5_web_page.html:150
msgctxt "web"
msgid ""
"Saved: its cover, background and details are fetched again when PC5 opens."
msgstr ""
"Uloženo: její obal, pozadí a podrobnosti se znovu načtou při otevření PC5."

#. Web page text.
#: title/pc5_web_page.html:151
msgctxt "web"
msgid "Cleared: PC5 reads the game's folder again."
msgstr "Vymazáno: PC5 znovu přečte složku hry."

#. Web page text.
#. %s and %d are filled in by the page; %1$s, %2$s put them in another order.
#: title/pc5_web_page.html:153 title/pc5_web_page.html:178
#: title/pc5_web_page.html:266
#, c-format
msgctxt "web"
msgid "Not saved: %s"
msgstr "Neuloženo: %s"

#. Web page text.
#. %s and %d are filled in by the page; %1$s, %2$s put them in another order.
#: title/pc5_web_page.html:156
#, c-format
msgctxt "web"
msgid "; GOG product %s"
msgstr "; produkt GOG %s"

#. Web page text.
#. %s and %d are filled in by the page; %1$s, %2$s put them in another order.
#: title/pc5_web_page.html:157
#, c-format
msgctxt "web"
msgid ""
"PC5 picks the game's cover, background and details by this number (%s%s). "
"If they are another game's, type the number from the game's Steam store "
"link (store.steampowered.com/app/<number>). Empty: PC5 reads the folder "
"again."
msgstr ""
"PC5 vybírá obal, pozadí a podrobnosti hry podle tohoto čísla (%s%s). Pokud "
"patří jiné hře, zadejte číslo z odkazu na hru v obchodě Steam "
"(store.steampowered.com/app/<číslo>). Prázdné: PC5 znovu přečte složku."

#. Web page text.
#: title/pc5_web_page.html:176
msgctxt "web"
msgid "Saved: used at the game's next start."
msgstr "Uloženo: použije se při příštím spuštění hry."

#. Web page text.
#: title/pc5_web_page.html:189
msgctxt "web"
msgid "Files: change a game's text files"
msgstr "Soubory: změna textových souborů hry"

#. Web page text.
#: title/pc5_web_page.html:194
msgctxt "web"
msgid "Game folder"
msgstr "Složka hry"

#. Web page text.
#: title/pc5_web_page.html:194
msgctxt "web"
msgid "Windows (registry, saves, settings)"
msgstr "Windows (registr, uložené pozice, nastavení)"

#. Web page text.
#: title/pc5_web_page.html:222
msgctxt "web"
msgid "This folder is empty"
msgstr "Tato složka je prázdná"

#. Web page text.
#: title/pc5_web_page.html:233
msgctxt "web"
msgid "Larger than 8 MB: too large to change here"
msgstr "Větší než 8 MB: na změnu tady příliš velký"

#. Web page text.
#. %s and %d are filled in by the page; %1$s, %2$s put them in another order.
#: title/pc5_web_page.html:237
#, c-format
msgctxt "web"
msgid "Not shown: %s"
msgstr "Nezobrazeno: %s"

#. Web page text.
#: title/pc5_web_page.html:251
msgctxt "web"
msgid "UTF-8 with its mark"
msgstr "UTF-8 se značkou BOM"

#. Web page text.
#: title/pc5_web_page.html:252
msgctxt "web"
msgid "Western (one byte a letter)"
msgstr "Západní (jeden bajt na písmeno)"

#. Web page text.
#. %s and %d are filled in by the page; %1$s, %2$s put them in another order.
#: title/pc5_web_page.html:253
#, c-format
msgctxt "web"
msgid ""
"%s · %s line ends · %d lines · %s. Saved as it was: the same encoding and "
"line ends. A game reads it at its next start."
msgstr ""
"%s · konce řádků %s · %d řádků · %s. Uloží se jako dřív: stejné kódování i "
"konce řádků. Hra ho načte při dalším spuštění."

#. Web page text.
#: title/pc5_web_page.html:255
msgctxt "web"
msgid "Close"
msgstr "Zavřít"

#. Web page text.
#: title/pc5_web_page.html:263
msgctxt "web"
msgid "Saved."
msgstr "Uloženo."

#. Web page text.
#: title/pc5_web_page.html:271
msgctxt "web"
msgid "Close without saving the changes?"
msgstr "Zavřít bez uložení změn?"

#. Web page text.
#: title/pc5_web_page.html:276
msgctxt "web"
msgid ""
"Wine writes its .reg files while a game plays: change them only when no "
"game is running."
msgstr ""
"Wine zapisuje své soubory .reg během hraní: měňte je, jen když žádná hra "
"neběží."

#. Web page text.
#. %s and %d are filled in by the page; %1$s, %2$s put them in another order.
#: title/pc5_web_page.html:278
#, c-format
msgctxt "web"
msgid "Not opened: %s"
msgstr "Neotevřeno: %s"

#. Web page text.
#: title/pc5_web_page.html:281
msgctxt "web"
msgid ""
"Text files only (.ini, .cfg, .txt, .json, .reg and the like), up to 8 MB. "
"The console's File manager changes them too, a line at a time."
msgstr ""
"Jen textové soubory (.ini, .cfg, .txt, .json, .reg a podobné) do 8 MB. "
"Mění je i Správce souborů na konzoli, po řádcích."

#. Web page text.
#: title/pc5_web_page.html:292
msgctxt "web"
msgid "No games yet."
msgstr "Zatím žádné hry."

#. Web page text.
#: title/pc5_web_page.html:295
msgctxt "web"
msgid "USB drive"
msgstr "USB disk"

#. Web page text.
#: title/pc5_web_page.html:296
msgctxt "web"
msgid "can't start"
msgstr "nelze spustit"

#. Web page text.
#. %s and %d are filled in by the page; %1$s, %2$s put them in another order.
#: title/pc5_web_page.html:301
#, c-format
msgctxt "web"
msgid "Settings: %s"
msgstr "Nastavení: %s"

#. Web page text.
#: title/pc5_web_page.html:304
msgctxt "web"
msgid "Newest log"
msgstr "Nejnovější protokol"

#. Web page text.
#: title/pc5_web_page.html:306
msgctxt "web"
msgid "Report a problem"
msgstr "Nahlásit problém"

#. Web page text.
#: title/pc5_web_page.html:307
msgctxt "web"
msgid ""
"Downloads the newest log and opens GitHub's form, filled in: attach the "
"log there."
msgstr ""
"Stáhne nejnovější protokol a otevře vyplněný formulář na GitHubu: tam "
"protokol přiložte."

#. Web page text.
#: title/pc5_web_page.html:313
msgctxt "web"
msgid "Launch options (launch.txt)"
msgstr "Možnosti spuštění (launch.txt)"

#. Web page text.
#: title/pc5_web_page.html:314
msgctxt "web"
msgid ""
"The first line that isn't empty or a comment (# or ;) is added to the "
"program's command line."
msgstr ""
"První řádek, který není prázdný ani komentář (# nebo ;), se přidá k "
"příkazovému řádku programu."

#. Web page text.
#: title/pc5_web_page.html:318
msgctxt "web"
msgid "Environment variables (env.txt)"
msgstr "Proměnné prostředí (env.txt)"

#. Web page text.
#: title/pc5_web_page.html:318
msgctxt "web"
msgid "One NAME=value a line, set before the game starts."
msgstr ""
"Jedna proměnná NÁZEV=hodnota na řádek, nastaví se před spuštěním hry."

#. Web page text.
#: title/pc5_web_page.html:319
msgctxt "web"
msgid "Extra logging (winedebug.txt)"
msgstr "Podrobnější protokolování (winedebug.txt)"

#. Web page text.
#: title/pc5_web_page.html:320
msgctxt "web"
msgid ""
"Only when an issue asks for it, for example err+all,+seh. Empty it "
"afterwards: it slows the game down."
msgstr ""
"Jen když o to hlášení požádá, například err+all,+seh. Pak ho vyprázdněte: "
"hru zpomaluje."

#. Web page text.
#. %s and %d are filled in by the page; %1$s, %2$s put them in another order.
#: title/pc5_web_page.html:325
#, c-format
msgctxt "web"
msgid "The games didn't load: %s"
msgstr "Hry se nenačetly: %s"

#. Web page text.
#: title/pc5_web_page.html:338
msgctxt "web"
msgid "No logs kept."
msgstr "Žádné uložené protokoly."

#. Web page text.
#: title/pc5_web_page.html:342
msgctxt "web"
msgid "had a problem"
msgstr "s problémem"

#. Web page text.
#. %s and %d are filled in by the page; %1$s, %2$s put them in another order.
#: title/pc5_web_page.html:345
#, c-format
msgctxt "web"
msgid "The logs didn't load: %s"
msgstr "Protokoly se nenačetly: %s"

#. Web page text.
#: title/pc5_web_page.html:354
msgctxt "web"
msgid "the connection was lost"
msgstr "spojení bylo ztraceno"

#. Web page text.
#. %s and %d are filled in by the page; %1$s, %2$s put them in another order.
#: title/pc5_web_page.html:371
#, c-format
msgctxt "web"
msgid "Sending %d of %d: %s"
msgstr "Odesílání %d z %d: %s"

#. Web page text.
#. %s and %d are filled in by the page; %1$s, %2$s put them in another order.
#: title/pc5_web_page.html:375
#, c-format
msgctxt "web"
msgid "Stopped at %s: %s"
msgstr "Zastaveno u %s: %s"

#. Web page text.
#. %s and %d are filled in by the page; %1$s, %2$s put them in another order.
#: title/pc5_web_page.html:382
#, c-format
msgctxt "web"
msgid "Sent %d files (%s). PC5 asks to install the game in a moment."
msgstr "Odesláno souborů: %d (%s). PC5 se za chvíli zeptá na instalaci hry."

#. Web page text.
#: title/pc5_web_page.html:391
msgctxt "web"
msgid "Type the game's folder name first (no / or \\)."
msgstr "Nejdřív zadejte název složky hry (bez / nebo \\)."

#~ msgid "Maximum: all of it, for a game that says there is too little."
