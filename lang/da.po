#, c-format
msgid ""
"PC5's folder has %.100s where the new version has a %s of that name. Move "
"it out of the folder and try again."
msgstr ""
"PC5's mappe har %.100s, hvor den nye version har noget med samme navn "
"(%s). Flyt det ud af mappen, og prøv igen."

#: title/pc5_upgrade.c:713
#, c-format
msgid "A new file is missing: %.200s."
msgstr "En ny fil mangler: %.200s."

