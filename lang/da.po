msgstr "Spillene blev ikke indlæst: %s"

#. Web page text.
#: title/pc5_web_page.html:340
msgctxt "web"
msgid "No logs kept."
msgstr "Ingen logfiler gemt."

#. Web page text.
#: title/pc5_web_page.html:344
msgctxt "web"
