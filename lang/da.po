#, c-format
msgid "PC5 can't open %s on the USB drive: %s."
msgstr "PC5 kan ikke åbne %s på USB-drevet: %s."

#: title/pc5_library.c:2991
#, c-format
msgid ""
"The copy of %s doesn't match the USB drive. The drive or its cable may be "
"failing; nothing was kept."
msgstr ""
"Kopien af %s passer ikke med USB-drevet. Drevet eller kablet er måske ved "
"at gå i stykker; intet blev beholdt."

