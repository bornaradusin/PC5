#, c-format
msgctxt "web"
msgid "Sent %d files (%s). PC5 asks to install the game in a moment."
msgstr ""
"Sendte %d filer (%s). PC5 spørger om lidt, om spillet skal installeres."

#. Web page text.
#: title/pc5_web_page.html:393
msgctxt "web"
msgid "Type the game's folder name first (no / or \\)."
msgstr "Skriv navnet på spillets mappe først (uden / eller \\)."

