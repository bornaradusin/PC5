msgstr "PC5 løb tør for hukommelse under kopieringen af %s."

#: title/pc5_files.c:427 title/pc5_library.c:1763
#, c-format
msgid "PC5 can't put %s in place: %s."
msgstr "PC5 kan ikke sætte %s på plads: %s."

