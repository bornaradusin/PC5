msgstr "Цю папку не можна встановити"

#: title/pc5_ui.c:5164
#, c-format
msgid "The update needs %s and the console has %s free."
msgstr "Оновленню потрібно %s, а на консолі вільно %s."

#: title/pc5_ui.c:5197
#, c-format
msgid "%s's program wasn't changed"
msgstr "Програму %s не змінено"

#: title/pc5_ui.c:5201
#, c-format
msgid "%s starts %s now"
msgstr "%s тепер запускає %s"

