#, c-format
msgctxt "web"
msgid "The games didn't load: %s"
msgstr "Ігри не завантажилися: %s"

#. Web page text.
#: title/pc5_web_page.html:232
msgctxt "web"
msgid "No logs kept."
msgstr "Журналів немає."

#. Web page text.
#: title/pc5_web_page.html:236
msgctxt "web"
msgid "had a problem"
msgstr "була проблема"

#. Web page text.
#. %s and %d are filled in by the page; %1$s, %2$s put them in another order.
#: title/pc5_web_page.html:239
#, c-format
msgctxt "web"
msgid "The logs didn't load: %s"
msgstr "Журнали не завантажилися: %s"

#. Web page text.
#: title/pc5_web_page.html:248
msgctxt "web"
msgid "the connection was lost"
msgstr "з’єднання втрачено"

#. Web page text.
#. %s and %d are filled in by the page; %1$s, %2$s put them in another order.
