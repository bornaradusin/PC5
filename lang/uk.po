#. Web page text.
#: title/pc5_web_page.html:391
msgctxt "web"
msgid "Type the game's folder name first (no / or \\)."
msgstr "Спершу введіть назву папки гри (без / і \\)."

#~ msgid "Maximum: all of it, for a game that says there is too little."
#~ msgstr "Максимум: уся, для гри, яка пише, що пам’яті замало."

#~ msgid "Loading"
#~ msgstr "Завантаження"

#~ msgid "Wine's VKD3D"
#~ msgstr "VKD3D з Wine"

#~ msgid "WineD3D on Vulkan"
#~ msgstr "WineD3D на Vulkan"

#~ msgid "SoC temperature"
#~ msgstr "Температура SoC"

#~ msgid "Its program is set in its prospero-win profile."
#~ msgstr "Її програму задано в її профілі prospero-win."

#~ msgid "Hides when unused"
#~ msgstr "Ховається"

#~ msgid "Game controlled"
#~ msgstr "Керує гра"

#~ msgid "Wine's own Direct3D draws it; change it only if the picture is wrong"
#~ msgstr ""
#~ "Малює власний Direct3D з Wine; змінюйте, лише якщо зображення неправильне"

#~ msgid "Wine's own Direct3D 12; if it doesn't help, set it back to Auto"
#~ msgstr "Власний Direct3D 12 з Wine; якщо не допомагає, поверніть «Авто»"

#~ msgid ""
#~ "Wine's own Direct3D on Vulkan; if it doesn't help, set it back to Auto"
#~ msgstr ""
#~ "Власний Direct3D з Wine на Vulkan; якщо не допомагає, поверніть «Авто»"

#~ msgid ""
#~ "Wine's own Direct3D on OpenGL; if it doesn't help, set it back to Auto"
#~ msgstr ""
#~ "Власний Direct3D з Wine на OpenGL; якщо не допомагає, поверніть «Авто»"

#~ msgid "Graphics API"
#~ msgstr "Графічний API"

#~ msgid "As Windows: 4 GB for a game made for it, otherwise 2 GB"
#~ msgstr "Як у Windows: 4 ГБ для розрахованої на це гри, інакше 2 ГБ"

#~ msgid "Video memory"
#~ msgstr "Відеопам’ять"

#~ msgid "2 GB at most, a number older games' checks can read"
#~ msgstr "Не більше 2 ГБ — число, яке розуміють перевірки старих ігор"

#~ msgid "Full"
#~ msgstr "Уся"

#~ msgid "CPU sharing"
#~ msgstr "Розподіл CPU"

#~ msgid "Its threads take turns, as on a PC: steadier for some games"
#~ msgstr "Потоки працюють по черзі, як на ПК: стабільніше для деяких ігор"

#~ msgid ""
#~ "PC5's choice: VKD3D-Proton turns the game's Direct3D 12 into Vulkan. The "
#~ "fastest, and what most games want."
#~ msgstr ""
#~ "Вибір PC5: VKD3D-Proton перетворює Direct3D 12 гри на Vulkan. Найшвидший і "
#~ "підходить більшості ігор."

#~ msgid ""
#~ "PC5's choice: Wine's own Direct3D draws the game's DirectDraw with OpenGL."
#~ msgstr ""
#~ "Вибір PC5: власний Direct3D з Wine малює DirectDraw гри через OpenGL."

#~ msgid ""
#~ "PC5's choice: DXVK turns the game's Direct3D into Vulkan. The fastest, and "
#~ "what most games want."
#~ msgstr ""
#~ "Вибір PC5: DXVK перетворює Direct3D гри на Vulkan. Найшвидший і підходить "
#~ "більшості ігор."

#~ msgid ""
#~ "Wine's own Direct3D 12 (VKD3D). Slower than Auto; try it if the game won't "
#~ "start or draws wrong."
#~ msgstr ""
#~ "Власний Direct3D 12 з Wine (VKD3D). Повільніший за «Авто»; спробуйте, якщо "
#~ "гра не запускається чи малює неправильно."

#~ msgid ""
#~ "Wine's own Direct3D, drawing with Vulkan. Try it if the game draws wrong "
#~ "with Auto; often faster than WineD3D."
#~ msgstr ""
#~ "Власний Direct3D з Wine, що малює через Vulkan. Спробуйте, якщо з «Авто» "
#~ "гра малює неправильно; часто швидший за WineD3D."

#~ msgid ""
#~ "Wine's own Direct3D, drawing with OpenGL. The slowest; try it if the game "
#~ "won't start with the others."
#~ msgstr ""
#~ "Власний Direct3D з Wine, що малює через OpenGL. Найповільніший; спробуйте, "
#~ "якщо з іншими гра не запускається."

#~ msgid ""
#~ "A .NET program: it runs with Wine Mono, which PC5 sets up the first time a "
#~ ".NET game starts."
#~ msgstr ""
#~ "Програма .NET: вона працює з Wine Mono, який PC5 налаштовує під час "
#~ "першого запуску гри на .NET."

#~ msgid "Games players have tried, on your phone with a QR code"
#~ msgstr "Ігри, які пробували гравці, — на телефоні за QR-кодом"

#~ msgid "Focus mode"
#~ msgstr "Фокус"

#~ msgid "Shown"
#~ msgstr "Показано"

#~ msgid ""
#~ "Scan the code with your phone: PC5's wiki opens on the list of games "
#~ "players have tried, how each ran and the settings that helped."
#~ msgstr ""
#~ "Відскануйте код телефоном: вікі PC5 відкриється на списку ігор, які "
#~ "пробували гравці, — як кожна працювала й які налаштування допомогли."

#~ msgid ""
#~ "On your phone or computer, open "
#~ "github.com/bornaradusin/PC5/wiki/Game-compatibility: the games players "
#~ "have tried, how each ran and the settings that helped."
#~ msgstr ""
#~ "На телефоні чи комп’ютері відкрийте "
#~ "github.com/bornaradusin/PC5/wiki/Game-compatibility: ігри, які пробували "
#~ "гравці, як кожна працювала й які налаштування допомогли."

#~ msgid ""
#~ "Got a game running? Add a game, at the top of the list's page: the form "
#~ "takes a minute. You need a GitHub account."
#~ msgstr ""
#~ "Гра запрацювала? Натисніть Add a game угорі сторінки списку: форма займає "
#~ "хвилину. Потрібен обліковий запис GitHub."

#~ msgid "Keep changing"
#~ msgstr "Продовжити редагування"

#~ msgid "Vibration, light bar and triggers"
#~ msgstr "Вібрація, світлова панель і тригери"

#~ msgid "Off. On holds the game at 30 fps and shows 60"
#~ msgstr "Вимк. Увімк. тримає гру на 30 кадрах/с і показує 60"
