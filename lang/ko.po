msgstr "게임 폴더를 읽을 수 없습니다."

#: title/pc5_library.c:1512 title/pc5_library.c:1763 title/pc5_library.c:2840
#, c-format
msgid "A path in the game is too long: %s."
msgstr "게임 안의 경로가 너무 깁니다: %s."

#: title/pc5_library.c:1521
#, c-format
msgid "PC5 can't keep %s: %s."
msgstr "%s을(를) 보관할 수 없습니다: %s."

#: title/pc5_library.c:1577
#, c-format
msgid "PC5 can't put the saves in place: %s."
msgstr "저장 데이터를 제자리에 놓을 수 없습니다: %s."

