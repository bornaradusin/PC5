#, c-format
msgid "You have %s"
msgstr "현재 버전: %s"

#: title/pc5_ui.c:8374
#, c-format
msgid ""
"This may already be fixed in it. Update, try the game again, and report it "
"if it still happens. %s."
msgstr "새 버전에서 이미 고쳐졌을 수 있습니다. 업데이트한 뒤 게임을 다시 해 보고, 그래도 문제가 생기면 보고하세요. %s."

#. In a question window: the title, its text, or a button's label (keep buttons short).
#: title/pc5_ui.c:8377
msgid "Report anyway"
msgstr "그래도 보고"

#: title/pc5_ui.c:8382
#, c-format
msgid "Starting %s"
msgstr "%s 시작하는 중"

#: title/pc5_ui.c:8385
#, c-format
msgid "Installing %.80s for it, once"
msgstr "이 게임을 위해 %.80s 설치 중(처음 한 번만)"

#: title/pc5_ui.c:8389
#, c-format
msgid "Setting up .NET for your games, once: %u of %u"
msgstr "게임용 .NET 설정 중(처음 한 번만): %u/%u"

#: title/pc5_update.c:125
#, c-format
msgid "PC5 %s is available on GitHub"
msgstr "GitHub에 PC5 %s 버전이 있습니다"

#: title/pc5_update.c:126
#, c-format
msgid "You have the newest PC5 (%s)"
msgstr "최신 PC5입니다(%s)"

#: title/pc5_update.c:127
msgid "No PC5 release is published on GitHub yet"
msgstr "GitHub에 아직 PC5 릴리스가 없습니다"

#: title/pc5_update.c:128
msgid "GitHub didn't answer: is the console online?"
msgstr "GitHub가 응답하지 않습니다. 본체가 인터넷에 연결되어 있나요?"

#: title/pc5_update.c:129
msgid "Not checked yet"
msgstr "아직 확인하지 않음"

#: title/pc5_upgrade.c:292
msgid "PC5 can't unpack this zip."
msgstr "이 zip 파일의 압축을 풀 수 없습니다."

#: title/pc5_upgrade.c:296
msgid "The download can't be read."
msgstr "다운로드한 파일을 읽을 수 없습니다."

#: title/pc5_upgrade.c:311
msgid "The download is a zip PC5 can't read (ZIP64)."
msgstr "다운로드한 파일이 PC5가 읽을 수 없는 zip입니다(ZIP64)."

#: title/pc5_upgrade.c:340
#, c-format
msgid "The download holds a file PC5 won't unpack: %.120s"
msgstr "다운로드한 파일에 PC5가 풀지 않는 파일이 있습니다: %.120s"

#: title/pc5_upgrade.c:351
#, c-format
msgid "There isn't room on the drive to unpack it: it needs %s."
msgstr "드라이브에 압축을 풀 공간이 없습니다. 필요한 공간: %s."

#: title/pc5_upgrade.c:355
msgid "The folder to unpack it in can't be made."
msgstr "압축을 풀 폴더를 만들 수 없습니다."

#: title/pc5_upgrade.c:363 title/pc5_upgrade.c:1093 title/pc5_upgrade.c:1244
#: title/pc5_upgrade.c:1328 title/pc5_upgrade.c:1355
msgid "Cancelled."
msgstr "취소했습니다."

#: title/pc5_upgrade.c:408
msgid "The download is damaged (a file in it doesn't match its checksum)."
msgstr "다운로드한 파일이 손상되었습니다(안의 파일이 체크섬과 일치하지 않습니다)."

#: title/pc5_upgrade.c:411
#, c-format
msgid "Files can't be written on the drive (%s)."
msgstr "드라이브에 파일을 쓸 수 없습니다(%s)."

#: title/pc5_upgrade.c:414
msgid "PC5 ran out of memory unpacking it."
msgstr "압축을 푸는 중에 메모리가 부족해졌습니다."

#: title/pc5_upgrade.c:417
msgid "The download isn't a zip PC5 can read."
msgstr "다운로드한 파일이 PC5가 읽을 수 있는 zip이 아닙니다."

#: title/pc5_upgrade.c:589 title/pc5_upgrade.c:710 title/pc5_upgrade.c:1316
msgid "A path in PC5's folder is too long."
msgstr "PC5 폴더 안의 경로가 너무 깁니다."

#: title/pc5_upgrade.c:597
#, c-format
msgid ""
"PC5's folder has %.100s where the new version has a %s of that name. Move "
"it out of the folder and try again."
msgstr ""
"PC5 폴더에 %.100s이(가) 있는데, 새 버전에서는 같은 이름이 다른 종류(%s)입니다. 폴더 밖으로 옮긴 뒤 다시 시도하세요."

#: title/pc5_upgrade.c:713
#, c-format
msgid "A new file is missing: %.200s."
msgstr "새 파일이 없습니다: %.200s."

#: title/pc5_upgrade.c:716
#, c-format
msgid "PC5 can't put its new files in place (%.150s: %s)."
msgstr "새 파일을 제자리에 놓을 수 없습니다(%.150s: %s)."

#: title/pc5_upgrade.c:1085 title/pc5_upgrade.c:1105
#, c-format
msgid "The download can't be saved (%s)."
msgstr "다운로드한 파일을 저장할 수 없습니다(%s)."

#: title/pc5_upgrade.c:1095
#, c-format
msgid "GitHub answered the download with an error (HTTP %d)."
msgstr "GitHub가 다운로드에 오류로 응답했습니다(HTTP %d)."

#: title/pc5_upgrade.c:1096
#, c-format
msgid "The download stopped (%d). Is the console still online?"
msgstr "다운로드가 멈췄습니다(%d). 본체가 아직 인터넷에 연결되어 있나요?"

#: title/pc5_upgrade.c:1097
msgid "The download was cut short."
msgstr "다운로드가 중간에 끊겼습니다."

#: title/pc5_upgrade.c:1103
msgid "The download doesn't match the checksum GitHub lists for it."
msgstr "다운로드한 파일이 GitHub에 나와 있는 체크섬과 일치하지 않습니다."

#: title/pc5_upgrade.c:1277
msgid "GitHub didn't answer. Is the console online?"
msgstr "GitHub가 응답하지 않았습니다. 본체가 인터넷에 연결되어 있나요?"

#: title/pc5_upgrade.c:1279
#, c-format
msgid "You already have the newest PC5 (%s)."
msgstr "이미 최신 PC5입니다(%s)."

#: title/pc5_upgrade.c:1282
#, c-format
msgid ""
"PC5 %s's release on GitHub has no %s.zip to install. Download it from "
"GitHub instead."
msgstr "GitHub의 PC5 %s 릴리스에 설치할 %s.zip이 없습니다. 대신 GitHub에서 직접 다운로드하세요."

#: title/pc5_upgrade.c:1286
#, c-format
msgid ""
"PC5 is on the console more than once (%.200s and %.200s), so it can't tell "
"which to update. Delete the copy you don't use, or install PC5 %s from "
"GitHub as before."
msgstr ""
"본체에 PC5가 여러 개 있어서(%.200s, %.200s) 어느 것을 업데이트할지 알 수 없습니다. 쓰지 않는 사본을 삭제하거나, "
"이전처럼 GitHub에서 PC5 %s 버전을 설치하세요."

#: title/pc5_upgrade.c:1290
#, c-format
msgid ""
"PC5's folder wasn't found on the console's drives (in homebrew, "
"etaHEN/games or at the top of a drive). Install PC5 %s from GitHub as "
"before."
msgstr ""
"본체 드라이브(homebrew, etaHEN/games 또는 드라이브 최상위)에서 PC5 폴더를 찾지 못했습니다. 이전처럼 "
"GitHub에서 PC5 %s 버전을 설치하세요."

#: title/pc5_upgrade.c:1297
#, c-format
msgid "PC5 can't update itself where it is (%s)."
msgstr "지금 위치에서는 PC5가 스스로 업데이트할 수 없습니다(%s)."

#: title/pc5_upgrade.c:1299
#, c-format
msgid "PC5 can't write to its folder (%s)."
msgstr "PC5 폴더에 쓸 수 없습니다(%s)."

#: title/pc5_upgrade.c:1303
msgid ""
"An earlier update isn't finished. Close PC5 and open it again: it finishes "
"it then."
msgstr "이전 업데이트가 끝나지 않았습니다. PC5를 닫았다가 다시 열면 마무리됩니다."

#: title/pc5_upgrade.c:1309
#, c-format
msgid "PC5 can't make its work folder (%s)."
msgstr "작업 폴더를 만들 수 없습니다(%s)."

#: title/pc5_upgrade.c:1326
#, c-format
msgid ""
"There isn't room on PC5's drive for the update: it needs about %s free."
msgstr "PC5 드라이브에 업데이트할 공간이 없습니다. 약 %s의 여유 공간이 필요합니다."

#: title/pc5_upgrade.c:1339 title/pc5_upgrade.c:1378
msgid "The work folder can't be written."
msgstr "작업 폴더에 쓸 수 없습니다."

#: title/pc5_upgrade.c:1345
#, c-format
msgid "The download isn't PC5 (%s is missing something)."
msgstr "다운로드한 파일이 PC5가 아닙니다(%s에 빠진 것이 있습니다)."

#: title/pc5_upgrade.c:1346
msgid "The work folder can't be read."
msgstr "작업 폴더를 읽을 수 없습니다."

#: title/pc5_upgrade.c:1390
#, c-format
msgid ""
"%.120s Close PC5 and open it again: it finishes the update then. If it "
"still can't, install PC5 %s from GitHub."
msgstr ""
"%.120s PC5를 닫았다가 다시 열면 업데이트를 마칩니다. 그래도 안 되면 GitHub에서 PC5 %s 버전을 설치하세요."

#: title/pc5_upgrade.c:1449
#, c-format
msgid "PC5 can't start the update (%d)."
msgstr "업데이트를 시작할 수 없습니다(%d)."

#: title/pc5_web.c:711
msgid "It isn't UTF-8 text"
msgstr "UTF-8 텍스트가 아닙니다"

#: title/pc5_web.c:1062
msgid "PC5 has no folder to show."
msgstr "표시할 폴더가 없습니다."

