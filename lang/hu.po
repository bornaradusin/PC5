#, c-format
msgctxt "web"
msgid "The console didn't answer: %s"
msgstr "A konzol nem válaszolt: %s"

#. Web page text.
#: title/pc5_web_page.html:133
msgctxt "web"
msgid "given by you"
msgstr "te adtad meg"

#. Web page text.
#. %s and %d are filled in by the page; %1$s, %2$s put them in another order.
#: title/pc5_web_page.html:134
#, c-format
msgctxt "web"
msgid "found in %s"
msgstr "itt található: %s"

#. Web page text.
#: title/pc5_web_page.html:134
