msgid "PC5 can't copy its sce_module/libc.prx into the tile."
msgstr ""
"A PC5 nem tudja a csempébe másolni a saját sce_module/libc.prx fájlját."

#: title/pc5_tile.c:283
msgid "PC5 can't write the tile's lapy.elf."
msgstr "A PC5 nem tudja írni a csempe lapy.elf fájlját."

#: title/pc5_tile.c:287
#, c-format
msgid "PC5 can't write the tile's %s."
msgstr "A PC5 nem tudja írni a csempe fájlját: %s."

#: title/pc5_tile.c:291
msgid "PC5 can't copy its eboot.bin into the tile."
msgstr "A PC5 nem tudja a csempébe másolni a saját eboot.bin fájlját."

#: title/pc5_tile.c:394 title/pc5_tile.c:437
msgid "PC5 can't make the tile's sce_sys."
msgstr "A PC5 nem tudja létrehozni a csempe sce_sys mappáját."

#: title/pc5_tile.c:398
msgid "PC5 can't make the tile's picture."
msgstr "A PC5 nem tudja elkészíteni a csempe képét."

#: title/pc5_tile.c:412
msgid "PC5 can't write the tile's pictures."
msgstr "A PC5 nem tudja írni a csempe képeit."

#: title/pc5_tile.c:444
msgid "PC5 can't write the tile's param.json from its own."
msgstr "A PC5 nem tudja megírni a csempe param.json fájlját a sajátjából."

#: title/pc5_tile.c:496
msgid "PC5 doesn't know where to make the tile."
msgstr "A PC5 nem tudja, hol készítse el a csempét."

#: title/pc5_tile.c:501
#, c-format
msgid "PC5 can't find a free title ID for the tile in %s."
msgstr "A PC5 nem talál szabad játékazonosítót a csempéhez itt: %s."

#: title/pc5_tile.c:511
msgid "The tiles' folder path is too long."
msgstr "A csempék mappájának elérési útja túl hosszú."

#: title/pc5_tile.c:527
#, c-format
msgid "PC5 can't replace the tile: %s."
msgstr "A PC5 nem tudja lecserélni a csempét: %s."

#: title/pc5_tile.c:533
#, c-format
msgid "PC5 can't put the tile in place: %s."
msgstr "A PC5 nem tudja a helyére tenni a csempét: %s."

#: title/pc5_tile.c:636 title/pc5_ui.c:4785
msgid ""
"It isn't in PC5 any more. Take the tile off the home screen, or install "
"the game again."
msgstr ""
"Már nincs a PC5-ben. Vedd le a csempét a kezdőképernyőről, vagy telepítsd "
"újra a játékot."

#: title/pc5_tile.c:697
msgid "PC5 lost its place readying the game."
msgstr "A PC5 elvesztette a fonalat a játék előkészítése közben."

