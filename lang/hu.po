msgstr "A PC5 nem tudja olvasni az USB-meghajtón: %s (%s)."

#: title/pc5_library.c:2527 title/pc5_library.c:2953
#, c-format
msgid "PC5 can't read back %s: %s."
msgstr "A PC5 nem tudja visszaolvasni: %s (%s)."

