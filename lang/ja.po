#: title/pc5_web_page.html:294
msgctxt "web"
msgid "No games yet."
msgstr "まだゲームがありません。"

#. Web page text.
#: title/pc5_web_page.html:297
msgctxt "web"
msgid "USB drive"
msgstr "USBドライブ"

#. Web page text.
#: title/pc5_web_page.html:298
msgctxt "web"
msgid "can't start"
msgstr "起動できません"

