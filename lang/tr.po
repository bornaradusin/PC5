msgstr "%s kopyalanırken PC5'in belleği yetmedi."

#: title/pc5_files.c:427 title/pc5_library.c:1766
#, c-format
msgid "PC5 can't put %s in place: %s."
msgstr "%s yerine konamıyor: %s."

