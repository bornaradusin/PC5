#: title/pc5_web_page.html:148 title/pc5_web_page.html:174
#: title/pc5_web_page.html:260
msgctxt "web"
msgid "Saving…"
msgstr "Kaydediliyor…"

#. Web page text.
#: title/pc5_web_page.html:152
msgctxt "web"
msgid ""
"Saved: its cover, background and details are fetched again when PC5 opens."
msgstr ""
"Kaydedildi: kapağı, arka planı ve ayrıntıları PC5 açıldığında yeniden "
"alınır."

#. Web page text.
#: title/pc5_web_page.html:153
msgctxt "web"
msgid "Cleared: PC5 reads the game's folder again."
msgstr "Temizlendi: PC5 oyunun klasörünü yeniden okur."

#. Web page text.
#. %s and %d are filled in by the page; %1$s, %2$s put them in another order.
#: title/pc5_web_page.html:155 title/pc5_web_page.html:180
#: title/pc5_web_page.html:268
#, c-format
msgctxt "web"
msgid "Not saved: %s"
msgstr "Kaydedilmedi: %s"

#. Web page text.
#. %s and %d are filled in by the page; %1$s, %2$s put them in another order.
#: title/pc5_web_page.html:158
#, c-format
msgctxt "web"
msgid "; GOG product %s"
msgstr "; GOG ürünü %s"

#. Web page text.
#. %s and %d are filled in by the page; %1$s, %2$s put them in another order.
#: title/pc5_web_page.html:159
#, c-format
msgctxt "web"
msgid ""
"PC5 picks the game's cover, background and details by this number (%s%s). "
"If they are another game's, type the number from the game's Steam store "
"link (store.steampowered.com/app/<number>). Empty: PC5 reads the folder "
"again."
msgstr ""
"PC5 oyunun kapağını, arka planını ve ayrıntılarını bu numaraya göre seçer "
"(%s%s). Başka bir oyunun olanlar geliyorsa oyunun Steam mağaza "
"bağlantısındaki numarayı yaz (store.steampowered.com/app/<numara>). Boş: "
"PC5 klasörü yeniden okur."

#. Web page text.
#: title/pc5_web_page.html:178
msgctxt "web"
msgid "Saved: used at the game's next start."
msgstr "Kaydedildi: oyunun bir sonraki açılışında kullanılır."

#. Web page text.
#: title/pc5_web_page.html:191
msgctxt "web"
msgid "Files: change a game's text files"
msgstr "Dosyalar: bir oyunun metin dosyalarını değiştirin"

#. Web page text.
#: title/pc5_web_page.html:196
msgctxt "web"
msgid "Game folder"
msgstr "Oyun klasörü"

#. Web page text.
#: title/pc5_web_page.html:196
msgctxt "web"
msgid "Windows (registry, saves, settings)"
msgstr "Windows (kayıt defteri, kayıtlar, ayarlar)"

#. Web page text.
#: title/pc5_web_page.html:224
msgctxt "web"
msgid "This folder is empty"
msgstr "Bu klasör boş"

#. Web page text.
#: title/pc5_web_page.html:235
msgctxt "web"
msgid "Larger than 8 MB: too large to change here"
msgstr "8 MB'tan büyük: burada değiştirmek için çok büyük"

#. Web page text.
#. %s and %d are filled in by the page; %1$s, %2$s put them in another order.
#: title/pc5_web_page.html:239
#, c-format
msgctxt "web"
msgid "Not shown: %s"
msgstr "Gösterilemedi: %s"

