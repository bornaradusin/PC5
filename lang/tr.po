msgid "That program is too deep in the game's folder for Windows."
msgstr "Bu program, oyun klasöründe Windows için fazla derinde."

#: title/pc5_library.c:537 title/pc5_library.c:1789 title/pc5_library.c:2502
#: title/pc5_library.c:2505 title/pc5_library.c:2514 title/pc5_library.c:2586
#: title/pc5_library.c:2778
#, c-format
msgid "PC5 can't write its notes: %s."
msgstr "PC5 notlarını yazamıyor: %s."

#: title/pc5_library.c:558
msgid "PC5 is out of memory."
msgstr "PC5'in belleği yetmiyor."

#: title/pc5_library.c:562
#, c-format
msgid "%.200s doesn't start any of the game's programs."
msgstr "%.200s, oyunun programlarından hiçbirini başlatmıyor."

