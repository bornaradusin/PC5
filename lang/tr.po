msgid "PC5 can't make the .NET runtime's folders: is the console full?"
msgstr ".NET çalışma zamanının klasörleri oluşturulamıyor: konsol dolu mu?"

#: title/pc5_game.c:557
#, c-format
msgid ""
"The app's .NET runtime has no %.80s. Copy the PPSA11018 folder to the "
"console again."
msgstr ""
"Uygulamanın .NET çalışma zamanında %.80s yok. PPSA11018 klasörünü konsola "
"yeniden kopyala."

#: title/pc5_game.c:563
msgid "PC5 can't copy the .NET runtime: is the console full?"
msgstr ".NET çalışma zamanı kopyalanamıyor: konsol dolu mu?"

#: title/pc5_game.c:571
msgid "PC5 can't finish the .NET runtime's copy."
msgstr ".NET çalışma zamanının kopyası tamamlanamıyor."

#: title/pc5_home.c:157
msgid "The tile's program is missing from PC5's app (pc5/forwarder)."
msgstr "Kutucuğun programı PC5 uygulamasında yok (pc5/forwarder)."

#: title/pc5_home.c:161
#, c-format
msgid "PC5 can't use %s: %s."
msgstr "%s kullanılamıyor: %s."

