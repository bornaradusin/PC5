#, c-format
msgid "The program its launcher started isn't one of the game's: %.200s"
msgstr ""
"Başlatıcısının açtığı program oyunun programlarından biri değil: %.200s"

#: title/pc5_library.c:933
msgid "The arguments its launcher gave are too long."
msgstr "Başlatıcısının verdiği bağımsız değişkenler çok uzun."

#: title/pc5_library.c:955
#, c-format
msgid "Its programs kept starting each other: %d hand-offs in a row."
msgstr "Programları birbirini başlatıp durdu: art arda %d geçiş."

#: title/pc5_library.c:969
msgid "The program's path is too long for Windows."
msgstr "Programın yolu Windows için çok uzun."

#: title/pc5_library.c:1028
#, c-format
msgid "Its profile has a mistake (%s)."
msgstr "Profilinde bir hata var (%s)."

#: title/pc5_library.c:1045
msgid "Its Windows folder is missing."
msgstr "Windows klasörü eksik."

#: title/pc5_library.c:1185
#, c-format
msgid "PC5 can't delete %s: %s."
msgstr "%s silinemiyor: %s."

#: title/pc5_library.c:1284 title/pc5_library.c:1559 title/pc5_library.c:1614
#, c-format
msgid "PC5 can't move the game's folder: %s."
msgstr "Oyunun klasörü taşınamıyor: %s."

#: title/pc5_library.c:1293 title/pc5_library.c:1564
#, c-format
msgid "PC5 can't delete the game's profile: %s."
msgstr "Oyunun profili silinemiyor: %s."

#: title/pc5_library.c:1307 title/pc5_library.c:1551 title/pc5_library.c:2651
#: title/pc5_library.c:2659
msgid "A path is too long."
msgstr "Bir yol çok uzun."

#: title/pc5_library.c:1510
msgid "PC5 can't read the game's folder."
msgstr "Oyunun klasörü okunamıyor."

#: title/pc5_library.c:1518 title/pc5_library.c:1769 title/pc5_library.c:2846
#, c-format
msgid "A path in the game is too long: %s."
msgstr "Oyundaki bir yol çok uzun: %s."

#: title/pc5_library.c:1527
#, c-format
msgid "PC5 can't keep %s: %s."
msgstr "%s saklanamıyor: %s."

#: title/pc5_library.c:1583
#, c-format
msgid "PC5 can't put the saves in place: %s."
msgstr "Kayıtlar yerine konamıyor: %s."

#: title/pc5_library.c:1597
msgid "This game's saves can't be kept apart from it."
msgstr "Bu oyunun kayıtları oyundan ayrı saklanamaz."

#: title/pc5_library.c:1603
#, c-format
msgid "PC5 can't make its saves folder: %s."
msgstr "Kayıt klasörü oluşturulamıyor: %s."

#: title/pc5_library.c:1607
msgid "PC5 is still keeping this game's saves from before: start PC5 again."
msgstr ""
"PC5 bu oyunun önceki kayıtlarını hâlâ saklıyor: PC5'i yeniden başlat."

#: title/pc5_library.c:1640
#, c-format
msgid "PC5 can't move the saves: %s."
msgstr "Kayıtlar taşınamıyor: %s."

#: title/pc5_library.c:1727
#, c-format
msgid "A path in the update is too long: %s."
msgstr "Güncellemedeki bir yol çok uzun: %s."

#: title/pc5_library.c:1809
#, c-format
msgid "PC5 can't write the game's list of files: %s."
msgstr "Oyunun dosya listesi yazılamıyor: %s."

#: title/pc5_library.c:2127
msgid ""
"PC5's Windows template is missing from the app: copy the PC5 folder again."
msgstr ""
"PC5'in Windows şablonu uygulamada yok: PC5 klasörünü yeniden kopyala."

#: title/pc5_library.c:2151
msgid "PC5's Windows template is damaged: copy the PC5 folder again."
msgstr "PC5'in Windows şablonu bozuk: PC5 klasörünü yeniden kopyala."

