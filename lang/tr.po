#: title/pc5_library.c:1301 title/pc5_library.c:1545 title/pc5_library.c:2645
#: title/pc5_library.c:2653
msgid "A path is too long."
msgstr "Bir yol çok uzun."

#: title/pc5_library.c:1504
msgid "PC5 can't read the game's folder."
msgstr "Oyunun klasörü okunamıyor."

#: title/pc5_library.c:1512 title/pc5_library.c:1763 title/pc5_library.c:2840
#, c-format
msgid "A path in the game is too long: %s."
msgstr "Oyundaki bir yol çok uzun: %s."

#: title/pc5_library.c:1521
#, c-format
msgid "PC5 can't keep %s: %s."
msgstr "%s saklanamıyor: %s."

