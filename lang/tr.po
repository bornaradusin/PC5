msgctxt "web"
msgid "Sent %d files (%s). PC5 asks to install the game in a moment."
msgstr ""
"%d dosya gönderildi (%s). PC5 birazdan oyunu yüklemek isteyip istemediğini "
"soracak."

#. Web page text.
#: title/pc5_web_page.html:417
msgctxt "web"
msgid "Type the game's folder name first (no / or \\)."
msgstr "Önce oyunun klasör adını yaz (/ ya da \\ olmadan)."

