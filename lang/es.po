#~ msgstr "Cargando"

#~ msgid "Wine's VKD3D"
#~ msgstr "VKD3D de Wine"

#~ msgid "WineD3D on Vulkan"
#~ msgstr "WineD3D sobre Vulkan"

#~ msgid "SoC temperature"
#~ msgstr "Temperatura del SoC"

