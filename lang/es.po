#: title/pc5_web_page.html:320
msgctxt "web"
msgid "Launch options (launch.txt)"
msgstr "Opciones de inicio (launch.txt)"

#. Web page text.
#: title/pc5_web_page.html:321
msgctxt "web"
msgid ""
"The first line that isn't empty or a comment (# or ;) is added to the "
"program's command line."
msgstr ""
"La primera línea que no esté vacía ni sea un comentario (# o ;) se añade a "
"la línea de comandos del programa."

#. Web page text.
#: title/pc5_web_page.html:325
msgctxt "web"
msgid "Environment variables (env.txt)"
msgstr "Variables de entorno (env.txt)"

#. Web page text.
#: title/pc5_web_page.html:325
msgctxt "web"
msgid "One NAME=value a line, set before the game starts."
msgstr "Un NOMBRE=valor por línea, definido antes de que se inicie el juego."

#. Web page text.
#: title/pc5_web_page.html:326
msgctxt "web"
msgid "Extra logging (winedebug.txt)"
msgstr "Registro adicional (winedebug.txt)"

#. Web page text.
#: title/pc5_web_page.html:327
msgctxt "web"
msgid ""
"Only when an issue asks for it, for example err+all,+seh. Empty it "
"afterwards: it slows the game down."
msgstr ""
"Solo cuando un issue lo pida, por ejemplo err+all,+seh. Vacíalo después: "
"ralentiza el juego."

