msgid "PC5 is still keeping this game's saves from before: start PC5 again."
msgstr ""
"PC5 aún está conservando los datos guardados anteriores de este juego: "
"vuelve a iniciar PC5."

#: title/pc5_library.c:1728
#, c-format
msgid "PC5 can't move the saves: %s."
msgstr "PC5 no puede mover los datos guardados: %s."

