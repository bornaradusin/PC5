msgid "Not opened: %s"
msgstr "No se ha abierto: %s"

#. Web page text.
#: title/pc5_web_page.html:283
msgctxt "web"
msgid ""
"Text files only (.ini, .cfg, .txt, .json, .reg and the like), up to 8 MB. "
"The console's File manager changes them too, a line at a time."
msgstr ""
"Solo archivos de texto (.ini, .cfg, .txt, .json, .reg y similares), de "
"hasta 8 MB. El Gestor de archivos de la consola también los cambia, línea "
"a línea."

#. Web page text.
#: title/pc5_web_page.html:294
msgctxt "web"
msgid "No games yet."
msgstr "Aún no hay juegos."

