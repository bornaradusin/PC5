msgstr "Panel táctil + OPTIONS durante 2 s sigue saliendo del juego"

#: title/pc5_ui.c:7227
msgid "Two fingers: PC5's on-screen keyboard, or a key of its own"
msgstr "Dos dedos: el teclado en pantalla de PC5 o una tecla propia"

#: title/pc5_ui.c:7230
msgid "A key for each half's click and each quick swipe"
msgstr "Una tecla para el clic de cada mitad y cada deslizamiento rápido"

#: title/pc5_ui.c:7231
msgid "A finger moves the pointer; a click sends its key"
msgstr "Un dedo mueve el puntero; un clic envía su tecla"

#: title/pc5_ui.c:7232
msgid "The whole touchpad is one button"
msgstr "Todo el panel táctil es un solo botón"

