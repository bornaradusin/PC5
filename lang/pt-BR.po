#, c-format
msgid "PC5 ran out of memory deleting %s."
msgstr "O PC5 ficou sem memória ao excluir %s."

#: title/pc5_ftp.c:626 title/pc5_web.c:1061
msgid "There's no network here."
msgstr "Não há rede aqui."

#: title/pc5_ftp.c:628 title/pc5_ui.c:2654
msgid "PC5's INSTALL folder isn't there."
msgstr "A pasta INSTALL do PC5 não existe."

#: title/pc5_ftp.c:633 title/pc5_web.c:1067
#, c-format
msgid "Port %u is taken, or there's no network."
msgstr "A porta %u está em uso ou não há rede."

#: title/pc5_ftp.c:647 title/pc5_web.c:1081
msgid "PC5 can't start it."
msgstr "O PC5 não consegue iniciá-lo."

#: title/pc5_game.c:544
msgid "The app's path is too long."
msgstr "O caminho do app é longo demais."

#: title/pc5_game.c:550
msgid "PC5 can't read the app's .NET runtime."
msgstr "O PC5 não consegue ler o runtime .NET do app."

#: title/pc5_game.c:575
msgid "A path of the .NET runtime is too long."
msgstr "Um caminho do runtime .NET é longo demais."

#: title/pc5_game.c:580
msgid "PC5 can't make the .NET runtime's folders: is the console full?"
msgstr ""
"O PC5 não consegue criar as pastas do runtime .NET: o console está cheio?"

#: title/pc5_game.c:591
#, c-format
msgid ""
"The app's .NET runtime has no %.80s. Copy the PPSA11018 folder to the "
"console again."
msgstr ""
"O runtime .NET do app não tem %.80s. Copie a pasta PPSA11018 para o "
"console de novo."

#: title/pc5_game.c:597
msgid "PC5 can't copy the .NET runtime: is the console full?"
msgstr "O PC5 não consegue copiar o runtime .NET: o console está cheio?"

#: title/pc5_game.c:605
msgid "PC5 can't finish the .NET runtime's copy."
msgstr "O PC5 não consegue concluir a cópia do runtime .NET."

#: title/pc5_home.c:157
msgid "The tile's program is missing from PC5's app (pc5/forwarder)."
msgstr "O programa do atalho está faltando no app do PC5 (pc5/forwarder)."

#: title/pc5_home.c:161
#, c-format
msgid "PC5 can't use %s: %s."
msgstr "O PC5 não consegue usar %s: %s."

#: title/pc5_home.c:165
msgid "PC5 ran out of memory making the tile's picture."
msgstr "O PC5 ficou sem memória ao criar a imagem do atalho."

#: title/pc5_home.c:180
#, c-format
msgid "PC5 can't write the tile in %s: %s."
msgstr "O PC5 não consegue gravar o atalho em %s: %s."

#: title/pc5_library.c:169
#, c-format
msgid ""
"Plug in the USB drive with %.100s: it plays from the folder %.200s on it."
msgstr "Conecte a unidade USB com %.100s: ele é jogado da pasta %.200s nela."

#: title/pc5_library.c:175 title/pc5_library.c:2855 title/pc5_library.c:2906
#, c-format
msgid "PC5 can't make the game's folder: %s."
msgstr "O PC5 não consegue criar a pasta do jogo: %s."

#: title/pc5_library.c:195
#, c-format
msgid "PC5 can't link the game's folder on the USB drive: %s."
msgstr "O PC5 não consegue vincular a pasta do jogo na unidade USB: %s."

#: title/pc5_library.c:595 title/pc5_library.c:612
msgid "Choose one of the game's programs."
msgstr "Escolha um dos programas do jogo."

#: title/pc5_library.c:608 title/pc5_library.c:758 title/pc5_library.c:982
msgid "PC5's notes on this game are missing."
msgstr "As anotações do PC5 sobre este jogo estão faltando."

#: title/pc5_library.c:620
msgid "That program is too deep in the game's folder for Windows."
msgstr "Esse programa está fundo demais na pasta do jogo para o Windows."

#: title/pc5_library.c:625 title/pc5_library.c:1877 title/pc5_library.c:2590
#: title/pc5_library.c:2593 title/pc5_library.c:2602 title/pc5_library.c:2676
#: title/pc5_library.c:2868
#, c-format
msgid "PC5 can't write its notes: %s."
msgstr "O PC5 não consegue gravar as anotações dele: %s."

#: title/pc5_library.c:646
msgid "PC5 is out of memory."
msgstr "O PC5 está sem memória."

#: title/pc5_library.c:650
#, c-format
msgid "%.200s doesn't start any of the game's programs."
msgstr "%.200s não inicia nenhum dos programas do jogo."

#: title/pc5_library.c:850
msgid "The game's launch options are too long: 511 characters at most."
msgstr ""
"As opções de inicialização do jogo são longas demais: no máximo 511 "
"caracteres."

#: title/pc5_library.c:867
msgid "The game's path is too long for Windows."
msgstr "O caminho do jogo é longo demais para o Windows."

#: title/pc5_library.c:883 title/pc5_library.c:1061
#, c-format
msgid "PC5 can't write the game's profile: %s."
msgstr "O PC5 não consegue gravar o perfil do jogo: %s."

#: title/pc5_library.c:1007
#, c-format
msgid "The program its launcher started isn't one of the game's: %.200s"
msgstr "O programa que o launcher dele abriu não é do jogo: %.200s"

#: title/pc5_library.c:1021
msgid "The arguments its launcher gave are too long."
msgstr "Os argumentos passados pelo launcher dele são longos demais."

#: title/pc5_library.c:1043
#, c-format
msgid "Its programs kept starting each other: %d hand-offs in a row."
msgstr ""
"Os programas dele ficaram abrindo uns aos outros: %d passagens seguidas."

#: title/pc5_library.c:1057
msgid "The program's path is too long for Windows."
msgstr "O caminho do programa é longo demais para o Windows."

#: title/pc5_library.c:1116
#, c-format
msgid "Its profile has a mistake (%s)."
msgstr "O perfil dele tem um erro (%s)."

#: title/pc5_library.c:1133
msgid "Its Windows folder is missing."
msgstr "A pasta Windows dele está faltando."

#: title/pc5_library.c:1273
#, c-format
msgid "PC5 can't delete %s: %s."
msgstr "O PC5 não consegue excluir %s: %s."

#: title/pc5_library.c:1372 title/pc5_library.c:1647 title/pc5_library.c:1702
#, c-format
msgid "PC5 can't move the game's folder: %s."
msgstr "O PC5 não consegue mover a pasta do jogo: %s."

#: title/pc5_library.c:1381 title/pc5_library.c:1652
#, c-format
msgid "PC5 can't delete the game's profile: %s."
msgstr "O PC5 não consegue excluir o perfil do jogo: %s."

#: title/pc5_library.c:1395 title/pc5_library.c:1639 title/pc5_library.c:2741
#: title/pc5_library.c:2749
msgid "A path is too long."
msgstr "Um caminho é longo demais."

#: title/pc5_library.c:1598
msgid "PC5 can't read the game's folder."
msgstr "O PC5 não consegue ler a pasta do jogo."

#: title/pc5_library.c:1606 title/pc5_library.c:1857 title/pc5_library.c:2936
#, c-format
msgid "A path in the game is too long: %s."
msgstr "Um caminho no jogo é longo demais: %s."

#: title/pc5_library.c:1615
#, c-format
msgid "PC5 can't keep %s: %s."
msgstr "O PC5 não consegue guardar %s: %s."

#: title/pc5_library.c:1671
#, c-format
msgid "PC5 can't put the saves in place: %s."
msgstr "O PC5 não consegue colocar os dados salvos no lugar: %s."

#: title/pc5_library.c:1685
msgid "This game's saves can't be kept apart from it."
msgstr "Os dados salvos deste jogo não podem ser guardados separados dele."

#: title/pc5_library.c:1691
#, c-format
msgid "PC5 can't make its saves folder: %s."
msgstr "O PC5 não consegue criar a pasta de dados salvos dele: %s."

#: title/pc5_library.c:1695
msgid "PC5 is still keeping this game's saves from before: start PC5 again."
msgstr ""
"O PC5 ainda está guardando os dados salvos anteriores deste jogo: inicie o "
"PC5 de novo."

#: title/pc5_library.c:1728
#, c-format
msgid "PC5 can't move the saves: %s."
msgstr "O PC5 não consegue mover os dados salvos: %s."

#: title/pc5_library.c:1815
#, c-format
msgid "A path in the update is too long: %s."
msgstr "Um caminho na atualização é longo demais: %s."

#: title/pc5_library.c:1897
#, c-format
msgid "PC5 can't write the game's list of files: %s."
msgstr "O PC5 não consegue gravar a lista de arquivos do jogo: %s."

#: title/pc5_library.c:2215
msgid ""
"PC5's Windows template is missing from the app: copy the PC5 folder again."
msgstr ""
"O modelo de Windows do PC5 está faltando no app: copie a pasta PC5 de novo."

#: title/pc5_library.c:2239
msgid "PC5's Windows template is damaged: copy the PC5 folder again."
msgstr ""
"O modelo de Windows do PC5 está danificado: copie a pasta PC5 de novo."

#: title/pc5_library.c:2321 title/pc5_library.c:2381
#, c-format
msgid "PC5 can't make its folders in %s: %s."
msgstr "O PC5 não consegue criar as pastas dele em %s: %s."

#: title/pc5_library.c:2332
#, c-format
msgid "PC5 can't make its folder on the USB drive: %s."
msgstr "O PC5 não consegue criar a pasta dele na unidade USB: %s."

#: title/pc5_library.c:2335
msgid "PC5 can't name the game's folder on the USB drive."
msgstr "O PC5 não consegue dar nome à pasta do jogo na unidade USB."

#: title/pc5_library.c:2353
#, c-format
msgid ""
"The drive reads at %.0f MB/s here, too slow to play from (%.0f needed). "
"Plug it into a port on the back or the front USB-C port. Installing to the "
"console still works."
msgstr ""
"A unidade lê a %.0f MB/s aqui, devagar demais para jogar a partir dela "
"(são necessários %.0f). Conecte-a a uma porta traseira ou à porta USB-C "
"frontal. Instalar no console continua funcionando."

#: title/pc5_library.c:2361
#, c-format
msgid ""
"Not enough space on the USB drive: the game needs %s and it has %s free."
msgstr ""
"Não há espaço suficiente na unidade USB: o jogo precisa de %s e ela tem %s "
"livres."

#: title/pc5_library.c:2365
msgid ""
"Only a game on a USB drive can play from it: this folder isn't on one."
msgstr ""
"Só um jogo que está numa unidade USB pode ser jogado a partir dela: esta "
"pasta não está numa."

#: title/pc5_library.c:2367
msgid "A game in PC5's INSTALL folder is installed, not played from there."
msgstr "Um jogo na pasta INSTALL do PC5 é instalado, não jogado de lá."

#: title/pc5_library.c:2372
#, c-format
msgid ""
"The drive reads at %.0f MB/s in this USB port, too slow to play from (at "
"least %.0f is needed). On the original PS5 the front USB-A port is the "
"slow one: plug the drive into a port on the back, or the front USB-C port. "
"Install still works from this port."
msgstr ""
"A unidade lê a %.0f MB/s nesta porta USB, devagar demais para jogar a "
"partir dela (são necessários pelo menos %.0f). No PS5 original, a porta "
"USB-A frontal é a lenta: conecte a unidade a uma porta traseira ou à porta "
"USB-C frontal. Instalar ainda funciona por esta porta."

#: title/pc5_library.c:2378
msgid "The game's program is too deep in its folder for Windows."
msgstr "O programa do jogo está fundo demais na pasta dele para o Windows."

#: title/pc5_library.c:2386
#, c-format
msgid "Not enough space: the game needs %s and the console has %s free."
msgstr ""
"Não há espaço suficiente: o jogo precisa de %s e o console tem %s livres."

#: title/pc5_library.c:2389
msgid "PC5 can't name the game."
msgstr "O PC5 não consegue dar nome ao jogo."

#: title/pc5_library.c:2392
#, c-format
msgid "PC5 can't start the install: %s."
msgstr "O PC5 não consegue iniciar a instalação: %s."

#: title/pc5_library.c:2399 title/pc5_library.c:2472 title/pc5_library.c:2508
#: title/pc5_library.c:2757
msgid "Out of memory."
msgstr "Sem memória."

#: title/pc5_library.c:2432
msgid "A path in the Windows template is too long."
msgstr "Um caminho no modelo de Windows é longo demais."

#: title/pc5_library.c:2435 title/pc5_library.c:2440 title/pc5_library.c:2943
#: title/pc5_tile.c:519
#, c-format
msgid "PC5 can't make %s: %s."
msgstr "O PC5 não consegue criar %s: %s."

#: title/pc5_library.c:2443
#, c-format
msgid "PC5's Windows template is missing %s."
msgstr "Está faltando %s no modelo de Windows do PC5."

#: title/pc5_library.c:2461
#, c-format
msgid "PC5 can't copy %s: %s."
msgstr "O PC5 não consegue copiar %s: %s."

#: title/pc5_library.c:2486
#, c-format
msgid "PC5 can't read %s on the USB drive: %s."
msgstr "O PC5 não consegue ler %s na unidade USB: %s."

#: title/pc5_library.c:2527 title/pc5_library.c:2953
#, c-format
msgid "PC5 can't read back %s: %s."
msgstr "O PC5 não consegue reler %s: %s."

#: title/pc5_library.c:2527
#, c-format
msgid "The USB drive stopped answering while PC5 copied %s (%s)."
msgstr "A unidade USB parou de responder enquanto o PC5 copiava %s (%s)."

#: title/pc5_library.c:2555 title/pc5_library.c:2567
#, c-format
msgid ""
"The game couldn't be put back in the INSTALL folder: it is in %.180s."
msgstr ""
"Não foi possível devolver o jogo à pasta INSTALL: ele está em %.180s."

#: title/pc5_library.c:2606
#, c-format
msgid "PC5 can't save the cover: %s."
msgstr "O PC5 não consegue salvar a capa: %s."

#: title/pc5_library.c:2613
#, c-format
msgid "PC5 can't put the game in place: %s."
msgstr "O PC5 não consegue colocar o jogo no lugar: %s."

#: title/pc5_library.c:2722
msgid "PC5 didn't install this game, so it can't update it."
msgstr "O PC5 não instalou este jogo, então não pode atualizá-lo."

#: title/pc5_library.c:2724
#, c-format
msgid ""
"%s plays from its USB drive: copy the newer version over its folder %s "
"there."
msgstr ""
"%s é jogado da unidade USB dele: copie a versão mais nova por cima da "
"pasta %s dele lá."

#: title/pc5_library.c:2729
msgid "The game's folder is missing: uninstall it and install it again."
msgstr "A pasta do jogo está faltando: desinstale e instale-o de novo."

#: title/pc5_library.c:2732
#, c-format
msgid ""
"This folder doesn't have %s, the program %s starts. Choose the folder of a "
