msgstr "Enviar um jogo"

#. Web page text.
#: title/pc5_web_page.html:59
msgctxt "web"
msgid ""
"Choose a game's folder: it goes to PC5's INSTALL folder, then PC5 asks to "
"install it."
msgstr ""
"Escolha a pasta de um jogo: ela vai para a pasta INSTALL do PC5, e então o "
"PC5 pergunta se quer instalá-lo."

