#: title/pc5_files.c:100
msgid "The name is empty."
msgstr "De naam is leeg."

#: title/pc5_files.c:101
#, c-format
msgid "\"%s\" can't be a name."
msgstr "“%s” kan geen naam zijn."

#: title/pc5_files.c:102
msgid "The name is too long: 255 bytes at most."
msgstr "De naam is te lang: maximaal 255 bytes."

#: title/pc5_files.c:105
#, c-format
msgid "A name can't have %s in it."
msgstr "Een naam mag geen %s bevatten."

#: title/pc5_files.c:108
msgid "A name can't end in a space or a dot."
msgstr "Een naam mag niet eindigen op een spatie of een punt."

#: title/pc5_files.c:240
#, c-format
msgid "%s has folders too deep to copy."
msgstr "%s heeft mappen die te diep liggen om te kopiëren."

#: title/pc5_files.c:241 title/pc5_files.c:251 title/pc5_files.c:381
#: title/pc5_files.c:398
#, c-format
msgid "PC5 can't read %s: %s."
msgstr "PC5 kan %s niet lezen: %s."

#: title/pc5_files.c:256
#, c-format
msgid "A path in %s is too long."
msgstr "Een pad in %s is te lang."

#: title/pc5_files.c:267
msgid "PC5 ran out of memory planning the copy."
msgstr "PC5 had te weinig geheugen om het kopiëren te plannen."

#: title/pc5_files.c:281
msgid "Nothing is chosen."
msgstr "Er is niets gekozen."

#: title/pc5_files.c:284 title/pc5_files.c:289 title/pc5_tile.c:631
#: title/pc5_upgrade.c:637
msgid "PC5 ran out of memory."
msgstr "PC5 heeft te weinig geheugen."

#: title/pc5_files.c:288
msgid "The folder to paste into isn't there any more."
msgstr "De map om in te plakken is er niet meer."

#: title/pc5_files.c:296
#, c-format
msgid "%s isn't there any more."
msgstr "%s is er niet meer."

#: title/pc5_files.c:300
#, c-format
msgid "%s can't go into itself or a folder inside it."
msgstr "%s kan niet in zichzelf of in een map daarbinnen."

#: title/pc5_files.c:304
#, c-format
msgid "The path of %s would be too long."
msgstr "Het pad van %s zou te lang worden."

#: title/pc5_files.c:319
#, c-format
msgid "PC5 can't find a free name for %s."
msgstr "PC5 vindt geen vrije naam voor %s."

#: title/pc5_files.c:351
#, c-format
msgid "There isn't room: it needs %s and the drive has %s free."
msgstr "Er is niet genoeg ruimte: er is %s nodig en de schijf heeft %s vrij."

#: title/pc5_files.c:357
msgid "PC5 ran out of memory planning the work."
msgstr "PC5 had te weinig geheugen om het werk te plannen."

#: title/pc5_files.c:385 title/pc5_files.c:406 title/pc5_files.c:419
#: title/pc5_library.c:2349 title/pc5_library.c:2438 title/pc5_library.c:2860
#: title/pc5_library.c:2875 title/pc5_library.c:2881
#, c-format
msgid "PC5 can't write %s: %s."
msgstr "PC5 kan %s niet schrijven: %s."

#: title/pc5_files.c:391
#, c-format
msgid "PC5 ran out of memory copying %s."
msgstr "PC5 had te weinig geheugen bij het kopiëren van %s."

#: title/pc5_files.c:427 title/pc5_library.c:1763
#, c-format
msgid "PC5 can't put %s in place: %s."
msgstr "PC5 kan %s niet op zijn plaats zetten: %s."

#: title/pc5_files.c:453
#, c-format
msgid "PC5 can't make the folder %s: %s."
msgstr "PC5 kan de map %s niet maken: %s."

#: title/pc5_files.c:459
#, c-format
msgid "PC5 can't move %s: %s."
msgstr "PC5 kan %s niet verplaatsen: %s."

#: title/pc5_files.c:464
#, c-format
msgid "PC5 ran out of memory deleting %s."
msgstr "PC5 had te weinig geheugen bij het verwijderen van %s."

#: title/pc5_ftp.c:626 title/pc5_web.c:884
msgid "There's no network here."
msgstr "Er is hier geen netwerk."

#: title/pc5_ftp.c:628 title/pc5_ui.c:2520
msgid "PC5's INSTALL folder isn't there."
msgstr "De INSTALL-map van PC5 is er niet."

#: title/pc5_ftp.c:633 title/pc5_web.c:889
#, c-format
msgid "Port %u is taken, or there's no network."
msgstr "Poort %u is bezet, of er is geen netwerk."

#: title/pc5_ftp.c:647 title/pc5_web.c:903
msgid "PC5 can't start it."
msgstr "PC5 kan het niet starten."

#: title/pc5_game.c:415
msgid "The app's path is too long."
msgstr "Het pad van de app is te lang."

#: title/pc5_game.c:421
msgid "PC5 can't read the app's .NET runtime."
msgstr "PC5 kan de .NET-runtime van de app niet lezen."

#: title/pc5_game.c:446
msgid "A path of the .NET runtime is too long."
msgstr "Een pad van de .NET-runtime is te lang."

#: title/pc5_game.c:451
msgid "PC5 can't make the .NET runtime's folders: is the console full?"
msgstr "PC5 kan de mappen van de .NET-runtime niet maken: is de console vol?"

#: title/pc5_game.c:462
#, c-format
msgid ""
"The app's .NET runtime has no %.80s. Copy the PPSA11018 folder to the "
"console again."
msgstr ""
"De .NET-runtime van de app mist %.80s. Kopieer de map PPSA11018 opnieuw "
"naar de console."

#: title/pc5_game.c:468
msgid "PC5 can't copy the .NET runtime: is the console full?"
msgstr "PC5 kan de .NET-runtime niet kopiëren: is de console vol?"

#: title/pc5_game.c:476
msgid "PC5 can't finish the .NET runtime's copy."
msgstr "PC5 kan het kopiëren van de .NET-runtime niet afronden."

#: title/pc5_home.c:157
msgid "The tile's program is missing from PC5's app (pc5/forwarder)."
msgstr ""
"Het programma voor tegels ontbreekt in de app van PC5 (pc5/forwarder)."

#: title/pc5_home.c:161
#, c-format
msgid "PC5 can't use %s: %s."
msgstr "PC5 kan %s niet gebruiken: %s."

#: title/pc5_home.c:165
msgid "PC5 ran out of memory making the tile's picture."
msgstr "PC5 had te weinig geheugen om de afbeelding van de tegel te maken."

#: title/pc5_home.c:180
#, c-format
msgid "PC5 can't write the tile in %s: %s."
msgstr "PC5 kan de tegel niet in %s schrijven: %s."

#: title/pc5_library.c:169
#, c-format
msgid ""
"Plug in the USB drive with %.100s: it plays from the folder %.200s on it."
msgstr ""
"Sluit de USB-schijf met %.100s aan: de game wordt gespeeld vanuit de map "
"%.200s daarop."

#: title/pc5_library.c:175 title/pc5_library.c:2756 title/pc5_library.c:2807
#, c-format
msgid "PC5 can't make the game's folder: %s."
msgstr "PC5 kan de map van de game niet maken: %s."

#: title/pc5_library.c:195
#, c-format
msgid "PC5 can't link the game's folder on the USB drive: %s."
msgstr "PC5 kan de map van de game op de USB-schijf niet koppelen: %s."

#: title/pc5_library.c:498 title/pc5_library.c:515
msgid "Choose one of the game's programs."
msgstr "Kies een van de programma's van de game."

#: title/pc5_library.c:511 title/pc5_library.c:661 title/pc5_library.c:885
msgid "PC5's notes on this game are missing."
msgstr "De notities van PC5 over deze game ontbreken."

#: title/pc5_library.c:523
msgid "That program is too deep in the game's folder for Windows."
msgstr "Dat programma zit te diep in de map van de game voor Windows."

#: title/pc5_library.c:528 title/pc5_library.c:1780 title/pc5_library.c:2493
#: title/pc5_library.c:2496 title/pc5_library.c:2505 title/pc5_library.c:2577
#: title/pc5_library.c:2769
#, c-format
msgid "PC5 can't write its notes: %s."
msgstr "PC5 kan zijn notities niet schrijven: %s."

#: title/pc5_library.c:549
msgid "PC5 is out of memory."
msgstr "PC5 heeft geen geheugen meer."

#: title/pc5_library.c:553
#, c-format
msgid "%.200s doesn't start any of the game's programs."
msgstr "%.200s start geen van de programma's van de game."

#: title/pc5_library.c:753
msgid "The game's launch options are too long: 511 characters at most."
msgstr "De startopties van de game zijn te lang: maximaal 511 tekens."

#: title/pc5_library.c:770
msgid "The game's path is too long for Windows."
msgstr "Het pad van de game is te lang voor Windows."

#: title/pc5_library.c:786 title/pc5_library.c:964
#, c-format
msgid "PC5 can't write the game's profile: %s."
msgstr "PC5 kan het profiel van de game niet schrijven: %s."

#: title/pc5_library.c:910
#, c-format
msgid "The program its launcher started isn't one of the game's: %.200s"
msgstr ""
"Het programma dat de launcher startte, hoort niet bij de game: %.200s"

#: title/pc5_library.c:924
msgid "The arguments its launcher gave are too long."
msgstr "De argumenten van de launcher zijn te lang."

#: title/pc5_library.c:946
#, c-format
msgid "Its programs kept starting each other: %d hand-offs in a row."
msgstr "De programma's bleven elkaar starten: %d keer achter elkaar."

#: title/pc5_library.c:960
msgid "The program's path is too long for Windows."
msgstr "Het pad van het programma is te lang voor Windows."

#: title/pc5_library.c:1019
#, c-format
msgid "Its profile has a mistake (%s)."
msgstr "Het profiel bevat een fout (%s)."

#: title/pc5_library.c:1036
msgid "Its Windows folder is missing."
msgstr "De Windows-map ontbreekt."

#: title/pc5_library.c:1176
#, c-format
msgid "PC5 can't delete %s: %s."
msgstr "PC5 kan %s niet verwijderen: %s."

#: title/pc5_library.c:1275 title/pc5_library.c:1550 title/pc5_library.c:1605
#, c-format
msgid "PC5 can't move the game's folder: %s."
msgstr "PC5 kan de map van de game niet verplaatsen: %s."

#: title/pc5_library.c:1284 title/pc5_library.c:1555
#, c-format
msgid "PC5 can't delete the game's profile: %s."
msgstr "PC5 kan het profiel van de game niet verwijderen: %s."

#: title/pc5_library.c:1298 title/pc5_library.c:1542 title/pc5_library.c:2642
#: title/pc5_library.c:2650
msgid "A path is too long."
msgstr "Een pad is te lang."

#: title/pc5_library.c:1501
msgid "PC5 can't read the game's folder."
msgstr "PC5 kan de map van de game niet lezen."

#: title/pc5_library.c:1509 title/pc5_library.c:1760 title/pc5_library.c:2837
#, c-format
msgid "A path in the game is too long: %s."
msgstr "Een pad in de game is te lang: %s."

#: title/pc5_library.c:1518
#, c-format
msgid "PC5 can't keep %s: %s."
msgstr "PC5 kan %s niet bewaren: %s."

#: title/pc5_library.c:1574
#, c-format
msgid "PC5 can't put the saves in place: %s."
msgstr "PC5 kan de opgeslagen gegevens niet terugzetten: %s."

#: title/pc5_library.c:1588
msgid "This game's saves can't be kept apart from it."
msgstr ""
"De opgeslagen gegevens van deze game kunnen niet apart worden bewaard."

#: title/pc5_library.c:1594
#, c-format
msgid "PC5 can't make its saves folder: %s."
msgstr "PC5 kan de map voor opgeslagen gegevens niet maken: %s."

#: title/pc5_library.c:1598
msgid "PC5 is still keeping this game's saves from before: start PC5 again."
msgstr ""
"PC5 is nog bezig de eerdere opgeslagen gegevens van deze game te bewaren: "
"start PC5 opnieuw."

#: title/pc5_library.c:1631
#, c-format
msgid "PC5 can't move the saves: %s."
msgstr "PC5 kan de opgeslagen gegevens niet verplaatsen: %s."

#: title/pc5_library.c:1718
#, c-format
msgid "A path in the update is too long: %s."
msgstr "Een pad in de update is te lang: %s."

#: title/pc5_library.c:1800
#, c-format
msgid "PC5 can't write the game's list of files: %s."
msgstr "PC5 kan de bestandslijst van de game niet schrijven: %s."

#: title/pc5_library.c:2118
msgid ""
"PC5's Windows template is missing from the app: copy the PC5 folder again."
msgstr ""
"Het Windows-sjabloon van PC5 ontbreekt in de app: kopieer de map PC5 "
"opnieuw."

#: title/pc5_library.c:2142
msgid "PC5's Windows template is damaged: copy the PC5 folder again."
msgstr ""
"Het Windows-sjabloon van PC5 is beschadigd: kopieer de map PC5 opnieuw."

#: title/pc5_library.c:2224 title/pc5_library.c:2284
#, c-format
msgid "PC5 can't make its folders in %s: %s."
msgstr "PC5 kan zijn mappen in %s niet maken: %s."

#: title/pc5_library.c:2235
#, c-format
msgid "PC5 can't make its folder on the USB drive: %s."
msgstr "PC5 kan zijn map op de USB-schijf niet maken: %s."

#: title/pc5_library.c:2238
msgid "PC5 can't name the game's folder on the USB drive."
msgstr "PC5 kan de map van de game op de USB-schijf geen naam geven."

#: title/pc5_library.c:2256
#, c-format
msgid ""
"The drive reads at %.0f MB/s here, too slow to play from (%.0f needed). "
"Plug it into a port on the back or the front USB-C port. Installing to the "
"console still works."
msgstr ""
"De schijf leest hier met %.0f MB/s, te traag om vanaf te spelen (%.0f "
"nodig). Sluit hem aan op een poort aan de achterkant of op de USB-C-poort "
"aan de voorkant. Installeren op de console werkt nog wel."

#: title/pc5_library.c:2264
#, c-format
msgid ""
"Not enough space on the USB drive: the game needs %s and it has %s free."
msgstr ""
"Niet genoeg ruimte op de USB-schijf: de game heeft %s nodig en er is %s "
"vrij."

#: title/pc5_library.c:2268
msgid ""
"Only a game on a USB drive can play from it: this folder isn't on one."
msgstr ""
"Alleen een game op een USB-schijf kan daarvandaan gespeeld worden: deze "
"map staat er niet op."

#: title/pc5_library.c:2270
msgid "A game in PC5's INSTALL folder is installed, not played from there."
msgstr ""
"Een game in de INSTALL-map van PC5 wordt geïnstalleerd, niet vandaar "
"gespeeld."

#: title/pc5_library.c:2275
#, c-format
msgid ""
"The drive reads at %.0f MB/s in this USB port, too slow to play from (at "
"least %.0f is needed). On the original PS5 the front USB-A port is the "
"slow one: plug the drive into a port on the back, or the front USB-C port. "
"Install still works from this port."
msgstr ""
"De schijf leest in deze USB-poort met %.0f MB/s, te traag om vanaf te "
"spelen (minstens %.0f nodig). Op de originele PS5 is de USB-A-poort aan de "
"voorkant de trage: sluit de schijf aan op een poort aan de achterkant of "
"op de USB-C-poort aan de voorkant. Installeren werkt nog wel via deze "
"poort."

#: title/pc5_library.c:2281
msgid "The game's program is too deep in its folder for Windows."
msgstr "Het programma van de game zit te diep in zijn map voor Windows."

#: title/pc5_library.c:2289
#, c-format
msgid "Not enough space: the game needs %s and the console has %s free."
msgstr ""
"Niet genoeg ruimte: de game heeft %s nodig en de console heeft %s vrij."

#: title/pc5_library.c:2292
msgid "PC5 can't name the game."
msgstr "PC5 kan de game geen naam geven."

#: title/pc5_library.c:2295
#, c-format
msgid "PC5 can't start the install: %s."
msgstr "PC5 kan de installatie niet starten: %s."

#: title/pc5_library.c:2302 title/pc5_library.c:2375 title/pc5_library.c:2411
#: title/pc5_library.c:2658
msgid "Out of memory."
msgstr "Te weinig geheugen."

#: title/pc5_library.c:2335
msgid "A path in the Windows template is too long."
msgstr "Een pad in het Windows-sjabloon is te lang."

#: title/pc5_library.c:2338 title/pc5_library.c:2343 title/pc5_library.c:2844
#: title/pc5_tile.c:519
#, c-format
msgid "PC5 can't make %s: %s."
msgstr "PC5 kan %s niet maken: %s."

#: title/pc5_library.c:2346
#, c-format
msgid "PC5's Windows template is missing %s."
msgstr "Het Windows-sjabloon van PC5 mist %s."

#: title/pc5_library.c:2364
#, c-format
msgid "PC5 can't copy %s: %s."
msgstr "PC5 kan %s niet kopiëren: %s."

#: title/pc5_library.c:2389
#, c-format
msgid "PC5 can't read %s on the USB drive: %s."
msgstr "PC5 kan %s op de USB-schijf niet lezen: %s."

#: title/pc5_library.c:2430 title/pc5_library.c:2854
#, c-format
msgid "PC5 can't read back %s: %s."
msgstr "PC5 kan %s niet teruglezen: %s."

#: title/pc5_library.c:2430
#, c-format
msgid "The USB drive stopped answering while PC5 copied %s (%s)."
msgstr "De USB-schijf reageerde niet meer terwijl PC5 %s kopieerde (%s)."

#: title/pc5_library.c:2458 title/pc5_library.c:2470
#, c-format
msgid ""
"The game couldn't be put back in the INSTALL folder: it is in %.180s."
msgstr "De game kon niet terug in de INSTALL-map: hij staat in %.180s."

#: title/pc5_library.c:2509
#, c-format
msgid "PC5 can't save the cover: %s."
msgstr "PC5 kan de cover niet opslaan: %s."

#: title/pc5_library.c:2516
#, c-format
msgid "PC5 can't put the game in place: %s."
msgstr "PC5 kan de game niet op zijn plaats zetten: %s."

#: title/pc5_library.c:2623
msgid "PC5 didn't install this game, so it can't update it."
msgstr "PC5 heeft deze game niet geïnstalleerd en kan hem dus niet updaten."

#: title/pc5_library.c:2625
#, c-format
msgid ""
"%s plays from its USB drive: copy the newer version over its folder %s "
"there."
msgstr ""
"%s wordt gespeeld vanaf zijn USB-schijf: kopieer de nieuwere versie daar "
"over zijn map %s."

#: title/pc5_library.c:2630
msgid "The game's folder is missing: uninstall it and install it again."
msgstr ""
"De map van de game ontbreekt: deïnstalleer hem en installeer hem opnieuw."

#: title/pc5_library.c:2633
#, c-format
msgid ""
"This folder doesn't have %s, the program %s starts. Choose the folder of a "
"newer copy of %s."
msgstr ""
"Deze map heeft geen %s, het programma dat %s start. Kies de map van een "
"nieuwere kopie van %s."

#: title/pc5_library.c:2647
#, c-format
msgid "Not enough space: the update needs %s and the console has %s free."
msgstr ""
"Niet genoeg ruimte: de update heeft %s nodig en de console heeft %s vrij."

#: title/pc5_library.c:2653
msgid ""
"An earlier update of this game isn't finished: close PC5 and open it again "
"to finish it."
msgstr ""
"Een eerdere update van deze game is niet klaar: sluit PC5 en open het "
"opnieuw om hem af te ronden."

#: title/pc5_library.c:2655
#, c-format
msgid "PC5 can't start the update: %s."
msgstr "PC5 kan de update niet starten: %s."

#: title/pc5_library.c:2684
msgid ""
"Kept saves can't be put back for a game that plays from its USB drive."
msgstr ""
"Bewaarde gegevens kunnen niet worden teruggezet voor een game die vanaf "
"zijn USB-schijf wordt gespeeld."

