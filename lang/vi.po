#. A menu row's value, shown at its right: keep it short (about 15 characters).
#: title/pc5_ui.c:6725
msgid "Keep"
msgstr "Giữ nguyên"

#. A menu row's name (about 30 characters fit).
#: title/pc5_ui.c:6728
msgid "Game memory"
msgstr "Bộ nhớ trò chơi"

#: title/pc5_ui.c:6729
msgid ""
"4 GB even for a game not made for it: room for mods; Auto if it misbehaves"
msgstr ""
"4 GB cả với trò chơi không làm cho mức đó: chỗ cho mod; chọn Tự động nếu "
"có trục trặc"

#: title/pc5_ui.c:6730
msgid "2 GB, or 4 GB for a game made for it, as on Windows"
msgstr "2 GB, hoặc 4 GB cho trò chơi được làm cho mức đó, như trên Windows"

#. A menu row's value, shown at its right: keep it short (about 15 characters).
#: title/pc5_ui.c:6731
msgid "4 GB"
msgstr "4 GB"

#. A menu row's name (about 30 characters fit).
#: title/pc5_ui.c:6734
msgid "Graphics memory"
msgstr "Bộ nhớ đồ họa"

#: title/pc5_ui.c:6736
msgid "All 8 GB: the game may take memory the rest of it needs"
msgstr "Cả 8 GB: trò chơi có thể chiếm bộ nhớ mà phần còn lại cần"

#: title/pc5_ui.c:6737
msgid ""
"More for the game's textures, less for the rest; Auto if it runs out of "
"memory"
msgstr ""
"Nhiều hơn cho texture của trò chơi, ít hơn cho phần còn lại; Tự động nếu "
"hết bộ nhớ"

#: title/pc5_ui.c:6738
msgid ""
"4 GB, so the game leaves room for the rest: the console's memory is shared"
msgstr ""
"4 GB, để trò chơi chừa chỗ cho phần còn lại: bộ nhớ của máy là dùng chung"

