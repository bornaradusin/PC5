"The new version is installed. Close PC5 from the PS button and open it "
"again."
msgstr "Phiên bản mới đã được cài. Hãy đóng PC5 bằng nút PS rồi mở lại."

#: title/pc5_ui.c:4538
msgid "The update was stopped"
msgstr "Đã dừng cập nhật"

#: title/pc5_ui.c:4538
msgid "PC5 is as it was, and what was downloaded is deleted."
msgstr "PC5 vẫn như cũ, và phần đã tải về đã bị xóa."

#: title/pc5_ui.c:4541
msgid "PC5's update isn't finished"
msgstr "Bản cập nhật của PC5 chưa xong"

#: title/pc5_ui.c:4541
msgid "PC5 wasn't updated"
msgstr "PC5 chưa được cập nhật"

#: title/pc5_ui.c:4627 title/pc5_ui.c:5683 title/pc5_ui.c:5700
#: title/pc5_ui.c:5770
#, c-format
msgid "%s can't start"
msgstr "Không mở được %s"

#: title/pc5_ui.c:4628
#, c-format
msgid ""
"%s You can uninstall it from its menu (Triangle) and install it again."
msgstr "%s Bạn có thể gỡ cài đặt nó từ menu của nó (△) rồi cài lại."

#: title/pc5_ui.c:4629 title/pc5_ui.c:5184
