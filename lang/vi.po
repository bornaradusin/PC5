msgstr "PC5 không lưu được ảnh bìa: %s."

#: title/pc5_library.c:2607
#, c-format
msgid "PC5 can't put the game in place: %s."
msgstr "PC5 không đặt được trò chơi vào chỗ: %s."

#: title/pc5_library.c:2716
msgid "PC5 didn't install this game, so it can't update it."
msgstr "PC5 không cài trò chơi này nên không cập nhật được."

#: title/pc5_library.c:2718
#, c-format
msgid ""
"%s plays from its USB drive: copy the newer version over its folder %s "
"there."
msgstr ""
"%s chạy từ ổ USB của nó: hãy chép phiên bản mới hơn đè lên thư mục %s trên "
"ổ đó."

#: title/pc5_library.c:2723
msgid "The game's folder is missing: uninstall it and install it again."
msgstr "Thư mục của trò chơi bị thiếu: hãy gỡ cài đặt rồi cài lại."

#: title/pc5_library.c:2726
#, c-format
msgid ""
"This folder doesn't have %s, the program %s starts. Choose the folder of a "
"newer copy of %s."
msgstr ""
"Thư mục này không có %s, chương trình mà %s khởi động. Hãy chọn thư mục "
"của bản %s mới hơn."

#: title/pc5_library.c:2740
#, c-format
msgid "Not enough space: the update needs %s and the console has %s free."
msgstr "Không đủ chỗ: bản cập nhật cần %s nhưng máy chỉ còn trống %s."

#: title/pc5_library.c:2746
msgid ""
"An earlier update of this game isn't finished: close PC5 and open it again "
"to finish it."
msgstr ""
"Một bản cập nhật trước của trò chơi này chưa xong: hãy đóng PC5 rồi mở lại "
"để hoàn tất."

#: title/pc5_library.c:2748
#, c-format
msgid "PC5 can't start the update: %s."
msgstr "PC5 không bắt đầu cập nhật được: %s."

#: title/pc5_library.c:2777
msgid ""
"Kept saves can't be put back for a game that plays from its USB drive."
msgstr "Không thể đặt lại dữ liệu lưu đã giữ cho trò chơi chạy từ ổ USB."

#: title/pc5_library.c:2781
msgid "The install has begun already."
msgstr "Quá trình cài đặt đã bắt đầu rồi."

#: title/pc5_library.c:2797
msgid "PC5 can't read the kept saves."
msgstr "PC5 không đọc được dữ liệu lưu đã giữ."

#: title/pc5_library.c:2797
msgid "The kept saves are damaged: they have no registry."
msgstr "Dữ liệu lưu đã giữ bị hỏng: không có registry."

#: title/pc5_library.c:2874
#, c-format
msgid "PC5 can't make the game's folder on the USB drive: %s."
msgstr "PC5 không tạo được thư mục của trò chơi trên ổ USB: %s."

#: title/pc5_library.c:2947
#, c-format
msgid "PC5 can't open %s on the USB drive: %s."
msgstr "PC5 không mở được %s trên ổ USB: %s."

#: title/pc5_library.c:2985
#, c-format
msgid ""
"The copy of %s doesn't match the USB drive. The drive or its cable may be "
"failing; nothing was kept."
msgstr ""
"Bản sao của %s không khớp với ổ USB. Ổ hoặc cáp có thể đang hỏng; không "
"giữ lại gì cả."

