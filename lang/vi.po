msgstr "Đổi chương trình"

#. A menu row's name (about 30 characters fit).
#: title/pc5_ui.c:6824
msgid "Steam emulator"
msgstr "Giả lập Steam"

#: title/pc5_ui.c:6825
msgid "Steam's own library: the game won't find Steam on the console"
msgstr "Thư viện gốc của Steam: trò chơi sẽ không tìm thấy Steam trên máy"

#: title/pc5_ui.c:6826
msgid "Stands in for Steam, which the game asks for; Off if it misbehaves"
msgstr "Thay thế Steam mà trò chơi đòi hỏi; Tắt nếu có trục trặc"

#. A menu row's name (about 30 characters fit).
#: title/pc5_ui.c:6830 title/pc5_ui.c:7909
