msgid "Music wasn't saved"
msgstr "Nhạc chưa được lưu"

#: title/pc5_ui.c:3497
msgid "PC5 couldn't create the game's music folder. Check free space."
msgstr ""
"PC5 không tạo được thư mục nhạc của trò chơi. Hãy kiểm tra dung lượng "
"trống."

