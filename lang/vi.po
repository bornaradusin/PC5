#: title/pc5_upgrade.c:1328 title/pc5_upgrade.c:1355
msgid "Cancelled."
msgstr "Đã hủy."

#: title/pc5_upgrade.c:408
msgid "The download is damaged (a file in it doesn't match its checksum)."
msgstr "Tệp tải về bị hỏng (một tệp trong đó không khớp với checksum)."

#: title/pc5_upgrade.c:411
#, c-format
msgid "Files can't be written on the drive (%s)."
msgstr "Không ghi được tệp lên ổ (%s)."

#: title/pc5_upgrade.c:414
msgid "PC5 ran out of memory unpacking it."
msgstr "PC5 hết bộ nhớ khi giải nén."

#: title/pc5_upgrade.c:417
msgid "The download isn't a zip PC5 can read."
msgstr "Tệp tải về không phải tệp zip mà PC5 đọc được."

#: title/pc5_upgrade.c:589 title/pc5_upgrade.c:710 title/pc5_upgrade.c:1316
msgid "A path in PC5's folder is too long."
msgstr "Một đường dẫn trong thư mục của PC5 quá dài."

#: title/pc5_upgrade.c:597
#, c-format
msgid ""
"PC5's folder has %.100s where the new version has a %s of that name. Move "
"it out of the folder and try again."
msgstr ""
"Thư mục của PC5 có %.100s trong khi bản mới có một %s cùng tên. Hãy chuyển "
"nó ra khỏi thư mục rồi thử lại."

#: title/pc5_upgrade.c:713
#, c-format
msgid "A new file is missing: %.200s."
msgstr "Thiếu một tệp mới: %.200s."

#: title/pc5_upgrade.c:716
#, c-format
msgid "PC5 can't put its new files in place (%.150s: %s)."
msgstr "PC5 không đặt được các tệp mới vào chỗ (%.150s: %s)."

#: title/pc5_upgrade.c:1085 title/pc5_upgrade.c:1105
#, c-format
msgid "The download can't be saved (%s)."
msgstr "Không lưu được tệp tải về (%s)."

#: title/pc5_upgrade.c:1095
#, c-format
msgid "GitHub answered the download with an error (HTTP %d)."
msgstr "GitHub trả về lỗi cho lượt tải (HTTP %d)."

#: title/pc5_upgrade.c:1096
#, c-format
msgid "The download stopped (%d). Is the console still online?"
msgstr "Tải về đã dừng (%d). Máy còn kết nối mạng không?"

#: title/pc5_upgrade.c:1097
msgid "The download was cut short."
msgstr "Tải về bị ngắt giữa chừng."

#: title/pc5_upgrade.c:1103
msgid "The download doesn't match the checksum GitHub lists for it."
msgstr "Tệp tải về không khớp với checksum mà GitHub ghi."

#: title/pc5_upgrade.c:1277
msgid "GitHub didn't answer. Is the console online?"
msgstr "GitHub không phản hồi. Máy có đang kết nối mạng không?"

#: title/pc5_upgrade.c:1279
#, c-format
msgid "You already have the newest PC5 (%s)."
msgstr "Bạn đã có PC5 mới nhất (%s)."

#: title/pc5_upgrade.c:1282
#, c-format
msgid ""
"PC5 %s's release on GitHub has no %s.zip to install. Download it from "
"GitHub instead."
msgstr ""
"Bản phát hành PC5 %s trên GitHub không có %s.zip để cài. Hãy tải nó từ "
"GitHub."

#: title/pc5_upgrade.c:1286
#, c-format
msgid ""
"PC5 is on the console more than once (%.200s and %.200s), so it can't tell "
"which to update. Delete the copy you don't use, or install PC5 %s from "
"GitHub as before."
msgstr ""
"PC5 có trên máy nhiều hơn một bản (%.200s và %.200s), nên không biết cập "
"nhật bản nào. Hãy xóa bản bạn không dùng, hoặc cài PC5 %s từ GitHub như "
"trước."

#: title/pc5_upgrade.c:1290
#, c-format
msgid ""
"PC5's folder wasn't found on the console's drives (in homebrew, "
"etaHEN/games or at the top of a drive). Install PC5 %s from GitHub as "
"before."
msgstr ""
"Không tìm thấy thư mục của PC5 trên các ổ của máy (trong homebrew, "
"etaHEN/games hoặc ở cấp trên cùng của ổ). Hãy cài PC5 %s từ GitHub như "
"trước."

#: title/pc5_upgrade.c:1297
#, c-format
msgid "PC5 can't update itself where it is (%s)."
msgstr "PC5 không tự cập nhật được ở vị trí hiện tại (%s)."

#: title/pc5_upgrade.c:1299
#, c-format
msgid "PC5 can't write to its folder (%s)."
msgstr "PC5 không ghi được vào thư mục của nó (%s)."

#: title/pc5_upgrade.c:1303
msgid ""
"An earlier update isn't finished. Close PC5 and open it again: it finishes "
"it then."
msgstr ""
"Một bản cập nhật trước chưa xong. Hãy đóng PC5 rồi mở lại: nó sẽ hoàn tất "
"khi đó."

#: title/pc5_upgrade.c:1309
#, c-format
msgid "PC5 can't make its work folder (%s)."
msgstr "PC5 không tạo được thư mục làm việc (%s)."

#: title/pc5_upgrade.c:1326
#, c-format
msgid ""
"There isn't room on PC5's drive for the update: it needs about %s free."
msgstr "Ổ chứa PC5 không đủ chỗ cho bản cập nhật: cần trống khoảng %s."

#: title/pc5_upgrade.c:1339 title/pc5_upgrade.c:1378
msgid "The work folder can't be written."
msgstr "Không ghi được vào thư mục làm việc."

#: title/pc5_upgrade.c:1345
#, c-format
msgid "The download isn't PC5 (%s is missing something)."
msgstr "Tệp tải về không phải PC5 (%s thiếu thứ gì đó)."

#: title/pc5_upgrade.c:1346
msgid "The work folder can't be read."
msgstr "Không đọc được thư mục làm việc."

#: title/pc5_upgrade.c:1390
#, c-format
msgid ""
"%.120s Close PC5 and open it again: it finishes the update then. If it "
"still can't, install PC5 %s from GitHub."
msgstr ""
"%.120s Hãy đóng PC5 rồi mở lại: nó sẽ hoàn tất bản cập nhật khi đó. Nếu "
"vẫn không được, hãy cài PC5 %s từ GitHub."

#: title/pc5_upgrade.c:1449
#, c-format
msgid "PC5 can't start the update (%d)."
msgstr "PC5 không bắt đầu cập nhật được (%d)."

#: title/pc5_web.c:885
msgid "PC5 has no folder to show."
msgstr "PC5 không có thư mục nào để hiện."

#. Web page text.
#: title/pc5_web_page.html:46
msgctxt "web"
msgid "Asking the console…"
msgstr "Đang hỏi máy…"

#. Web page text.
#: title/pc5_web_page.html:47
msgctxt "web"
msgid "Game compatibility list"
msgstr "Danh sách tương thích"

#. Web page text.
#: title/pc5_web_page.html:48
msgctxt "web"
msgid "Help (wiki)"
msgstr "Trợ giúp (wiki)"

#. Web page text.
#: title/pc5_web_page.html:49
msgctxt "web"
msgid "Report a problem with PC5"
msgstr "Báo lỗi PC5"

#. Web page text.
#: title/pc5_web_page.html:52
msgctxt "web"
msgid "Send a game"
msgstr "Gửi trò chơi"

#. Web page text.
#: title/pc5_web_page.html:53
msgctxt "web"
msgid ""
"Choose a game's folder: it goes to PC5's INSTALL folder, then PC5 asks to "
"install it."
msgstr ""
"Chọn thư mục của trò chơi: nó sẽ được gửi vào thư mục INSTALL của PC5, rồi "
"PC5 sẽ hỏi có cài không."

#. Web page text.
#: title/pc5_web_page.html:55
msgctxt "web"
msgid "Choose a folder"
msgstr "Chọn thư mục"

#. Web page text.
#: title/pc5_web_page.html:57
msgctxt "web"
msgid ""
"A phone that can't choose a folder: type the game's folder name, then "
"choose its files."
msgstr ""
"Điện thoại không chọn được thư mục: hãy nhập tên thư mục của trò chơi, rồi "
"chọn các tệp của nó."

#. Web page text.
#: title/pc5_web_page.html:60
msgctxt "web"
msgid "Choose files"
msgstr "Chọn tệp"

#. Web page text.
#: title/pc5_web_page.html:66
msgctxt "web"
msgid "Games"
msgstr "Trò chơi"

#. Web page text.
#: title/pc5_web_page.html:66
msgctxt "web"
msgid "Refresh"
msgstr "Làm mới"

#. Web page text.
#: title/pc5_web_page.html:68 title/pc5_web_page.html:74
msgctxt "web"
msgid "Loading…"
msgstr "Đang tải…"

#. Web page text.
#: title/pc5_web_page.html:71
msgctxt "web"
msgid "Logs"
msgstr "Nhật ký"

#. Web page text.
#. Keep <b>...</b> and <code>...</code> around the same words.
#: title/pc5_web_page.html:72
msgctxt "web"
msgid ""
"Attach one to an issue on GitHub when a game has a problem: a game's "
"<b>Report a problem</b> above downloads its newest log and opens GitHub's "
"form with the game, PC5 and its settings filled in."
msgstr ""
"Khi một trò chơi gặp lỗi, hãy đính kèm một nhật ký vào issue trên GitHub: "
"nút <b>Báo lỗi</b> của trò chơi ở trên sẽ tải nhật ký mới nhất và mở biểu "
"mẫu GitHub đã điền sẵn trò chơi, PC5 và cài đặt của nó."

#. Web page text.
#. A text box's hint, shown in it while it is empty.
#: title/pc5_web_page.html:59
msgctxt "web"
msgid "The game's folder name"
msgstr "Tên thư mục của trò chơi"

#. Web page text.
#. A text box's hint, shown in it while it is empty.
#: title/pc5_web_page.html:67
msgctxt "web"
msgid "Find a game"
msgstr "Tìm trò chơi"

#. Web page text.
#: title/pc5_web_page.html:103
msgctxt "web"
msgid "bytes"
msgstr "byte"

#. Web page text.
#. %s and %d are filled in by the page; %1$s, %2$s put them in another order.
#: title/pc5_web_page.html:124
#, c-format
msgctxt "web"
msgid "PC5 %s · %s free on the console"
msgstr "PC5 %s · máy còn trống %s"

#. Web page text.
#. %s and %d are filled in by the page; %1$s, %2$s put them in another order.
#: title/pc5_web_page.html:125
#, c-format
msgctxt "web"
msgid " · INSTALL folder: %s free"
msgstr " · Thư mục INSTALL: còn trống %s"

#. Web page text.
#. %s and %d are filled in by the page; %1$s, %2$s put them in another order.
#: title/pc5_web_page.html:127
#, c-format
msgctxt "web"
msgid "The console didn't answer: %s"
msgstr "Máy không phản hồi: %s"

#. Web page text.
#: title/pc5_web_page.html:133
msgctxt "web"
msgid "given by you"
msgstr "do bạn nhập"

#. Web page text.
#. %s and %d are filled in by the page; %1$s, %2$s put them in another order.
#: title/pc5_web_page.html:134
#, c-format
msgctxt "web"
msgid "found in %s"
msgstr "tìm thấy trong %s"

#. Web page text.
#: title/pc5_web_page.html:134
msgctxt "web"
msgid "none found"
msgstr "không tìm thấy"

#. Web page text.
#. %s and %d are filled in by the page; %1$s, %2$s put them in another order.
#: title/pc5_web_page.html:135
#, c-format
msgctxt "web"
msgid "Which game it is (Steam app ID: %s)"
msgstr "Đây là trò chơi nào (Steam app ID: %s)"

#. Web page text.
#: title/pc5_web_page.html:135
msgctxt "web"
msgid "none"
msgstr "không có"

#. Web page text.
#: title/pc5_web_page.html:136
msgctxt "web"
msgid "Steam app ID, e.g. 1091500"
msgstr "Steam app ID, ví dụ 1091500"

#. Web page text.
#: title/pc5_web_page.html:139 title/pc5_web_page.html:165
msgctxt "web"
msgid "Save"
msgstr "Lưu"

#. Web page text.
#: title/pc5_web_page.html:142 title/pc5_web_page.html:168
msgctxt "web"
msgid "Saving…"
msgstr "Đang lưu…"

#. Web page text.
#: title/pc5_web_page.html:146
msgctxt "web"
msgid ""
"Saved: its cover, background and details are fetched again when PC5 opens."
msgstr ""
"Đã lưu: ảnh bìa, ảnh nền và thông tin của nó sẽ được lấy lại khi PC5 mở."

#. Web page text.
#: title/pc5_web_page.html:147
msgctxt "web"
msgid "Cleared: PC5 reads the game's folder again."
msgstr "Đã xóa: PC5 sẽ đọc lại thư mục của trò chơi."

#. Web page text.
#. %s and %d are filled in by the page; %1$s, %2$s put them in another order.
#: title/pc5_web_page.html:149 title/pc5_web_page.html:174
#, c-format
msgctxt "web"
msgid "Not saved: %s"
msgstr "Chưa lưu: %s"

#. Web page text.
#. %s and %d are filled in by the page; %1$s, %2$s put them in another order.
#: title/pc5_web_page.html:152
#, c-format
msgctxt "web"
msgid "; GOG product %s"
msgstr "; sản phẩm GOG %s"

#. Web page text.
#. %s and %d are filled in by the page; %1$s, %2$s put them in another order.
#: title/pc5_web_page.html:153
#, c-format
msgctxt "web"
msgid ""
"PC5 picks the game's cover, background and details by this number (%s%s). "
"If they are another game's, type the number from the game's Steam store "
"link (store.steampowered.com/app/<number>). Empty: PC5 reads the folder "
"again."
msgstr ""
"PC5 chọn ảnh bìa, ảnh nền và thông tin của trò chơi theo số này (%s%s). "
"Nếu chúng là của trò chơi khác, hãy nhập số trong liên kết cửa hàng Steam "
"của trò chơi (store.steampowered.com/app/<số>). Để trống: PC5 sẽ đọc lại "
"thư mục."

#. Web page text.
#: title/pc5_web_page.html:172
msgctxt "web"
msgid "Saved: used at the game's next start."
msgstr "Đã lưu: sẽ dùng ở lần khởi động tới của trò chơi."

#. Web page text.
#: title/pc5_web_page.html:187
msgctxt "web"
msgid "No games yet."
msgstr "Chưa có trò chơi nào."

#. Web page text.
#: title/pc5_web_page.html:190
msgctxt "web"
msgid "USB drive"
msgstr "Ổ USB"

#. Web page text.
#: title/pc5_web_page.html:191
msgctxt "web"
msgid "can't start"
msgstr "không khởi động được"

#. Web page text.
#. %s and %d are filled in by the page; %1$s, %2$s put them in another order.
#: title/pc5_web_page.html:196
#, c-format
msgctxt "web"
msgid "Settings: %s"
msgstr "Cài đặt: %s"

#. Web page text.
#: title/pc5_web_page.html:199
msgctxt "web"
msgid "Newest log"
msgstr "Nhật ký mới nhất"

#. Web page text.
#: title/pc5_web_page.html:201
msgctxt "web"
msgid "Report a problem"
msgstr "Báo lỗi"

#. Web page text.
#: title/pc5_web_page.html:202
msgctxt "web"
msgid ""
"Downloads the newest log and opens GitHub's form, filled in: attach the "
"log there."
msgstr ""
"Tải nhật ký mới nhất và mở biểu mẫu GitHub đã điền sẵn: hãy đính kèm nhật "
"ký ở đó."

#. Web page text.
#: title/pc5_web_page.html:208
msgctxt "web"
msgid "Launch options (launch.txt)"
msgstr "Tùy chọn khởi chạy (launch.txt)"

#. Web page text.
#: title/pc5_web_page.html:209
msgctxt "web"
msgid ""
"The first line that isn't empty or a comment (# or ;) is added to the "
"program's command line."
msgstr ""
"Dòng đầu tiên không trống và không phải chú thích (# hoặc ;) sẽ được thêm "
"vào dòng lệnh của chương trình."

#. Web page text.
#: title/pc5_web_page.html:212
msgctxt "web"
msgid "Environment variables (env.txt)"
msgstr "Biến môi trường (env.txt)"

#. Web page text.
#: title/pc5_web_page.html:212
msgctxt "web"
msgid "One NAME=value a line, set before the game starts."
msgstr "Mỗi dòng một NAME=value, được đặt trước khi trò chơi khởi động."

#. Web page text.
#: title/pc5_web_page.html:213
msgctxt "web"
msgid "Extra logging (winedebug.txt)"
msgstr "Ghi nhật ký thêm (winedebug.txt)"

#. Web page text.
#: title/pc5_web_page.html:214
msgctxt "web"
msgid ""
"Only when an issue asks for it, for example err+all,+seh. Empty it "
"afterwards: it slows the game down."
msgstr ""
"Chỉ khi một issue yêu cầu, ví dụ err+all,+seh. Hãy xóa trống sau đó: nó "
"làm trò chơi chậm đi."

#. Web page text.
#. %s and %d are filled in by the page; %1$s, %2$s put them in another order.
#: title/pc5_web_page.html:219
#, c-format
msgctxt "web"
msgid "The games didn't load: %s"
msgstr "Không tải được danh sách trò chơi: %s"

#. Web page text.
#: title/pc5_web_page.html:232
msgctxt "web"
msgid "No logs kept."
msgstr "Không có nhật ký nào được giữ."

#. Web page text.
#: title/pc5_web_page.html:236
msgctxt "web"
msgid "had a problem"
msgstr "đã gặp lỗi"

#. Web page text.
#. %s and %d are filled in by the page; %1$s, %2$s put them in another order.
#: title/pc5_web_page.html:239
#, c-format
msgctxt "web"
msgid "The logs didn't load: %s"
msgstr "Không tải được nhật ký: %s"

#. Web page text.
#: title/pc5_web_page.html:248
msgctxt "web"
msgid "the connection was lost"
msgstr "mất kết nối"

#. Web page text.
#. %s and %d are filled in by the page; %1$s, %2$s put them in another order.
#: title/pc5_web_page.html:265
#, c-format
msgctxt "web"
msgid "Sending %d of %d: %s"
msgstr "Đang gửi %d/%d: %s"

#. Web page text.
#. %s and %d are filled in by the page; %1$s, %2$s put them in another order.
#: title/pc5_web_page.html:269
#, c-format
msgctxt "web"
msgid "Stopped at %s: %s"
msgstr "Đã dừng ở %s: %s"

#. Web page text.
#. %s and %d are filled in by the page; %1$s, %2$s put them in another order.
#: title/pc5_web_page.html:276
#, c-format
msgctxt "web"
msgid "Sent %d files (%s). PC5 asks to install the game in a moment."
msgstr "Đã gửi %d tệp (%s). Lát nữa PC5 sẽ hỏi có cài trò chơi không."

#. Web page text.
#: title/pc5_web_page.html:285
msgctxt "web"
msgid "Type the game's folder name first (no / or \\)."
msgstr "Hãy nhập tên thư mục của trò chơi trước (không có / hoặc \\)."
