#: title/pc5_ui.c:4933
#, c-format
msgid ""
"Together they need %s and the console has %s free. Go back and untick some."
msgstr ""
"Tổng cộng chúng cần %s nhưng máy chỉ còn trống %s. Hãy quay lại và bỏ chọn "
