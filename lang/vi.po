#: title/pc5_ui.c:4167 title/pc5_ui.c:4268 title/pc5_ui.c:4836
#: title/pc5_ui.c:5408 title/pc5_ui_enhancements_input.h:56
msgid "The console's on-screen keyboard can't be used just now."
msgstr "Hiện không dùng được bàn phím ảo của máy."

