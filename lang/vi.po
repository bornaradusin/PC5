msgid "Update to PC5 %s first?"
msgstr "Cập nhật lên PC5 %s trước?"

#: title/pc5_ui.c:9261
#, c-format
msgid "You have %s"
msgstr "Bạn đang có %s"

#: title/pc5_ui.c:9262
#, c-format
msgid ""
"This may already be fixed in it. Update, try the game again, and report it "
