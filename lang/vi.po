msgstr "Bản sao lưu chưa được lưu"

#: title/pc5_ui.c:4264
msgid ""
"Choose another folder. The backup name is unavailable or its path is too "
"long."
msgstr ""
"Hãy chọn thư mục khác. Tên bản sao lưu không dùng được hoặc đường dẫn quá "
"dài."

