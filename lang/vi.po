#, c-format
msgid "Starting %s"
msgstr "Đang khởi động %s"

#: title/pc5_ui.c:9273
#, c-format
msgid "Installing %.80s for it, once"
msgstr "Đang cài %.80s cho nó, chỉ một lần"

