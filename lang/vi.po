msgstr "Cả 8 GB: trò chơi có thể chiếm bộ nhớ mà phần còn lại cần"

#: title/pc5_ui.c:6897
msgid "2 GB at most, so older games don't get confused"
msgstr "Tối đa 2 GB, để trò chơi cũ không bị nhầm lẫn"

#: title/pc5_ui.c:6898
msgid ""
"4 GB, so the game leaves room for the rest: the console's memory is shared"
msgstr ""
"4 GB, để trò chơi chừa chỗ cho phần còn lại: bộ nhớ của máy là dùng chung"

#: title/pc5_ui.c:6900
msgid ""
"Less for textures, more for the game: for one that runs out of memory"
msgstr "Ít hơn cho texture, nhiều hơn cho game: khi game hết bộ nhớ"

#: title/pc5_ui.c:6902
msgid "More for a game that says there is too little; Auto if it misbehaves"
msgstr "Nhiều hơn cho game thấy quá ít; Tự động nếu lỗi"

#: title/pc5_ui.c:6903
msgid ""
"More for the game's textures, less for the rest; Auto if it runs out of "
"memory"
msgstr ""
"Nhiều hơn cho texture của trò chơi, ít hơn cho phần còn lại; Tự động nếu "
"hết bộ nhớ"

