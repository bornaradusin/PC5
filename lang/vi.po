msgid "Frame generation"
msgstr "Tạo khung hình"

#: title/pc5_ui.c:6859
msgid ""
"Held at 40 fps, two frames made between each two: for a game that can't "
"hold 60"
msgstr ""
"Giữ ở 40 fps, tạo hai khung hình giữa mỗi hai khung: cho trò chơi không "
"giữ được 60"

#. A menu row's value, shown at its right: keep it short (about 15 characters).
#: title/pc5_ui.c:6860
msgid "40 → 120 fps"
msgstr "40 → 120 fps"

#: title/pc5_ui.c:6862
msgid ""
"Held at 60 fps, a frame made between each two: smoother on a 120 Hz TV"
msgstr ""
"Giữ ở 60 fps, tạo một khung hình giữa mỗi hai khung: mượt hơn trên TV 120 "
"Hz"

#: title/pc5_ui.c:6863
msgid "Held at 30 fps and shown at 60: smoother where it runs below 60"
msgstr "Giữ ở 30 fps và hiển thị 60: mượt hơn ở chỗ chạy dưới 60"

#. A menu row's value, shown at its right: keep it short (about 15 characters).
#: title/pc5_ui.c:6864
msgid "60 → 120 fps"
msgstr "60 → 120 fps"

#. A menu row's value, shown at its right: keep it short (about 15 characters).
#: title/pc5_ui.c:6864
msgid "30 → 60 fps"
msgstr "30 → 60 fps"

#: title/pc5_ui.c:6866
msgid "Off. Left and right: 60 → 120 or 40 → 120 fps"
msgstr "Tắt. Trái và phải: 60 → 120 hoặc 40 → 120 fps"

#: title/pc5_ui.c:6867
msgid ""
"Off. Left and right: 30 → 60 fps (with 120 Hz output on, 60 → 120 or 40 → "
"120)"
msgstr ""
"Tắt. Trái và phải: 30 → 60 fps (khi bật xuất hình 120 Hz: 60 → 120 hoặc 40 "
"→ 120)"

