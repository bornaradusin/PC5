msgid "Password (empty: none)"
msgstr "Mật khẩu (trống: không có)"

#: title/pc5_ui.c:4800
msgid "Appearance wasn't changed"
msgstr "Giao diện không thay đổi"

#: title/pc5_ui.c:4800
msgid "Appearance backup complete"
msgstr "Đã sao lưu giao diện xong"

#: title/pc5_ui.c:4801
msgid "The saved appearance was restored. Game files and saves were kept."
msgstr ""
"Đã khôi phục giao diện đã lưu. Tệp trò chơi và dữ liệu lưu vẫn được giữ."

#: title/pc5_ui.c:4865 title/pc5_ui.c:4996
msgid "Out of memory"
msgstr "Hết bộ nhớ"

#: title/pc5_ui.c:4865 title/pc5_ui.c:4996
