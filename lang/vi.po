msgstr "Ảnh bìa và ảnh nền do thành viên tạo, dùng khóa của bạn"

#: title/pc5_ui.c:2594
msgid "Its catalogue's covers and backgrounds"
msgstr "Ảnh bìa và ảnh nền từ danh mục của nó"

#: title/pc5_ui.c:2594
msgid "The cover on the game's page, and its Steam background"
msgstr "Ảnh bìa trên trang của trò chơi và ảnh nền Steam của nó"

#: title/pc5_ui.c:2595
msgid "Steam's pictures for a game Steam's search misses"
msgstr "Hình Steam cho trò chơi mà tìm kiếm của Steam bỏ sót"

#: title/pc5_ui.c:2603
#, c-format
msgid "Needs your key, in %s"
msgstr "Cần khóa của bạn, trong %s"

