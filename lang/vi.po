msgid ""
"A phone that can't choose a folder: type the game's folder name, then "
"choose its files."
msgstr ""
"Điện thoại không chọn được thư mục: hãy nhập tên thư mục của trò chơi, rồi "
"chọn các tệp của nó."

#. Web page text.
#: title/pc5_web_page.html:66
msgctxt "web"
msgid "Choose files"
msgstr "Chọn tệp"

