#: title/pc5_ui.c:1618
msgid ""
"Its cover can only be changed as in Covers on the wiki: a picture of your "
"own."
msgstr ""
"Chỉ có thể đổi ảnh bìa của nó theo trang Covers trên wiki: dùng ảnh của "
"riêng bạn."

#: title/pc5_ui.c:1619
msgid "Only a game PC5 installed has a tile picture."
msgstr "Chỉ trò chơi do PC5 cài mới có hình biểu tượng."

#: title/pc5_ui.c:1620
msgid ""
"Its background can only be changed as in Covers on the wiki: a picture of "
"your own."
msgstr ""
"Chỉ có thể đổi ảnh nền của nó theo trang Covers trên wiki: dùng ảnh của "
"riêng bạn."

#: title/pc5_ui.c:1626
msgid "PC5 ran out of memory"
msgstr "PC5 hết bộ nhớ"

#: title/pc5_ui.c:1626
msgid "Close PC5 and open it again."
msgstr "Hãy đóng PC5 rồi mở lại."

#: title/pc5_ui.c:1800
msgid "The cover wasn't changed"
msgstr "Ảnh bìa chưa được đổi"

#: title/pc5_ui.c:1801
msgid "The tile picture wasn't changed"
msgstr "Hình biểu tượng chưa được đổi"

#: title/pc5_ui.c:1801
