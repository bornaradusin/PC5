msgid "PC5 can't find the game's folder"
msgstr "PC5 không tìm thấy thư mục của trò chơi"

#: title/pc5_ui.c:3619 title/pc5_ui.c:5389
msgid "Its files may be missing: uninstall it and install it again."
msgstr "Có thể tệp của nó bị thiếu: hãy gỡ cài đặt rồi cài lại."

#: title/pc5_ui.c:3660
msgid "Phone uploads need a game with its own PC5 folder."
msgstr "Tải lên từ điện thoại cần trò chơi có thư mục PC5 riêng."

#: title/pc5_ui.c:3670 title/pc5_ui.c:3679
msgid "Phone connection unavailable"
msgstr "Không kết nối được với điện thoại"

#: title/pc5_ui.c:3679
msgid ""
"Check the network, then try again. The phone and PS5 must share a network "
"or phone hotspot."
msgstr ""
"Hãy kiểm tra mạng rồi thử lại. Điện thoại và PS5 phải dùng chung mạng hoặc "
"điểm phát sóng của điện thoại."

#: title/pc5_ui.c:3703
