#: title/pc5_ui.c:4138 title/pc5_ui.c:8080
#, c-format
msgid "Line %d"
msgstr "Dòng %d"

#: title/pc5_ui.c:4140
msgid "New line"
msgstr "Dòng mới"

#: title/pc5_ui.c:4254
msgid "Choose a writable folder"
msgstr "Chọn thư mục có thể ghi"

#: title/pc5_ui.c:4254
msgid ""
"Open a folder on internal storage or a USB drive, then choose Save here."
msgstr "Mở một thư mục trên bộ nhớ máy hoặc ổ USB, rồi chọn Lưu ở đây."

#: title/pc5_ui.c:4264
