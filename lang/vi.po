#, c-format
msgid "Windows can't use the name \"%.180s\"."
msgstr "Windows không dùng được tên \"%.180s\"."

#: title/pc5_source.c:325
msgid "The folder goes too many levels deep."
msgstr "Thư mục lồng quá nhiều cấp."

#: title/pc5_source.c:464
msgid "There is no Windows program in this folder."
msgstr "Thư mục này không có chương trình Windows nào."

#: title/pc5_source.c:466
msgid "This folder only has installers and tools, not a game."
msgstr "Thư mục này chỉ có trình cài đặt và công cụ, không có trò chơi."

#: title/pc5_textdoc.c:142 title/pc5_textdoc.c:246
msgid "It's larger than 8 MB: PC5 changes text files up to that size."
msgstr "Tệp lớn hơn 8 MB: PC5 chỉ sửa tệp văn bản đến kích thước đó."

#: title/pc5_textdoc.c:155
msgid "It's UTF-16 big-endian text, which PC5 doesn't change."
msgstr "Đây là văn bản UTF-16 big-endian, PC5 không sửa loại này."

#: title/pc5_textdoc.c:163 title/pc5_textdoc.c:177 title/pc5_textdoc.c:195
msgid ""
"It isn't text: PC5 changes only text files (.ini, .cfg, .txt and the like)."
msgstr ""
"Đây không phải văn bản: PC5 chỉ sửa tệp văn bản (.ini, .cfg, .txt và tương "
"tự)."

#: title/pc5_textdoc.c:182 title/pc5_textdoc.c:200 title/pc5_textdoc.c:209
msgid "There isn't memory enough to open it."
msgstr "Không đủ bộ nhớ để mở."

#: title/pc5_textdoc.c:230
msgid "It has more lines than PC5 can show."
msgstr "Tệp có nhiều dòng hơn mức PC5 có thể hiển thị."

#: title/pc5_textdoc.c:374
#, c-format
msgid ""
"This file is in an older encoding with room for Western letters only, and "
"“%s” isn't one of them."
msgstr ""
"Tệp này dùng bảng mã cũ chỉ chứa chữ cái phương Tây, và “%s” không nằm "
"trong đó."

#: title/pc5_textdoc.c:406 title/pc5_textdoc.c:408
msgid "There isn't memory enough to save it."
msgstr "Không đủ bộ nhớ để lưu."

#: title/pc5_tile.c:58
msgid "The tile's folder path is too long."
msgstr "Đường dẫn thư mục của biểu tượng quá dài."

#: title/pc5_tile.c:63
#, c-format
msgid "The tile's %s can't be read."
msgstr "Không đọc được %s của biểu tượng."

#: title/pc5_tile.c:69
msgid "The tile was made by a PC5 this one doesn't know: make it again."
msgstr ""
"Biểu tượng được tạo bởi một bản PC5 mà bản này không biết: hãy tạo lại."

#: title/pc5_tile.c:76
msgid "The tile doesn't say which game it starts: make it again."
msgstr "Biểu tượng không cho biết nó mở trò chơi nào: hãy tạo lại."

#: title/pc5_tile.c:85
msgid "The tile doesn't say where PC5 is: make it again."
msgstr "Biểu tượng không cho biết PC5 ở đâu: hãy tạo lại."

#: title/pc5_tile.c:119
msgid "A tile's ID is PPSA and five digits."
msgstr "ID của biểu tượng là PPSA và năm chữ số."

#: title/pc5_tile.c:143
#, c-format
msgid ""
"PC5's lapy.elf isn't the one this PC5 can make tiles from (%d compares, %d "
"names)."
msgstr ""
"lapy.elf của PC5 không phải bản mà PC5 này dùng để tạo biểu tượng được (%d "
"phép so sánh, %d tên)."

#: title/pc5_tile.c:252
#, c-format
msgid "PC5's folder path is too long for a tile (%d characters at most)."
msgstr "Đường dẫn thư mục của PC5 quá dài cho biểu tượng (tối đa %d ký tự)."

#: title/pc5_tile.c:257
msgid "PC5 can't read its own program to copy into the tile."
msgstr "PC5 không đọc được chương trình của chính nó để chép vào biểu tượng."

#: title/pc5_tile.c:262
msgid "PC5's folder has no lapy.elf."
msgstr "Thư mục của PC5 không có lapy.elf."

#: title/pc5_tile.c:273
msgid "PC5 ran out of memory making the tile."
msgstr "PC5 hết bộ nhớ khi tạo biểu tượng."

#: title/pc5_tile.c:277
msgid "PC5 can't make the tile's folders."
msgstr "PC5 không tạo được các thư mục của biểu tượng."

#: title/pc5_tile.c:282
msgid "PC5 can't copy its sce_module/libc.prx into the tile."
msgstr "PC5 không chép được sce_module/libc.prx của nó vào biểu tượng."

#: title/pc5_tile.c:286
msgid "PC5 can't write the tile's lapy.elf."
msgstr "PC5 không ghi được lapy.elf của biểu tượng."

#: title/pc5_tile.c:290
#, c-format
msgid "PC5 can't write the tile's %s."
msgstr "PC5 không ghi được %s của biểu tượng."

#: title/pc5_tile.c:294
msgid "PC5 can't copy its eboot.bin into the tile."
msgstr "PC5 không chép được eboot.bin của nó vào biểu tượng."

#: title/pc5_tile.c:397 title/pc5_tile.c:440
msgid "PC5 can't make the tile's sce_sys."
msgstr "PC5 không tạo được sce_sys của biểu tượng."

#: title/pc5_tile.c:401
msgid "PC5 can't make the tile's picture."
msgstr "PC5 không tạo được hình của biểu tượng."

#: title/pc5_tile.c:415
msgid "PC5 can't write the tile's pictures."
msgstr "PC5 không ghi được các hình của biểu tượng."

#: title/pc5_tile.c:447
msgid "PC5 can't write the tile's param.json from its own."
msgstr ""
"PC5 không ghi được param.json của biểu tượng từ param.json của chính nó."

#: title/pc5_tile.c:499
msgid "PC5 doesn't know where to make the tile."
msgstr "PC5 không biết tạo biểu tượng ở đâu."

#: title/pc5_tile.c:504
#, c-format
msgid "PC5 can't find a free title ID for the tile in %s."
msgstr "PC5 không tìm được title ID trống cho biểu tượng trong %s."

#: title/pc5_tile.c:514
msgid "The tiles' folder path is too long."
msgstr "Đường dẫn thư mục chứa biểu tượng quá dài."

#: title/pc5_tile.c:530
#, c-format
msgid "PC5 can't replace the tile: %s."
msgstr "PC5 không thay được biểu tượng: %s."

#: title/pc5_tile.c:536
#, c-format
msgid "PC5 can't put the tile in place: %s."
msgstr "PC5 không đặt được biểu tượng vào chỗ: %s."

#: title/pc5_tile.c:639 title/pc5_ui.c:5008
msgid ""
"It isn't in PC5 any more. Take the tile off the home screen, or install "
"the game again."
msgstr ""
"Nó không còn trong PC5 nữa. Hãy gỡ biểu tượng khỏi màn hình chính, hoặc "
"cài lại trò chơi."

#: title/pc5_tile.c:701 title/pc5_ui.c:6332
msgid ""
"Its program is wrapped in Steam's DRM (SteamStub), which starts only with "
"Steam running, and Steam doesn't run on the console. A copy of the game "
"without it can start."
msgstr ""
"Chương trình của nó được bọc DRM của Steam (SteamStub), chỉ khởi động khi "
"Steam đang chạy, mà Steam không chạy trên máy. Bản trò chơi không có DRM "
"này thì khởi động được."

#: title/pc5_tile.c:720
msgid "PC5 lost its place readying the game."
msgstr "PC5 gặp trục trặc khi chuẩn bị trò chơi."

