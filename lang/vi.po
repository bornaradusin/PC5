msgstr "Gỡ nhạc thư viện"

#: title/pc5_ui.c:6801
msgid "Delete this game's imported music; the original source file is kept"
msgstr "Xóa nhạc đã nhập của trò chơi này; tệp nguồn gốc vẫn được giữ"

#. A menu row's name (about 30 characters fit).
#: title/pc5_ui.c:6805 title/pc5_ui.c:7693
msgid "Tile picture"
msgstr "Hình biểu tượng"

#: title/pc5_ui.c:6806
msgid ""
"Its home screen tile's picture: a square one found online, or one made "
"from its cover"
msgstr ""
"Hình biểu tượng màn hình chính của nó: một hình vuông tìm trên mạng, hoặc "
"làm từ ảnh bìa"

#: title/pc5_ui.c:6810
#, c-format
msgid "Its tile, %.40s, starts the game"
msgstr "Biểu tượng của nó, %.40s, mở trò chơi"

#. A menu row's name (about 30 characters fit).
#: title/pc5_ui.c:6811
msgid "Home screen tile"
msgstr "Biểu tượng màn hình chính"

#: title/pc5_ui.c:6812
msgid "A tile on the PS5's home screen that starts it"
msgstr "Một biểu tượng trên màn hình chính PS5 để mở nó"

#: title/pc5_ui.c:6817
#, c-format
msgid "Now: %.150s"
msgstr "Hiện tại: %.150s"

